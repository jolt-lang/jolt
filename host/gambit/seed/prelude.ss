(guard (e (#t #f))
  (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "disj" "disj[oin]. Returns a new set of the same (hashed/sorted) type, that\n  does not contain key(s)." (jolt-list (jolt-vector (jolt-symbol #f "set")) (jolt-vector (jolt-symbol #f "set") (jolt-symbol #f "key")) (jolt-vector (jolt-symbol #f "set") (jolt-symbol #f "key") (jolt-symbol #f "&") (jolt-symbol #f "ks")))))
