  (jolt-invoke (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "conj" "conj[oin]. Returns a new collection with the xs\n    'added'. (conj nil item) returns (item).\n    (conj coll) returns coll. (conj) returns [].\n    The 'addition' may happen at different 'places' depending\n    on the concrete type." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x") (jolt-symbol #f "&") (jolt-symbol #f "xs"))) jolt-nil))
