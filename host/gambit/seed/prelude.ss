  (jolt-invoke (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "*print-namespace-maps*" "*print-namespace-maps* controls whether the printer will print\n  namespace map literal syntax. It defaults to false, but the REPL binds\n  to true." jolt-nil jolt-nil))
