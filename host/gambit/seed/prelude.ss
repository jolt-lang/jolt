  (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "cond->" "Takes an expression and a set of test/form pairs. Threads expr (via ->)\n  through each form for which the corresponding test\n  expression is true. Note that, unlike cond branching, cond-> threading does\n  not short circuit after the first true test expression." (jolt-list (jolt-vector (jolt-symbol #f "expr") (jolt-symbol #f "&") (jolt-symbol #f "clauses")))))
