(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "-" "If no ys are supplied, returns the negation of x, else subtracts\n  the ys from x and returns the result. Does not auto-promote\n  longs, will throw on overflow. See also: -'" (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more"))) jolt-nil))
