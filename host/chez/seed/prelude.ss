  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "ensure" "Must be called in a transaction. Protects the ref from modification\n  by other transactions.  Returns the in-transaction-value of\n  ref. Allows for more concurrency than (ref-set ref @ref)" (jolt-list (jolt-vector (jolt-symbol #f "ref")))))
