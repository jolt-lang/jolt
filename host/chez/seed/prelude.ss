  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "drop-while" "Returns a lazy sequence of the items in coll starting from the\n  first item for which (pred item) returns logical false.  Returns a\n  stateful transducer when no collection is provided." (jolt-list (jolt-vector (jolt-symbol #f "pred")) (jolt-vector (jolt-symbol #f "pred") (jolt-symbol #f "coll")))))
