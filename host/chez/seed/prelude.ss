  (jv$clojure.core/attach-core-doc-meta! "clojure.java.io" "make-parents" "Given the same arg(s) as for file, creates all parent directories of\n   the file they represent." (jolt-list (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "&") (jolt-symbol #f "more"))) jolt-nil))
