  (let ((_lp$29573 jv$clojure.core/attach-core-doc-meta!) (_la$29574 "clojure.core") (_la$29575 "delay?") (_la$29576 "returns true if x is a Delay created with delay") (_la$29577 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$29573) (_lp$29573 _la$29574 _la$29575 _la$29576 _la$29577 jolt-nil) (jolt-invoke _lp$29573 _la$29574 _la$29575 _la$29576 _la$29577 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29578 jv$clojure.core/attach-core-doc-meta!) (_la$29579 "clojure.core") (_la$29580 "deliver") (_la$29581 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29582 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29578) (_lp$29578 _la$29579 _la$29580 _la$29581 _la$29582 jolt-nil) (jolt-invoke _lp$29578 _la$29579 _la$29580 _la$29581 _la$29582 jolt-nil))))
