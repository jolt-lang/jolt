  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "fn" "params => positional-params*, or positional-params* & rest-param\n  positional-param => binding-form\n  rest-param => binding-form\n  binding-form => name, or destructuring-form\n\n  Defines a function.\n\n  See https://clojure.org/reference/special_forms#fn for more information" (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "sigs")))))
