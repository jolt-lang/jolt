  (let ((_lp$29552 jv$clojure.core/attach-core-doc-meta!) (_la$29553 "clojure.core") (_la$29554 "delay?") (_la$29555 "returns true if x is a Delay created with delay") (_la$29556 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$29552) (_lp$29552 _la$29553 _la$29554 _la$29555 _la$29556 jolt-nil) (jolt-invoke _lp$29552 _la$29553 _la$29554 _la$29555 _la$29556 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29557 jv$clojure.core/attach-core-doc-meta!) (_la$29558 "clojure.core") (_la$29559 "deliver") (_la$29560 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29561 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29557) (_lp$29557 _la$29558 _la$29559 _la$29560 _la$29561 jolt-nil) (jolt-invoke _lp$29557 _la$29558 _la$29559 _la$29560 _la$29561 jolt-nil))))
