  (let ((_lp$30391 jv$clojure.core/attach-core-doc-meta!) (_la$30392 "clojure.core") (_la$30393 "delay?") (_la$30394 "returns true if x is a Delay created with delay") (_la$30395 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$30391) (_lp$30391 _la$30392 _la$30393 _la$30394 _la$30395 jolt-nil) (jolt-invoke _lp$30391 _la$30392 _la$30393 _la$30394 _la$30395 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30396 jv$clojure.core/attach-core-doc-meta!) (_la$30397 "clojure.core") (_la$30398 "deliver") (_la$30399 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$30400 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$30396) (_lp$30396 _la$30397 _la$30398 _la$30399 _la$30400 jolt-nil) (jolt-invoke _lp$30396 _la$30397 _la$30398 _la$30399 _la$30400 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30401 jv$clojure.core/attach-core-doc-meta!) (_la$30402 "clojure.core") (_la$30403 "denominator") (_la$30404 "Returns the denominator part of a Ratio.") (_la$30405 (jolt-list-pos 814 4 (jolt-vector (jolt-symbol #f "r")))) (_la$30406 (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "java.math.BigInteger"))) (if (#3%procedure? _lp$30401) (_lp$30401 _la$30402 _la$30403 _la$30404 _la$30405 _la$30406) (jolt-invoke _lp$30401 _la$30402 _la$30403 _la$30404 _la$30405 _la$30406))))
(guard (e (#t #f))
  (let ((_lp$30407 jv$clojure.core/attach-core-doc-meta!) (_la$30408 "clojure.core") (_la$30409 "deref") (_la$30410 "Also reader macro: @ref/@agent/@var/@atom/@delay/@future/@promise. Within a transaction,\n  returns the in-transaction-value of ref, else returns the\n  most-recently-committed value of ref. When applied to a var, agent\n  or atom, returns its current state. When applied to a delay, forces\n  it if not already forced. When applied to a future, will block if\n  computation not complete. When applied to a promise, will block\n  until a value is delivered.  The variant taking a timeout can be\n  used for blocking references (futures and promises), and will return\n  timeout-val if the timeout (in milliseconds) is reached before a\n  value is available. See also - realized?.") (_la$30411 (jolt-list-pos 818 4 (jolt-vector (jolt-symbol #f "ref")) (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "timeout-ms") (jolt-symbol #f "timeout-val"))))) (if (#3%procedure? _lp$30407) (_lp$30407 _la$30408 _la$30409 _la$30410 _la$30411 jolt-nil) (jolt-invoke _lp$30407 _la$30408 _la$30409 _la$30410 _la$30411 jolt-nil))))
