  (let ((_lp$29244 jv$clojure.core/attach-core-doc-meta!) (_la$29245 "clojure.core") (_la$29246 "doall") (_la$29247 "When lazy sequences are produced via functions that have side\n  effects, any effects other than those needed to produce the first\n  element in the seq do not occur until the seq is consumed. doall can\n  be used to force any effects. Walks through the successive nexts of\n  the seq, retains the head and returns it, thus causing the entire\n  seq to reside in memory at one time.") (_la$29248 (jolt-list (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll"))))) (if (#3%procedure? _lp$29244) (_lp$29244 _la$29245 _la$29246 _la$29247 _la$29248 jolt-nil) (jolt-invoke _lp$29244 _la$29245 _la$29246 _la$29247 _la$29248 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29249 jv$clojure.core/attach-core-doc-meta!) (_la$29250 "clojure.core") (_la$29251 "dorun") (_la$29252 "When lazy sequences are produced via functions that have side\n  effects, any effects other than those needed to produce the first\n  element in the seq do not occur until the seq is consumed. dorun can\n  be used to force any effects. Walks through the successive nexts of\n  the seq, does not retain the head and returns nil.") (_la$29253 (jolt-list (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll"))))) (if (#3%procedure? _lp$29249) (_lp$29249 _la$29250 _la$29251 _la$29252 _la$29253 jolt-nil) (jolt-invoke _lp$29249 _la$29250 _la$29251 _la$29252 _la$29253 jolt-nil))))
