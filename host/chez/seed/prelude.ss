  (let ((_lp$29680 jv$clojure.core/attach-core-doc-meta!) (_la$29681 "clojure.core") (_la$29682 "delay?") (_la$29683 "returns true if x is a Delay created with delay") (_la$29684 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$29680) (_lp$29680 _la$29681 _la$29682 _la$29683 _la$29684 jolt-nil) (jolt-invoke _lp$29680 _la$29681 _la$29682 _la$29683 _la$29684 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29685 jv$clojure.core/attach-core-doc-meta!) (_la$29686 "clojure.core") (_la$29687 "deliver") (_la$29688 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29689 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29685) (_lp$29685 _la$29686 _la$29687 _la$29688 _la$29689 jolt-nil) (jolt-invoke _lp$29685 _la$29686 _la$29687 _la$29688 _la$29689 jolt-nil))))
