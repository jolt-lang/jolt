  (let ((_lp$29577 jv$clojure.core/attach-core-doc-meta!) (_la$29578 "clojure.core") (_la$29579 "deliver") (_la$29580 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29581 (jolt-list (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29577) (_lp$29577 _la$29578 _la$29579 _la$29580 _la$29581 jolt-nil) (jolt-invoke _lp$29577 _la$29578 _la$29579 _la$29580 _la$29581 jolt-nil))))
