  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "with-bindings*" "Takes a map of Var/value pairs. Installs for the given Vars the associated\n  values as thread-local bindings. Then calls f with the supplied arguments.\n  Pops the installed bindings after f returned. Returns whatever f returns." (jolt-list (jolt-vector (jolt-symbol #f "binding-map") (jolt-symbol #f "f") (jolt-symbol #f "&") (jolt-symbol #f "args"))) jolt-nil))
