(guard (e (#t #f))
  (let ((_lp$29020 jv$clojure.core/attach-core-doc-meta!) (_la$29021 "clojure.core") (_la$29022 "defmulti") (_la$29023 "Creates a new multimethod with the associated dispatch function.\n  The docstring and attr-map are optional.\n\n  Options are key-value pairs and may be one of:\n\n  :default\n\n  The default dispatch value, defaults to :default\n\n  :hierarchy\n\n  The value used for hierarchical dispatch (e.g. ::square is-a ::shape)\n\n  Hierarchies are type-like relationships that do not depend upon type\n  inheritance. By default Clojure's multimethods dispatch off of a\n  global hierarchy map.  However, a hierarchy relationship can be\n  created with the derive function used to augment the root ancestor\n  created with make-hierarchy.\n\n  Multimethods expect the value of the hierarchy option to be supplied as\n  a reference type e.g. a var (i.e. via the Var-quote dispatch macro #'\n  or the var special form).") (_la$29024 (jolt-list (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "docstring?") (jolt-symbol #f "attr-map?") (jolt-symbol #f "dispatch-fn") (jolt-symbol #f "&") (jolt-symbol #f "options"))))) (if (#3%procedure? _lp$29020) (_lp$29020 _la$29021 _la$29022 _la$29023 _la$29024 jolt-nil) (jolt-invoke _lp$29020 _la$29021 _la$29022 _la$29023 _la$29024 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29025 jv$clojure.core/attach-core-doc-meta!) (_la$29026 "clojure.core") (_la$29027 "defn") (_la$29028 "Same as (def name (fn [params* ] exprs*)) or (def\n    name (fn ([params* ] exprs*)+)) with any doc-string or attrs added\n    to the var metadata. prepost-map defines a map with optional keys\n    :pre and :post that contain collections of pre or post conditions.") (_la$29029 (jolt-list (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "prepost-map?") (jolt-symbol #f "body")) (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-list (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "prepost-map?") (jolt-symbol #f "body")) (jolt-symbol #f "+") (jolt-symbol #f "attr-map?"))))) (if (#3%procedure? _lp$29025) (_lp$29025 _la$29026 _la$29027 _la$29028 _la$29029 jolt-nil) (jolt-invoke _lp$29025 _la$29026 _la$29027 _la$29028 _la$29029 jolt-nil))))
