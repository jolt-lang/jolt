  (let ((_lp$29019 jv$clojure.core/attach-core-doc-meta!) (_la$29020 "clojure.core") (_la$29021 "*default-data-reader-fn*") (_la$29022 "When no data reader is found for a tag and *default-data-reader-fn*\n  is non-nil, it will be called with two arguments,\n  the tag and the value.  If *default-data-reader-fn* is nil (the\n  default), an exception will be thrown for the unknown tag.")) (if (#3%procedure? _lp$29019) (_lp$29019 _la$29020 _la$29021 _la$29022 jolt-nil jolt-nil) (jolt-invoke _lp$29019 _la$29020 _la$29021 _la$29022 jolt-nil jolt-nil))))
