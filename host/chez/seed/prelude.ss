  (let ((_lp$29695 jv$clojure.core/attach-core-doc-meta!) (_la$29696 "clojure.core") (_la$29697 "delay?") (_la$29698 "returns true if x is a Delay created with delay") (_la$29699 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$29695) (_lp$29695 _la$29696 _la$29697 _la$29698 _la$29699 jolt-nil) (jolt-invoke _lp$29695 _la$29696 _la$29697 _la$29698 _la$29699 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29700 jv$clojure.core/attach-core-doc-meta!) (_la$29701 "clojure.core") (_la$29702 "deliver") (_la$29703 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29704 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29700) (_lp$29700 _la$29701 _la$29702 _la$29703 _la$29704 jolt-nil) (jolt-invoke _lp$29700 _la$29701 _la$29702 _la$29703 _la$29704 jolt-nil))))
