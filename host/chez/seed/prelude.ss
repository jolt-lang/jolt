  (let ((_lp$30407 jv$clojure.core/attach-core-doc-meta!) (_la$30408 "clojure.core") (_la$30409 "delay?") (_la$30410 "returns true if x is a Delay created with delay") (_la$30411 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$30407) (_lp$30407 _la$30408 _la$30409 _la$30410 _la$30411 jolt-nil) (jolt-invoke _lp$30407 _la$30408 _la$30409 _la$30410 _la$30411 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30412 jv$clojure.core/attach-core-doc-meta!) (_la$30413 "clojure.core") (_la$30414 "deliver") (_la$30415 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$30416 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$30412) (_lp$30412 _la$30413 _la$30414 _la$30415 _la$30416 jolt-nil) (jolt-invoke _lp$30412 _la$30413 _la$30414 _la$30415 _la$30416 jolt-nil))))
