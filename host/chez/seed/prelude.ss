  (let ((_lp$29684 jv$clojure.core/attach-core-doc-meta!) (_la$29685 "clojure.core") (_la$29686 "delay?") (_la$29687 "returns true if x is a Delay created with delay") (_la$29688 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$29684) (_lp$29684 _la$29685 _la$29686 _la$29687 _la$29688 jolt-nil) (jolt-invoke _lp$29684 _la$29685 _la$29686 _la$29687 _la$29688 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29689 jv$clojure.core/attach-core-doc-meta!) (_la$29690 "clojure.core") (_la$29691 "deliver") (_la$29692 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29693 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29689) (_lp$29689 _la$29690 _la$29691 _la$29692 _la$29693 jolt-nil) (jolt-invoke _lp$29689 _la$29690 _la$29691 _la$29692 _la$29693 jolt-nil))))
