(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "with-bindings" "Takes a map of Var/value pairs. Installs for the given Vars the associated\n  values as thread-local bindings. Then executes body. Pops the installed\n  bindings after body was evaluated. Returns the value of body." (jolt-list (jolt-vector (jolt-symbol #f "binding-map") (jolt-symbol #f "&") (jolt-symbol #f "body"))) jolt-nil))
