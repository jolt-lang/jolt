(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "PrintWriter-on" "implements java.io.PrintWriter given flush-fn, which will be called\n  when .flush() is called, with a string built up since the last call to .flush().\n  if not nil, close-fn will be called with no arguments when .close is called.\n  autoflush? determines if the PrintWriter will autoflush, false by default." (jolt-list (jolt-vector (jolt-symbol #f "flush-fn") (jolt-symbol #f "close-fn")) (jolt-vector (jolt-symbol #f "flush-fn") (jolt-symbol #f "close-fn") (jolt-symbol #f "autoflush?"))) (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "java.io.PrintWriter")))
