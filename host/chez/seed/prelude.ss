(guard (e (#t #f))
  (let ((_lp$32600 jv$clojure.core/attach-core-doc-meta!) (_la$32601 "clojure.core") (_la$32602 "trampoline") (_la$32603 "trampoline can be used to convert algorithms requiring mutual\n  recursion without stack consumption. Calls f with supplied args, if\n  any. If f returns a fn, calls that fn with no arguments, and\n  continues to repeat, until the return value is not a fn, then\n  returns that non-fn value. Note that if you want to return a fn as a\n  final value, you must wrap it in some data structure and unpack it\n  after trampoline returns.") (_la$32604 (jolt-list-pos 570 4 (jolt-vector (jolt-symbol #f "f")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "&") (jolt-symbol #f "args"))))) (if (#3%procedure? _lp$32600) (_lp$32600 _la$32601 _la$32602 _la$32603 _la$32604 jolt-nil) (jolt-invoke _lp$32600 _la$32601 _la$32602 _la$32603 _la$32604 jolt-nil))))
