  (let ((_lp$30419 jv$clojure.core/attach-core-doc-meta!) (_la$30420 "clojure.core") (_la$30421 "delay?") (_la$30422 "returns true if x is a Delay created with delay") (_la$30423 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$30419) (_lp$30419 _la$30420 _la$30421 _la$30422 _la$30423 jolt-nil) (jolt-invoke _lp$30419 _la$30420 _la$30421 _la$30422 _la$30423 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30424 jv$clojure.core/attach-core-doc-meta!) (_la$30425 "clojure.core") (_la$30426 "deliver") (_la$30427 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$30428 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$30424) (_lp$30424 _la$30425 _la$30426 _la$30427 _la$30428 jolt-nil) (jolt-invoke _lp$30424 _la$30425 _la$30426 _la$30427 _la$30428 jolt-nil))))
