  (let ((_lp$29038 jv$clojure.core/attach-core-doc-meta!) (_la$29039 "clojure.core") (_la$29040 "conj") (_la$29041 "conj[oin]. Returns a new collection with the xs\n    'added'. (conj nil item) returns (item).\n    (conj coll) returns coll. (conj) returns [].\n    The 'addition' may happen at different 'places' depending\n    on the concrete type.") (_la$29042 (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x") (jolt-symbol #f "&") (jolt-symbol #f "xs"))))) (if (#3%procedure? _lp$29038) (_lp$29038 _la$29039 _la$29040 _la$29041 _la$29042 jolt-nil) (jolt-invoke _lp$29038 _la$29039 _la$29040 _la$29041 _la$29042 jolt-nil))))
