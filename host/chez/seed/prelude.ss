  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "empty?" "Returns true if coll has no items. To check the emptiness of a seq,\n  please use the idiom (seq x) rather than (not (empty? x))" (jolt-list (jolt-vector (jolt-symbol #f "coll")))))
