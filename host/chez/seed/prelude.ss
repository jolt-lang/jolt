  (let ((_lp$29701 jv$clojure.core/attach-core-doc-meta!) (_la$29702 "clojure.core") (_la$29703 "delay?") (_la$29704 "returns true if x is a Delay created with delay") (_la$29705 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$29701) (_lp$29701 _la$29702 _la$29703 _la$29704 _la$29705 jolt-nil) (jolt-invoke _lp$29701 _la$29702 _la$29703 _la$29704 _la$29705 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$29706 jv$clojure.core/attach-core-doc-meta!) (_la$29707 "clojure.core") (_la$29708 "deliver") (_la$29709 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$29710 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$29706) (_lp$29706 _la$29707 _la$29708 _la$29709 _la$29710 jolt-nil) (jolt-invoke _lp$29706 _la$29707 _la$29708 _la$29709 _la$29710 jolt-nil))))
