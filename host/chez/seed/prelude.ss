  (let ((_lp$30577 jv$clojure.core/attach-core-doc-meta!) (_la$30578 "clojure.core") (_la$30579 "defmacro") (_la$30580 "Like defn, but the resulting function name is declared as a\n  macro and will be used as a macro by the compiler when it is\n  called.") (_la$30581 (jolt-list-pos 762 4 (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "body")) (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-list-pos 762 77 (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "body")) (jolt-symbol #f "+") (jolt-symbol #f "attr-map?"))))) (if (#3%procedure? _lp$30577) (_lp$30577 _la$30578 _la$30579 _la$30580 _la$30581 jolt-nil) (jolt-invoke _lp$30577 _la$30578 _la$30579 _la$30580 _la$30581 jolt-nil))))
