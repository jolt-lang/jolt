  (let ((_lp$30417 jv$clojure.core/attach-core-doc-meta!) (_la$30418 "clojure.core") (_la$30419 "delay?") (_la$30420 "returns true if x is a Delay created with delay") (_la$30421 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$30417) (_lp$30417 _la$30418 _la$30419 _la$30420 _la$30421 jolt-nil) (jolt-invoke _lp$30417 _la$30418 _la$30419 _la$30420 _la$30421 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30422 jv$clojure.core/attach-core-doc-meta!) (_la$30423 "clojure.core") (_la$30424 "deliver") (_la$30425 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$30426 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$30422) (_lp$30422 _la$30423 _la$30424 _la$30425 _la$30426 jolt-nil) (jolt-invoke _lp$30422 _la$30423 _la$30424 _la$30425 _la$30426 jolt-nil))))
