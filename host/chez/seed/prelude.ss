  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "pcalls" "Executes the no-arg fns in parallel, returning a lazy sequence of\n  their values" (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "fns")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "peek" "For a list or queue, same as first, for a vector, same as, but much\n  more efficient than, last. If the collection is empty, returns nil." (jolt-list (jolt-vector (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "persistent!" "Returns a new, persistent version of the transient collection, in\n  constant time. The transient collection cannot be used after this\n  call, any such use will throw an exception." (jolt-list (jolt-vector (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "pmap" "Like map, except f is applied in parallel. Semi-lazy in that the\n  parallel computation stays ahead of the consumption, but doesn't\n  realize the entire result unless required. Only useful for\n  computationally intensive functions where the time of f dominates\n  the coordination overhead." (jolt-list (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "coll") (jolt-symbol #f "&") (jolt-symbol #f "colls")))))
