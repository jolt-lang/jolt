(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "=" "Equality. Returns true if x equals y, false if not. Same as\n  Java x.equals(y) except it also works for nil, and compares\n  numbers and collections in a type-independent manner.  Clojure's immutable data\n  structures define equals() (and thus =) as a value, not an identity,\n  comparison." (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more"))) jolt-nil))
