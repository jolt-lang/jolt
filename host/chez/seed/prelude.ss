  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "ex-info" "Create an instance of ExceptionInfo, a RuntimeException subclass\n   that carries a map of additional data." (jolt-list (jolt-vector (jolt-symbol #f "msg") (jolt-symbol #f "map")) (jolt-vector (jolt-symbol #f "msg") (jolt-symbol #f "map") (jolt-symbol #f "cause"))) jolt-nil))
(guard (e (#t #f))
