(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "declare" "defs the supplied var names with no bindings, useful for making forward declarations." (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "names"))) jolt-nil))
