  (let ((_lp$28926 jv$clojure.core/attach-core-doc-meta!) (_la$28927 "clojure.core") (_la$28928 "conj") (_la$28929 "conj[oin]. Returns a new collection with the xs\n    'added'. (conj nil item) returns (item).\n    (conj coll) returns coll. (conj) returns [].\n    The 'addition' may happen at different 'places' depending\n    on the concrete type.") (_la$28930 (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x") (jolt-symbol #f "&") (jolt-symbol #f "xs"))))) (if (#3%procedure? _lp$28926) (_lp$28926 _la$28927 _la$28928 _la$28929 _la$28930 jolt-nil) (jolt-invoke _lp$28926 _la$28927 _la$28928 _la$28929 _la$28930 jolt-nil))))
