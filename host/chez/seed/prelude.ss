  (let ((_lp$25055 jv$clojure.core/attach-core-doc-meta!) (_la$25056 "clojure.core") (_la$25057 "commute") (_la$25058 "Must be called in a transaction. Sets the in-transaction-value of\n  ref to:\n\n  (apply fun in-transaction-value-of-ref args)\n\n  and returns the in-transaction-value of ref.\n\n  At the commit point of the transaction, sets the value of ref to be:\n\n  (apply fun most-recently-committed-value-of-ref args)\n\n  Thus fun should be commutative, or, failing that, you must accept\n  last-one-in-wins behavior.  commute allows for more concurrency than\n  ref-set.") (_la$25059 (jolt-list (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "fun") (jolt-symbol #f "&") (jolt-symbol #f "args"))))) (if (#3%procedure? _lp$25055) (_lp$25055 _la$25056 _la$25057 _la$25058 _la$25059 jolt-nil) (jolt-invoke _lp$25055 _la$25056 _la$25057 _la$25058 _la$25059 jolt-nil))))
