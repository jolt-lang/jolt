  (let ((_lp$29771 jv$clojure.core/attach-core-doc-meta!) (_la$29772 "clojure.core") (_la$29773 "commute") (_la$29774 "Must be called in a transaction. Sets the in-transaction-value of\n  ref to:\n\n  (apply fun in-transaction-value-of-ref args)\n\n  and returns the in-transaction-value of ref.\n\n  At the commit point of the transaction, sets the value of ref to be:\n\n  (apply fun most-recently-committed-value-of-ref args)\n\n  Thus fun should be commutative, or, failing that, you must accept\n  last-one-in-wins behavior.  commute allows for more concurrency than\n  ref-set.") (_la$29775 (jolt-list (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "fun") (jolt-symbol #f "&") (jolt-symbol #f "args"))))) (if (#3%procedure? _lp$29771) (_lp$29771 _la$29772 _la$29773 _la$29774 _la$29775 jolt-nil) (jolt-invoke _lp$29771 _la$29772 _la$29773 _la$29774 _la$29775 jolt-nil))))
