  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "requiring-resolve" "Resolves namespace-qualified sym per 'resolve'. If initial resolve\nfails, attempts to require sym's namespace and retries." (jolt-list (jolt-vector (jolt-symbol #f "sym"))) jolt-nil))
