  (let ((_lp$28916 jv$clojure.core/attach-core-doc-meta!) (_la$28917 "clojure.core") (_la$28918 "conj") (_la$28919 "conj[oin]. Returns a new collection with the xs\n    'added'. (conj nil item) returns (item).\n    (conj coll) returns coll. (conj) returns [].\n    The 'addition' may happen at different 'places' depending\n    on the concrete type.") (_la$28920 (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x") (jolt-symbol #f "&") (jolt-symbol #f "xs"))))) (if (#3%procedure? _lp$28916) (_lp$28916 _la$28917 _la$28918 _la$28919 _la$28920 jolt-nil) (jolt-invoke _lp$28916 _la$28917 _la$28918 _la$28919 _la$28920 jolt-nil))))
