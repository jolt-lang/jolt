  (let ((_lp$29696 jv$clojure.core/attach-core-doc-meta!) (_la$29697 "clojure.core") (_la$29698 "denominator") (_la$29699 "Returns the denominator part of a Ratio.") (_la$29700 (jolt-list-pos 814 4 (jolt-vector (jolt-symbol #f "r")))) (_la$29701 (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "java.math.BigInteger"))) (if (#3%procedure? _lp$29696) (_lp$29696 _la$29697 _la$29698 _la$29699 _la$29700 _la$29701) (jolt-invoke _lp$29696 _la$29697 _la$29698 _la$29699 _la$29700 _la$29701))))
(guard (e (#t #f))
  (let ((_lp$29702 jv$clojure.core/attach-core-doc-meta!) (_la$29703 "clojure.core") (_la$29704 "deref") (_la$29705 "Also reader macro: @ref/@agent/@var/@atom/@delay/@future/@promise. Within a transaction,\n  returns the in-transaction-value of ref, else returns the\n  most-recently-committed value of ref. When applied to a var, agent\n  or atom, returns its current state. When applied to a delay, forces\n  it if not already forced. When applied to a future, will block if\n  computation not complete. When applied to a promise, will block\n  until a value is delivered.  The variant taking a timeout can be\n  used for blocking references (futures and promises), and will return\n  timeout-val if the timeout (in milliseconds) is reached before a\n  value is available. See also - realized?.") (_la$29706 (jolt-list-pos 818 4 (jolt-vector (jolt-symbol #f "ref")) (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "timeout-ms") (jolt-symbol #f "timeout-val"))))) (if (#3%procedure? _lp$29702) (_lp$29702 _la$29703 _la$29704 _la$29705 _la$29706 jolt-nil) (jolt-invoke _lp$29702 _la$29703 _la$29704 _la$29705 _la$29706 jolt-nil))))
