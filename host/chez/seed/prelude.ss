(guard (e (#t #f))
  (let ((_lp$32316 jv$clojure.core/attach-core-doc-meta!) (_la$32317 "clojure.core") (_la$32318 "set-error-mode!") (_la$32319 "Sets the error-mode of agent a to mode-keyword, which must be\n  either :fail or :continue.  If an action being run by the agent\n  throws an exception or doesn't pass the validator fn, an\n  error-handler may be called (see set-error-handler!), after which,\n  if the mode is :continue, the agent will continue as if neither the\n  action that caused the error nor the error itself ever happened.\n  \n  If the mode is :fail, the agent will become failed and will stop\n  accepting new 'send' and 'send-off' actions, and any previously\n  queued actions will be held until a 'restart-agent'.  Deref will\n  still work, returning the state of the agent before the error.") (_la$32320 (jolt-list-pos 338 4 (jolt-vector (jolt-symbol #f "a") (jolt-symbol #f "mode-keyword"))))) (if (#3%procedure? _lp$32316) (_lp$32316 _la$32317 _la$32318 _la$32319 _la$32320 jolt-nil) (jolt-invoke _lp$32316 _la$32317 _la$32318 _la$32319 _la$32320 jolt-nil))))
