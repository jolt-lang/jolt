  (let ((_lp$25274 jv$clojure.core/attach-core-doc-meta!) (_la$25275 "clojure.core") (_la$25276 "deliver") (_la$25277 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$25278 (jolt-list (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$25274) (_lp$25274 _la$25275 _la$25276 _la$25277 _la$25278 jolt-nil) (jolt-invoke _lp$25274 _la$25275 _la$25276 _la$25277 _la$25278 jolt-nil))))
