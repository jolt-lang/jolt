  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "==" "Returns non-nil if nums all have the equivalent\n  value (type-independent), otherwise false" (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more"))) jolt-nil))
