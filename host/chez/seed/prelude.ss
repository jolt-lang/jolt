  (jv$clojure.core/attach-core-doc-meta! "clojure.pprint" "formatter" "Makes a function which can directly run format-in. The function is\nfn [stream & args] ... and returns nil unless the stream is nil (meaning \noutput to a string) in which case it returns the resulting string.\n\nformat-in can be either a control string or a previously compiled format." (jolt-list (jolt-vector (jolt-symbol #f "format-in"))) jolt-nil))
