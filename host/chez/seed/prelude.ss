  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "rsubseq" "sc must be a sorted collection, test(s) one of <, <=, > or\n  >=. Returns a reverse seq of those entries with keys ek for\n  which (test (.. sc comparator (compare ek key)) 0) is true" (jolt-list (jolt-vector (jolt-symbol #f "sc") (jolt-symbol #f "test") (jolt-symbol #f "key")) (jolt-vector (jolt-symbol #f "sc") (jolt-symbol #f "start-test") (jolt-symbol #f "start-key") (jolt-symbol #f "end-test") (jolt-symbol #f "end-key"))) jolt-nil))
