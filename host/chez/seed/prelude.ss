  (let ((_lp$30410 jv$clojure.core/attach-core-doc-meta!) (_la$30411 "clojure.core") (_la$30412 "delay?") (_la$30413 "returns true if x is a Delay created with delay") (_la$30414 (jolt-list-pos 806 4 (jolt-vector (jolt-symbol #f "x"))))) (if (#3%procedure? _lp$30410) (_lp$30410 _la$30411 _la$30412 _la$30413 _la$30414 jolt-nil) (jolt-invoke _lp$30410 _la$30411 _la$30412 _la$30413 _la$30414 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30415 jv$clojure.core/attach-core-doc-meta!) (_la$30416 "clojure.core") (_la$30417 "deliver") (_la$30418 "Delivers the supplied value to the promise, releasing any pending\n  derefs. A subsequent call to deliver on a promise will have no effect.") (_la$30419 (jolt-list-pos 810 4 (jolt-vector (jolt-symbol #f "promise") (jolt-symbol #f "val"))))) (if (#3%procedure? _lp$30415) (_lp$30415 _la$30416 _la$30417 _la$30418 _la$30419 jolt-nil) (jolt-invoke _lp$30415 _la$30416 _la$30417 _la$30418 _la$30419 jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$30420 jv$clojure.core/attach-core-doc-meta!) (_la$30421 "clojure.core") (_la$30422 "denominator") (_la$30423 "Returns the denominator part of a Ratio.") (_la$30424 (jolt-list-pos 814 4 (jolt-vector (jolt-symbol #f "r")))) (_la$30425 (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "java.math.BigInteger"))) (if (#3%procedure? _lp$30420) (_lp$30420 _la$30421 _la$30422 _la$30423 _la$30424 _la$30425) (jolt-invoke _lp$30420 _la$30421 _la$30422 _la$30423 _la$30424 _la$30425))))
(guard (e (#t #f))
  (let ((_lp$30426 jv$clojure.core/attach-core-doc-meta!) (_la$30427 "clojure.core") (_la$30428 "deref") (_la$30429 "Also reader macro: @ref/@agent/@var/@atom/@delay/@future/@promise. Within a transaction,\n  returns the in-transaction-value of ref, else returns the\n  most-recently-committed value of ref. When applied to a var, agent\n  or atom, returns its current state. When applied to a delay, forces\n  it if not already forced. When applied to a future, will block if\n  computation not complete. When applied to a promise, will block\n  until a value is delivered.  The variant taking a timeout can be\n  used for blocking references (futures and promises), and will return\n  timeout-val if the timeout (in milliseconds) is reached before a\n  value is available. See also - realized?.") (_la$30430 (jolt-list-pos 818 4 (jolt-vector (jolt-symbol #f "ref")) (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "timeout-ms") (jolt-symbol #f "timeout-val"))))) (if (#3%procedure? _lp$30426) (_lp$30426 _la$30427 _la$30428 _la$30429 _la$30430 jolt-nil) (jolt-invoke _lp$30426 _la$30427 _la$30428 _la$30429 _la$30430 jolt-nil))))
