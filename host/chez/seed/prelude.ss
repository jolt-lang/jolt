  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "even?" "Returns true if n is even, throws an exception if n is not an integer" (jolt-list (jolt-vector (jolt-symbol #f "n")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "every-pred" "Takes a set of predicates and returns a function f that returns true if all of its\n  composing predicates return a logical true value against all of its arguments, else it returns\n  false. Note that f is short-circuiting in that it will stop execution on the first\n  argument that triggers a logical false result against the original predicates." (jolt-list (jolt-vector (jolt-symbol #f "p")) (jolt-vector (jolt-symbol #f "p1") (jolt-symbol #f "p2")) (jolt-vector (jolt-symbol #f "p1") (jolt-symbol #f "p2") (jolt-symbol #f "p3")) (jolt-vector (jolt-symbol #f "p1") (jolt-symbol #f "p2") (jolt-symbol #f "p3") (jolt-symbol #f "&") (jolt-symbol #f "ps")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "every?" "Returns true if (pred x) is logical true for every x in coll, else\n  false." (jolt-list (jolt-vector (jolt-symbol #f "pred") (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "ex-cause" "Returns the cause of ex if ex is a Throwable.\n  Otherwise returns nil." (jolt-list (jolt-vector (jolt-symbol #f "ex")))))
(guard (e (#t #f))
