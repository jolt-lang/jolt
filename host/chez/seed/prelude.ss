  (let ((_lp$29538 jv$clojure.core/attach-core-doc-meta!) (_la$29539 "clojure.core") (_la$29540 "*default-data-reader-fn*") (_la$29541 "When no data reader is found for a tag and *default-data-reader-fn*\n  is non-nil, it will be called with two arguments,\n  the tag and the value.  If *default-data-reader-fn* is nil (the\n  default), an exception will be thrown for the unknown tag.")) (if (#3%procedure? _lp$29538) (_lp$29538 _la$29539 _la$29540 _la$29541 jolt-nil jolt-nil) (jolt-invoke _lp$29538 _la$29539 _la$29540 _la$29541 jolt-nil jolt-nil))))
