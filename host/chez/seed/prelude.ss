  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "areduce" "Reduces an expression across an array a, using an index named idx,\n  and return value named ret, initialized to init, setting ret to the \n  evaluation of expr at each step, returning ret." (jolt-list (jolt-vector (jolt-symbol #f "a") (jolt-symbol #f "idx") (jolt-symbol #f "ret") (jolt-symbol #f "init") (jolt-symbol #f "expr")))))
