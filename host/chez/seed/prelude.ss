  (let ((_lp$28133 jv$clojure.core/attach-core-doc-meta!) (_la$28134 "clojure.core") (_la$28135 "*default-data-reader-fn*") (_la$28136 "When no data reader is found for a tag and *default-data-reader-fn*\n  is non-nil, it will be called with two arguments,\n  the tag and the value.  If *default-data-reader-fn* is nil (the\n  default), an exception will be thrown for the unknown tag.")) (if (#3%procedure? _lp$28133) (_lp$28133 _la$28134 _la$28135 _la$28136 jolt-nil jolt-nil) (jolt-invoke _lp$28133 _la$28134 _la$28135 _la$28136 jolt-nil jolt-nil))))
