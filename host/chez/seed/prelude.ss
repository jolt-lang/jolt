(guard (e (#t #f))
  (let ((_lp$28861 jv$clojure.core/attach-core-doc-meta!) (_la$28862 "clojure.core") (_la$28863 "*print-length*") (_la$28864 "*print-length* controls how many items of each collection the\n  printer will print. If it is bound to logical false, there is no\n  limit. Otherwise, it must be bound to an integer indicating the maximum\n  number of items of each collection to print. If a collection contains\n  more items, the printer will print items up to the limit followed by\n  '...' to represent the remaining items. The root binding is nil\n  indicating no limit.")) (if (#3%procedure? _lp$28861) (_lp$28861 _la$28862 _la$28863 _la$28864 jolt-nil jolt-nil) (jolt-invoke _lp$28861 _la$28862 _la$28863 _la$28864 jolt-nil jolt-nil))))
(guard (e (#t #f))
  (let ((_lp$28865 jv$clojure.core/attach-core-doc-meta!) (_la$28866 "clojure.core") (_la$28867 "*print-level*") (_la$28868 "*print-level* controls how many levels deep the printer will\n  print nested objects. If it is bound to logical false, there is no\n  limit. Otherwise, it must be bound to an integer indicating the maximum\n  level to print. Each argument to print is at level 0; if an argument is a\n  collection, its items are at level 1; and so on. If an object is a\n  collection and is at a level greater than or equal to the value bound to\n  *print-level*, the printer prints '#' to represent it. The root binding\n  is nil indicating no limit.")) (if (#3%procedure? _lp$28865) (_lp$28865 _la$28866 _la$28867 _la$28868 jolt-nil jolt-nil) (jolt-invoke _lp$28865 _la$28866 _la$28867 _la$28868 jolt-nil jolt-nil))))
