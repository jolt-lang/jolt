  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "serialized-require" "Like 'require', but serializes loading.\n  Interim function preferred over 'require' for known asynchronous loads.\n  Future changes may make these equivalent." (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "args"))) jolt-nil))
