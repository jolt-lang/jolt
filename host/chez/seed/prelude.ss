  (let ((_lp$28159 jv$clojure.core/attach-core-doc-meta!) (_la$28160 "clojure.core") (_la$28161 "*print-length*") (_la$28162 "*print-length* controls how many items of each collection the\n  printer will print. If it is bound to logical false, there is no\n  limit. Otherwise, it must be bound to an integer indicating the maximum\n  number of items of each collection to print. If a collection contains\n  more items, the printer will print items up to the limit followed by\n  '...' to represent the remaining items. The root binding is nil\n  indicating no limit.")) (if (#3%procedure? _lp$28159) (_lp$28159 _la$28160 _la$28161 _la$28162 jolt-nil jolt-nil) (jolt-invoke _lp$28159 _la$28160 _la$28161 _la$28162 jolt-nil jolt-nil))))
