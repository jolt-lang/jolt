+/* jolt: a signal relay for sun.misc.Signal. A program's handler has to run on
+   a thread of the program's own, whichever thread the kernel interrupted and
+   whatever that thread was doing: parked in a foreign call, waiting on a
+   condition, or running Scheme code. Chez's own Scheme signals reach the
+   main thread only, and only at its next safe point. Here the C handler does
+   the one async-signal-safe thing, writing the signal's number to a pipe, and
+   a thread that reads the pipe runs the handler. Nothing is blocked, so a
+   signal nobody asked for keeps whatever disposition it had. A handler that
+   was there before (the expeditor's SIGWINCH, a C library's) still runs. */
+#define JOLT_RELAY_NSIG 65
+static int jolt_relay_pipe[2] = {-1, -1};
+static struct sigaction jolt_relay_orig[JOLT_RELAY_NSIG];
+static char jolt_relay_saved[JOLT_RELAY_NSIG];
+static volatile sig_atomic_t jolt_relay_chain[JOLT_RELAY_NSIG];
+
+static void jolt_relay_handler(INT sig, siginfo_t *si, void *ctx) {
+  int saved_errno = errno;
+  if (sig > 0 && sig < JOLT_RELAY_NSIG) {
+    unsigned char b = (unsigned char)sig;
+    /* the write end is non-blocking: a full pipe drops the signal rather
+       than hang the thread the kernel picked */
+    if (write(jolt_relay_pipe[1], &b, 1) < 0) { /* dropped */ }
+    if (jolt_relay_chain[sig]) {
+      struct sigaction *o = &jolt_relay_orig[sig];
+      if (o->sa_flags & SA_SIGINFO) o->sa_sigaction(sig, si, ctx);
+      else o->sa_handler(sig);
+    }
+  }
+  errno = saved_errno;
+}
+
+/* The pipe's read end, opened on the first call; -1 if it can't be. */
+static INT s_jolt_signal_relay_fd(void) {
+  if (jolt_relay_pipe[0] < 0) {
+    int fds[2];
+    if (pipe(fds) != 0) return -1;
+    fcntl(fds[0], F_SETFD, FD_CLOEXEC);
+    fcntl(fds[1], F_SETFD, FD_CLOEXEC);
+    fcntl(fds[1], F_SETFL, fcntl(fds[1], F_GETFL) | O_NONBLOCK);
+    jolt_relay_pipe[1] = fds[1];
+    jolt_relay_pipe[0] = fds[0];
+  }
+  return jolt_relay_pipe[0];
+}
+
+/* MODE 1 relays SIG through the pipe, 2 ignores it, 0 gives it back the
+   disposition it had before the first call. 0 on success, -1 with errno set,
+   -2 for a signal number out of range or a relay with no pipe. Callers
+   serialize. */
+static INT s_jolt_signal_relay_set(INT sig, INT mode) {
+  struct sigaction act;
+  if (sig <= 0 || sig >= JOLT_RELAY_NSIG) return -2;
+  if (!jolt_relay_saved[sig]) {
+    if (sigaction(sig, (struct sigaction *)0, &jolt_relay_orig[sig]) != 0) return -1;
+    jolt_relay_saved[sig] = 1;
+  }
+  if (mode == 0) {
+    jolt_relay_chain[sig] = 0;
+    return SIGACTION(sig, &jolt_relay_orig[sig], (struct sigaction *)0) == 0 ? 0 : -1;
+  }
+  sigemptyset(&act.sa_mask);
+  if (mode == 2) {
+    act.sa_flags = 0;
+    act.sa_handler = SIG_IGN;
+    jolt_relay_chain[sig] = 0;
+  } else {
+    if (jolt_relay_pipe[1] < 0) return -2;
+    act.sa_flags = SA_SIGINFO;
+#ifdef SA_RESTART
+    act.sa_flags |= SA_RESTART;
+#endif
+    act.sa_sigaction = jolt_relay_handler;
+    jolt_relay_chain[sig] =
+      (jolt_relay_orig[sig].sa_flags & SA_SIGINFO)
+        ? jolt_relay_orig[sig].sa_sigaction != (void (*)(int, siginfo_t *, void *))0
+        : (jolt_relay_orig[sig].sa_handler != SIG_DFL && jolt_relay_orig[sig].sa_handler != SIG_IGN);
+  }
+  return SIGACTION(sig, &act, (struct sigaction *)0) == 0 ? 0 : -1;
+}
+
+/* Sscheme_deinit: every relayed or ignored signal gets back the disposition it
+   had before, so a host that loaded jolt as a library has its signals again
+   after jolt_library_shutdown. The pipe is abandoned, not closed. The reader
+   thread is parked in read(2) on it, and a close would wake it with EOF into
+   a Scheme that is gone; left open, nothing ever writes to it again, as the
+   shutdown watcher stays parked in sigwait. A later Sscheme_init opens a
+   new pipe, so a reinit's reader never shares the old one. A handler already
+   running on another thread sees -1 and its write fails harmlessly. */
+void S_jolt_signal_relay_deinit(void) {
+  INT sig;
+  for (sig = 1; sig < JOLT_RELAY_NSIG; sig += 1) {
+    if (jolt_relay_saved[sig]) {
+      jolt_relay_chain[sig] = 0;
+      SIGACTION(sig, &jolt_relay_orig[sig], (struct sigaction *)0);
+      jolt_relay_saved[sig] = 0;
+    }
+  }
+  jolt_relay_pipe[1] = -1;
+  jolt_relay_pipe[0] = -1;
+}
+
+void S_jolt_signal_relay_init(void) {
+  Sforeign_symbol("(cs)jolt_signal_relay_fd", (void *)s_jolt_signal_relay_fd);
+  Sforeign_symbol("(cs)jolt_signal_relay_set", (void *)s_jolt_signal_relay_set);
+}
+
 #endif /* WIN32 */
 
