diff --git a/s/syntax.ss b/s/syntax.ss
--- a/s/syntax.ss
+++ b/s/syntax.ss
@@ -582,6 +582,30 @@
     ; stored in the library/ct-info record for the file.
     `(cte-optimization-loc ,box ,exp ,exts)))
 
+;; jolt: a top-level definition whose identifier's symbol carries a
+;; cross-library optimization box on its property list ('*clo*, put there by
+;; the program before the definition is expanded) records its value's
+;; inlining information into that box, as a library export's definition does
+;; (build-library-body). The box goes on the definition's label too, where
+;; cp0's $top-level-value handler looks for it, so a reference compiled
+;; afterward is inlined as an imported library variable's is. Putting the box
+;; on the symbol is the program's promise that the variable is defined once and
+;; never assigned: the promise a library export carries by construction. Chez
+;; itself never puts the property on an interaction-environment symbol (its
+;; top-level labels are separate gensyms), so a definition without it is
+;; expanded exactly as before. The value goes into the cte-optimization-loc
+;; itself, not through a variable as a library's does, which is how cp0 tells
+;; the two apart (cp0.ss record-procedure!).
+(define build-top-level-definition
+  (lambda (ae id label rhs)
+    (let ([db (let ([sym (id-sym-name id)]) (and (symbol? sym) (get-clo-info sym)))])
+      (if (box? db)
+          (begin
+            (put-clo-info label db)
+            (build-global-assignment ae label
+              (build-cte-optimization-loc db rhs '())))
+          (build-global-assignment ae label rhs)))))
+
 (define build-primitive-reference
   (lambda (ae name)
     (if ($suppress-primitive-inlining)
@@ -2197,7 +2221,7 @@
                        (fluid-let ([require-invoke (library-collector #f)]
                                    [require-visit (library-collector #f)])
                          (residualize-invoke-requirements
-                           (build-global-assignment ae label
+                           (build-top-level-definition ae id label
                              (not-at-top (chi rhs r empty-wrap)))))))
                    rcode*))]
               [system-define (label rhs ae)
