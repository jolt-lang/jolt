diff --git a/c/schsig.c b/c/schsig.c
index e3442e6..ab9d19e 100644
--- a/c/schsig.c
+++ b/c/schsig.c
@@ -417,6 +417,25 @@ static void handle_call_error(ptr tc, iptr type, ptr x) {
     iptr argcnt;
 
     argcnt = (iptr)AC0(tc);
+    if (!S_errors_to_console &&
+        (type == ERROR_CALL_NONPROCEDURE ||
+         type == ERROR_CALL_NONPROCEDURE_SYMBOL ||
+         type == ERROR_CALL_ARGUMENT_COUNT)) {
+        ptr handler = SYMVAL(S_G.call_error_handler_id);
+        iptr stack_avail = (((uptr)ESP(tc) - (uptr)SFP(tc)) >> log2_ptr_bytes) - 1;
+        if (Sprocedurep(handler) && argcnt < stack_avail + asm_arg_reg_cnt) {
+            iptr i;
+            /* As in event-detour, prepend the callee without allocating a list.
+               Near the stack limit the Scheme fallback reconstructs the args. */
+            for (i = argcnt; i > 0; i--)
+                S_put_scheme_arg(tc, i+1, S_get_scheme_arg(tc, i));
+            S_put_scheme_arg(tc, 1,
+                type == ERROR_CALL_NONPROCEDURE_SYMBOL ? SYMVAL(x) : x);
+            CP(tc) = handler;
+            AC0(tc) = (ptr)(argcnt+1);
+            return;
+        }
+    }
     arg1 = argcnt == 0 ? Snil : S_get_scheme_arg(tc, 1);
     p = Scons(FIX(type), Scons(FIX(argcnt), Scons(x, Scons(arg1, Snil))));
 
@@ -435,7 +454,7 @@ static void handle_call_error(ptr tc, iptr type, ptr x) {
 void S_handle_docall_error() {
     ptr tc = get_thread_context();
 
-    AC0(tc) = (ptr)0;
+    /* The call-site check sets AC0 before this detour; retain its arguments. */
     handle_call_error(tc, ERROR_CALL_NONPROCEDURE, CP(tc));
 }
 
@@ -923,6 +942,9 @@ void S_schsig_init(void) {
         S_protect(&S_G.error_id);
         S_G.error_id = S_intern((const unsigned char *)"$c-error");
 
+        S_protect(&S_G.call_error_handler_id);
+        S_G.call_error_handler_id = S_intern((const unsigned char *)"$call-error-handler");
+
         S_protect(&S_G.event_and_resume_id);
         S_G.event_and_resume_id = S_intern((const unsigned char *)"$event-and-resume");
 
