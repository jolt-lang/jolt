diff --git a/s/prims.ss b/s/prims.ss
index 9dd0558..216e21f 100644
--- a/s/prims.ss
+++ b/s/prims.ss
@@ -611,6 +611,14 @@
       ($oops who "~s is not a procedure" p))
     (#3%$jolt-site-call (lambda () (p)))))
 
+(define-who $clj-call
+  (lambda (f . args)
+    (if (and (procedure? f) (logbit? (length args) (procedure-arity-mask f)))
+        (#2%apply f args)
+        (#2%apply ($top-level-value '$clj-call-handler) f args))))
+($set-top-level-value! '$clj-call-handler
+  (lambda (f . args) ($oops '$clj-call "~s is not a procedure" f)))
+
 (define-who $call-getting-continuation-attachment
   (lambda (default-val p)
     (unless (procedure? p)
