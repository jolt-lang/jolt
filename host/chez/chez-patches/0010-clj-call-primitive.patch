diff --git a/s/cpnanopass.ss b/s/cpnanopass.ss
index b3338c0..0edd378 100644
--- a/s/cpnanopass.ss
+++ b/s/cpnanopass.ss
@@ -1271,6 +1271,30 @@
                    (seq
                     ,(%primcall #f #f set-virtual-register! (quote 12) ,o)
                     ,(return mode r))))))))]
+        [(call ,info ,mdcl ,pr ,[e 'non/none -> e] ,[e* 'non/none -> e*] ...)
+         (guard (eq? (primref-name pr) '$clj-call))
+         ;; Jolt's call of a value that may not be a procedure (a call through a
+         ;; Clojure var): a procedure that accepts this many arguments is
+         ;; applied directly; anything else -- a keyword, map, multimethod, or a
+         ;; wrong arity -- goes to the handler Jolt registers as the top-level
+         ;; value of $clj-call-handler, with the value first. Open-coded here so
+         ;; the passes before this one see a single call.
+         (let* ([f (make-tmp 'f)] [t* (map (lambda (x) (make-tmp 't)) e*)]
+                [c (make-tmp 'c)]
+                [info (make-info-call (info-call-src info) (info-call-sexpr info) #f
+                        (info-call-pariah? info) (info-call-error? info)
+                        (eq? mode 'non/some) '())])
+           `(let ([,(cons f t*) ,(cons e e*)] ...)
+              (if (if ,(%primcall #f #f procedure? ,f)
+                      (let ([,c ,(%primcall #f #f $closure-code ,f)])
+                        ,(%primcall #f #f fxlogbit? (quote ,(length e*))
+                           (if ,(%primcall #f #f $code-arity-in-closure? ,c)
+                               ,(%primcall #f #f $closure-ref ,f (quote 1))
+                               ,(%primcall #f #f $code-arity-mask ,c))))
+                      (quote #f))
+                  (call ,info #f ,f ,t* ...)
+                  (call ,info #f ,(%primcall #f #f $top-level-value (quote $clj-call-handler))
+                        ,f ,t* ...))))]
         [(call ,info ,mdcl ,pr ,[e1 'non/none -> e1]
                (case-lambda ,info2 (clause (,x) ,interface ,[body])))
          (guard (and (eq? (primref-name pr) '$call-getting-continuation-attachment)
