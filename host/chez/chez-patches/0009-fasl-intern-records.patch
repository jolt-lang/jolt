+/* A record whose type's uid has a $fasl-intern property is interned as it is
+   read, the way an rtd is by its uid: its first field must be a symbol, and
+   the record is replaced by the one on that symbol's $fasl-intern property,
+   or becomes that property when there is none yet. A runtime that interns its
+   own objects (a language's keywords) puts each one there, so a quoted
+   constant in compiled code loads as the object the runtime already has. */
+static void fasl_intern_record(ptr *x) {
+  ptr rec = *x, uid, key, ls;
+
+  uid = RECORDDESCUID(RECORDINSTTYPE(rec));
+  if (!Ssymbolp(uid)) return;
+  for (ls = SYMSPLIST(uid); ls != Snil; ls = Scdr(Scdr(ls)))
+    if (Scar(ls) == S_G.fasl_intern_key) break;
+  if (ls == Snil) return;
+
+  key = RECORDINSTIT(rec, 0);
+  if (!Ssymbolp(key)) return;
+  tc_mutex_acquire();
+  for (ls = SYMSPLIST(key); ls != Snil; ls = Scdr(Scdr(ls)))
+    if (Scar(ls) == S_G.fasl_intern_key) {
+      *x = Scar(Scdr(ls));
+      break;
+    }
+  if (ls == Snil)
+    SETSYMSPLIST(key, Scons(S_G.fasl_intern_key, Scons(rec, SYMSPLIST(key))));
+  tc_mutex_release();
+}
