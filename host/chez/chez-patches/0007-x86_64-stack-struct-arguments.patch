-                          `(set! ,(%mref ,%sp ,offset) (inline ,(make-info-load 'integer-8 #f)
-                                                               ,%load ,x ,%zero (immediate ,x-offset)))]))))]
+                          ;; a piece smaller than a word is stored at its own width:
