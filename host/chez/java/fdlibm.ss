;; fdlibm, the libm java.lang.StrictMath is specified to be, ported over the
;; words of a double as the JDK 21's java.lang.FdLibm ports it to Java. Every
;; java.lang.Math transcendental JDK 21 does not intrinsify delegates to
;; StrictMath, so these are the JVM's digits on every platform; the host libm
;; is a different function, a last digit apart on a few inputs in a thousand.
;; Math.sin/cos/tan/exp/log/log10/pow may be HotSpot intrinsics whose digits
;; vary by CPU; jolt answers StrictMath's for them, which is what JDK 21 gives
;; on aarch64 for all but sin and cos (known-divergences.edn).
;;
;; Portable: fl/fx arithmetic and the adapter's word accessors, so Gambit
;; includes this file as Chez loads it. The algorithms and constants are
;; fdlibm 5.3's (licenses/fdlibm.txt). Java's int arithmetic is kept as
;; fixnums: fdl-hi is the high word signed, as fdlibm's __HI, and fdl-ix its
;; magnitude bits.

(define-syntax fdl-hi
  (syntax-rules ()
    ((_ e) (let ((h (sa-flonum-hi32 e)))
             (if (fx< h #x80000000) h (fx- h #x100000000))))))
(define-syntax fdl-ix
  (syntax-rules () ((_ e) (fxand (sa-flonum-hi32 e) #x7fffffff))))
(define-syntax fdl-lo (syntax-rules () ((_ e) (sa-flonum-lo32 e))))
(define-syntax fdl-int (syntax-rules () ((_ e) (flonum->fixnum e))))   ; (int) of a small double
;; __HI(x, h): x with its high word replaced and its low word kept
(define (fdl-set-hi x h) (sa-words->flonum (fxand h #xffffffff) (sa-flonum-lo32 x)))
;; __HI_LO(h, 0), and so __HI(0.0, h)
(define-syntax fdl-hi->fl (syntax-rules () ((_ h) (sa-hi32->flonum (fxand h #xffffffff)))))
;; c0 + z*(c1 + z*(... cn)), as fdlibm writes its polynomials
(define-syntax fdl-poly
  (syntax-rules ()
    ((_ z c) c)
    ((_ z c0 c1 ...) (fl+ c0 (fl* z (fdl-poly z c1 ...))))))
;; 2^k for k in [-1074, 1023], exactly; scaling by one is fdlibm's exponent-field
;; arithmetic whenever the result is a normal double
(define fdl-pow2-vec
  (let ((v (make-vector 2098 0.0)))
    (do ((k 0 (fx+ k 1))) ((fx= k 2098) v)
      (vector-set! v k (exact->inexact (expt 2 (fx- k 1074)))))))
(define-syntax fdl-pow2 (syntax-rules () ((_ k) (vector-ref fdl-pow2-vec (fx+ k 1074)))))
;; __LO(x, 0), x truncated to the bits of its high word. For a normal x of
;; exponent e, adding 2^(e+32) of x's sign leaves the sum's last bit worth
;; 2^(e-20), so x+M-M is x rounded to that grain, and one grain back toward
;; zero when the rounding went up: flonum arithmetic, no bit cast.
(define-syntax fdl-clear-lo
  (syntax-rules ()
    ((_ e) (let* ((x e) (ex (fxand (fxsrl (sa-flonum-hi32 x) 20) #x7ff)))
             (if (or (fx= ex 0) (fx> ex 2014))
                 (sa-hi32->flonum (sa-flonum-hi32 x))
                 (let* ((m (fdl-pow2 (fx- ex 991)))
                        (m (if (fl< x 0.0) (fl- m) m))
                        (r (fl- (fl+ x m) m)))
                   (if (fl> (flabs r) (flabs x))
                       (fl- r (fl* (fdl-pow2 (fx- ex 1043)) (if (fl< x 0.0) -1.0 1.0)))
                       r)))))))
;; Math.scalb: rounded once, as the JDK's stepwise scaling is
(define (fdl-scalb x n)
  (if (or (fl= x 0.0) (not (fl= x x)) (fl= (flabs x) +inf.0))
      x
      (exact->inexact (* (exact x) (expt 2 n)))))

;; ---- sin, cos, tan ----------------------------------------------------------
(define-syntax fdl-ksin
  (syntax-rules ()
    ((_ xe ye iy) (let ((x xe) (y ye)) (fdl-ksin-body x y iy)))))
(define-syntax fdl-ksin-body
  (syntax-rules ()
    ((_ x y iy)
  (if (fx< (fdl-ix x) #x3e400000)
      x
      (let* ((z (fl* x x)) (v (fl* z x))
             (r (fdl-poly z 0.00833333333332249 -0.0001984126982985795 2.7557313707070068e-06 -2.5050760253406863e-08 1.58969099521155e-10)))
        (if (fx= iy 0)
            (fl+ x (fl* v (fl+ -0.16666666666666632 (fl* z r))))
            (fl- x (fl- (fl- (fl* z (fl- (fl* 0.5 y) (fl* v r))) y)
                        (fl* v -0.16666666666666632)))))))))
(define-syntax fdl-kcos
  (syntax-rules ()
    ((_ xe ye) (let ((x xe) (y ye)) (fdl-kcos-body x y)))))
(define-syntax fdl-kcos-body
  (syntax-rules ()
    ((_ x y)
  (let ((ix (fdl-ix x)))
    (if (fx< ix #x3e400000)
        1.0
        (let* ((z (fl* x x))
               (r (fl* z (fdl-poly z 0.0416666666666666 -0.001388888888887411 2.480158728947673e-05 -2.7557314351390663e-07 2.087572321298175e-09 -1.1359647557788195e-11))))
          (if (fx< ix #x3fd33333)
              (fl- 1.0 (fl- (fl* 0.5 z) (fl- (fl* z r) (fl* x y))))
              (let* ((qx (if (fx> ix #x3fe90000) 0.28125 (fdl-hi->fl (fx- ix #x00200000))))
                     (hz (fl- (fl* 0.5 z) qx))
                     (a (fl- 1.0 qx)))
                (fl- a (fl- hz (fl- (fl* z r) (fl* x y))))))))))))
(define (fdl-ktan-poly x y)                         ; (values r w) for |x| < pi/4ish
  (let* ((z (fl* x x)) (w (fl* z z))
         (r (fdl-poly w 0.13333333333320124 0.021869488294859542 0.0035920791075913124 0.0005880412408202641 7.817944429395571e-05 -1.8558637485527546e-05))
         (v (fl* z (fdl-poly w 0.05396825397622605 0.0088632398235993 0.0014562094543252903 0.0002464631348184699 7.140724913826082e-05 2.590730518636337e-05)))
         (s (fl* z x))
         (r (fl+ (fl+ y (fl* z (fl+ (fl* s (fl+ r v)) y))) (fl* 0.3333333333333341 s))))
    (values r (fl+ x r))))
;; -1/(x+r) to full precision, for tan's odd quadrants
(define (fdl-ktan-inv x r w)
  (let* ((z (fdl-clear-lo w))
         (v (fl- r (fl- z x)))
         (a (fl/ -1.0 w))
         (t (fdl-clear-lo a))
         (s (fl+ 1.0 (fl* t z))))
    (fl+ t (fl* a (fl+ s (fl* t v))))))
(define (fdl-ktan x y iy)
  (let* ((hx (fdl-hi x)) (ix (fxand hx #x7fffffff)))
    (cond
      ((fx< ix #x3e300000)
       (cond ((fx= 0 (fxior (fxior ix (fdl-lo x)) (fx+ iy 1))) (fl/ 1.0 (flabs x)))
             ((fx= iy 1) x)
             (else (fdl-ktan-inv x y (fl+ x y)))))
      ((fx>= ix #x3fe59428)
       (let* ((x (if (fx< hx 0) (fl- x) x)) (y (if (fx< hx 0) (fl- y) y))
              (x (fl+ (fl- 0.7853981633974483 x) (fl- 3.061616997868383e-17 y))))
         (let-values (((r w) (fdl-ktan-poly x 0.0)))
           (let ((v (fixnum->flonum iy)))
             (fl* (if (fx< hx 0) -1.0 1.0)
                  (fl- v (fl* 2.0 (fl- x (fl- (fl/ (fl* w w) (fl+ w v)) r)))))))))
      (else
       (let-values (((r w) (fdl-ktan-poly x y)))
         (if (fx= iy 1) w (fdl-ktan-inv x r w)))))))

(define fdl-two-over-pi
  '#(#xA2F983 #x6E4E44 #x1529FC #x2757D1 #xF534DD #xC0DB62 #x95993C #x439041 #xFE5163
     #xABDEBB #xC561B7 #x246E3A #x424DD2 #xE00649 #x2EEA09 #xD1921C #xFE1DEB #x1CB129
     #xA73EE8 #x8235F5 #x2EBB44 #x84E99C #x7026B4 #x5F7E41 #x3991D6 #x398353 #x39F49C
     #x845F8B #xBDF928 #x3B1FF8 #x97FFDE #x05980F #xEF2F11 #x8B5A0A #x6D1F6D #x367ECF
     #x27CB09 #xB74F46 #x3F669E #x5FEA2D #x7527BA #xC7EBE5 #xF17B3D #x0739F7 #x8A5292
     #xEA6BFB #x5FB11F #x8D5D08 #x560330 #x46FC7B #x6BABF0 #xCFBC20 #x9AF436 #x1DA9E3
     #x91615E #xE61B08 #x659985 #x5F14A0 #x68408D #xFFD880 #x4D7327 #x310606 #x1556CA
     #x73A8C9 #x60E27B #xC08C6B))
(define fdl-npio2-hw
  '#(#x3FF921FB #x400921FB #x4012D97C #x401921FB #x401F6A7A #x4022D97C #x4025FDBB
     #x402921FB #x402C463A #x402F6A7A #x4031475C #x4032D97C #x40346B9C #x4035FDBB
     #x40378FDB #x403921FB #x403AB41B #x403C463A #x403DD85A #x403F6A7A #x40407E4C
     #x4041475C #x4042106C #x4042D97C #x4043A28C #x40446B9C #x404534AC #x4045FDBB
     #x4046C6CB #x40478FDB #x404858EB #x404921FB))
(define fdl-pio2-parts
  '#(1.570796251296997 7.549789415861596e-08 5.390302529957765e-15 3.282003415807913e-22
     1.270655753080676e-29 1.2293330898111133e-36 2.7337005381646456e-44 2.1674168387780482e-51))

;; __kernel_rem_pio2 at prec 2 (jk 4): x's 24-bit chunks tx times 2/pi's bits,
;; as (values n y0 y1) with n mod 8
(define (fdl-kernel-rem-pio2 tx e0 nx)
  (let* ((jk 4) (jp 4) (jx (fx- nx 1))
         (jv (fxmax 0 (fxquotient (fx- e0 3) 24)))
         (q0 (fx- e0 (fx* 24 (fx+ jv 1))))
         (iq (make-vector 20 0)) (f (make-vector 20 0.0))
         (fq (make-vector 20 0.0)) (q (make-vector 20 0.0)))
    (define (ipio2 j) (fixnum->flonum (vector-ref fdl-two-over-pi j)))
    (define (q-at! i)                              ; q[i] = sum x[j]*f[jx+i-j]
      (let loop ((j 0) (fw 0.0))
        (if (fx> j jx)
            (vector-set! q i fw)
            (loop (fx+ j 1) (fl+ fw (fl* (vector-ref tx j) (vector-ref f (fx- (fx+ jx i) j))))))))
    (do ((i 0 (fx+ i 1)) (j (fx- jv jx) (fx+ j 1))) ((fx> i (fx+ jx jk)))
      (vector-set! f i (if (fx< j 0) 0.0 (ipio2 j))))
    (do ((i 0 (fx+ i 1))) ((fx> i jk)) (q-at! i))
    (let recompute ((jz jk))
      ;; distill q[] into iq[] reversingly
      (let ((z (let loop ((i 0) (j jz) (z (vector-ref q jz)))
                 (if (fx> j 0)
                     (let ((fw (fixnum->flonum (fdl-int (fl* 5.960464477539063e-08 z)))))
                       (vector-set! iq i (fdl-int (fl- z (fl* 16777216.0 fw))))
                       (loop (fx+ i 1) (fx- j 1) (fl+ (vector-ref q (fx- j 1)) fw)))
                     z))))
        (let* ((z (fdl-scalb z q0))
               (z (fl- z (fl* 8.0 (flfloor (fl* z 0.125)))))
               (n (fdl-int z))
               (z (fl- z (fixnum->flonum n)))
               (ih 0))
          (cond
            ((fx> q0 0)
             (let ((i (fxsra (vector-ref iq (fx- jz 1)) (fx- 24 q0))))
               (set! n (fx+ n i))
               (vector-set! iq (fx- jz 1) (fx- (vector-ref iq (fx- jz 1)) (fxsll i (fx- 24 q0))))
               (set! ih (fxsra (vector-ref iq (fx- jz 1)) (fx- 23 q0)))))
            ((fx= q0 0) (set! ih (fxsra (vector-ref iq (fx- jz 1)) 23)))
            ((fl>= z 0.5) (set! ih 2)))
          (when (fx> ih 0)
            (set! n (fx+ n 1))
            (let ((carry 0))
              (do ((i 0 (fx+ i 1))) ((fx= i jz))
                (let ((j (vector-ref iq i)))
                  (if (fx= carry 0)
                      (unless (fx= j 0)
                        (set! carry 1)
                        (vector-set! iq i (fx- #x1000000 j)))
                      (vector-set! iq i (fx- #xffffff j)))))
              (cond ((fx= q0 1) (vector-set! iq (fx- jz 1) (fxand (vector-ref iq (fx- jz 1)) #x7fffff)))
                    ((fx= q0 2) (vector-set! iq (fx- jz 1) (fxand (vector-ref iq (fx- jz 1)) #x3fffff))))
              (when (fx= ih 2)
                (set! z (fl- 1.0 z))
                (unless (fx= carry 0) (set! z (fl- z (fdl-scalb 1.0 q0)))))))
          (if (and (fl= z 0.0)
                   (let loop ((i (fx- jz 1)) (j 0))
                     (if (fx>= i jk) (loop (fx- i 1) (fxior j (vector-ref iq i))) (fx= j 0))))
              ;; need recomputation: k = how many more terms
              (let ((k (let loop ((k 1)) (if (fx= 0 (vector-ref iq (fx- jk k))) (loop (fx+ k 1)) k))))
                (do ((i (fx+ jz 1) (fx+ i 1))) ((fx> i (fx+ jz k)))
                  (vector-set! f (fx+ jx i) (ipio2 (fx+ jv i)))
                  (q-at! i))
                (recompute (fx+ jz k)))
              (fdl-rem-pio2-finish iq fq q z n ih jz q0 jp)))))))
(define (fdl-rem-pio2-finish iq fq q z n ih jz q0 jp)
  (let-values
      (((jz q0)
        (if (fl= z 0.0)
            (let loop ((jz (fx- jz 1)) (q0 (fx- q0 24)))
              (if (fx= 0 (vector-ref iq jz)) (loop (fx- jz 1) (fx- q0 24)) (values jz q0)))
            (let ((z (fdl-scalb z (fx- q0))))
              (if (fl>= z 16777216.0)
                  (let ((fw (fixnum->flonum (fdl-int (fl* 5.960464477539063e-08 z)))))
                    (vector-set! iq jz (fdl-int (fl- z (fl* 16777216.0 fw))))
                    (vector-set! iq (fx+ jz 1) (fdl-int fw))
                    (values (fx+ jz 1) (fx+ q0 24)))
                  (begin (vector-set! iq jz (fdl-int z)) (values jz q0)))))))
    (let loop ((i jz) (fw (fdl-scalb 1.0 q0)))
      (when (fx>= i 0)
        (vector-set! q i (fl* fw (fixnum->flonum (vector-ref iq i))))
        (loop (fx- i 1) (fl* fw 5.960464477539063e-08))))
    (do ((i jz (fx- i 1))) ((fx< i 0))
      (let loop ((k 0) (fw 0.0))
        (if (and (fx<= k jp) (fx<= k (fx- jz i)))
            (loop (fx+ k 1) (fl+ fw (fl* (vector-ref fdl-pio2-parts k) (vector-ref q (fx+ i k)))))
            (vector-set! fq (fx- jz i) fw))))
    (let* ((fw (let loop ((i jz) (fw 0.0)) (if (fx< i 0) fw (loop (fx- i 1) (fl+ fw (vector-ref fq i))))))
           (y0 (if (fx= ih 0) fw (fl- fw)))
           (fw (let loop ((i 1) (fw (fl- (vector-ref fq 0) fw)))
                 (if (fx> i jz) fw (loop (fx+ i 1) (fl+ fw (vector-ref fq i)))))))
      (values (fxand n 7) y0 (if (fx= ih 0) fw (fl- fw))))))

;; __ieee754_rem_pio2: x - n*pi/2 as (values n y0 y1), y0+y1 the remainder
(define (fdl-rem-pio2 x)
  (let* ((hx (fdl-hi x)) (ix (fxand hx #x7fffffff)))
    (cond
      ((fx<= ix #x3fe921fb) (values 0 x 0.0))
      ((fx< ix #x4002d97c)                          ; |x| < 3pi/4
       (let* ((s (if (fx> hx 0) 1.0 -1.0))
              (z (fl- x (fl* s 1.5707963267341256))))
         (if (not (fx= ix #x3ff921fb))
             (let ((y0 (fl- z (fl* s 6.077100506506192e-11))))
               (values (if (fx> hx 0) 1 -1) y0 (fl- (fl- z y0) (fl* s 6.077100506506192e-11))))
             (let* ((z (fl- z (fl* s 6.077100506303966e-11)))
                    (y0 (fl- z (fl* s 2.0222662487959506e-21))))
               (values (if (fx> hx 0) 1 -1) y0 (fl- (fl- z y0) (fl* s 2.0222662487959506e-21)))))))
      ((fx<= ix #x413921fb) (fdl-rem-pio2-medium x hx ix))
      ((fx>= ix #x7ff00000) (let ((n (fl- x x))) (values 0 n n)))
      (else
       (let* ((e0 (fx- (fxsra ix 20) 1046))
              (z (sa-words->flonum (fx- ix (fxsll e0 20)) (fdl-lo x)))
              (tx (make-vector 3 0.0)))
         (let loop ((i 0) (z z))
           (if (fx< i 2)
               (let ((t (fixnum->flonum (fdl-int z))))
                 (vector-set! tx i t)
                 (loop (fx+ i 1) (fl* (fl- z t) 16777216.0)))
               (vector-set! tx 2 z)))
         (let ((nx (let loop ((nx 3)) (if (fl= (vector-ref tx (fx- nx 1)) 0.0) (loop (fx- nx 1)) nx))))
           (let-values (((n y0 y1) (fdl-kernel-rem-pio2 tx e0 nx)))
             (if (fx< hx 0) (values (fx- n) (fl- y0) (fl- y1)) (values n y0 y1)))))))))
(define (fdl-rem-pio2-medium x hx ix)               ; |x| ~<= 2^19*(pi/2)
  (let* ((t (flabs x))
         (n (fdl-int (fl+ (fl* t 0.6366197723675814) 0.5)))
         (fn (fixnum->flonum n))
         (r (fl- t (fl* fn 1.5707963267341256)))
         (w (fl* fn 6.077100506506192e-11)))
    (let-values
        (((r w y0)
          (if (and (fx< n 32) (not (fx= ix (vector-ref fdl-npio2-hw (fx- n 1)))))
              (values r w (fl- r w))
              (let* ((j (fxsra ix 20)) (y0 (fl- r w)))
                (if (fx<= (fx- j (fxand (fxsra (fdl-hi y0) 20) #x7ff)) 16)
                    (values r w y0)
                    (let* ((t r) (w (fl* fn 6.077100506303966e-11)) (r (fl- t w))
                           (w (fl- (fl* fn 2.0222662487959506e-21) (fl- (fl- t r) w)))
                           (y0 (fl- r w)))
                      (if (fx<= (fx- j (fxand (fxsra (fdl-hi y0) 20) #x7ff)) 49)
                          (values r w y0)
                          (let* ((t r) (w (fl* fn 2.0222662487111665e-21)) (r (fl- t w))
                                 (w (fl- (fl* fn 8.4784276603689e-32) (fl- (fl- t r) w))))
                            (values r w (fl- r w))))))))))
      (let ((y1 (fl- (fl- r y0) w)))
        (if (fx< hx 0) (values (fx- n) (fl- y0) (fl- y1)) (values n y0 y1))))))

;; rem_pio2 for pi/4 < |x| < 3pi/4, n = +-1, inline: y0, y1 are |x|'s, and
;; x's own are their negations, which the odd ksin and even kcos absorb
(define-syntax fdl-pio2-small
  (syntax-rules ()
    ((_ x ix (y0 y1) body)
     (let ((z (fl- (flabs x) 1.5707963267341256)))
       (if (fx= ix #x3ff921fb)
           (let* ((z (fl- z 6.077100506303966e-11))
                  (y0 (fl- z 2.0222662487959506e-21))
                  (y1 (fl- (fl- z y0) 2.0222662487959506e-21)))
             body)
           (let* ((y0 (fl- z 6.077100506506192e-11))
                  (y1 (fl- (fl- z y0) 6.077100506506192e-11)))
             body))))))
(define (fdlibm-sin x)
  (let ((ix (fdl-ix x)))
    (cond ((fx<= ix #x3fe921fb) (fdl-ksin x 0.0 0))
          ((fx< ix #x4002d97c)
           (fdl-pio2-small x ix (y0 y1) (let ((c (fdl-kcos y0 y1))) (if (fl< x 0.0) (fl- c) c))))
          ((fx>= ix #x7ff00000) (fl- x x))
          (else
           (let-values (((n y0 y1) (fdl-rem-pio2 x)))
             (case (fxand n 3)
               ((0) (fdl-ksin y0 y1 1))
               ((1) (fdl-kcos y0 y1))
               ((2) (fl- (fdl-ksin y0 y1 1)))
               (else (fl- (fdl-kcos y0 y1)))))))))
(define (fdlibm-cos x)
  (let ((ix (fdl-ix x)))
    (cond ((fx<= ix #x3fe921fb) (fdl-kcos x 0.0))
          ((fx< ix #x4002d97c) (fdl-pio2-small x ix (y0 y1) (fl- (fdl-ksin y0 y1 1))))
          ((fx>= ix #x7ff00000) (fl- x x))
          (else
           (let-values (((n y0 y1) (fdl-rem-pio2 x)))
             (case (fxand n 3)
               ((0) (fdl-kcos y0 y1))
               ((1) (fl- (fdl-ksin y0 y1 1)))
               ((2) (fl- (fdl-kcos y0 y1)))
               (else (fdl-ksin y0 y1 1))))))))
(define (fdlibm-tan x)
  (let ((ix (fdl-ix x)))
    (cond ((fx<= ix #x3fe921fb) (fdl-ktan x 0.0 1))
          ((fx>= ix #x7ff00000) (fl- x x))
          (else
           (let-values (((n y0 y1) (fdl-rem-pio2 x)))
             (fdl-ktan y0 y1 (fx- 1 (fxsll (fxand n 1) 1))))))))

;; ---- asin, acos, atan, atan2 ------------------------------------------------
(define (fdl-asin-pq t)                             ; p/q of the rational approximation
  (fl/ (fl* t (fdl-poly t 0.16666666666666666 -0.3255658186224009 0.20121253213486293 -0.04005553450067941 0.0007915349942898145 3.479331075960212e-05))
       (fdl-poly t 1.0 -2.403394911734414 2.0209457602335057 -0.6882839716054533 0.07703815055590194)))
(define (fdlibm-asin x)
  (let* ((hx (fdl-hi x)) (ix (fxand hx #x7fffffff)))
    (cond
      ((fx>= ix #x3ff00000)
       (if (fx= 0 (fxior (fx- ix #x3ff00000) (fdl-lo x)))
           (fl+ (fl* x 1.5707963267948966) (fl* x 6.123233995736766e-17))
           (fl/ (fl- x x) (fl- x x))))
      ((fx< ix #x3fe00000)
       (if (fx< ix #x3e400000)
           x
           (fl+ x (fl* x (fdl-asin-pq (fl* x x))))))
      (else
       (let* ((w (fl- 1.0 (flabs x)))
              (t (fl* w 0.5))
              (s (flsqrt t))
