;; coll-defaults.ss — the methods java.util's abstract classes and interfaces give
;; every collection: AbstractCollection's containsAll / removeAll / retainAll,
;; AbstractList's indexOf / lastIndexOf / listIterator / subList, the Map and
;; Queue defaults, Iterator.forEachRemaining.
;;
;; A shim registers the methods its representation answers directly. The JDK
;; class it models inherits the rest from AbstractCollection, AbstractList,
;; AbstractMap or an interface default, and those are written once here over
;; the members every collection has — size, iterator, get, set, add(int, E),
;; remove(int), put, remove(Object), containsKey — reached by dispatch, so an
;; override in the shim, or in a proxy over it, is what they call. They are
;; found the way fi-defaults.ss's are: at the end of the dispatch chain
;; (dispatch-miss), through the receiver's class graph, so a method a shim
;; defines itself always wins and a hit on a shim's own table costs nothing.
;;
;; Loaded after fi-defaults.ss, whose lookup this one chains behind.

(define (cd-call self m . args)
  (record-method-dispatch self m (if (null? args) jolt-nil (list->cseq args))))
(define (cd-truthy? x) (jolt-truthy? x))
(define (cd-size self) (jnum->exact (cd-call self "size")))
(define (cd-elems c) (seq->list (jolt-seq c)))
;; Collection.contains on any argument collection, as the JDK calls it: through
;; the argument's own contains, so a TreeSet's comparator or a HashSet's hash
;; decides.
(define (cd-has? c x)
  (cond ((pset? c) (jolt-contains? c x))
        ((jhost? c) (cd-truthy? (cd-call c "contains" x)))
        (else (and (exists (lambda (e) (objects-equals? x e)) (cd-elems c)) #t))))
;; a walk through ITERATOR, removing what DROP? picks; #t when anything went
(define (cd-iter-remove! self drop?)
  (let ((it (cd-call self "iterator")))
    (let loop ((changed #f))
      (if (cd-truthy? (cd-call it "hasNext"))
          (let ((x (cd-call it "next")))
            (if (drop? x)
                (begin (cd-call it "remove") (loop #t))
                (loop changed)))
          changed))))
(define (cd-index-check! i n)
  (unless (and (fx>=? i 0) (fx<? i n))
    (throw-jvm 'IndexOutOfBoundsException
               (string-append "Index " (number->string i) " out of bounds for length " (number->string n)))))
(define (cd-range-check! from to n)
  (cond ((fx<? from 0) (throw-jvm 'IndexOutOfBoundsException (string-append "fromIndex = " (number->string from))))
        ((fx>? to n) (throw-jvm 'IndexOutOfBoundsException (string-append "toIndex = " (number->string to))))
        ((fx>? from to) (throw-jvm 'IllegalArgumentException
                                   (string-append "fromIndex(" (number->string from) ") > toIndex(" (number->string to) ")")))))
;; toArray(), toArray(T[]) and Collection.toArray(IntFunction)
(define (cd-to-array elems args)
  (if (and (pair? args) (not (jolt-array? (car args))) (not (jolt-nil? (car args))))
      (jcoll-to-array elems (list (jolt-fi-call (car args) "apply" (->num 0))))
      (jcoll-to-array elems args)))

;; ---- AbstractCollection -------------------------------------------------------------
(define cd-collection-defaults
  (list
    (list "isEmpty" 0 (lambda (self) (fx=? 0 (cd-size self))))
    ;; AbstractCollection.add: a collection that defines no add refuses one
    (list "add" 1 (lambda (self x) (throw-jvm 'UnsupportedOperationException jolt-nil)))
    (list "contains" 1 (lambda (self x) (and (exists (lambda (e) (objects-equals? x e)) (cd-elems self)) #t)))
    (list "containsAll" 1 (lambda (self c) (for-all (lambda (x) (cd-truthy? (cd-call self "contains" x))) (cd-elems c))))
    (list "addAll" 1 (lambda (self c)
                       (fold-left (lambda (ch x) (or (cd-truthy? (cd-call self "add" x)) ch)) #f (cd-elems c))))
    (list "removeAll" 1 (lambda (self c) (cd-iter-remove! self (lambda (x) (cd-has? c x)))))
    (list "retainAll" 1 (lambda (self c) (cd-iter-remove! self (lambda (x) (not (cd-has? c x))))))
    (list "removeIf" 1 (lambda (self p) (cd-iter-remove! self (lambda (x) (cd-truthy? (jolt-fi-call p "test" x))))))
    (list "clear" 0 (lambda (self) (cd-iter-remove! self (lambda (x) #t)) jolt-nil))
    (list "toArray" 0 (lambda (self) (cd-to-array (cd-elems self) '())))
    (list "toArray" 1 (lambda (self a) (cd-to-array (cd-elems self) (list a))))
    (list "forEach" 1 (lambda (self f) (for-each (lambda (x) (jolt-fi-call f "accept" x)) (cd-elems self)) jolt-nil))))

;; ---- AbstractList -------------------------------------------------------------------
(define (cd-index-of self x)
  (let loop ((xs (cd-elems self)) (i 0))
    (cond ((null? xs) -1) ((objects-equals? x (car xs)) i) (else (loop (cdr xs) (fx+ i 1))))))
(define (cd-last-index-of self x)
  (let loop ((xs (cd-elems self)) (i 0) (hit -1))
    (if (null? xs) hit (loop (cdr xs) (fx+ i 1) (if (objects-equals? x (car xs)) i hit)))))
(define (cd-get self i) (cd-call self "get" (->num i)))
(define (cd-first self)
  (when (fx=? 0 (cd-size self)) (throw-jvm 'NoSuchElementException jolt-nil))
  (cd-get self 0))
(define (cd-last self)
  (let ((n (cd-size self)))
    (when (fx=? 0 n) (throw-jvm 'NoSuchElementException jolt-nil))
    (cd-get self (fx- n 1))))
(define cd-list-defaults
  (list
    (list "indexOf" 1 (lambda (self x) (->num (cd-index-of self x))))
    (list "lastIndexOf" 1 (lambda (self x) (->num (cd-last-index-of self x))))
    (list "add" 1 (lambda (self x) (cd-call self "add" (->num (cd-size self)) x) #t))
    (list "listIterator" 0 (lambda (self) (make-cd-list-iterator self 0)))
    (list "listIterator" 1 (lambda (self i)
                             (let ((i (jnum->exact i)) (n (cd-size self)))
                               (unless (and (fx>=? i 0) (fx<=? i n))
                                 (throw-jvm 'IndexOutOfBoundsException (string-append "Index: " (number->string i))))
                               (make-cd-list-iterator self i))))
    (list "iterator" 0 (lambda (self) (make-cd-list-iterator self 0)))
    (list "subList" 2 (lambda (self from to) (make-cd-sublist self (jnum->exact from) (jnum->exact to))))
    (list "replaceAll" 1 (lambda (self f)
                           (do ((i 0 (fx+ i 1))) ((fx=? i (cd-size self)) jolt-nil)
                             (cd-call self "set" (->num i) (jolt-fi-call f "apply" (cd-get self i))))))
    (list "sort" 1 (lambda (self cmp)
                     (let ((xs (jcoll-sorted (cd-elems self) cmp)))
                       (let loop ((xs xs) (i 0))
                         (unless (null? xs) (cd-call self "set" (->num i) (car xs)) (loop (cdr xs) (fx+ i 1))))
                       jolt-nil)))
    (list "getFirst" 0 cd-first)
    (list "getLast" 0 cd-last)
    (list "addFirst" 1 (lambda (self x) (cd-call self "add" (->num 0) x) jolt-nil))
    (list "addLast" 1 (lambda (self x) (cd-call self "add" (->num (cd-size self)) x) jolt-nil))
    (list "removeFirst" 0 (lambda (self) (cd-first self) (cd-call self "remove" (->num 0))))
    (list "removeLast" 0 (lambda (self) (cd-last self) (cd-call self "remove" (->num (fx- (cd-size self) 1)))))
    (list "addAll" 2 (lambda (self i c)
                       (let loop ((xs (cd-elems c)) (k (jnum->exact i)))
                         (if (null? xs)
                             (pair? (cd-elems c))
                             (begin (cd-call self "add" (->num k) (car xs)) (loop (cdr xs) (fx+ k 1)))))))))

;; A ListIterator over any List, through its get / set / add / remove, so it is
;; live as AbstractList's is. State #(list cursor last-returned expected);
;; last-returned is -1 when nothing may be removed or set, and expected is the
;; list's modCount when it keeps one (jutil-modcount), checked as
;; AbstractList.ListItr checks it. Each tag is one JDK class.
(define (cd-list-iterator-tag lst)
  (let ((c (guard (e (#t #f)) (jolt-class-name lst))))
    (cond ((equal? c "java.util.ArrayList") "cd-arraylist-listitr")
          ((member c '("java.util.Vector" "java.util.Stack")) "cd-vector-listitr")
          (else "cd-abstractlist-listitr"))))
(define (make-cd-list-iterator lst i)
  (make-jhost (cd-list-iterator-tag lst) (vector lst i -1 (jutil-modcount lst))))
(define (cdi-check! it)
  (let ((e (vector-ref (jhost-state it) 3)))
    (when (and e (not (eqv? e (jutil-modcount (cdi-list it))))) (jutil-cme!))))
(define (cdi-resync! it) (vector-set! (jhost-state it) 3 (jutil-modcount (cdi-list it))))
(define (cdi-list it) (vector-ref (jhost-state it) 0))
(define (cdi-cursor it) (vector-ref (jhost-state it) 1))
(define (cdi-cursor! it i) (vector-set! (jhost-state it) 1 i))
(define (cdi-last it) (vector-ref (jhost-state it) 2))
(define (cdi-last! it i) (vector-set! (jhost-state it) 2 i))
(define (cdi-need-last it)
  (when (fx<? (cdi-last it) 0) (throw-jvm 'IllegalStateException jolt-nil)))
(define cd-list-iterator-methods
  (list
    (cons "hasNext" (lambda (self) (fx<? (cdi-cursor self) (cd-size (cdi-list self)))))
    (cons "next" (lambda (self)
                   (cdi-check! self)
                   (let ((i (cdi-cursor self)))
                     (unless (fx<? i (cd-size (cdi-list self))) (throw-jvm 'NoSuchElementException jolt-nil))
                     (cdi-cursor! self (fx+ i 1)) (cdi-last! self i)
                     (cd-get (cdi-list self) i))))
    (cons "hasPrevious" (lambda (self) (fx>? (cdi-cursor self) 0)))
    (cons "previous" (lambda (self)
                       (cdi-check! self)
                       (let ((i (fx- (cdi-cursor self) 1)))
                         (when (fx<? i 0) (throw-jvm 'NoSuchElementException jolt-nil))
                         (cdi-cursor! self i) (cdi-last! self i)
                         (cd-get (cdi-list self) i))))
    (cons "nextIndex" (lambda (self) (->num (cdi-cursor self))))
    (cons "previousIndex" (lambda (self) (->num (fx- (cdi-cursor self) 1))))
    (cons "remove" (lambda (self)
                     (cdi-need-last self)
                     (cdi-check! self)
                     (cd-call (cdi-list self) "remove" (->num (cdi-last self)))
                     (when (fx<? (cdi-last self) (cdi-cursor self)) (cdi-cursor! self (fx- (cdi-cursor self) 1)))
                     (cdi-last! self -1)
                     (cdi-resync! self)
                     jolt-nil))
    (cons "set" (lambda (self x)
                  (cdi-need-last self)
                  (cdi-check! self)
                  (cd-call (cdi-list self) "set" (->num (cdi-last self)) x)
                  jolt-nil))
    (cons "add" (lambda (self x)
                  (cdi-check! self)
                  (cd-call (cdi-list self) "add" (->num (cdi-cursor self)) x)
                  (cdi-resync! self)
                  (cdi-cursor! self (fx+ (cdi-cursor self) 1))
                  (cdi-last! self -1)
                  jolt-nil))
    (cons "forEachRemaining" (lambda (self f)
                               (let loop ()
                                 (when (fx<? (cdi-cursor self) (cd-size (cdi-list self)))
                                   (jolt-fi-call f "accept" (cd-call self "next"))
                                   (loop)))
                               jolt-nil))))
(for-each (lambda (p)
            (hashtable-set! jhost-tag->fqn (car p) (cdr p))
            (jch-register-supers! (cdr p) '("java.util.ListIterator"))
            (register-host-methods! (car p) cd-list-iterator-methods))
          '(("cd-arraylist-listitr" . "java.util.ArrayList$ListItr")
            ("cd-vector-listitr" . "java.util.Vector$ListItr")
            ("cd-abstractlist-listitr" . "java.util.AbstractList$ListItr")))
(jch-register-supers! "java.util.ListIterator" '("java.util.Iterator"))
(register-seq-arm-last! (lambda (x) (and (jhost? x) (member (jhost-tag x) '("cd-arraylist-listitr" "cd-vector-listitr"
                                                                       "cd-abstractlist-listitr")) #t))
  (lambda (it)
    (let ((lst (cdi-list it)))
      (let loop ((i (fx- (cd-size lst) 1)) (acc '()))
        (if (fx<? i (cdi-cursor it))
            (if (null? acc) jolt-nil (list->cseq acc))
            (loop (fx- i 1) (cons (cd-get lst i) acc)))))))

;; subList: a live window onto its list, as AbstractList's SubList is — reads and
;; writes go through the parent at the offset, and a structural change made
;; through it moves its end. When the root list keeps a modCount the window
;; remembers it: a structural change made to the root any other way makes
;; every use of the window a ConcurrentModificationException, and one made
;; through the window (or a window inside it) carries the new count and size up
;; to each window it sits in, as the JDK's updateSizeAndModCount does.
;; State #(root offset size expected outer-window). Each tag is one JDK class,
;; by the root's.
(define (cd-sublist-tag lst)
  (let ((c (guard (e (#t #f)) (jolt-class-name lst))))
    (cond ((equal? c "java.util.ArrayList") "cd-arraylist-sublist")
          ((jch-isa? c "java.util.RandomAccess") "cd-ra-sublist")
          (else "cd-sublist"))))
(define (make-cd-sublist lst from to)
  (cd-range-check! from to (cd-size lst))
  (make-jhost (cd-sublist-tag lst) (vector lst from (fx- to from) (jutil-modcount lst) #f)))
(define (cds-parent s) (vector-ref (jhost-state s) 0))
(define (cds-off s) (vector-ref (jhost-state s) 1))
(define (cds-n s) (vector-ref (jhost-state s) 2))
(define (cds-n! s n) (vector-set! (jhost-state s) 2 n))
(define (cds-st s) (jhost-state s))
(define (cds-expected s) (let ((st (cds-st s))) (and (fx>? (vector-length st) 3) (vector-ref st 3))))
(define (cds-outer s) (let ((st (cds-st s))) (and (fx>? (vector-length st) 4) (vector-ref st 4))))
(define (cds-check! s)
  (let ((e (cds-expected s)))
    (when (and e (not (eqv? e (jutil-modcount (cds-parent s))))) (jutil-cme!))))
;; after a structural change made through S: S and each window holding it take
;; the size change and the root's new count
(define (cds-moved! s delta)
  (let loop ((w s))
    (when w
      (cds-n! w (fx+ (cds-n w) delta))
      (when (cds-expected w) (vector-set! (cds-st w) 3 (jutil-modcount (cds-parent w))))
      (loop (cds-outer w)))))
(define (cds-elems s)
  (cds-check! s)
  (let ((p (cds-parent s)) (o (cds-off s)))
    (let loop ((i (fx- (cds-n s) 1)) (acc '()))
      (if (fx<? i 0) acc (loop (fx- i 1) (cons (cd-get p (fx+ o i)) acc))))))
(define cd-sublist-methods
  (list
    (cons "size" (lambda (self) (cds-check! self) (->num (cds-n self))))
    (cons "get" (lambda (self i)
                  (let ((i (jnum->exact i))) (cd-index-check! i (cds-n self)) (cds-check! self)
                    (cd-get (cds-parent self) (fx+ (cds-off self) i)))))
    (cons "set" (lambda (self i x)
                  (let ((i (jnum->exact i))) (cd-index-check! i (cds-n self)) (cds-check! self)
                    (cd-call (cds-parent self) "set" (->num (fx+ (cds-off self) i)) x))))
    (cons "add" (case-lambda
                  ((self x) (cds-check! self)
                            (cd-call (cds-parent self) "add" (->num (fx+ (cds-off self) (cds-n self))) x)
                            (cds-moved! self 1) #t)
                  ((self i x)
                   (let ((i (jnum->exact i)))
                     (unless (and (fx>=? i 0) (fx<=? i (cds-n self)))
                       (throw-jvm 'IndexOutOfBoundsException (string-append "Index: " (number->string i))))
                     (cds-check! self)
                     (cd-call (cds-parent self) "add" (->num (fx+ (cds-off self) i)) x)
                     (cds-moved! self 1)
                     jolt-nil))))
    (cons "remove" (lambda (self x)
                     ;; remove(int) by position (the index is checked before the
                     ;; count, as SubList checks it); remove(Object) is the first equal
                     (if (and (fixnum? x) (not (jfloat? x)))
                         (let ((i x)) (cd-index-check! i (cds-n self)) (cds-check! self)
                           (let ((old (cd-call (cds-parent self) "remove" (->num (fx+ (cds-off self) i)))))
                             (cds-moved! self -1) old))
                         (let ((i (begin (cds-check! self) (cd-index-of self x))))
                           (if (fx<? i 0) #f
                               (begin (cd-call (cds-parent self) "remove" (->num (fx+ (cds-off self) i)))
                                      (cds-moved! self -1) #t))))))
    (cons "clear" (lambda (self)
                    (cds-check! self)
                    (let ((n (cds-n self)))
                      (do ((k 0 (fx+ k 1))) ((fx=? k n))
                        (cd-call (cds-parent self) "remove" (->num (cds-off self))))
                      (cds-moved! self (fx- 0 n)))
                    jolt-nil))
    ;; made without a check: the window inside reports a change on first use
    (cons "subList" (lambda (self from to)
                      (let ((from (jnum->exact from)) (to (jnum->exact to)))
                        (cd-range-check! from to (cds-n self))
                        (make-jhost (jhost-tag self) (vector (cds-parent self) (fx+ (cds-off self) from) (fx- to from)
                                                             (cds-expected self) self)))))))
(for-each (lambda (p)
            (hashtable-set! jhost-tag->fqn (car p) (cadr p))
            (register-host-methods! (car p) cd-sublist-methods)
            (register-jutil-coll! (car p) (caddr p) cds-elems))
          '(("cd-arraylist-sublist" "java.util.ArrayList$SubList" ralist)
            ("cd-ra-sublist" "java.util.AbstractList$RandomAccessSubList" ralist)
            ("cd-sublist" "java.util.AbstractList$SubList" list)))
(jch-register-supers! "java.util.AbstractList" '("java.util.AbstractCollection" "java.util.List"))
(jch-register-supers! "java.util.AbstractList$SubList" '("java.util.AbstractList"))
(jch-register-supers! "java.util.AbstractList$RandomAccessSubList" '("java.util.AbstractList$SubList" "java.util.RandomAccess"))
(jch-register-supers! "java.util.ArrayList$SubList" '("java.util.AbstractList" "java.util.RandomAccess"))
(define-jhost-tag-pred (cd-sublist? t)
  (and (member t '("cd-arraylist-sublist" "cd-ra-sublist" "cd-sublist")) #t))
(register-seq-arm-last! cd-sublist? (lambda (x) (let ((xs (cds-elems x))) (if (null? xs) jolt-nil (list->cseq xs)))))
(register-count-arm-last! cd-sublist? (lambda (x) (cds-n x)))
;; a window's modCount is its root's: an iterator over it sees a change made
;; through the window or to the root
(for-each (lambda (t) (register-modcount! t (lambda (s) (jutil-modcount (cds-parent s)))))
          '("cd-arraylist-sublist" "cd-ra-sublist" "cd-sublist"))

;; ---- Map -------------------------------------------------------------------------------
(define cd-absent (list 'cd-absent))
(define (cd-map-ref self k)
  (if (cd-truthy? (cd-call self "containsKey" k)) (cd-call self "get" k) cd-absent))
(define (cd-map-entries self) (cd-elems (cd-call self "entrySet")))
(define (cd-ek e) (jolt-nth e 0))
(define (cd-ev e) (jolt-nth e 1))
(define cd-map-defaults
  (list
    (list "isEmpty" 0 (lambda (self) (fx=? 0 (cd-size self))))
    (list "containsValue" 1 (lambda (self x) (and (exists (lambda (e) (objects-equals? x (cd-ev e))) (cd-map-entries self)) #t)))
    (list "getOrDefault" 2 (lambda (self k d) (let ((v (cd-map-ref self k))) (if (eq? v cd-absent) d v))))
    (list "putAll" 1 (lambda (self m) (for-each (lambda (e) (cd-call self "put" (cd-ek e) (cd-ev e))) (cd-elems m)) jolt-nil))
    (list "putIfAbsent" 2 (lambda (self k v)
                            (let ((old (cd-call self "get" k)))
                              (if (jolt-nil? old) (cd-call self "put" k v) old))))
    (list "remove" 2 (lambda (self k v)
                       (let ((old (cd-map-ref self k)))
                         (if (and (not (eq? old cd-absent)) (objects-equals? old v))
                             (begin (cd-call self "remove" k) #t)
                             #f))))
    (list "replace" 2 (lambda (self k v)
                        (if (cd-truthy? (cd-call self "containsKey" k)) (cd-call self "put" k v) jolt-nil)))
    (list "replace" 3 (lambda (self k old v)
                        (let ((cur (cd-map-ref self k)))
                          (if (and (not (eq? cur cd-absent)) (objects-equals? cur old))
                              (begin (cd-call self "put" k v) #t)
                              #f))))
    (list "computeIfAbsent" 2 (lambda (self k f)
                                (let ((old (cd-call self "get" k)))
                                  (if (jolt-nil? old)
                                      (let ((nv (jolt-fi-call f "apply" k)))
                                        (unless (jolt-nil? nv) (cd-call self "put" k nv))
                                        nv)
                                      old))))
    (list "computeIfPresent" 2 (lambda (self k f)
                                 (let ((old (cd-call self "get" k)))
                                   (if (jolt-nil? old)
                                       jolt-nil
                                       (let ((nv (jolt-fi-call f "apply" k old)))
                                         (if (jolt-nil? nv) (cd-call self "remove" k) (cd-call self "put" k nv))
                                         nv)))))
    (list "compute" 2 (lambda (self k f)
                        (let* ((old (cd-call self "get" k)) (nv (jolt-fi-call f "apply" k old)))
                          (cond ((not (jolt-nil? nv)) (cd-call self "put" k nv) nv)
                                ((cd-truthy? (cd-call self "containsKey" k)) (cd-call self "remove" k) jolt-nil)
                                (else jolt-nil)))))
    (list "merge" 3 (lambda (self k v f)
                      (let* ((old (cd-call self "get" k))
                             (nv (if (jolt-nil? old) v (jolt-fi-call f "apply" old v))))
                        (if (jolt-nil? nv)
                            (begin (cd-call self "remove" k) jolt-nil)
                            (begin (cd-call self "put" k nv) nv)))))
    (list "forEach" 1 (lambda (self f)
                        (for-each (lambda (e) (jolt-fi-call f "accept" (cd-ek e) (cd-ev e))) (cd-map-entries self))
                        jolt-nil))
    (list "replaceAll" 1 (lambda (self f)
                           (for-each (lambda (e) (cd-call self "put" (cd-ek e) (jolt-fi-call f "apply" (cd-ek e) (cd-ev e))))
                                     (cd-map-entries self))
                           jolt-nil))))

;; ---- Queue / Deque / Iterator -------------------------------------------------------------
(define cd-queue-defaults
  (list
    (list "element" 0 (lambda (self)
                        (if (fx=? 0 (cd-size self)) (throw-jvm 'NoSuchElementException jolt-nil) (cd-call self "peek"))))
    (list "remove" 0 (lambda (self)
                       (if (fx=? 0 (cd-size self)) (throw-jvm 'NoSuchElementException jolt-nil) (cd-call self "poll"))))
    (list "add" 1 (lambda (self x)
                    (if (cd-truthy? (cd-call self "offer" x)) #t (throw-jvm 'IllegalStateException "Queue full"))))))
(define cd-iterator-defaults
  (list
    (list "forEachRemaining" 1 (lambda (self f)
                                 (let loop ()
                                   (when (cd-truthy? (cd-call self "hasNext"))
                                     (jolt-fi-call f "accept" (cd-call self "next"))
                                     (loop)))
                                 jolt-nil))
    (list "remove" 0 (lambda (self) (throw-jvm 'UnsupportedOperationException "remove")))))

;; interface or abstract class -> ((name argc proc) ...)
(define cd-default-tbl (make-hashtable string-hash string=?))
(hashtable-set! cd-default-tbl "java.util.Collection" cd-collection-defaults)
(hashtable-set! cd-default-tbl "java.util.List" cd-list-defaults)
(hashtable-set! cd-default-tbl "java.util.Map" cd-map-defaults)
(hashtable-set! cd-default-tbl "java.util.Queue" cd-queue-defaults)
(hashtable-set! cd-default-tbl "java.util.Iterator" cd-iterator-defaults)

;; The default METHOD-NAME of ARGC arguments a host object's class inherits, or
;; #f. Asked of shims only (a jhost): reify, deftype and proxy values implement
;; the interface themselves, and a proxy's superclass is a shim, which answers.
(define (cd-default-find obj method-name argc)
  (and (jhost? obj)
       (let loop ((tags (value-host-tags obj)))
         (cond ((null? tags) #f)
               ((let ((ms (hashtable-ref cd-default-tbl (car tags) #f)))
                  (and ms (find (lambda (m) (and (string=? (car m) method-name) (fx=? (cadr m) argc))) ms)))
                => caddr)
               (else (loop (cdr tags)))))))
(let ((prev iface-default-hook))
  (set-iface-default-hook!
    (lambda (obj method-name argc)
      (or (and prev (prev obj method-name argc))
          (cd-default-find obj method-name argc)))))
