#!/bin/sh
# jolt — the pure-Chez jolt runtime. NO Janet.
#
# Compiles and evaluates jolt (Clojure) on Chez using the checked-in bootstrap
# seed (host/chez/seed/). With only Chez installed it runs jolt end to end:
#
#   jolt -e "(+ 1 2)"             evaluate an expression
#   jolt run -m app.core [args]   resolve deps.edn, run a namespace's -main
#   jolt -M:alias [args]          run an alias's :main-opts
#   jolt repl | path | <task>     REPL, print roots, or a deps.edn task
#
# The launcher cd's to the jolt repo root so the runtime's relative loads work;
# the user's original cwd (the project dir, where deps.edn lives) is passed in
# JOLT_PWD.
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export JOLT_PWD="${JOLT_PWD:-$PWD}"

# Identify the Chez Scheme executable. $JOLT_CHEZ is authoritative and is how the
# Makefile hands down the one it selected — the same interpreter that mints the
# seed and compiles target/dev/flat.so. A direct bin/jolt invocation does not
# inherit that export, so prefer any 10.x Chez already provisioned by make before
# searching PATH. Otherwise a checkout built with the local Chez can silently
# fall back to an older system Chez: source mode then dies on whichever primitive
# that release predates, and a devboot fasl cannot load in a different Chez.
if [ -z "${JOLT_CHEZ:-}" ]; then
  for candidate in "$root"/.cache/local/chezscheme-*/bin/scheme chez chezscheme; do
    if [ -x "$candidate" ]; then
      candidate_path="$candidate"
    else
      candidate_path="$(command -v "$candidate" 2>/dev/null || true)"
    fi
    [ -n "$candidate_path" ] || continue

    case "$("$candidate_path" --version 2>/dev/null || true)" in
      10.*)
        if [ "$(printf '(display (threaded?))\n' | "$candidate_path" -q 2>/dev/null)" = "#t" ]; then
          JOLT_CHEZ="$candidate_path"
          break
        fi
        ;;
    esac
  done

  if [ -z "${JOLT_CHEZ:-}" ]; then
    echo "No threaded Chez Scheme 10.x found; install one or set JOLT_CHEZ." >&2
    exit 1
  fi
fi
CHEZ="$JOLT_CHEZ"
# Resolved to a path and exported: build.ss's toolchain-dir lookup reads
# JOLT_CHEZ from its own environment to find the csv dir next to the running
# interpreter, rather than re-deriving it from a `command -v` PATH search that
# can silently disagree with the interpreter actually selected above.
export JOLT_CHEZ="$(command -v "$CHEZ" 2>/dev/null || echo "$CHEZ")"

# Version for --version / banners: git describe of this checkout, else "dev".
export JOLT_VERSION="${JOLT_VERSION:-$(git -C "$root" describe --tags --always --dirty 2>/dev/null || echo dev)}"
# Dev source mode opts OUT of the per-namespace AOT cache: the compiler is
# volatile here (a "dev" version tag wouldn't invalidate the cache across edits),
# and devboot already covers startup. A built jolt binary defaults the cache ON.
export JOLT_AOT_CACHE="${JOLT_AOT_CACHE:-0}"
cd "$root" || exit 1

# Dev boot cache: precompiled target/dev/flat.so loads the runtime ~10x faster
# than source mode. Check freshness against the input list emitted by make devboot.
# The cache is not used for REPL (interactive stdin needed) or when the first
# arg is "repl" (explicit REPL command).
CACHE_SO="target/dev/flat.so"
CACHE_INPUTS="target/dev/flat.inputs"
CACHE_CHEZ="target/dev/flat.chez"
use_cache=0
if [ -f "$CACHE_SO" ] && [ -f "$CACHE_INPUTS" ] && [ $# -gt 0 ] && [ "$1" != "repl" ]; then
  stale=0
  while IFS= read -r f; do
    if [ -n "$f" ] && [ "$CACHE_SO" -ot "$f" ]; then
      stale=1
      break
    fi
  done < "$CACHE_INPUTS"
  # A fasl loads only in the Chez that wrote it, and neither of the two ways that
  # stops being true touches a jolt source file: a Chez upgraded in place (the
  # image is older than the executable), or a different Chez entirely (make
  # provisions its own when PATH has the wrong version). Source mode is slower
  # but correct; "incompatible fasl-object version" is neither.
  if [ "$stale" = 0 ] && [ -f "$CACHE_CHEZ" ]; then
    built_with="$(cat "$CACHE_CHEZ")"
    # Resolve to a path before comparing: make hands down an absolute one and the
    # PATH search leaves a bare name, and those are the same Chez.
    chez_path="$(command -v "$CHEZ" 2>/dev/null || echo "$CHEZ")"
    if [ "$built_with" != "$chez_path" ] || [ "$CACHE_SO" -ot "$built_with" ]; then
      stale=1
    fi
  fi
  if [ "$stale" = 0 ]; then
    use_cache=1
  fi
fi

# The devcache entry is a checked-in script sharing cli.ss's tail (cli-tail.ss)
# — an inline heredoc here once drifted from cli.ss and broke project commands.
if [ "$use_cache" = 1 ]; then
  exec ${CHEZ} --script host/chez/cli-devcache.ss "$@"
fi

# Fallback: source mode. Hint for devs (only when interactive).
if [ -t 1 ] && [ -z "${JOLT_QUIET:-}" ]; then
  echo "jolt: source mode; run 'make devboot' to precompile" >&2
fi
exec ${CHEZ} --script host/chez/cli.ss "$@"
