;; What ci/metrics-gate.clj holds the jolt-metrics report to.
;;
;; :critical-free — path prefixes where any CRITICAL finding (a function over the
;; cyclomatic/cognitive/lines/nesting/params limits, or a file over 1000 source
;; lines) or a file jolt-metrics cannot read fails the build. Add a tree here
;; once its criticals are cleared; there is no per-finding allowlist for these.
;;
;; The rest is unused code that stays on purpose. Each entry says why: the tool
;; can't see var-deref from Scheme, #' lookups, or a require kept for what
;; loading it does.
{:critical-free ["jolt-core/"]
 :unused-requires
 [{:path "stdlib/clojure/core/async/flow/impl.clj" :lib "clojure.core.async.flow.impl.graph"
   :why "upstream core.async's own require; impl.clj names the Graph class it defines"}
  {:path "test/chez/ns-audit/good/host.cljc" :lib "clojure.set"
   :why "ns-audit fixture"}
  {:path "test/chez/ns-audit/good/plain.clj" :lib "clojure.string"
   :why "ns-audit fixture"}]
 :unused-private
 [{:path "jolt-core/clojure/core/22-coll.clj" :name "serialized-require"
   :why "clojure.core's private, kept for code that reaches #'clojure.core/serialized-require"}
  {:path "jolt-core/clojure/core/50-io.clj" :name "lift-ns"
   :why "clojure.pprint calls #'clojure.core/lift-ns"}]
 :unused-public
 [{:path "jolt-core/jolt/analyzer.clj" :name "set-name-counter!"
   :why "var-deref from host/chez/build.ss"}
  {:path "jolt-core/jolt/analyzer.clj" :name "defmacro-expansion"
   :why "var-deref from host/chez/ns.ss"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "current-unit"
   :why "var-deref from host/chez (build.ss, emit-image.ss)"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-prelude-mode!"
   :why "var-deref from host/chez and the gate harnesses"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-seed-mint!"
   :why "var-deref from host/chez (the seed mint)"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-var-cache!"
   :why "var-deref from host/chez and the gate harnesses"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-target!"
   :why "var-deref from host/chez (build targets)"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-source-reg!"
   :why "var-deref from host/chez"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-debug-locals!"
   :why "var-deref from host/chez"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "seed-fnsrc-ns-counter!"
   :why "var-deref from host/chez/build.ss"}
  {:path "compatibility/cheshire/core.clj" :name "parse-string-strict"
   :why "cheshire's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/cheshire/core.clj" :name "parse-stream-strict"
   :why "cheshire's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/cheshire/core.clj" :name "parsed-seq"
   :why "cheshire's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/bencode/core.clj" :name "read-netstring"
   :why "nrepl/bencode's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/bencode/core.clj" :name "write-netstring"
   :why "nrepl/bencode's public API, for scripts that call it; nothing in jolt does"}]}
