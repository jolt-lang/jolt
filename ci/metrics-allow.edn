;; What ci/metrics-gate.clj holds the jolt-metrics report to.
;;
;; :critical-free — path prefixes where any CRITICAL finding (a function over the
;; cyclomatic/cognitive/lines/nesting/params limits, or a file over 1000 source
;; lines) or a file jolt-metrics cannot read fails the build. Add a tree here
;; once its criticals are cleared; there is no per-finding allowlist for these.
;;
;; :unused-requires, :unused-private and :unused-public are unused code that
;; stays on purpose. Each entry says why: the tool can't see var-deref from
;; Scheme, #' lookups, or a require kept for what loading it does.
;;
;; :lints are :warning and performance-rule lint findings that stay, each as a
;; path, a rule and how many findings of that rule the file keeps. Prefer fixing
;; the code; a deliberate shape inside a form can also take a
;; #_{:jolt-metrics/ignore [:rule]} marker, but not in a fixture whose lines a
;; golden file pins.
{:critical-free ["jolt-core/"]
 :unused-requires
 [{:path "stdlib/clojure/core/async/flow/impl.clj" :lib "clojure.core.async.flow.impl.graph"
   :why "upstream core.async's own require; impl.clj names the Graph class it defines"}
  {:path "test/chez/ns-audit/good/host.cljc" :lib "clojure.set"
   :why "ns-audit fixture"}
  {:path "test/chez/ns-audit/good/plain.clj" :lib "clojure.string"
   :why "ns-audit fixture"}]
 :unused-private
 [{:path "jolt-core/clojure/core/22-coll.clj" :name "serialized-require"
   :why "clojure.core's private, kept for code that reaches #'clojure.core/serialized-require"}
  {:path "jolt-core/clojure/core/50-io.clj" :name "lift-ns"
   :why "clojure.pprint calls #'clojure.core/lift-ns"}]
 :unused-public
 [{:path "clj-kondo.exports/jolt-lang/jolt/hooks/jolt/ffi.clj" :name "defcfn"
   :why "clj-kondo hook, named in the exported config.edn"}
  {:path "clj-kondo.exports/jolt-lang/jolt/hooks/jolt/ffi.clj" :name "with-arena"
   :why "clj-kondo hook, named in the exported config.edn"}
  {:path "jolt-core/jolt/analyzer.clj" :name "set-name-counter!"
   :why "var-deref from host/chez/build.ss"}
  {:path "jolt-core/jolt/analyzer.clj" :name "defmacro-expansion"
   :why "var-deref from host/chez/ns.ss"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "current-unit"
   :why "var-deref from host/chez (build.ss, emit-image.ss)"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-prelude-mode!"
   :why "var-deref from host/chez and the gate harnesses"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-seed-mint!"
   :why "var-deref from host/chez (the seed mint)"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-var-cache!"
   :why "var-deref from host/chez and the gate harnesses"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-target!"
   :why "var-deref from host/chez (build targets)"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "set-source-reg!"
   :why "var-deref from host/chez"}
  {:path "jolt-core/jolt/backend_scheme.clj" :name "seed-fnsrc-ns-counter!"
   :why "var-deref from host/chez/build.ss"}
  {:path "compatibility/cheshire/core.clj" :name "parse-string-strict"
   :why "cheshire's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/cheshire/core.clj" :name "parse-stream-strict"
   :why "cheshire's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/cheshire/core.clj" :name "parsed-seq"
   :why "cheshire's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/bencode/core.clj" :name "read-netstring"
   :why "nrepl/bencode's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/bencode/core.clj" :name "write-netstring"
   :why "nrepl/bencode's public API, for scripts that call it; nothing in jolt does"}
  {:path "compatibility/jsonista/core.clj" :name "write-value"
   :why "jsonista's public API, for libraries that call it (muuntaja); nothing in jolt does"}
  {:path "compatibility/jsonista/core.clj" :name "read-value"
   :why "jsonista's public API, for libraries that call it (muuntaja); nothing in jolt does"}
  {:path "compatibility/jsonista/core.clj" :name "write-value-as-bytes"
   :why "jsonista's public API, for libraries that call it (muuntaja); nothing in jolt does"}
  {:path "compatibility/jsonista/core.clj" :name "java-collection-module"
   :why "jsonista's public API, for libraries that call it; nothing in jolt does"}]
 :lints
 [{:path "jolt-core/clojure/core/20-coll.clj" :rule :str-accumulation :count 1
   :why "pr-str's variadic loop: a StringBuilder measured 5-8% slower for 2-3 args, the usual call, and only wins past about 6"}
  {:path "stdlib/jolt/line_editor.clj" :rule :str-accumulation :count 2
   :why "a CSI sequence's few parameter bytes, and a dim line under the input cut at the terminal width: both bounded and short"}
  {:path "stdlib/jolt/parinfer.clj" :rule :str-accumulation :count 1
   :why "one line's closing-paren trail, bounded by nesting depth; written as parinfer.js writes it"}
  {:path "stdlib/jolt/infix/grammar.clj" :rule :refer-all :count 1
   :why "rm-hull/infix's grammar as upstream writes it: it names dozens of combinators bare"}
  {:path "test/chez/loader-test.clj" :rule :use :count 1
   :why "tests use itself"}
  {:path "test/chez/loop-shadow-app/src/app/core.clj" :rule :loop-without-recur :count 1
   :why "fixture: a loop binding that shadows a record local, the shape the bug needed"}
  {:path "test/chez/scalar-capture-app/src/app/core.clj" :rule :redundant-let :count 1
   :why "fixture: a let that rebinds a local the scalar-replaced ctor args read"}
  {:path "test/errors/macro/synthetic-expansion/input.clj" :rule :redundant-let :count 2
   :why "error-report fixture; its golden output pins these lines"}
  {:path "test/conformance/certify.clj" :rule :inline-def :count 2
   :why "the script publishes its results as vars for the exit check at the bottom"}
  {:path "test/print_method_overhead_test.clj" :rule :inline-def :count 2
   :why "install! adds a print-method arm at run time; that is what it measures"}]}
