  ;; --- Scaling and performance -------------------------------------------------

  ;; Reading was quadratic until v0.7.7 (37s for core.clj) and the value-based
  ;; corpus rows missed it.
  readscaling {:doc "Reading a source file form by form costs time linear in its size"
               :depends [testbin deps]
               :task (sh "JOLT_NO_USER_DEPS=1 target/release/jolt run test/read_scaling_test.clj")}

  ;; Without the variadic registration, (apply max (range)) realizes an unbounded
  ;; seq until the process dies.
  applyscaling {:doc "apply streams a variadic's rest, so (apply max (range)) stays lazy"
                :depends [testbin deps]
                :task (sh "JOLT_NO_USER_DEPS=1 JOLT_GC_TRIP_BYTES=16777216 target/release/jolt run test/apply_scaling_test.clj")}

  ;; Judged by counting mutex allocations, not a timed ratio, so load can't
