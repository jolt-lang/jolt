              :task (sh "JOLT_NO_USER_DEPS=1 target/release/jolt run test/hotpath_scaling_test.clj")}

  ;; Runs alone because a busy neighbour moved its ratio 1.5-3x. The CPU is
  ;; printed first: some rows' ratios are a property of the runner's
  ;; microarchitecture, not of the moment. A failing row is
  ;; retried in a fresh process.
  fastpathratio {:doc "Read, string-scan and dispatch fast paths, judged as ratios in one process"
                 :depends [testbin]
                 :task (sh "echo \"fastpathratio: cpu $( (grep -m1 'model name' /proc/cpuinfo 2>/dev/null || sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -m) | sed 's/.*: //')\"; \\
if JOLT_NO_USER_DEPS=1 target/release/jolt run test/fastpath_ratio_test.clj >target/fastpathratio.out 2>&1; then \\
cat target/fastpathratio.out; \\
else \\
cat target/fastpathratio.out; \\
only=$(sed -n 's/^  - \\([^:]*\\): .*/\\1/p' target/fastpathratio.out | paste -sd, -); \\
if [ -z \"$only\" ]; then exit 1; fi; \\
echo; echo \"fastpathratio: judging $only again in a fresh process\"; \\
FASTPATH_ONLY=\"$only\" JOLT_NO_USER_DEPS=1 target/release/jolt run test/fastpath_ratio_test.clj; \\
fi")}

  ;; Stdlib fasls once got built with var-cache off, which ran 2-7x slower. CI
