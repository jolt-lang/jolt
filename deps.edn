;; jolt's build and gate as jolt tasks, beside the Makefile: `jolt info` lists
;; them by group, `jolt build` builds, `jolt test -j 8` runs the full gate.
;; Variables come from the environment (`CHEZ=/opt/chez/bin/chez jolt testbin`).
;; Shared code is in tools/tasks/, and taskparity fails when this file and the
;; Makefile stop naming the same targets.
{:tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])
  :init (do (load-file "tools/tasks/env.clj")
            (load-file "tools/tasks/gate.clj")
            (refer 'tasks.env :only '[sh chez gambit-env jolt-bin]))

  ;; --- Start here --------------------------------------------------------------

  info {:doc "Every task, grouped by topic (start here)"
        :task (do (load-file "tools/tasks/info.clj")
                  (tasks.info/print-info (:tasks (read-string (slurp "deps.edn")))))}

  chez-path {:doc "Print the Chez these tasks run"
             :task (println (deref tasks.env/chez-path))}

  deps {:doc "Submodules plus a threaded, patched Chez (provisioned when absent)"
        :depends [submodules]
        :task (let [out (-> (babashka.process/shell {:out :string :err :string :continue true
                                                     :in "(write (threaded?)) (newline)\n"}
                                                    (deref tasks.env/chez-path) "-q")
                            :out str str/trim)]
                (when-not (= "#t" out)
                  (println (str "Jolt requires a threaded Chez Scheme (" (deref tasks.env/chez-path) " reported " out ")"))
                  (System/exit 1)))}

  submodules {:doc "Initialize every vendored submodule when any is missing"
              :task (when (tasks.env/sh-out "git submodule status --recursive | grep -q '^-' && echo missing")
                      (shell "git submodule update --init --recursive"))}

  hooks {:doc "Install the repo's git hooks into .git/hooks (re-run after a hook changes)"
         :task (sh "for h in tools/git-hooks/*; do cp \"$h\" \".git/hooks/$(basename \"$h\")\"; chmod +x \".git/hooks/$(basename \"$h\")\"; echo \"installed .git/hooks/$(basename \"$h\")\"; done")}

  ;; --- Build and install -------------------------------------------------------

  build {:doc "Build the standalone binary (testbin)"
         :override-builtin true
         :depends [testbin]
         :task nil}

  default {:doc "What a bare `make` does: build"
           :depends [build]
           :task nil}

  ;; Per-case CLI and build gates boot a built binary about 10x faster than
  ;; script mode.
  testbin {:doc "Standalone binary at target/release/jolt, rebuilt when an input is newer"
           :depends [deps]
           :task (if (tasks.gate/done? 'testbin)
                   (println "testbin: built once by the gate runner")
                   (let [inputs ["host/chez" "jolt-core" "stdlib" "compatibility" "vendor/fs/src"
                                 "vendor/process/src" "vendor/cli/src" "vendor/grenadine/src"
                                 "vendor/grenadine-generated" "vendor/irregex"]
                         bin "target/release/jolt"]
                     (if (or (tasks.env/getenv "JOLT_FORCE_TESTBIN")
                             (not (fs/executable? bin))
                             (not-empty (tasks.env/sh-out (str "find " (str/join " " inputs)
                                                               " -type f -newer " bin " -print -quit 2>/dev/null"))))
                       (chez "--script" "host/chez/build-jolt.ss" "release" bin)
                       (println "testbin: target/release/jolt up to date"))))}

  ;; Not named install, because jolt runs a file named ./install before a task of
  ;; that name.
  install-local {:doc "Install target/release/jolt into $PREFIX/bin (default ~/.local)"
                 :depends [build]
                 :task (let [prefix (or (tasks.env/getenv "PREFIX")
                                        (if (= "0" (tasks.env/sh-out "id -u"))
                                          "/usr/local"
                                          (str (System/getProperty "user.home") "/.local")))]
                         (shell "install -d" (str prefix "/bin"))
                         (shell "install -m 755 target/release/jolt" (str prefix "/bin/jolt")))}

  jolt {:doc "Check the seed fixpoint, then build the release and debug binaries"
        :depends [selfhost jolt-release jolt-debug deps]
        :task (sh "echo \"OK: target/release/jolt and target/debug/jolt built\"")}

  jolt-release {:doc "Build the self-contained release binary at target/release/jolt"
                :depends [deps]
                :task (sh "$JOLT_CHEZ --script host/chez/build-jolt.ss release target/release/jolt $JOLT_CROSS_TARGET")}

  jolt-debug {:doc "Build the debug binary at target/debug/jolt"
              :depends [deps]
              :task (sh "$JOLT_CHEZ --script host/chez/build-jolt.ss debug target/debug/jolt")}

  remint {:doc "Re-mint the seed after changing a seed source (reader, analyzer, backend)"
          :depends [deps]
          :task (sh "sh host/chez/remint.sh")}

  devboot {:doc "Precompile the runtime to target/dev/flat.so so dev bin/jolt boots ~10x faster"
           :depends [submodules deps]
           :task (chez "--script" "host/chez/make-devboot.ss")}

  gateboot {:doc "Precompile the gate boot preamble to target/dev/gate.so for faster gate boots"
            :depends [submodules deps]
            :task (chez "--script" "host/chez/make-gateboot.ss")}

  ;; --- The gate ----------------------------------------------------------------

  ;; Includes the self-host byte fixpoint, which only holds on the Chez that
  ;; minted the seed.
  test {:doc "Full gate for a dev machine: selfhost plus the CI gate (-j N runs N at once)"
        :depends [deps]
        :task (tasks.gate/run-gate! "test" tasks.gate/test-gates *command-line-args*)}

  ;; The seed runs on any Chez but its bytes differ by Chez version, so CI skips
  ;; selfhost.
  ci {:doc "CI gate, behavior only: every gate except the self-host byte fixpoint"
      :depends [deps]
      :task (tasks.gate/run-gate! "ci" tasks.gate/ci-gates *command-line-args*)}

  bionic-ci {:doc "The CI gate on bionic (Android/Termux)"
             :task (tasks.gate/run-gate! "bionic-ci" tasks.gate/ci-gates *command-line-args*)}

  ci-shard {:doc "Run one shard of a gate: SHARD_SET=test|ci SHARD=i SHARDS=n"
            :task (tasks.gate/ci-shard! *command-line-args*)}

  ci-shard-list {:doc "Print the gates that shard SHARD of SHARDS would run"
                 :task (doseq [g (:gates (tasks.gate/shard))] (println g))}

  gate-status {:doc "Say whether this exact working tree is covered by a complete gate run"
               :task (tasks.gate/gate-status!)}

  ;; --- Seed and self-host ------------------------------------------------------

  selfhost {:doc "Self-host fixpoint: rebuilding the seed with bootstrap.ss gives the same seed"
            :depends [deps]
            :task (sh "sh host/chez/selfcheck.sh")}

  seeddefs {:doc "Every var the checked-in seed defines exists after the seed loads"
            :task (sh "$JOLT_CHEZ --script host/chez/run-seed-defs.ss"
                      "JOLT_WP_TRACE=1 JOLT_IR_VALIDATE=1 $JOLT_CHEZ --script host/chez/run-seed-defs.ss")}

  ;; Without it a forward reference could slip through a remint that an in-order
  ;; load refuses.
  mintgate {:doc "The seed mint refuses a form that names a var defined below it"
            :depends [deps]
            :task (chez "--script" "test/chez/mint-gate-test.ss")}

  ;; cli.ss and bootstrap.ss hand-mirror build.ss's manifest, so a load added to
  ;; one drifts.
  manifestcheck {:doc "cli.ss and bootstrap.ss load manifests match build.ss's runtime manifest"
                 :task (sh "sh host/chez/manifest-check.sh")}

  ;; --- Conformance against Clojure on the JVM ----------------------------------

  corpus {:doc "Corpus conformance against JVM-sourced expected values (allowlist and floor)"
          :depends [deps]
          :task (chez "--script" "host/chez/run-corpus.ss")}

  cts {:doc "Run the vendored clojure-test-suite per namespace against a failures baseline"
       :depends [testbin deps]
       :task (sh "JOLT_BIN=\"${JOLT_BIN:-target/release/jolt}\" bash host/chez/cts.sh")}

  sci {:doc "Load borkdude/sci's source through jolt, gated on a floor"
       :depends [deps]
       :task (chez "--script" "host/chez/run-sci.ss")}

  ;; Complements run-sci.ss, which is a broad but deliberately lenient
  ;; source-loading check.
  scifunctional {:doc "Load SCI through the ordinary dependency path, then reuse real contexts"
                 :depends [testbin]
                 :task (sh "JOLT_NO_USER_DEPS=1 target/release/jolt -Sdeps '{:deps {borkdude/sci {:local/root \"vendor/sci\"}}}' run test/chez/sci-functional-test.clj")}

  ;; The JVM's default locale changes rendered text (zone names), so the locale
  ;; is pinned to en_US.
  certify {:doc "Check corpus expecteds against JVM Clojure via the pinned oracle"
           :task (sh "if command -v clojure >/dev/null 2>&1; then \\
v=$(sed -n 's/^ :clojure-version \"\\([^\"]*\\)\".*/\\1/p' test/conformance/profile.edn); \\
if [ -z \"$v\" ]; then echo \"certify: no :clojure-version in test/conformance/profile.edn\"; exit 1; fi; \\
jdk=$(sed -n 's/^ :oracle-jdk \\([0-9]*\\).*/\\1/p' test/conformance/profile.edn); \\
if [ -z \"$jdk\" ]; then echo \"certify: no :oracle-jdk in test/conformance/profile.edn\"; exit 1; fi; \\
if [ -z \"$JAVA_CMD\" ]; then \\
for c in /opt/homebrew/opt/openjdk@$jdk/bin/java /usr/local/opt/openjdk@$jdk/bin/java \\
/usr/lib/jvm/java-$jdk-openjdk*/bin/java /usr/lib/jvm/temurin-$jdk-jdk*/bin/java \\
/usr/lib/jvm/java-$jdk-*/bin/java; do \\
if [ -x \"$c\" ]; then JAVA_CMD=\"$c\"; break; fi; \\
done; \\
if [ -z \"$JAVA_CMD\" ] && [ -x /usr/libexec/java_home ]; then \\
h=$(/usr/libexec/java_home -v \"$jdk\" 2>/dev/null) && [ -x \"$h/bin/java\" ] && JAVA_CMD=\"$h/bin/java\"; \\
fi; \\
if [ -n \"$JAVA_CMD\" ]; then echo \"certify: JAVA_CMD=$JAVA_CMD (profile pins JDK $jdk)\"; export JAVA_CMD; fi; \\
fi; \\
deps=\"{:deps {org.clojure/clojure {:mvn/version \\\"$v\\\"}}}\"; \\
clojure -J-Duser.language=en -J-Duser.country=US -Sdeps \"$deps\" -M test/conformance/certify.clj --self-test && \\
clojure -J-Duser.language=en -J-Duser.country=US -Sdeps \"$deps\" -M test/conformance/certify.clj; \\
else \\
echo \"certify: clojure not on PATH — skipped\"; \\
fi")}

  ;; Needs no JVM, so it runs in ci. certify checks the JVM half.
  documented {:doc "Each known-divergence entry renders its recorded jolt value, unlike the JVM's"
              :task (chez "--script" "host/chez/run-documented.ss")}

  documented-record {:doc "Print what jolt answers for the known-divergences entries, to record a new one"
                     :task (sh "$JOLT_CHEZ --script host/chez/run-documented.ss --record")}

  unit {:doc "Host-specific unit cases"
        :depends [deps]
        :task (chez "--script" "host/chez/run-unit.ss")}

  ;; Skips and exits 0 without library checkouts, so a green `jolt test` does not
  ;; cover them.
  libconformance {:doc "OPT-IN: replay third-party libraries' own test suites and compare tallies"
                  :depends [testbin deps]
                  :task (sh "JOLT_BIN=\"${JOLT_BIN:-target/release/jolt}\" \\
JOLT_NO_USER_DEPS=1 target/release/jolt run test/conformance/libs/run.clj $LIBS"
                            "JOLT_BIN=\"${JOLT_BIN:-target/release/jolt}\" sh host/chez/embedded-migratus-upstream-smoke.sh")}

  libperf {:doc "OPT-IN: time library test suites on jolt and JVM Clojure, list the slow ones"
           :depends [testbin deps]
           :task (sh "JOLT_BIN=\"${JOLT_BIN:-target/release/jolt}\" \\
JOLT_NO_USER_DEPS=1 target/release/jolt run test/conformance/libs/timing.clj $LIBS")}

  ;; --- Values and collections --------------------------------------------------

  values {:doc "Value-model unit tests (nil, truthiness, collections on Chez)"
          :depends [deps]
          :task (chez "--script" "test/chez/values-test.ss")}

  ;; A tuning pass that changes a hash value fails nothing until a hash crosses
  ;; to the JVM.
  hasheq {:doc "The hash engine's values match JVM Clojure's, pinned as literal goldens"
          :depends [deps]
          :task (chez "--script" "test/chez/hasheq-test.ss")}

  ;; A 32-bit Chez computes in bignums, so this forces those generic twins under
  ;; test on 64-bit.
  narrowhash {:doc "The hash suites again with the engine's 32-bit-safe generic arms forced on"
              :depends [deps]
              :task (sh "JOLT_NARROW_HASH=1 $JOLT_CHEZ --script test/chez/hasheq-test.ss"
                        "JOLT_NARROW_HASH=1 $JOLT_CHEZ --script test/chez/values-test.ss"
                        "JOLT_NARROW_HASH=1 $JOLT_CHEZ --script test/chez/transient-test.ss")}

  transient {:doc "Transients: mutable backing, snapshot on persistent!, linear-time builds"
             :depends [deps]
             :task (chez "--script" "test/chez/transient-test.ss")}

  sortedcoll {:doc "Sorted collections: lazy tree walk for seq, rseq, subseq, hash and = from tree"
              :depends [deps]
              :task (chez "--script" "test/chez/sorted-test.ss")}

  rrbprop {:doc "RRB vector catvec and slice against a list model, with RRB invariants"
           :task (chez "--script" "test/chez/rrb-property-test.ss")}

  rrbscaling {:doc "RRB vector catvec and slice stay within their complexity bounds"
              :task (chez "--script" "test/chez/rrb-scaling-test.ss")}

  arraymap {:doc "Array-mode maps use one flat slot vector, with matching transients and seqs"
            :task (chez "--script" "test/chez/arraymap-test.ss")}

  ;; Random assoc/dissoc, persistent and through a transient, against an alist
  ;; model over collision families and nil/false keys.
  hamt {:doc "Hash-mode maps and sets match a model, iterate in hash order, keep their node layout"
        :task (chez "--script" "test/chez/hamt-test.ss")}

  arraybacking {:doc "Which Chez vector type backs each array element kind, boxed arrays included"
                :task (chez "--script" "test/chez/array-backing-test.ss")}

  recfast {:doc "Plain defrecords answer count, seq, assoc, reduce-kv, =, hash from their slots"
           :task (chez "--script" "test/chez/recfast-test.ss")}

  recordinline {:doc "Record predicates, accessors and constructors are open-coded, same semantics"
                :task (chez "--script" "test/chez/record-inline-test.ss")}

  recordshadow {:doc "A top-level define may not silently rebind a define-record-type generated name"
                :depends [deps]
                :task (chez "--script" "host/chez/record-shadow-check.ss")}

  ;; Each of these was O(n) while the reference is O(1), and no value test can
  ;; see that.
  complexity {:doc "Operations that must not be linear (count, drop, rseq, sorted first) stay fast"
              :depends [testbin deps]
              :task (sh "JOLT_NO_USER_DEPS=1 target/release/jolt run test/complexity_test.clj")}

  ;; Chez's single-attempt CAS fails spuriously on Apple silicon, which lost a
  ;; connection once in ~1400.
  cas {:doc "compare-and-swap is strong, with no spurious refusals on AArch64"
       :task (chez "--script" "test/chez/cas-test.ss")}

  s64wrap {:doc "unchecked-add, -subtract and -multiply wrap at 64 bits past the fixnum range"
           :depends [deps]
           :task (chez "--script" "test/chez/s64-wrap-test.ss")}

  flonumprint {:doc "A double prints as Double.toString does, and the fast path beats the host path"
               :task (chez "--script" "test/chez/flonum-print-test.ss")}

  ;; The old upward probe faulted on a flonum at the start of a page and killed
  ;; MinGW scheme.exe (#1337).
  flonumdisp {:doc "The flonum payload probe reads nothing in front of the flonum"
              :task (chez "--script" "test/chez/flonum-disp-test.ss")}

  utf8decode {:doc "UTF-8 bytes decode as java.nio's decoder does, malformed input included"
              :task (chez "--script" "test/chez/utf8-decode-test.ss")}

  stateimage {:doc "State images: value-graph round trip via jolt.image and the fasl behavior"
              :depends [deps]
              :task (chez "--script" "test/chez/state-image-test.ss")}

  ;; A shim that cannot round-trip must be refused by class name, never written
  ;; silently wrong.
  imagecoverage {:doc "Every java.util collection shim round-trips via a state image or is refused"
                 :depends [deps]
                 :task (chez "--script" "test/chez/image-coverage-test.ss")}

  ;; --- Compiler: inference and optimization ------------------------------------

  infer {:doc "Type inference: diagnostic counts and collected calls and escapes"
         :depends [deps]
         :task (chez "--script" "host/chez/run-infer.ss")}

  inferscaling {:doc "The optimizing passes stay polynomial in nesting depth"
                :depends [deps]
                :task (chez "--script" "host/chez/run-infer-scaling.ss")}

  wp {:doc "Whole-program param-type fixpoint: record types flowing across fn boundaries"
      :depends [deps]
      :task (chez "--script" "host/chez/run-wp.ss")}

  numwp {:doc "Hintless double inference unboxes params that every caller passes as flonum"
         :depends [deps]
         :task (chez "--script" "host/chez/run-numwp.ss")}

  ;; Lets portable hint-free code reach the same emission as hinted code.
  fieldjoin {:doc "Whole-program record field-type inference joined across every constructor call"
             :depends [deps]
             :task (chez "--script" "host/chez/run-fieldjoin.ss")}

  fieldnum {:doc "A ^double record field reads back as a flonum, so arithmetic over it unboxes"
            :depends [deps]
            :task (chez "--script" "host/chez/run-fieldnum.ss")}

  fieldread {:doc "A keyword lookup on a known record reads its slot directly, same value"
             :depends [deps]
             :task (chez "--script" "host/chez/run-fieldread.ss")}

  contagion {:doc "Flonum contagion for :num record fields, only beside a proven :double operand"
             :depends [deps]
             :task (chez "--script" "host/chez/run-contagion.ss")}

  narrow {:doc "Nilable record types and flow-sensitive narrowing inside `if (some? x)`"
          :depends [deps]
          :task (chez "--script" "host/chez/run-narrow.ss")}

  protoret {:doc "A protocol method whose impls return one record type gets a monomorphic return"
            :depends [deps]
            :task (chez "--script" "host/chez/run-protoret.ss")}

  ;; Typing an accumulator from its initial value alone would wrongly fold nil?
  ;; or coerce a long.
  accfix {:doc "A reduce accumulator or loop binding is typed from its fixpoint, not its init"
          :task (chez "--script" "host/chez/run-accfix.ss")}

  ;; The extend-type epoch bump is what keeps a stale cache from serving the old
  ;; impl.
  pic {:doc "Protocol-dispatch inline cache: emission, megamorphic use, extend-type reset"
       :depends [deps]
       :task (chez "--script" "host/chez/run-pic.ss")}

  devirt {:doc "A monomorphic protocol call resolves its impl by record tag, matching dispatch"
          :depends [deps]
          :task (chez "--script" "host/chez/run-devirt.ss")}

  ;; ^:dynamic, ^:redef and nested defs must opt out or redefinition would stop
  ;; working.
  directlink {:doc "Direct-link emission binds app defs to Scheme bindings, skipping var-deref"
              :depends [deps]
              :task (chez "--script" "test/chez/directlink-test.ss")}

  directcall {:doc "Call shapes a direct-link build emits: seed vars, interop guards, unchecked"
              :task (chez "--script" "host/chez/run-directcall.ss")}

  linkedrace {:doc "A direct-linked call racing a redefinition of its callee on another thread"
              :depends [deps]
              :task (chez "--script" "test/chez/linked-call-race-test.ss")}

  inline {:doc "IR inlining of small single-arity defns, with ^double and ^long coercions kept"
          :depends [deps]
          :task (chez "--script" "test/chez/inline-test.ss")}

  inline-body {:doc "Inlined defrecord and deftype method bodies read fields by index, not jolt-get"
               :depends [deps]
               :task (chez "--script" "host/chez/run-inline-body.ss")}

  guardedinline {:doc "Guarded inlining in the open-world compile, falling back after a redefinition"
                 :depends [deps]
                 :task (chez "--script" "host/chez/run-guarded-inline.ss")}

  ;; Inlining rows skip on a stock Chez unless JOLT_REQUIRE_LOCKFREE_CHEZ=1 (set
  ;; in CI).
  toplevelinline {:doc "Inlining through a top-level definition made with sa-define-inlinable!"
                  :depends [deps]
                  :task (chez "--script" "test/chez/top-level-inline-test.ss")}

  numeric {:doc "^double and ^long hints lower arithmetic to fl/fx ops, unhinted stays generic"
           :depends [deps]
           :task (chez "--script" "test/chez/numeric-test.ss")}

  mathfl {:doc "java.lang.Math over proven flonums lowers to native Chez flonum ops"
          :depends [deps]
          :task (chez "--script" "host/chez/run-mathfl.ss")}

  flarr {:doc "aget on a ^doubles array lowers to an unboxed flvector-ref typed :double"
         :depends [deps]
         :task (chez "--script" "host/chez/run-flarr.ss")}

  ;; op-registry names a proc per kind but not its arity, and this pins the two
  ;; together.
  oparity {:doc "Every numeric fast-path op at each admitted arity agrees with the generic path"
           :depends [deps]
           :task (chez "--script" "test/chez/op-arity-test.ss")}

  recfold {:doc "What an optimizing compile emits for record constructors, record? and seq?"
           :task (chez "--script" "host/chez/run-recfold.ss")}

  mandelbrot-num {:doc "Mandelbrot hot loop compiles to flonum ops with no generic arithmetic"
                  :depends [deps]
                  :task (chez "--script" "host/chez/run-mandelbrot-num.ss")}

  ;; --- Compiler: emission and IR -----------------------------------------------

  ;; A macro-spliced var-deref has no :var node, so only the text scan roots its
  ;; target.
  dcerefs {:doc "Dead-code elimination roots a target by IR walk or by scanning emitted Scheme"
           :depends [deps]
           :task (chez "--script" "host/chez/run-dce-refs.ss")}

  fnform {:doc "Anonymous fns get unique letrec names and registered source forms"
          :depends [deps]
          :task (chez "--script" "test/chez/fnform-test.ss")}

  poolshape {:doc "A constant pool's scope nesting does not grow with the pool"
             :depends [deps]
             :task (chez "--script" "test/chez/pool-shape-test.ss")}

  ;; A native set!-extended after its def-var! leaves an unnamed procedure and
  ;; images silently break.
  coreproc {:doc "Every clojure.core fn is nameable in value position so images can write it"
            :depends [deps]
            :task (chez "--script" "test/chez/core-proc-name-test.ss")}

  defmetacells {:doc "A var named in a def's evaluated metadata is cell-cached"
                :depends [deps]
                :task (chez "--script" "host/chez/run-defmetacells.ss")}

  staticsite {:doc "Class and member sites are emitted with a per-site cache"
              :depends [deps]
              :task (chez "--script" "host/chez/run-staticsite.ss")}

  hostsite {:doc "A host-object method call site caches its resolution and sees later additions"
            :task (chez "--script" "test/chez/jhost-method-site-test.ss")}

  dispatchalloc {:doc "An unhinted method call allocates only its arg vector and at most one arg list"
                 :task (chez "--script" "test/chez/method-dispatch-alloc-test.ss")}

  unitcontext {:doc "Emit-session state is per compilation unit, so units stay isolated"
               :depends [deps]
               :task (chez "--script" "test/chez/unit-context-test.ss")}

  irvalidate {:doc "The IR schema validator (JOLT_IR_VALIDATE) reports no problems on real code"
              :depends [deps]
              :task (sh "sh host/chez/ir-validate-smoke.sh")}

  ;; The list of munge-renamed names is kept by hand and drifted before.
  emittedheads {:doc "Every head the back end emits is one munge-name renames a user local away from"
                :depends [deps]
                :task (sh "JOLT_NO_USER_DEPS=1 bin/jolt run host/chez/emitted-heads-check.clj")}

  ;; A per-form cost regression is linear but slow, and one shipped green through
  ;; the whole gate.
  compilescaling {:doc "Compiling a namespace stays linear in its source, and quoted forms stay cheap"
                  :depends [testbin]
                  :task (sh "JOLT_NO_USER_DEPS=1 target/release/jolt run test/compile_scaling_test.clj")}

  shakelocal {:doc "Shaken fixture apps match plain builds and drop dead defs, no examples repo"
              :depends [testbin deps]
              :task (sh "SHAKESMOKE_SCOPE=local JOLT_BIN=\"${JOLT_BIN:-target/release/jolt}\" sh host/chez/tree-shake-smoke.sh")}

  ;; Slow (two builds per app), so it is not in the default gate. Skips without
  ;; the examples repo.
  shakesmoke {:doc "Tree-shake soundness: example apps built plain and tree-shaken print the same"
              :depends [testbin deps]
              :task (sh "JOLT_BIN=\"${JOLT_BIN:-target/release/jolt}\" sh host/chez/tree-shake-smoke.sh")}

