  lazyscaling {:doc "Lazy realization takes no per-cell mutex, before or after a thread exists"
               :depends [testbin deps]
               :task (sh "JOLT_NO_USER_DEPS=1 target/release/jolt run test/lazyseq_mt_scaling_test.clj")}

