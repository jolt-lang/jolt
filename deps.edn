  ;; On Windows, sh is cmd.exe, so mkdir -p made a directory named -p and mv, rm,
  ;; test do not exist.
  shelloutcheck {:doc "jolt-core shells out only to git, and the runtime names no program to run"
                 :task (sh "sh host/chez/shellout-check.sh")}

  ;; --- Gambit ------------------------------------------------------------------

  ;; Always uses brew's gsi, never a bare gsi or gsc, which is Ghostscript here.
  gambitcheck {:doc "The Gambit adapter and shims verified on native gsi (skipped without Gambit)"
               :task (sh (gambit-env)
                         "if [ -x \"$GAMBIT_GSI\" ]; then \\
\"$GAMBIT_GSI\" host/gambit/gambitcheck.ss; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitcheck: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitcheck: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  gambitkernel {:doc "The full booted manifest on native gsi, driven through the real natives"
                :task (sh (gambit-env)
                          "if [ -x \"$GAMBIT_GSI\" ]; then \\
\"$GAMBIT_GSI\" host/gambit/kernel-test.ss; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitkernel: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitkernel: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  ;; The only gate running emitted code on gsi end to end, so it sits in ci.
  gambiteval {:doc "Real jolt source evaluated on gsi, rendered output pinned to Chez captures"
              :task (sh (gambit-env)
                        "if [ -x \"$GAMBIT_GSI\" ]; then \\
\"$GAMBIT_GSI\" host/gambit/eval-test.ss; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambiteval: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambiteval: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  ;; A web REPL once hung at boot for a week while every other gambit gate stayed
  ;; green.
  gambitboot {:doc "The full-profile boot comes up on gsi, which the js and gsi targets share"
              :task (if (tasks.gate/done? 'gambitboot)
                      (println "gambitboot: already run by the gate runner")
                      (sh (gambit-env)
                          "if [ -x \"$GAMBIT_GSI\" ]; then \\
$JOLT_CHEZ --script host/gambit/gen-boot.ss full; \\
out=$(cd host/gambit && \"$GAMBIT_GSI\" boot-probe.scm < /dev/null 2>&1); \\
case \"$out\" in \\
*BOOT-OK*) echo \"gambitboot: full-profile boot OK on gsi\";; \\
*) printf '%s\\n' \"$out\" | tail -20; echo \"gambitboot: FAILED — full-profile boot did not reach BOOT-OK\" >&2; exit 1;; \\
esac; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitboot: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitboot: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi"))}

  ;; Regenerate after every change to any of the four records files.
  gambitgen {:doc "Regenerate host/gambit/records-gambit.ss from the four host/chez records files"
             :task (chez "--script" "host/gambit/gen-records.ss")}

  ;; Runs on Chez alone, so it gates in CI whether or not Gambit is installed.
  gambitgencheck {:doc "host/gambit/records-gambit.ss is current with its generator"
                  :task (sh "out=$(mktemp -d)/records-gambit.ss; \\
GEN_RECORDS_OUT=\"$out\" $JOLT_CHEZ --script host/gambit/gen-records.ss >/dev/null; \\
if diff -q \"$out\" host/gambit/records-gambit.ss >/dev/null; then \\
echo \"gambitgencheck: records-gambit.ss is current with the records files\"; \\
else \\
echo \"gambitgencheck: host/gambit/records-gambit.ss is STALE — run 'make gambitgen'\" >&2; \\
diff -u host/gambit/records-gambit.ss \"$out\" | head -40 >&2; \\
rm -f \"$out\"; exit 1; \\
fi; \\
rm -f \"$out\"")}

  gambitseed {:doc "Cross-mint the Gambit seed from the Chez seed, refusing Chez-only spellings"
              :task (chez "--script" "host/gambit/gen-seed.ss")}

  ;; Fails if the Chez seed was re-minted without make gambitseed.
  gambitseedcheck {:doc "Re-minting the Gambit seed matches host/gambit/seed/ byte for byte"
                   :task (sh "out=$(mktemp -d); \\
if ! GEN_SEED_OUT_DIR=\"$out\" $JOLT_CHEZ --script host/gambit/gen-seed.ss > \"$out/mint.log\" 2>&1; then \\
tail -20 \"$out/mint.log\" >&2; \\
echo \"gambitseedcheck: gen-seed.ss FAILED — the gambit seed cannot be minted from current sources\" >&2; \\
rm -rf \"$out\"; exit 1; \\
fi; \\
if diff -q \"$out/prelude.ss\" host/gambit/seed/prelude.ss >/dev/null \\
&& diff -q \"$out/image.ss\" host/gambit/seed/image.ss >/dev/null; then \\
echo \"gambitseedcheck: gambit seed is current with the sources\"; \\
rm -rf \"$out\"; \\
else \\
echo \"gambitseedcheck: host/gambit/seed is STALE — run 'make gambitseed'\" >&2; \\
rm -rf \"$out\"; exit 1; \\
fi")}

  ;; The boot splices most of host/chez, so a Chez-side name change can leave a
  ;; hole here.
  gambitunbound {:doc "Every Scheme global the full-profile boot references is defined"
                 :depends [gambitboot]
                 :task (sh (gambit-env)
                           "if [ -x \"$GAMBIT_GSC\" ]; then \\
JOLT_GSC=\"$GAMBIT_GSC\" sh host/gambit/unbound-check.sh; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitunbound: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitunbound: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  gambitunbound-regen {:doc "Regenerate the expected list gambitunbound compares against"
                       :task (sh (gambit-env)
                                 "JOLT_GSC=\"$GAMBIT_GSC\" sh host/gambit/unbound-check.sh --regen")}

  gambitvars {:doc "Every var cell the Gambit boot interned is bound"
              :task (sh (gambit-env)
                        "if [ -x \"$GAMBIT_GSI\" ]; then \\
\"$GAMBIT_GSI\" host/gambit/unbound-vars.ss < /dev/null; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitvars: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitvars: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  gambitvars-regen {:doc "Regenerate the expected list gambitvars compares against"
                    :task (sh (gambit-env)
                              "JOLT_GAMBITVARS=regen \"$GAMBIT_GSI\" host/gambit/unbound-vars.ss < /dev/null")}

  ;; Nothing else says which of the seed's statics the Gambit target carries.
  gambitstatics {:doc "Every Class member call and constructor the seed emits resolves on Gambit"
                 :task (sh (gambit-env)
                           "if [ -x \"$GAMBIT_GSI\" ]; then \\
JOLT_GSI=\"$GAMBIT_GSI\" sh host/gambit/seed-statics.sh; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitstatics: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitstatics: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  gambitstatics-regen {:doc "Regenerate the expected list gambitstatics compares against"
                       :task (sh (gambit-env)
                                 "JOLT_GSI=\"$GAMBIT_GSI\" sh host/gambit/seed-statics.sh --regen")}

  ;; Eval'd code on the Gambit boot cannot see unit macros. Grep only, so it runs
  ;; in CI.
  gambittwins {:doc "Every macro the emitter can call has a same-named function in eval-fns.ss"
               :task (sh "sh host/gambit/eval-twins-check.sh")}

  ;; Ordered after gambitboot, since gen-boot.ss rewrites boot-active.ss and -j
  ;; would race.
  gambitprofile {:doc "Build profiles: the reduced repl profile works and excluded features say so"
                 :depends [gambitboot]
                 :task (sh (gambit-env)
                           "if [ -x \"$GAMBIT_GSI\" ]; then \\
$JOLT_CHEZ --script host/gambit/gen-boot.ss repl; \\
\"$GAMBIT_GSI\" host/gambit/profile-test.ss; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitprofile: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitprofile: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  gambitweb {:doc "Build the Gambit JS target ($GAMBIT_WEB_OUT, profile $PROFILE)"
             :task (sh (gambit-env)
                       "if [ -x \"$GAMBIT_GSC\" ]; then \\
$JOLT_CHEZ --script host/gambit/gen-boot.ss ${PROFILE:-full}; \\
mkdir -p \"$(dirname \"${GAMBIT_WEB_OUT:-target/gambit/jolt-web.js}\")\"; \\
out=\"$(cd \"$(dirname \"${GAMBIT_WEB_OUT:-target/gambit/jolt-web.js}\")\" && pwd)/$(basename \"${GAMBIT_WEB_OUT:-target/gambit/jolt-web.js}\")\"; \\
(cd host/gambit && \"$GAMBIT_GSC\" -target js -exe -o \"$out\" repl-main.ss); \\
echo \"gambitweb: ${GAMBIT_WEB_OUT:-target/gambit/jolt-web.js} ($(wc -c < \"$out\" | tr -d ' ') bytes,\\
$(gzip -c \"$out\" | wc -c | tr -d ' ') gzipped)\"; \\
else \\
if [ -n \"$JOLT_REQUIRE_GAMBIT\" ]; then echo \"gambitweb: no gambit at $GAMBIT_PREFIX/bin and JOLT_REQUIRE_GAMBIT is set\" >&2; exit 1; else echo \"gambitweb: gambit-scheme not installed (GAMBIT_PREFIX=$GAMBIT_PREFIX) — skipped\"; fi; \\
fi")}

  ;; These two pairs were kept in step by hand with nothing watching.
  mirrordrift {:doc "Hand-mirrored host file pairs (rt.ss, rt-core.ss, two hasheq.ss) do not drift"
               :depends [deps]
               :task (sh "sh host/chez/mirror-drift-check.sh")}

  mirrordrift-regen {:doc "Regenerate the baseline mirrordrift compares the mirrored host files against"
                     :depends [deps]
                     :task (sh "sh host/chez/mirror-drift-check.sh --regen")}

  ;; --- Repository hygiene ------------------------------------------------------

  ;; A session-link trailer is a private URL, and commit messages describe only
  ;; the change.
  attributioncheck {:doc "No AI-assistant attribution in the commits this tree adds to origin/main"
                    :task (sh "sh tools/attributioncheck.sh")}

  noticecheck {:doc "NOTICE names every embedded third-party work, with its license in licenses/"
               :task (sh "sh tools/noticecheck.sh")}

  ;; The section must end inside the budget, or readers never see what the java.*
  ;; shims are not.
  readmecheck {:doc "README's 'Differences from Clojure' ends within its byte ceiling, links exist"
               :task (sh "end=$(LC_ALL=C awk '/^## Differences from Clojure$/ {seen=1; next} \\
seen && /^## / {print off; found=1; exit} \\
{off += length($0) + 1} \\
END {if (!found) print (seen ? off : -1)}' README.md); \\
if [ \"$end\" -lt 0 ]; then \\
echo \"readmecheck: README.md has no '## Differences from Clojure' section\" >&2; exit 1; fi; \\
if [ \"$end\" -gt 12000 ]; then \\
echo \"readmecheck: 'Differences from Clojure' ends at byte $end, past the 12000 ceiling.\" >&2; \\
echo \"  A truncating fetch would cut it. Move it earlier or shorten what precedes it;\" >&2; \\
echo \"  contributor-facing prose belongs in CONTRIBUTING.md.\" >&2; exit 1; fi; \\
for f in CONTRIBUTING.md llms.txt; do \\
[ -f \"$f\" ] || { echo \"readmecheck: $f is missing (README links to it)\" >&2; exit 1; }; \\
done; \\
echo \"readmecheck: divergences end at byte $end (ceiling 12000)\"")}

  ;; Its own CI job, because the gate list runs where clj-kondo is not installed.
  kondocheck {:doc "clj-kondo over what jolt ships, with tools/clj-kondo-ci.edn"
              :task (sh "clj-kondo --cache false --config tools/clj-kondo-ci.edn --fail-level error \\
--lint stdlib compatibility jolt-core/jolt tools")}

  ;; Both files are hand-written while both exist, so they can stop agreeing.
  taskparity {:doc "The Makefile and deps.edn name the same targets and gates, every task grouped"
              :task (do (load-file "tools/tasks/parity.clj")
                        (tasks.parity/main! tasks.env/root))}}}
