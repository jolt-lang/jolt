  ;; mono-nanos is NOT the epoch clock — it counts from an arbitrary origin, so a
  ;; wall-clock step can't skew a duration. Guards against it being aliased to wall.
  {:suite "telemetry" :expr "(< (jolt.host/mono-nanos) (jolt.host/wall-nanos))" :expected "true"}
  ;; finer than millisecond granularity: 200 back-to-back reads can't all land on a
