  ;; Stage B — nio Files consolidation: members from 6 original blocks (files-statics,
  ;; files-nofollow-time, files-throwing-setters, files-create+move, files-final, files-nofollow)
  ;; all resolve through one consolidated registration.
  {:suite "nio-files" :expr
   "(do (let [d (Files/createTempDirectory \"jnf\" (into-array java.nio.file.attribute.FileAttribute []))
             f (Paths/get \"f\" (into-array String []))
             g (Paths/get \"g\" (into-array String []))
             fp (.resolve d f)
             gp (.resolve d g)]
         (Files/createFile fp (into-array java.nio.file.attribute.FileAttribute []))
         (Files/write fp (.getBytes \"hello\") (into-array java.nio.file.OpenOption []))
         (let [sz (Files/size fp)                                  ;; files-statics (size)
               ex (Files/exists fp (into-array java.nio.file.LinkOption []))  ;; files-nofollow (exists)
               _  (Files/setLastModifiedTime fp (java.nio.file.attribute.FileTime/fromMillis 1000))  ;; files-throwing-setters
               mt (.toMillis (Files/getLastModifiedTime fp (into-array java.nio.file.LinkOption [])))  ;; files-nofollow-time
               _  (Files/copy fp gp (into-array java.nio.file.CopyOption []))  ;; files-final (copy)
               cpsz (Files/size gp)                               ;; copy preserved size
               gp2 (.resolve d (Paths/get \"h\" (into-array String [])))
               _  (Files/move gp gp2 (into-array java.nio.file.CopyOption []))  ;; files-create+move (move)
               mvsz (Files/size gp2)                              ;; move preserved size
               _  (Files/delete fp)
               _  (Files/delete gp2)
               _  (Files/deleteIfExists d)]
           [sz ex mt cpsz mvsz (pos? sz)])))"
   :expected "[5 true 1000 5 5 true]"}
  ;; Temp entries are named the JDK's way, prefix + an unsigned 64-bit random
  ;; number + suffix, and created exclusively with a retry on a taken name. The
  ;; millis-and-counter name collided across processes started in the same
  ;; millisecond, and the loser failed (jolt-lang/jolt#1528).
  {:suite "nio-create" :label "createTemp* names are prefix + random digits + suffix" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) b (java.nio.file.Files/createTempDirectory \"jtn\" fa) d (java.nio.file.Files/createTempDirectory b \"race-\" fa) f (java.nio.file.Files/createTempFile b \"tf-\" \".txt\" fa) j (java.io.File/createTempFile \"jft\" \".tmp\" (.toFile b)) num? (fn [s re] (boolean (re-matches re s)))] (try [(num? (str (.getFileName d)) #\"race-[0-9]{1,20}\") (num? (str (.getFileName f)) #\"tf-[0-9]{1,20}[.]txt\") (num? (.getName j) #\"jft[0-9]{1,20}[.]tmp\")] (finally (.delete j) (java.nio.file.Files/delete f) (java.nio.file.Files/delete d) (java.nio.file.Files/delete b))))" :expected "[true true true]"}
  ;; createDirectory's class comes from mkdir's own errno, as the JDK's does
  ;; (jolt-lang/jolt#1529); the JVM answers each of these the same.
  {:suite "nio-create" :label "createDirectory names each failure the JDK's way" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jcd\" fa) p (fn [s] (.resolve d s)) nm (fn [f] (try (f) :made (catch Exception e [(last (clojure.string/split (.getName (class e)) #\"\\.\")) (clojure.string/replace (.getMessage e) (str d) \"D\")])))] (spit (str (p \"plain\")) \"z\") (let [r [(nm #(java.nio.file.Files/createDirectory (p \"x\") fa)) (nm #(java.nio.file.Files/createDirectory (p \"x\") fa)) (nm #(java.nio.file.Files/createDirectory (p \"no/y\") fa)) (nm #(java.nio.file.Files/createDirectory (p \"plain/y\") fa)) (nm #(java.nio.file.Files/createDirectory (p \"plain\") fa))]] (java.nio.file.Files/delete (p \"x\")) (java.nio.file.Files/delete (p \"plain\")) (java.nio.file.Files/delete d) r))" :expected "[:made [\"FileAlreadyExistsException\" \"D/x\"] [\"NoSuchFileException\" \"D/no/y\"] [\"FileSystemException\" \"D/plain/y: Not a directory\"] [\"FileAlreadyExistsException\" \"D/plain\"]]"}
  ;; EACCES is AccessDenied, as translateToIOException names it; the untyped
  ;; mkdir failure rendered it a plain FileSystemException "Permission denied"
  {:suite "nio-create" :label "createDirectory in a read-only directory is AccessDenied" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jca\" fa) ro (.resolve d \"ro\") perms #(java.nio.file.Files/setPosixFilePermissions ro (java.nio.file.attribute.PosixFilePermissions/fromString %))] (java.nio.file.Files/createDirectory ro fa) (perms \"r-xr-xr-x\") (let [r (try (java.nio.file.Files/createDirectory (.resolve ro \"x\") fa) :made (catch Exception e [(.getSimpleName (class e)) (clojure.string/replace (.getMessage e) (str d) \"D\")]))] (perms \"rwxr-xr-x\") (java.nio.file.Files/delete ro) (java.nio.file.Files/delete d) r))" :expected "[\"AccessDeniedException\" \"D/ro/x\"]"}
  ;; the race itself: a directory made between a stat and the mkdir used to come
  ;; back a plain FileSystemException, so a createDirectory lock misread losing
  {:suite "nio-create" :label "createDirectory racing threads: every loser is FileAlreadyExists" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jcr\" fa) n 200 run (fn [] (frequencies (for [i (range n)] (try (java.nio.file.Files/createDirectory (.resolve d (str \"d\" i)) fa) :created (catch java.nio.file.FileAlreadyExistsException _ :exists) (catch Exception e (.getName (class e))))))) r (apply merge-with + (map deref (doall (repeatedly 4 #(future (run))))))] (doseq [i (range n)] (java.nio.file.Files/delete (.resolve d (str \"d\" i)))) (java.nio.file.Files/delete d) [(:created r) (:exists r) (count r)])" :expected "[200 600 2]"}
  ;; The JDK's argument rules for createTemp*: a nil suffix is .tmp, a prefix or
  ;; suffix naming a parent is refused for Files, and File keeps the last segment.
  {:suite "nio-create" :label "createTemp* prefix and suffix rules" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) b (java.nio.file.Files/createTempDirectory \"jtp\" fa) cls (fn [f] (try (f) :made (catch Exception e [(.getName (class e)) (.getMessage e)]))) t (java.nio.file.Files/createTempFile b \"t\" nil fa) j (java.io.File/createTempFile \"abc/def\" \".x\" (.toFile b)) r [(boolean (re-matches #\"t[0-9]+[.]tmp\" (str (.getFileName t)))) (boolean (re-matches #\"def[0-9]+[.]x\" (.getName j))) (cls #(java.nio.file.Files/createTempDirectory b \"../x\" fa)) (cls #(java.nio.file.Files/createTempFile b \"a/b\" \".x\" fa)) (cls #(java.nio.file.Files/createTempFile b \"a\" \"/b\" fa))]] (.delete j) (java.nio.file.Files/delete t) (java.nio.file.Files/delete b) r)" :expected "[true true [\"java.lang.IllegalArgumentException\" \"Invalid prefix or suffix\"] [\"java.lang.IllegalArgumentException\" \"Invalid prefix or suffix\"] [\"java.lang.IllegalArgumentException\" \"Invalid prefix or suffix\"]]"}
  ;; The class of a failed temp create comes from the create's errno, as on the JDK.
  {:suite "nio-create" :label "createTemp* names each failure the JDK's way" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) b (java.nio.file.Files/createTempDirectory \"jtf\" fa) f (.resolve b \"plain\") _ (spit (str f) \"z\") nm (fn [g] (try (g) :made (catch Exception e [(.getName (class e)) (clojure.string/replace (clojure.string/replace (.getMessage e) (str b) \"B\") #\"[0-9]{3,}\" \"N\")]))) r [(nm #(java.nio.file.Files/createTempFile (.resolve b \"no\") \"a\" \".x\" fa)) (nm #(java.nio.file.Files/createTempDirectory (.resolve b \"no\") \"a\" fa)) (nm #(java.nio.file.Files/createTempFile f \"a\" \".x\" fa)) (nm #(java.nio.file.Files/createTempDirectory f \"a\" fa)) (nm #(java.io.File/createTempFile \"abc\" \".x\" (.toFile (.resolve b \"no\")))) (nm #(java.io.File/createTempFile \"abc\" \".x\" (.toFile f)))]] (java.nio.file.Files/delete f) (java.nio.file.Files/delete b) r)" :expected "[[\"java.nio.file.NoSuchFileException\" \"B/no/aN.x\"] [\"java.nio.file.NoSuchFileException\" \"B/no/aN\"] [\"java.nio.file.FileSystemException\" \"B/plain/aN.x: Not a directory\"] [\"java.nio.file.FileSystemException\" \"B/plain/aN: Not a directory\"] [\"java.io.IOException\" \"No such file or directory\"] [\"java.io.IOException\" \"Not a directory\"]]"}
  ;; A permissions attribute goes in the create call. r-------- survives any umask.
  {:suite "nio-create" :label "createTemp* and create* honor a permissions attribute" :expr "(let [none (into-array java.nio.file.attribute.FileAttribute []) as (fn [s] (into-array java.nio.file.attribute.FileAttribute [(java.nio.file.attribute.PosixFilePermissions/asFileAttribute (java.nio.file.attribute.PosixFilePermissions/fromString s))])) b (java.nio.file.Files/createTempDirectory \"jtm\" none) perm (fn [p] (java.nio.file.attribute.PosixFilePermissions/toString (java.nio.file.Files/getPosixFilePermissions p (into-array java.nio.file.LinkOption [])))) a (java.nio.file.Files/createTempFile b \"a\" \".x\" (as \"r--------\")) c (java.nio.file.Files/createFile (.resolve b \"c\") (as \"r--------\")) d (java.nio.file.Files/createTempDirectory b \"d\" (as \"r-x------\")) e (java.nio.file.Files/createDirectory (.resolve b \"e\") (as \"r-x------\")) r [(perm a) (perm c) (perm d) (perm e)]] (doseq [p [a c d e b]] (java.nio.file.Files/delete p)) r)" :expected "[\"r--------\" \"r--------\" \"r-x------\" \"r-x------\"]"}
  {:suite "nio-create", :label "createDirectories raises what the first failing mkdir raised, as the JDK names it", :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jcds\" fa) p (fn [s] (.resolve d s)) ro (p \"ro\") perms #(java.nio.file.Files/setPosixFilePermissions ro (java.nio.file.attribute.PosixFilePermissions/fromString %)) sh (fn [s] (when s (clojure.string/replace (str s) (str d) \"D\"))) nm (fn [s] (try (sh (java.nio.file.Files/createDirectories (p s) fa)) (catch java.nio.file.FileSystemException e [(.getSimpleName (class e)) (sh (.getMessage e)) (sh (.getFile e)) (.getReason e)])))] (java.nio.file.Files/createDirectory ro fa) (perms \"r-xr-xr-x\") (spit (str (p \"plain\")) \"z\") (java.nio.file.Files/createSymbolicLink (p \"dang\") (p \"nowhere\") fa) (let [r [(nm \"ro/a/b\") (nm \"ro/a\") (nm \"ro\") (nm \"plain/x\") (nm \"plain/x/y\") (nm \"plain\") (nm \"dang/q\") (nm \"dang\") (nm \"ok/a/b\") (nm \"ok/a/b\") (nm \"ok/a\") (java.nio.file.Files/isDirectory (p \"ok/a/b\") (into-array java.nio.file.LinkOption [])) (.exists (.toFile (p \"ro/a\")))]] (perms \"rwxr-xr-x\") (doseq [s [\"ok/a/b\" \"ok/a\" \"ok\" \"ro\" \"plain\" \"dang\"]] (java.nio.file.Files/deleteIfExists (p s))) (java.nio.file.Files/delete d) r))", :expected "[[\"AccessDeniedException\" \"D/ro/a\" \"D/ro/a\" nil] [\"AccessDeniedException\" \"D/ro/a\" \"D/ro/a\" nil] \"D/ro\" [\"FileSystemException\" \"D/plain/x: Not a directory\" \"D/plain/x\" \"Not a directory\"] [\"FileSystemException\" \"D/plain/x: Not a directory\" \"D/plain/x\" \"Not a directory\"] [\"FileAlreadyExistsException\" \"D/plain\" \"D/plain\" nil] [\"FileAlreadyExistsException\" \"D/dang\" \"D/dang\" nil] [\"FileAlreadyExistsException\" \"D/dang\" \"D/dang\" nil] \"D/ok/a/b\" \"D/ok/a/b\" \"D/ok/a\" true false]"}
  ;; delete reads errno from its own unlink: a lost race is NoSuchFile, never whatever
  ;; else ran on the thread between the call and the read. Not a count of 200: APFS
  ;; lets two racing unlinks of one name both answer 0, in C and on the JVM too.
  {:suite "nio-create" :label "delete racing threads: every loser is NoSuchFile" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jdr\" fa) n 200 _ (doseq [i (range n)] (java.nio.file.Files/createFile (.resolve d (str \"f\" i)) fa)) run (fn [] (frequencies (for [i (range n)] (try (java.nio.file.Files/delete (.resolve d (str \"f\" i))) :deleted (catch java.nio.file.NoSuchFileException _ :gone) (catch Exception e (.getName (class e))))))) r (apply merge-with + (map deref (doall (repeatedly 4 #(future (run))))))] (java.nio.file.Files/delete d) [(>= (:deleted r) n) (every? #{:deleted :gone} (keys r))])" :expected "[true true]"}
  ;; ATOMIC_MOVE is one rename(2), as UnixCopyFile.move does: no existence
  ;; checks, REPLACE_EXISTING ignored, and failures named from errno with both
  ;; paths. Every answer here is JVM Clojure 1.12.3's (jolt-lang/jolt#1531).
  {:suite "buffered-mark" :label "marks over a stream that cannot seek" :expr "(do (import (quote [java.io BufferedInputStream ByteArrayInputStream])) (let [closed (atom nil) src (fn [n] (let [d (ByteArrayInputStream. (byte-array (map (fn [i] (unchecked-byte (mod i 100))) (range n))))] (proxy [java.io.InputStream] [] (read ([] (.read d)) ([a o l] (.read d a o l))) (available [] (.available d)) (close [] (reset! closed :closed) nil)))) rd (fn [b n] (vec (repeatedly n #(.read b)))) buffered (fn [n] (BufferedInputStream. (src n))) o (fn [f] (try (f) (catch java.io.IOException e (ex-message e))))] (let [b (buffered 5)] (.mark b 8) (let [x (rd b 2)] (.reset b) [(.markSupported b) x (rd b 3) (.read b)]))))" :expected "[true [0 1] [0 1 2] 3]"}
  {:suite "buffered-mark" :label "resets again, and after end of stream" :expr "(do (import (quote [java.io BufferedInputStream ByteArrayInputStream])) (let [closed (atom nil) src (fn [n] (let [d (ByteArrayInputStream. (byte-array (map (fn [i] (unchecked-byte (mod i 100))) (range n))))] (proxy [java.io.InputStream] [] (read ([] (.read d)) ([a o l] (.read d a o l))) (available [] (.available d)) (close [] (reset! closed :closed) nil)))) rd (fn [b n] (vec (repeatedly n #(.read b)))) buffered (fn [n] (BufferedInputStream. (src n))) o (fn [f] (try (f) (catch java.io.IOException e (ex-message e))))] (let [b (buffered 5)] (.mark b 8) (rd b 6) (.reset b) [(rd b 2) (do (.reset b) (rd b 1))])))" :expected "[[0 1] [0]]"}
