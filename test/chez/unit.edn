  {:suite "io" :label "split-paths reads the platform separator" :expr "(do (require (quote [babashka.fs :as fs])) (mapv str (fs/split-paths (str \"/a\" (System/getProperty \"path.separator\") \"/b\"))))" :expected "[\"/a\" \"/b\"]"}
  ;; A Path's ROOT is the prefix that is not a segment. The shim had a POSIX-only
  ;; one, so on Windows a drive path was a relative path whose first segment was
  ;; "C:" — fs/absolute? false, getRoot nil, getParent off the drive letter
  ;; (#1074). These rows are the POSIX half; win-platform-test.ss pins both.
  {:suite "io" :label "a Path's root, parent and absoluteness" :expr "(do (require (quote [babashka.fs :as fs])) (let [p (fs/path \"/a/b\")] [(fs/absolute? p) (str (.getRoot p)) (str (fs/parent p)) (.getNameCount p)]))" :expected "[true \"/\" \"/a\" 2]"}
  {:suite "io" :label "the parent of a root is nil" :expr "(do (require (quote [babashka.fs :as fs])) [(fs/parent (fs/path \"/\")) (.getRoot (fs/path \"a/b\")) (fs/absolute? (fs/path \"a/b\"))])" :expected "[nil nil false]"}
