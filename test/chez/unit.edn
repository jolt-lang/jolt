  ;; Extension points: core declares a point with a TOTAL default, a library
  ;; registers a possibly-partial refinement at a key. Lookup is (merge default
  ;; provider), so a provider only states what differs. :fallback :strict makes an
  ;; unregistered key an error rather than a silently-defaulted wrong answer —
  ;; the whole reason core can ship a point whose data it does not carry.
  ;; Each row declares its own point id so rows cannot interfere.
  {:suite "extension points" :expr "(do (jolt.host/register-extension-point! :xt-a {:key :string :root \"\" :fields {:sym :string :digits :long} :default {:sym \"x\" :digits 2} :fallback :strict}) (let [m (jolt.host/extension-value :xt-a \"\")] [(:sym m) (:digits m)]))" :expected "[\"x\" 2]"}
