  {:suite "vars / unbound" :expr "(do (declare uv-b) (pr-str (var-get (var uv-b))))" :expected "\"#object[clojure.lang.Var$Unbound 0 \\\"Unbound: #'user/uv-b\\\"]\""}
  {:suite "vars / unbound" :expr "(do (declare uv-c) (pr-str (deref (var uv-c))))" :expected "\"#object[clojure.lang.Var$Unbound 0 \\\"Unbound: #'user/uv-c\\\"]\""}
  {:suite "vars / unbound" :expr "(do (declare uv-d) (bound? (var uv-d)))" :expected "false"}
  {:suite "vars / unbound" :expr "(do (declare uv-e) (identical? uv-e (var-get (var uv-e))))" :expected "true"}
  {:suite "vars / unbound" :expr "(do (declare uv-f) (str uv-f))" :expected "\"Unbound: #'user/uv-f\""}
   {:suite "vars / unbound" :expr "(do (declare uv-late-undef-xyz) (pr-str uv-late-undef-xyz))" :expected "\"#object[clojure.lang.Var$Unbound 0 \\\"Unbound: #'user/uv-late-undef-xyz\\\"]\""}
  {:suite "vars / unbound" :expr "(do (declare ^:dynamic uv-g) (binding [uv-g 42] (deref (var uv-g))))" :expected "42"}
  ;; seq error semantics that guard the per-site unsafe-op work: a nil count
  ;; routes through a checked fx comparison in the take fast path, which must
  ;; keep raising. (Host-specific: real Clojure returns nil here, so this stays
  ;; out of the JVM-certified corpus.)
  {:suite "seq error semantics" :expr "(take nil [1 2 3])" :expected :throws}
  ;; sets are always hash-ordered (JVM PersistentHashSet behavior)
  {:suite "sets" :expr "(seq #{1 \"three\" :2})" :expected "(1 \"three\" :2)"}
  {:suite "sets" :expr "(seq (conj #{} :a :b :c))" :expected "(:c :b :a)"}
  ;; #error form must be readable: strings inside the map are quoted.
  ;; Neither JVM nor Jolt can roundtrip #error via edn/read-string (no reader
  ;; function for tag error), so this pins the pr-str output shape directly.
  {:suite "ex-info #error readable" :expr "(pr-str (ex-info \"boom\" {:a 1}))" :expected "\"#error {\\n :cause \\\"boom\\\"\\n :data {:a 1}\\n :via [ {:type clojure.lang.ExceptionInfo :message \\\"boom\\\" :data {:a 1} :at nil}]\\n :trace []}\""}
  {:suite "proxy over an interface" :expr "(.call (proxy [java.util.concurrent.Callable] [] (call [] (* 6 7))))" :expected "42"}
  ;; a proxy method with SEVERAL arities is written (name ([args] body) ([args] body)),
  ;; the shape proxy accepts alongside the flat (name [args] body). Only the flat one
  ;; was handled, so the grouped one handed reify a body expression where an arglist
  ;; belonged and died in destructuring.
  {:suite "proxy over an interface" :expr "(let [p (proxy [java.io.InputStream] [] (read ([] 65) ([b off len] 7)))] [(.read p) (.read p (byte-array 4) 0 4)])" :expected "[65 7]"}
  {:suite "proxy over an interface" :expr "(let [p (proxy [java.io.InputStream] [] (read ([] 9)) (available ([] 3)))] [(.read p) (.available p)])" :expected "[9 3]"}
  ;; a top-level form other than a def compiles as the fn user$evalN, which names
  ;; the reify inside it (clojure -M -e prints class user$eval1$reify__135)
  {:suite "reify class" :expr "(boolean (re-matches #\"class user\\$eval\\d+\\$reify__\\d+\" (str (class (reify java.lang.Runnable (run [_] nil))))))" :expected "true"}
  {:suite "promise class" :expr "(str (class (promise)))" :expected "\"class clojure.core$promise$reify__0\""}
  {:suite "future class" :expr "(str (class (future 1)))" :expected "\"class clojure.core$future_call$reify__0\""}
  ;; two same-named records in different namespaces: suffix match has >1
  ;; candidate — inline-impl-receiver-type must return nil (no seeding) so
  ;; the protocol method body uses generic field access, not the wrong
  ;; jrec-field-at index from the wrong record
  {:suite "record resolution / two ns same record name" :expr "(do (ns unit.rr.a) (defprotocol P1 (rr-foo [_])) (defrecord Circle [x y] P1 (rr-foo [this] [(:x this) (:y this)])) (ns unit.rr.b) (defrecord Circle [a b c]) (ns unit.rr.a) (rr-foo (->Circle 10 20)))" :expected "[10 20]"}
  ;; user fn named register-method must not be confused with
  ;; clojure.core/register-method — the ns check prevents the warp
  {:suite "register-method user fn" :expr "(do (defn register-method [a b c d] (str a b c)) (register-method \"X\" \"Y\" \"Z\" (fn [x] x)))" :expected "\"XYZ\""}

  ;; --- core.async alts -------------------------------------------------------
  ;; 1. alts-put vs alts-take rendezvous on unbuffered channel (the livelock fix)
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan) f (future (a/alts!! [[c :v]])) [v p] (a/alts!! [c (a/timeout 3000)])] (if (= p c) [v (first @f)] :timeout)))" :expected "[:v true]"}
  ;; 2. alts-take vs alts-put rendezvous (reversed: future takes, main puts)
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan) f (future (a/alts!! [c (a/timeout 3000)])) [v p] (a/alts!! [[c :v]])] (if (= p c) [v (first @f)] :timeout)))" :expected "[true :v]"}
  ;; 3. alts take vs blocking put (>!! in future)
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan) f (future (a/>!! c :x)) [v p] (a/alts!! [c (a/timeout 3000)])] (if (= p c) [v] :timeout)))" :expected "[:x]"}
  ;; 4. alts put vs blocking take (<!! in future)
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan) f (future (a/<!! c))] (Thread/sleep 50) (let [[v p] (a/alts!! [[c :y]])] (if (= p c) [v @f] :timeout))))" :expected "[true :y]"}
  ;; 5. :default returns immediately when nothing ready
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan)] (a/alts!! [c] :default :fallback)))" :expected "[:fallback :default]"}
  ;; 6. :priority true picks first ready port in declared order
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c1 (a/chan 1) c2 (a/chan 1)] (a/>!! c1 :a) (a/>!! c2 :b) (let [[v p] (a/alts!! [c1 c2] :priority true)] [v (if (= p c1) :c1 :c2)])))" :expected "[:a :c1]"}
  ;; 7. close! wakes parked alts take with nil
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan) f (future (a/alts!! [c (a/timeout 3000)]))] (Thread/sleep 50) (a/close! c) (let [[v p] @f] (and (nil? v) (= p c)))))" :expected "true"}
  ;; 8. close! wakes parked alts put with false
  ;; A put pending at close! stays until taken (jolt-5psco); one that loses the
  ;; race to close! fails. Either way the take and the put agree.
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan) f (future (a/alts!! [[c :v]]))] (Thread/sleep 50) (a/close! c) (let [t (a/<!! c) [v p] (deref f 1000 [:timeout nil])] [(contains? #{[:v true] [nil false]} [t v]) (= p c)])))" :expected "[true true]"}
  ;; 9. transducer chan works through alts put
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan 1 (map inc))] (a/alts!! [[c 1]]) (a/<!! c)))" :expected "2"}
  ;; Validate every put before any ready operation can mutate channel state.
  ;; JVM core.async throws while leaving :kept available; validating only as
  ;; each candidate is attempted consumes the earlier ready take first.
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [ready (a/chan 1) other (a/chan) _ (a/>!! ready :kept)] (try (a/alts!! [ready [other nil]] :priority true) [:no-throw (a/poll! ready)] (catch AssertionError _ [:threw (a/poll! ready)]))))" :expected "[:threw :kept]"}
  ;; 10. mult/tap smoke — proves the dataflow layer still works
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan) m (a/mult c) t1 (a/chan) t2 (a/chan)] (a/tap m t1) (a/tap m t2) (a/>!! c :x) [(a/<!! t1) (a/<!! t2)]))" :expected "[:x :x]"}
  ;; 11. alt! is the go-block macro over alts!: take clause. Buffered channel, so
  ;; nothing races a timeout.
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan 1)] (a/>!! c :v) (a/<!! (a/go (a/alt! c ([v] [:took v]) (a/timeout 3000) [:timeout])))))" :expected "[:took :v]"}
  ;; 12. alt! :default returns the default expr without parking when none is ready
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (a/<!! (a/go (a/alt! (a/chan) ([v] [:took v]) :default [:default]))))" :expected "[:default]"}
  ;; 13. alt! put clause writes through the channel
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan 1)] (a/<!! (a/go (a/alt! [[c :put]] [:wrote]))) (a/<!! c)))" :expected ":put"}
  ;; 14. alt!! is the blocking twin: completes outside a go block
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c (a/chan 1)] (a/>!! c :sync) (a/alt!! c ([v] [:took v]) (a/timeout 3000) [:timeout])))" :expected "[:took :sync]"}
  ;; 15. alt! :priority true takes the first ready port in declared order. Options
  ;; are keyword/value PAIRS in the clause list (do-alt partitions the whole list
  ;; in twos), so a ports vector still needs its own result expr.
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a]) (let [c1 (a/chan 1) c2 (a/chan 1)] (a/>!! c1 :a) (a/>!! c2 :b) (a/alt!! [c1 c2] ([v p] [v (if (= p c1) :c1 :c2)]) :priority true)))" :expected "[:a :c1]"}
  ;; 16. the protocols half: a ported library asks about ReadPort by its
  ;; interface and by satisfies?, and a non-channel must not answer either. The
  ;; interface is the dotted class name: ns/ReadPort names the protocol's var,
  ;; whose map instance? refuses as the JVM does (ClassCastException).
  {:suite "core.async alts" :expr "(do (require '[clojure.core.async :as a] '[clojure.core.async.impl.protocols]) (let [c (a/chan)] [(satisfies? clojure.core.async.impl.protocols/ReadPort c) (instance? clojure.core.async.impl.protocols.ReadPort c) (satisfies? clojure.core.async.impl.protocols/ReadPort 5) (instance? clojure.core.async.impl.protocols.ReadPort 5)]))" :expected "[true true false false]"}
  ;; clojure.test — instance? in is still reports correctly (instance? is a fn)
  {:suite "clojure.test" :expr "(do (require '[clojure.test :as t]) (t/reset-report!) (t/deftest t1 (t/is (instance? String 5))) (t/run-tests) [(t/n-pass) (t/n-fail)])" :expected "[0 1]"}
  ;; clojure.test — the report map carries :expected (the form as written) and
  ;; :actual (the form with its arguments evaluated, or the throwable), which is
  ;; the contract every custom reporter reads. They used to be folded into a
  ;; rendered :message, leaving a reporter (CIDER's test op, test.check,
  ;; matcher-combinators) with nothing to report.
  {:suite "clojure.test" :expr "(do (require '[clojure.test :as t]) (let [r (atom nil)] (binding [t/report (fn [m] (reset! r m))] (t/is (= 5 (+ 2 2)))) [(:type @r) (:expected @r) (:actual @r)]))" :expected "[:fail (= 5 (+ 2 2)) (not (= 5 4))]"}
  {:suite "clojure.test" :expr "(do (require '[clojure.test :as t]) (let [r (atom nil)] (binding [t/report (fn [m] (reset! r m))] (t/is (= 1 (throw (ex-info \"kaboom\" {}))))) [(:type @r) (:expected @r) (ex-message (:actual @r))]))" :expected "[:error (= 1 (throw (ex-info \"kaboom\" {}))) \"kaboom\"]"}
  {:suite "clojure.test" :expr "(do (require '[clojure.test :as t]) (let [r (atom nil)] (binding [t/report (fn [m] (reset! r m))] (t/is (instance? String 5))) [(:type @r) (:actual @r)]))" :expected "[:fail java.lang.Long]"}
  {:suite "clojure.test" :expr "(do (require '[clojure.test :as t]) (binding [t/report (fn [_])] [(t/is (= 1 1)) (t/is 42) (t/is (instance? String \"s\")) (t/is (nil? nil))]))" :expected "[true 42 true true]"}
  ;; clojure.test — report multimethod override fires on assertion outcomes
  {:suite "clojure.test" :expr "(do (require '[clojure.test :as t]) (t/reset-report!) (def rpt (atom false)) (defmethod t/report :fail [m] (reset! rpt true)) (t/deftest t2 (t/is (= 1 2))) (t/run-tests) @rpt)" :expected "true"}
  ;; clojure.test — interned (:test meta) tests run inside :once fixtures
  {:suite "clojure.test" :expr "(do (require '[clojure.test :as t]) (t/reset-report!) (def st (atom 0)) (t/use-fixtures :once (fn [f] (swap! st inc) (f))) (intern 'user 'itest (fn [] (t/is (= @st 1)))) (alter-meta! (var itest) assoc :test @(var itest)) (t/run-tests 'user) @st)" :expected "1"}
  {:suite "clojure.test / JVM output", :label "run-tests prints a Testing line per namespace, the FAIL block and the JVM's two summary lines, and returns the :summary map", :expr "(do (require '[clojure.test :as t]) (binding [*ns* (create-ns 'u18.a)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest ok (clojure.test/is true) (clojure.test/is (= 1 1))) (clojure.test/deftest bad (clojure.test/testing \"ctx\" (clojure.test/do-report {:type :fail :file \"a.clj\" :line 7 :message \"m\" :expected '(= 1 2) :actual '(not (= 1 2))})))))) (binding [*ns* (create-ns 'u18.b)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest b1 (clojure.test/is true))))) (let [r (atom nil) s (with-out-str (binding [t/*test-out* *out*] (reset! r (t/run-tests 'u18.a 'u18.b))))] [s @r]))", :expected "[\"\\nTesting u18.a\\n\\nFAIL in (bad) (a.clj:7)\\nctx\\nm\\nexpected: (= 1 2)\\n  actual: (not (= 1 2))\\n\\nTesting u18.b\\n\\nRan 3 tests containing 4 assertions.\\n1 failures, 0 errors.\\n\" {:test 3, :pass 3, :fail 1, :error 0, :type :summary}]"}
  {:suite "clojure.test / JVM output", :label "run-test-var brackets one var in Testing and the summary, and returns the :summary map", :expr "(do (require '[clojure.test :as t]) (binding [*ns* (create-ns 'u18.c)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest c1 (clojure.test/is true) (clojure.test/is false))))) (let [r (atom nil) s (with-out-str (binding [t/*test-out* *out*] (reset! r (t/run-test-var (resolve 'u18.c/c1)))))] [(subs s 0 15) (subs s (clojure.string/index-of s \"\\nRan\")) @r]))", :expected "[\"\\nTesting u18.c\\n\" \"\\nRan 1 tests containing 2 assertions.\\n1 failures, 0 errors.\\n\" {:test 1, :pass 1, :fail 1, :error 0, :type :summary}]"}
  {:suite "clojure.test / JVM output", :label "test-ns prints the Testing line and no summary, and returns the counters without :type", :expr "(do (require '[clojure.test :as t]) (binding [*ns* (create-ns 'u18.d)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest d1 (clojure.test/is true))))) (let [r (atom nil) s (with-out-str (binding [t/*test-out* *out*] (reset! r (t/test-ns 'u18.d))))] [s @r]))", :expected "[\"\\nTesting u18.d\\n\" {:test 1, :pass 1, :fail 0, :error 0}]"}
  {:suite "clojure.test / JVM output", :label "run-all-tests with a regex runs the matching namespaces and prints the summary", :expr "(do (require '[clojure.test :as t]) (binding [*ns* (create-ns 'u18.e)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest e1 (clojure.test/is true))))) (with-out-str (binding [t/*test-out* *out*] (t/run-all-tests #\"u18\\.e\"))))", :expected "\"\\nTesting u18.e\\n\\nRan 1 tests containing 1 assertions.\\n0 failures, 0 errors.\\n\""}
  {:suite "clojure.test / JVM output", :label "an uncaught throw prints the ERROR block with the throwable's class, message and ex-data, then the summary", :expr "(do (require '[clojure.test :as t] '[clojure.string :as str]) (binding [*ns* (create-ns 'u18.f)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest boom (throw (ex-info \"boom\" {:a 1})))))) (let [s (with-out-str (binding [t/*test-out* *out*] (t/run-tests 'u18.f))) ls (str/split-lines s)] [(take 3 ls) (str/starts-with? (nth ls 3) \"ERROR in (boom) (\") (take 4 (drop 4 ls)) (str/starts-with? (nth ls 8) \" at \") (take-last 3 ls)]))", :expected "[(\"\" \"Testing u18.f\" \"\") true (\"Uncaught exception, not in assertion.\" \"expected: nil\" \"  actual: clojure.lang.ExceptionInfo: boom\" \"{:a 1}\") true (\"\" \"Ran 1 tests containing 1 assertions.\" \"0 failures, 1 errors.\")]"}
  {:suite "clojure.test / JVM output", :label "the default report method prints a report map of a type it has no method for", :expr "(do (require '[clojure.test :as t]) (with-out-str (binding [t/*test-out* *out*] (t/do-report {:type :u18-custom :v 1}))))", :expected "\"{:type :u18-custom, :v 1}\\n\""}
  {:suite "clojure.test / JVM output", :label "a rebound report sees every event run-tests emits, in order", :expr "(do (require '[clojure.test :as t]) (binding [*ns* (create-ns 'u18.g)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest g1 (clojure.test/is true))))) (let [seen (atom [])] (binding [t/report (fn [m] (swap! seen conj (:type m)))] (t/run-tests 'u18.g)) @seen))", :expected "[:begin-test-ns :begin-test-var :pass :end-test-var :end-test-ns :summary]"}
  {:suite "clojure.test / JVM output", :label "*report-counters* is a fresh ref per namespace, read at :end-test-ns", :expr "(do (require '[clojure.test :as t]) (binding [*ns* (create-ns 'u18.h)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest h1 (clojure.test/is true) (clojure.test/is true))))) (binding [*ns* (create-ns 'u18.i)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest i1 (clojure.test/is true))))) (let [seen (atom []) orig t/report] (with-out-str (binding [t/*test-out* *out*] (binding [t/report (fn [m] (orig m) (when (= :end-test-ns (:type m)) (swap! seen conj @t/*report-counters*)))] (t/run-tests 'u18.h 'u18.i)))) @seen))", :expected "[{:test 1, :pass 2, :fail 0, :error 0} {:test 1, :pass 1, :fail 0, :error 0}]"}
  {:suite "clojure.test / JVM output", :label "try-expr reports an unexpected throw with the throwable itself as :actual", :expr "(do (require '[clojure.test :as t]) (let [a (atom nil)] (binding [t/report (fn [m] (reset! a m))] (t/try-expr nil (throw (ex-info \"x\" {})))) [(:type @a) (instance? Throwable (:actual @a)) (ex-message (:actual @a))]))", :expected "[:error true \"x\"]"}
  {:suite "clojure.test / JVM output", :label "ns-interns and ns-publics iterate in the JVM's hash order: an array map under 9 vars, a hash map past 8", :expr "(do (binding [*ns* (create-ns 'u18o)] (eval '(do (def zz 1) (def ok 2) (def errs 3) (def ^:private fails 4))) (create-ns 'u18p)) (binding [*ns* (the-ns 'u18p)] (eval '(do (def q 1) (def a 2) (def m 3) (def b 4) (def x 5) (def c 6) (def y 7) (def d 8) (def e 9)))) [(keys (ns-interns 'u18o)) (keys (ns-publics 'u18o)) (keys (ns-interns 'u18p)) (type (ns-interns 'u18o)) (type (ns-interns 'u18p))])", :expected "[(fails errs ok zz) (errs ok zz) (x a y q m e c b d) clojure.lang.PersistentArrayMap clojure.lang.PersistentHashMap]"}
  {:suite "clojure.test / JVM output", :label "run-tests runs a namespace's tests in (ns-interns ns) order, as test-all-vars does", :expr "(do (require '[clojure.test :as t]) (binding [*ns* (create-ns 'u18q)] (eval '(do (clojure.core/refer 'clojure.core) (clojure.test/deftest zz (clojure.test/do-report {:type :fail :file \"q.clj\" :line 1 :expected 1 :actual 2})) (clojure.test/deftest ok (clojure.test/do-report {:type :fail :file \"q.clj\" :line 2 :expected 1 :actual 2})) (clojure.test/deftest errs (clojure.test/do-report {:type :fail :file \"q.clj\" :line 3 :expected 1 :actual 2})) (clojure.test/deftest fails (clojure.test/do-report {:type :fail :file \"q.clj\" :line 4 :expected 1 :actual 2}))))) (with-out-str (binding [t/*test-out* *out*] (t/run-tests 'u18q))))", :expected "\"\\nTesting u18q\\n\\nFAIL in (fails) (q.clj:4)\\nexpected: 1\\n  actual: 2\\n\\nFAIL in (errs) (q.clj:3)\\nexpected: 1\\n  actual: 2\\n\\nFAIL in (ok) (q.clj:2)\\nexpected: 1\\n  actual: 2\\n\\nFAIL in (zz) (q.clj:1)\\nexpected: 1\\n  actual: 2\\n\\nRan 4 tests containing 4 assertions.\\n4 failures, 0 errors.\\n\""}
  {:suite "clojure.test / JVM output", :label "into / merge / conj of a hash map into a small map keep the hash map's iteration order", :expr "(let [h (hash-map 'zz 1 'ok 2 'errs 3 'fails 4)] [(keys (into {} h)) (keys (merge {} h)) (keys (persistent! (reduce conj! (transient {}) h))) (keys (conj {:a 1} h))])", :expected "[(fails errs ok zz) (fails errs ok zz) (fails errs ok zz) (:a fails errs ok zz)]"}
  ;; A record literal calls the type's factory, so under *read-eval* false the
  ;; reader refuses it as the JVM's CtorReader does, even with map->T loaded.
  ;; It used to call map->T / ->T at read time.
  {:suite "reader / read-eval" :expr "(do (defrecord RevBaz [a]) (let [n (atom 0) _ (alter-var-root (var map->RevBaz) (fn [f] (fn [m] (swap! n inc) (f m)))) err (fn [s] (try (binding [*read-eval* false] (read-string s)) (catch Exception e [(.getName (class e)) (ex-message e)])))] [(err \"#user.RevBaz{:a 1}\") (err \"#user.RevBaz[1]\") @n (:a (binding [*read-eval* true] (read-string \"#user.RevBaz[2]\")))]))" :expected "[[\"java.lang.RuntimeException\" \"Record construction syntax can only be used when *read-eval* == true\"] [\"java.lang.RuntimeException\" \"Record construction syntax can only be used when *read-eval* == true\"] 0 2]"}
  ;; io/copy honors :encoding both ways: it decodes a byte source into a Writer
  ;; and encodes a char source into a byte sink. It used to ignore it, so
  ;; (sh ... :out-enc "ISO-8859-1") decoded as UTF-8 and lost bytes to U+FFFD.
  {:suite "io" :expr "(do (require '[clojure.java.io :as io]) (let [ba (byte-array [-23 65 -1]) w (java.io.StringWriter.)] (io/copy (java.io.ByteArrayInputStream. ba) w :encoding \"ISO-8859-1\") (let [s (.toString w) b (java.io.ByteArrayOutputStream.)] (io/copy s b :encoding \"ISO-8859-1\") [(count s) (mapv int s) (vec (.toByteArray b))])))" :expected "[3 [233 65 255] [-23 65 -1]]"}
