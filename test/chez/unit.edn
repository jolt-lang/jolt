  ;; (.m string-target …) with a PROVEN string target (literal or ^String hint)
  ;; emits the string native directly — no record-method-dispatch, no rest-args
  ;; vector. These pin every table entry plus the fallback shapes (a method or
  ;; arity outside the table routes to the generic dispatch).
  {:suite "strdirect" :expr "(.length \"hello\")" :expected "5"}
  {:suite "strdirect" :expr "(.isEmpty \"\")" :expected "true"}
  {:suite "strdirect" :expr "(.toString \"x\")" :expected "\"x\""}
  {:suite "strdirect" :expr "(.toUpperCase \"ab\")" :expected "\"AB\""}
  {:suite "strdirect" :expr "(.toLowerCase \"AB\")" :expected "\"ab\""}
  {:suite "strdirect" :expr "(.trim \"  x  \")" :expected "\"x\""}
  {:suite "strdirect" :expr "(.hashCode \"hello\")" :expected "99162322"}
  {:suite "strdirect" :expr "(.charAt \"abc\" 1)" :expected "\\b"}
  {:suite "strdirect" :expr "(.indexOf \"a-b-c\" 45)" :expected "1"}
  {:suite "strdirect" :expr "(.indexOf \"a-b-c\" 45 2)" :expected "3"}
  {:suite "strdirect" :expr "(.startsWith \"hello\" \"he\")" :expected "true"}
  {:suite "strdirect" :expr "(.endsWith \"hello\" \"lo\")" :expected "true"}
  {:suite "strdirect" :expr "(.contains \"hello\" \"ell\")" :expected "true"}
  {:suite "strdirect" :expr "(.concat \"a\" \"b\")" :expected "\"ab\""}
  {:suite "strdirect" :expr "(.substring \"abcdef\" 1 3)" :expected "\"bc\""}
  {:suite "strdirect" :expr "(.replace \"a-b-c\" \"-\" \"_\")" :expected "\"a_b_c\""}
  {:suite "strdirect" :expr "(let [^String s \"a-b-c\"] (.charAt s 1))" :expected "\\-"}
  {:suite "strdirect" :expr "((fn [^String s] (.indexOf s 45)) \"a-b-c\")" :expected "1"}
  {:suite "strdirect" :expr "(let [s \"abc\"] (.length ^String s))" :expected "3"}
  ;; outside the table (method / arity) -> generic dispatch, same result
  {:suite "strdirect" :expr "(.codePointAt \"abc\" 1)" :expected "98"}
  {:suite "strdirect" :expr "(.indexOf \"abc\" \"b\" 1)" :expected "1"}
  {:suite "strdirect" :expr "(.substring \"abcdef\" 2)" :expected "\"cdef\""}
  ;; (.m keyword-target …) with a PROVEN keyword target (literal or
  ;; ^clojure.lang.Keyword hint) emits the keyword arm inline — the honeysql
  ;; kw->sym shape. Pins every table entry; (.compareTo) routes generic.
  {:suite "kwdirect" :expr "(.sym :ns/qual)" :expected "ns/qual"}
  {:suite "kwdirect" :expr "(.sym :plain)" :expected "plain"}
  {:suite "kwdirect" :expr "(.getName :ns/qual)" :expected "\"qual\""}
  {:suite "kwdirect" :expr "(.getNamespace :ns/qual)" :expected "\"ns\""}
