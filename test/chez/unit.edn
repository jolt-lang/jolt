 ;; io/resource has two branches — a source root (a jfile) and an embedded resource
 ;; baked into the image by make-devboot / jolt build. Which one serves a stdlib
 ;; path depends on whether target/dev/flat.so is fresh, so these assert only what
 ;; must hold for BOTH: the URL/File surface callers reach for. The embedded branch
 ;; used to answer none of it, which made orchard.meta flap on .getPath.
 {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (.getName (io/resource \"clojure/string.clj\")))" :expected "\"string.clj\""}
 {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io]) (quote [clojure.string :as s])) (s/ends-with? (.getPath (io/resource \"clojure/string.clj\")) \"clojure/string.clj\"))" :expected "true"}
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (boolean (seq (str (io/resource \"clojure/string.clj\")))))" :expected "true"}
  ;; A var built into the image names its classpath file in :file, so a tool can
  ;; open the definition through io/resource as it would on the JVM.
  {:suite "ioreader" :expr "(do (require (quote clojure.set) (quote clojure.walk) (quote clojure.java.io)) (every? (fn [s] (some? (clojure.java.io/resource (:file (meta (resolve s)))))) (quote [clojure.core/map-indexed clojure.core/pmap clojure.string/join clojure.set/union clojure.walk/postwalk])))" :expected "true"}
  ;; io/resource returns a java.net.URL, like the JVM, and its content reads back.
  ;; Not a corpus row: what RESOLVES differs by model — the JVM answers from the
  ;; classpath (clojure/string.clj lives in a jar), jolt from its source roots, and
  ;; the gate harness sets no roots at all, so any row naming an ambient resource
  ;; crashes there. This one owns its root, so it depends on nothing external.
  ;; Restores the roots in a finally: set-source-roots! is global, and leaving a
  ;; temp dir as the only root breaks every later row that needs to require.
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/joltresunit\") prior (jolt.host/source-roots)] (.mkdirs (io/file d)) (spit (io/file d \"probe.txt\") \"hello\") (try (jolt.host/set-source-roots! [d]) (let [u (io/resource \"probe.txt\")] [(instance? java.net.URL u) (.getName (class u)) (slurp u) (io/resource \"absent.txt\")]) (finally (jolt.host/set-source-roots! prior)))))" :expected "[true \"java.net.URL\" \"hello\" nil]"}
  ;; The 2-arity (resource n loader) resolves the same as the 1-arity: jolt has
  ;; one source-root classloader, so the loader argument is accepted and
  ;; ignored. cognitect aws-api calls it this way and used to fail to load.
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/joltresloader\") prior (jolt.host/source-roots)] (.mkdirs (io/file d)) (spit (io/file d \"probe2.txt\") \"hello\") (try (jolt.host/set-source-roots! [d]) [(slurp (io/resource \"probe2.txt\" (clojure.lang.RT/baseLoader))) (= (str (io/resource \"probe2.txt\")) (str (io/resource \"probe2.txt\" nil))) (io/resource \"absent2.txt\" (clojure.lang.RT/baseLoader))] (finally (jolt.host/set-source-roots! prior)))))" :expected "[\"hello\" true nil]"}
  ;; The JVM's resource has exactly two arities, so a third argument is an arity
  ;; error there and must stay one here — a rest argument would have swallowed it.
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (io/resource \"probe.txt\" nil nil))" :expected :throws}
  ;; A nil resource name is an NPE on the JVM — from io/resource and from every
  ;; ClassLoader method — because nil is a MISSING name, not the empty one. It
  ;; used to render as "" through the str coercion, and "" is the classpath root,
  ;; so the answer was a URL for the first source root. "" keeps that answer,
  ;; which is the JVM's.
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (io/resource nil))" :expected :throws}
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (io/resource nil (clojure.lang.RT/baseLoader)))" :expected :throws}
  {:suite "ioreader" :expr "(.getResource (clojure.lang.RT/baseLoader) nil)" :expected :throws}
  {:suite "ioreader" :expr "(.getResourceAsStream (clojure.lang.RT/baseLoader) nil)" :expected :throws}
  {:suite "ioreader" :expr "(.getResources (clojure.lang.RT/baseLoader) nil)" :expected :throws}
  {:suite "ioreader" :expr "(.getResource String nil)" :expected :throws}
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/joltresnil\") prior (jolt.host/source-roots)] (.mkdirs (io/file d)) (try (jolt.host/set-source-roots! [d]) (some? (io/resource \"\")) (finally (jolt.host/set-source-roots! prior)))))" :expected "true"}
  ;; Every ClassLoader resource method answers through io/resource's resolver, so
  ;; the loader surface resolves neither more nor less than io/resource does:
  ;; getResource agrees on the URL, getResourceAsStream reads the same content,
  ;; getResources enumerates the one root holding it, Class.getResource takes an
  ;; absolute "/name", and an absent name is nil on all of them. (The embedded
  ;; branch of the same claim needs a built binary — build-smoke's --resloader.)
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/joltrescl\") prior (jolt.host/source-roots)] (.mkdirs (io/file d)) (spit (io/file d \"probe3.txt\") \"hello\") (try (jolt.host/set-source-roots! [d]) (let [cl (clojure.lang.RT/baseLoader)] [(= (str (io/resource \"probe3.txt\")) (str (.getResource cl \"probe3.txt\"))) (slurp (.getResourceAsStream cl \"probe3.txt\")) (count (enumeration-seq (.getResources cl \"probe3.txt\"))) (= (str (io/resource \"probe3.txt\")) (str (.getResource String \"/probe3.txt\"))) [(.getResource cl \"absent3.txt\") (.getResourceAsStream cl \"absent3.txt\")]]) (finally (jolt.host/set-source-roots! prior)))))" :expected "[true \"hello\" 1 true [nil nil]]"}
  ;; a file: URL is a first-class source — slurp / .openStream / io/reader /
  ;; io/input-stream read its bytes (verified by content, not type) and io/file
  ;; strips the scheme. All five must hold before io/resource can return a URL.
  ;; Built against a temp file so nothing here depends on a machine path.
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (let [f (java.io.File/createTempFile \"joltres\" \".txt\")] (spit f \"hello\") (let [u (java.net.URL. (str \"file:\" (.getAbsolutePath f))) r (and (= \"hello\" (slurp u)) (= \"hello\" (slurp (.openStream u))) (= \"hello\" (slurp (io/reader u))) (= \"hello\" (slurp (io/input-stream u))) (= (.getAbsolutePath f) (str (io/file u))))] (.delete f) r)))" :expected "true"}
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (.getPath (.toURL (io/file \"/tmp/jolt-no-such-dir/x\"))))" :expected "\"/tmp/jolt-no-such-dir/x\""}
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (.getAbsolutePath (io/file \"/a/b\")))" :expected "\"/a/b\""}
  ;; Normalizing &form rebuilds the call form, so its reader metadata has to ride
  ;; along — a macro reading (:line (meta &form)) is how a library reports the
  ;; position of the call it is expanding. jolt-only: in an eval'd (do ...) the
  ;; JVM attaches no line meta to the inner form, so the two disagree here for a
  ;; reason that has nothing to do with the normalization. Loaded from a FILE both
  ;; answer the same {:line :column}, which is the case that matters.
  {:suite "macro-form" :expr "(do (defmacro amf-meta [& _] (list 'quote (boolean (:line (meta &form))))) (amf-meta x))" :expected "true"}
  ;; and the set-form normalization itself still holds through &form
  {:suite "macro-form" :expr "(do (defmacro amf-set [& _] (list 'quote [(set? (nth &form 1)) (map? (nth &form 1))])) (amf-set #{1 2}))" :expected "[true false]"}
  {:suite "ioreader" :expr "(slurp (StringReader. \"a=1\"))" :expected "\"a=1\""}
  {:suite "ioreader" :expr "(slurp (StringReader. \"b\") :encoding \"UTF-8\")" :expected "\"b\""}
  {:suite "ioreader" :expr "(with-open [r (StringReader. \"a\")] (.read r))" :expected "97"}
  {:suite "ioreader" :expr "(let [log (atom [])] (with-open [c {:close (fn [] (swap! log conj :closed))}] :r) (deref log))" :expected "[:closed]"}
  {:suite "ioreader" :expr "(let [log (atom [])] (try (with-open [c {:close (fn [] (swap! log conj :closed))}] (throw (ex-info \"boom\" {}))) (catch Exception e nil)) (deref log))" :expected "[:closed]"}
  {:suite "ioreader" :expr "(let [log (atom [])] (with-open [a {:close (fn [] (swap! log conj :outer))} b {:close (fn [] (swap! log conj :inner))}] :r) (deref log))" :expected "[:inner :outer]"}
  {:suite "ioreader" :expr "(with-open [c {:close (fn [] nil) :v 5}] (:v c))" :expected "5"}
  {:suite "ioreader" :expr "(do (defrecord RC [log] java.io.Closeable (close [_] (swap! log conj :closed))) (let [log (atom [])] (with-open [r (->RC log)] :body) @log))" :expected "[:closed]"}

  ;; --- line terminators (gh-948) ----------------------------------------------
  ;; readLine / lines / read-line / with-in-str / line-seq all end a line on a
  ;; newline, a carriage return, or the pair, and none of the three is part of the
  ;; line. The byte-decoding readers used Chez get-line, which splits on newline
  ;; alone, so every CRLF line came back with its CR still on it and an HTTP
  ;; header loop never recognized its own blank terminator line.
  {:suite "crlf" :expr "(let [r (java.io.BufferedReader. (java.io.InputStreamReader. (java.io.ByteArrayInputStream. (.getBytes \"a\\r\\nb\\nc\\rd\" \"UTF-8\"))))] [(.readLine r) (.readLine r) (.readLine r) (.readLine r) (.readLine r)])" :expected "[\"a\" \"b\" \"c\" \"d\" nil]"}
  {:suite "crlf" :expr "(vec (iterator-seq (.iterator (.lines (java.io.BufferedReader. (java.io.InputStreamReader. (java.io.ByteArrayInputStream. (.getBytes \"a\\r\\nb\\r\\n\" \"UTF-8\"))))))))" :expected "[\"a\" \"b\"]"}
  {:suite "crlf" :expr "(binding [*in* (java.io.BufferedReader. (java.io.InputStreamReader. (java.io.ByteArrayInputStream. (.getBytes \"x\\r\\n\" \"UTF-8\"))))] (read-line))" :expected "\"x\""}
  {:suite "crlf" :expr "(with-in-str \"x\\r\\n\" (read-line))" :expected "\"x\""}
  {:suite "crlf" :expr "(with-in-str \"a\\r\\nb\\nc\\rd\" [(read-line) (read-line) (read-line) (read-line) (read-line)])" :expected "[\"a\" \"b\" \"c\" \"d\" nil]"}
  {:suite "crlf" :expr "(line-seq (java.io.BufferedReader. (java.io.InputStreamReader. (java.io.ByteArrayInputStream. (.getBytes \"a\\r\\nb\\nc\\rd\" \"UTF-8\")))))" :expected "(\"a\" \"b\" \"c\" \"d\")"}
  {:suite "crlf" :expr "(let [r (java.io.BufferedReader. (java.io.StringReader. \"a\\r\\nb\\rc\\nd\"))] [(.readLine r) (.readLine r) (.readLine r) (.readLine r)])" :expected "[\"a\" \"b\" \"c\" \"d\"]"}
  ;; the newline of a CRLF is owed to the NEXT read, never peeked for: a reader
  ;; over a pipe must not block waiting to find out whether one follows.
  {:suite "crlf" :expr "(let [r (java.io.InputStreamReader. (java.io.ByteArrayInputStream. (.getBytes \"ab\\r\\ncd\" \"UTF-8\")))] [(.readLine r) (char (.read r)) (char (.read r)) (.read r)])" :expected "[\"ab\" \\c \\d -1]"}

  ;; --- a Reader jolt did not build (gh-952) -----------------------------------
  ;; io/reader refused a reify/proxy java.io.Reader outright, and the
  ;; BufferedReader constructor handed one straight back, so the result had no
  ;; readLine and no close. Both now go through a delegating adapter.
  ;; A deftype named Reader registers its ctor under its bare name too, and
  ;; lookup-class fell back from java.io.Reader (no ctor: abstract) to that bare
  ;; name, so a proxy over java.io.Reader built the user's type with no args —
  ;; "Wrong number of args (0) passed to: ->Reader" in every nREPL session once
  ;; ebb.impl.store (which defines one) was loaded.
  {:suite "ioreader / user Reader" :label "a user deftype named Reader does not answer for java.io.Reader" :expr "(do (deftype Reader [a b]) (require (quote [clojure.java.io :as io])) [(line-seq (io/reader (proxy [java.io.Reader] [] (read [cbuf off len] -1)))) (.-a (Reader. 1 2))])" :expected "[nil 1]"}
  ;; ...but a host class registered only by its short name still answers its
  ;; qualified name when a user type shares that short name. The type lives in
  ;; its own ns: the rows share one session, and a user-ns StringWriter would
  ;; answer later rows' bare (StringWriter.)
  {:suite "ioreader / user Reader" :label "a user deftype named StringWriter leaves java.io.StringWriter alone" :expr "(do (in-ns 'short-name-probe) (clojure.core/deftype StringWriter [a]) (in-ns 'user) (str (doto (java.io.StringWriter.) (.write \"x\"))))" :expected "\"x\""}
  {:suite "ioreader / user Reader" :expr "(do (require (quote [clojure.java.io :as io])) (slurp (io/reader (let [p (atom 0) s \"hi\\r\\nthere\"] (reify java.io.Reader (read [_ cbuf off len] (let [i @p] (if (>= i (count s)) -1 (do (aset cbuf off (.charAt s i)) (reset! p (inc i)) 1)))))))))" :expected "\"hi\\r\\nthere\""}
  {:suite "ioreader / user Reader" :expr "(let [src (let [p (atom 0) s \"hi\\r\\nthere\"] (reify java.io.Reader (read [_ cbuf off len] (let [i @p] (if (>= i (count s)) -1 (do (aset cbuf off (.charAt s i)) (reset! p (inc i)) 1)))))) b (java.io.BufferedReader. src)] [(identical? src b) (.getName (class b)) (instance? java.io.BufferedReader b) (.readLine b) (.readLine b) (.readLine b) (.close b)])" :expected "[false \"java.io.BufferedReader\" true \"hi\" \"there\" nil nil]"}
  {:suite "ioreader / user Reader" :expr "(do (require (quote [clojure.java.io :as io])) (line-seq (io/reader (proxy [java.io.Reader] [] (read [cbuf off len] -1)))))" :expected ""}

  ;; --- line-seq is LAZY (gh-1007) ---------------------------------------------
  ;; One readLine per element: a drain-and-split makes the first line wait for
  ;; the last, which is a hang for a reader over something still arriving (an
  ;; SSE body, a tailed log, a pipe). The counters below are what the producer
  ;; was asked for at the point the consumer had taken one line.
  {:suite "line-seq / lazy" :expr "(do (require (quote [clojure.java.io :as io])) (let [p (atom 0) s \"a\\nb\\nc\\n\" rdr (io/reader (proxy [java.io.Reader] [] (read [cbuf off len] (let [i @p] (if (>= i (count s)) -1 (do (aset cbuf off (.charAt s i)) (swap! p inc) 1)))))) ls (line-seq rdr) a (first ls) after @p] [a after (vec (rest ls)) @p]))" :expected "[\"a\" 2 [\"b\" \"c\"] 6]"}
  {:suite "line-seq / lazy" :expr "(do (require (quote [clojure.java.io :as io])) (let [n (atom 0) src (proxy [java.io.InputStream] [] (read ([] -1) ([b off len] (if (>= @n 3) -1 (let [ba (.getBytes (str \"tick \" @n \"\\n\") \"UTF-8\")] (swap! n inc) (System/arraycopy ba 0 b off (alength ba)) (alength ba)))))) ls (line-seq (io/reader src)) a (first ls) after @n] [a after (vec (rest ls))]))" :expected "[\"tick 0\" 1 [\"tick 1\" \"tick 2\"]]"}

  ;; a byte[] is a ByteArrayInputStream read as UTF-8, as on the JVM; it used to
  ;; fall through to the seq arm and read as the text of its element values.
  {:suite "ioreader / user Reader" :expr "(do (require (quote [clojure.java.io :as io])) [(vec (line-seq (io/reader (.getBytes \"a\\r\\nb\" \"UTF-8\")))) (slurp (io/reader (.getBytes \"é\" \"UTF-8\")))])" :expected "[[\"a\" \"b\"] \"é\"]"}
  ;; BufferedReader over jolt's own StringReader is the StringReader, so it has
  ;; to answer .lines and .ready itself.
  {:suite "ioreader / user Reader" :expr "(let [r (java.io.BufferedReader. (java.io.StringReader. \"l1\\r\\nl2\\r\\n\"))] [(.ready r) (vec (.lines r))])" :expected "[true [\"l1\" \"l2\"]]"}

  ;; --- java.text.Normalizer (gh-953) ------------------------------------------
  ;; The class symbol resolved while every member threw "no dependency provides".
  ;; Chez implements all four Unicode normalization forms, so they are real here.
  {:suite "normalizer" :expr "(java.text.Normalizer/normalize \"é\" java.text.Normalizer$Form/NFC)" :expected "\"é\""}
  {:suite "normalizer" :expr "[(vec (map int (java.text.Normalizer/normalize \"é\" java.text.Normalizer$Form/NFD))) (vec (map int (java.text.Normalizer/normalize \"é\" java.text.Normalizer$Form/NFC)))]" :expected "[[101 769] [233]]"}
  {:suite "normalizer" :expr "[(java.text.Normalizer/normalize \"ﬁ\" java.text.Normalizer$Form/NFKC) (str java.text.Normalizer$Form/NFKD) (.getName (class java.text.Normalizer$Form/NFC))]" :expected "[\"fi\" \"NFKD\" \"java.text.Normalizer$Form\"]"}
  {:suite "normalizer" :expr "[(java.text.Normalizer/isNormalized \"é\" java.text.Normalizer$Form/NFC) (java.text.Normalizer/isNormalized \"é\" java.text.Normalizer$Form/NFC)]" :expected "[true false]"}

  ;; --- java.text.Normalizer fast paths (gh-1066) -------------------------------
  ;; normalize/isNormalized no longer rebuild every string through Chez: a
  ;; per-character classification says which characters begin a normalization
  ;; segment of their own, so already-normalized runs are copied (or, when the
  ;; whole string is one, handed straight back) and only the stretches with no
  ;; boundary reach the normalizer. The rows below are the three classes and the
  ;; boundaries between them -- host/chez/java/text-normalize.ss.
  ;; An input that needs no work is the SAME string, not a rebuilt equal one.
  {:suite "normalizer" :expr "(let [s \"plain ascii\"] (identical? s (java.text.Normalizer/normalize s java.text.Normalizer$Form/NFKC)))" :expected "true"}
  ;; inert runs, an expansion (fi) and a singleton (OHM SIGN -> OMEGA) interleaved
  {:suite "normalizer" :expr "(java.text.Normalizer/normalize \"a\ufb01b\u2126c\" java.text.Normalizer$Form/NFKC)" :expected "\"afib\u03a9c\""}
  ;; an unsafe stretch: the combining acute has no boundary before it, so it is
  ;; normalized together with the character it belongs to and not on its own
  {:suite "normalizer" :expr "(vec (map int (java.text.Normalizer/normalize \"ae\u0301b\" java.text.Normalizer$Form/NFC)))" :expected "[97 233 98]"}
  ;; canonical ordering inside that stretch: dot-above (230) after dot-below (220)
  {:suite "normalizer" :expr "(vec (map int (java.text.Normalizer/normalize \"q\u0307\u0323\" java.text.Normalizer$Form/NFC)))" :expected "[113 803 775]"}
  ;; composes BACKWARD: a Hangul jamo and an Indic vowel sign each pull the
  ;; starter before them into their segment. Splitting there is the miss the
  ;; pinned table in text-normalize.ss exists to prevent (make normalizecheck).
  {:suite "normalizer" :expr "[(vec (map int (java.text.Normalizer/normalize \"\u1100\u1161\u11a8\" java.text.Normalizer$Form/NFC))) (vec (map int (java.text.Normalizer/normalize \"\uac00\u11a8\" java.text.Normalizer$Form/NFC))) (vec (map int (java.text.Normalizer/normalize \"\u09c7\u09be\" java.text.Normalizer$Form/NFC)))]" :expected "[[44033] [44033] [2507]]"}
  {:suite "normalizer" :expr "(vec (map int (java.text.Normalizer/normalize \"\uac01\" java.text.Normalizer$Form/NFD)))" :expected "[4352 4449 4520]"}
  ;; isNormalized answers at the first character that disagrees, and says true
  ;; for text it never has to normalize
  {:suite "normalizer" :expr "[(java.text.Normalizer/isNormalized \"\ufb01 and the rest of a long ascii tail\" java.text.Normalizer$Form/NFKC) (java.text.Normalizer/isNormalized \"plain ascii\" java.text.Normalizer$Form/NFKC) (java.text.Normalizer/isNormalized \"\uac00\u11a8\" java.text.Normalizer$Form/NFC)]" :expected "[false true false]"}

  ;; --- CharsetDecoder / CodingErrorAction (gh-946) ----------------------------
  ;; CodingErrorAction had no provider and the decoder's method table held only
  ;; .charset, so the documented way to decode a stream a chunk at a time could
  ;; not be written. The third row is that idiom: a 3-byte character split across
  ;; two chunks must survive the split, which is what compact() carries over.
  {:suite "charset-decoder" :expr "[(str java.nio.charset.CodingErrorAction/REPLACE) (.getName (class java.nio.charset.CodingErrorAction/REPORT)) (str java.nio.charset.CoderResult/UNDERFLOW)]" :expected "[\"REPLACE\" \"java.nio.charset.CodingErrorAction\" \"UNDERFLOW\"]"}
  {:suite "charset-decoder" :expr "(str (.decode (.newDecoder (java.nio.charset.Charset/forName \"UTF-8\")) (java.nio.ByteBuffer/wrap (byte-array [104 105]))))" :expected "\"hi\""}
  {:suite "charset-decoder" :expr "(let [d (.newDecoder (java.nio.charset.Charset/forName \"UTF-8\"))] [(str (.malformedInputAction d)) (str (.unmappableCharacterAction d)) (str (.malformedInputAction (.onMalformedInput d java.nio.charset.CodingErrorAction/IGNORE)))])" :expected "[\"REPORT\" \"REPORT\" \"IGNORE\"]"}
  {:suite "charset-decoder" :expr "(let [d (.newDecoder (java.nio.charset.Charset/forName \"UTF-8\")) in (java.nio.ByteBuffer/allocate 16) out (java.nio.CharBuffer/allocate 16) sb (StringBuilder.)] (doseq [chunk [[97 -30] [-126 -84 98]]] (.put in (byte-array chunk)) (.flip in) (let [r (.decode d in out false)] (.append sb (str (.flip out))) (.clear out) (.compact in) (assert (.isUnderflow r)))) (.flip in) (.decode d in out true) (.append sb (str (.flip out))) (str sb))" :expected "\"a€b\""}
  {:suite "charset-decoder" :expr "(let [d (doto (.newDecoder (java.nio.charset.Charset/forName \"UTF-8\")) (.onMalformedInput java.nio.charset.CodingErrorAction/REPLACE))] (str (.decode d (java.nio.ByteBuffer/wrap (byte-array [104 -1 105])))))" :expected "\"h�i\""}
