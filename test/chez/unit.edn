  ;; --- regex line terminators (gh-956) ----------------------------------------
  ;; Java's terminator set for DOT, ^ and $ is \n, \r, \r\n, NEL, LS and PS, and
  ;; (?d) UNIX_LINES is what narrows it to \n. jolt mapped those onto irregex ops
  ;; whose set is \n only and accepted (?d) as a no-op, so it behaved as if
  ;; UNIX_LINES were always on: DOT crossed a \r, (?m)^ did not match after one,
  ;; and a CRLF header read with (.*) kept its \r. A CRLF is ONE terminator, so
  ;; neither anchor may sit between the \r and the \n — the fourth row of each
  ;; group is that case.
  {:suite "regex / line terminators" :expr "(let [nel (str (char 0x85)) ls (str (char 0x2028)) ps (str (char 0x2029))] [(re-find #\"a.b\" \"a\\rb\") (re-find #\"a.b\" \"a\\nb\") (re-find #\"a.b\" (str \"a\" nel \"b\")) (re-find #\"a.b\" (str \"a\" ls \"b\")) (re-find #\"a.b\" (str \"a\" ps \"b\")) (re-find #\"a.b\" \"a\\tb\") (re-find #\"(?s)a.b\" \"a\\rb\")])" :expected "[nil nil nil nil nil \"a\\tb\" \"a\\rb\"]"}
  {:suite "regex / line terminators" :expr "[(re-find #\"(?m)^b\" \"a\\rb\") (re-find #\"(?m)^b\" \"a\\r\\nb\") (re-find #\"(?m)^b\" (str \"a\" (char 0x85) \"b\")) (re-find #\"(?m)^\\nb\" \"a\\r\\nb\")]" :expected "[\"b\" \"b\" \"b\" nil]"}
  {:suite "regex / line terminators" :expr "[(re-find #\"(?m)a$\" \"a\\rb\") (re-find #\"(?m)a$\" \"a\\r\\nb\") (re-find #\"(?m)\\r$\" \"a\\r\\nb\") (re-find #\"a$\" \"a\\r\") (re-find #\"a$\" \"a\\r\\n\") (re-find #\"a$\" \"a\\rb\") (re-find #\"a\\Z\" \"a\\r\") (re-find #\"a\\z\" \"a\\r\")]" :expected "[\"a\" \"a\" nil \"a\" \"a\" nil \"a\" nil]"}
  {:suite "regex / line terminators" :expr "(re-find #\"(?m)^(.*)$\" \"GET / HTTP/1.1\\r\\nHost: x\\r\\n\")" :expected "[\"GET / HTTP/1.1\" \"GET / HTTP/1.1\"]"}
  {:suite "regex / line terminators" :expr "(clojure.string/split \"a\\r\\nb\\r\\nc\" #\"(?m)$\")" :expected "[\"a\" \"\\r\\nb\" \"\\r\\nc\"]"}
  ;; (?d) restores the narrow set, which is what it means on the JVM — every row
  ;; above that differs from jolt's old answer agrees again under it.
  {:suite "regex / line terminators" :expr "[(re-find #\"(?d)a.b\" \"a\\rb\") (re-find #\"(?d)(?m)^b\" \"a\\rb\") (re-find #\"(?d)(?m)a$\" \"a\\rb\") (re-find #\"(?d)a$\" \"a\\r\") (re-find #\"(?d)a$\" \"a\\n\")]" :expected "[\"a\\rb\" nil nil nil \"a\"]"}
  ;; A resumed scan is not a fresh input: ^ anchors at the ORIGIN, not at the
  ;; cursor, and (?m)^ does not match at the end of input. Both follow from
  ;; irx-search-from passing the two positions separately (host/chez/regex.ss).
  {:suite "regex / line terminators" :expr "[(re-seq #\"^abc\" \"abcabc\") (clojure.string/replace \"abcabc\" #\"^abc\" \"-\") (re-seq #\"(?m)^\" \"a\\nb\\n\")]" :expected "[(\"abc\") \"-abc\" (\"\" \"\")]"}
  ;; The positions an anchor matches at, read off a Matcher — java.util.regex's
  ;; own rules at the edges: a non-multiline $ (and \Z) does not match between
  ;; the halves of a final CRLF; multiline ^ never matches at the end of input,
  ;; so it matches nowhere on "" and once on "a\n"; and (?d) keeps both rules.
  {:suite "regex / line terminators" :expr "(let [pos (fn [re s] (let [m (re-matcher re s)] (loop [acc []] (if (.find m) (recur (conj acc (.start m))) acc))))] [(pos #\"$\" \"ab\\r\\n\") (pos #\"\\Z\" \"ab\\r\\n\") (pos #\"$\" \"ab\\r\") (pos #\"$\" \"ab\\n\\n\") (pos #\"(?d)$\" \"ab\\n\")])" :expected "[[2 4] [2 4] [2 3] [3 4] [2 3]]"}
  {:suite "regex / line terminators" :expr "(let [pos (fn [re s] (let [m (re-matcher re s)] (loop [acc []] (if (.find m) (recur (conj acc (.start m))) acc))))] [(pos #\"(?m)^\" \"\") (pos #\"(?m)^\" \"a\\n\") (pos #\"(?m)^\" \"a\\r\\nb\") (pos #\"(?md)^\" \"a\\n\\n\") (re-matches #\"(?m)^$\" \"\")])" :expected "[[] [0] [0 3] [0 2] nil]"}

  ;; --- Base64 MIME encoder/decoder (gh-955) -----------------------------------
  ;; Four of the JDK's six Base64 statics were here; the MIME pair was not, and
  ;; the basic decoder is no substitute because it rejects the line breaks a
  ;; MIME/PEM body carries. The MIME encoder wraps at 76 characters with CRLF and
  ;; the MIME decoder discards every character outside the alphabet.
  {:suite "base64 / mime" :expr "(let [p \"The quick brown fox jumps over the lazy dog. \" s (apply str (repeat 10 p)) e (.encodeToString (java.util.Base64/getMimeEncoder) (.getBytes s \"UTF-8\"))] [(every? #(<= (count %) 76) (clojure.string/split e #\"\\r\\n\")) (> (count (clojure.string/split e #\"\\r\\n\")) 1) (= s (String. (.decode (java.util.Base64/getMimeDecoder) e))) (= e (.encodeToString (java.util.Base64/getEncoder) (.getBytes s \"UTF-8\")))])" :expected "[true true true false]"}
  {:suite "base64 / mime" :expr "[(String. (.decode (java.util.Base64/getMimeDecoder) \"aGVs\\r\\nbG8=\")) (String. (.decode (java.util.Base64/getMimeDecoder) \"aG Vs\\tbG8=\")) (try (String. (.decode (java.util.Base64/getDecoder) \"aGVs\\r\\nbG8=\")) (catch IllegalArgumentException e :threw))]" :expected "[\"hello\" \"hello\" :threw]"}
  {:suite "base64 / mime" :expr "[(.encodeToString (java.util.Base64/getMimeEncoder 8 (.getBytes \"\\n\")) (.getBytes \"hello world\" \"UTF-8\")) (.encodeToString (java.util.Base64/getMimeEncoder 7 (.getBytes \"\\n\")) (.getBytes \"hello world\" \"UTF-8\")) (.encodeToString (java.util.Base64/getMimeEncoder 0 (.getBytes \"\\n\")) (.getBytes \"hello world\" \"UTF-8\"))]" :expected "[\"aGVsbG8g\\nd29ybGQ=\" \"aGVs\\nbG8g\\nd29y\\nbGQ=\" \"aGVsbG8gd29ybGQ=\"]"}
  {:suite "base64 / mime" :expr "[(try (java.util.Base64/getMimeEncoder 8 (.getBytes \"A\")) :no-throw (catch IllegalArgumentException e :threw)) (.encodeToString (java.util.Base64/getMimeEncoder) (byte-array 0)) (.getName (class (java.util.Base64/getMimeDecoder))) (.encodeToString (.withoutPadding (java.util.Base64/getEncoder)) (.getBytes \"hi\" \"UTF-8\"))]" :expected "[:threw \"\" \"java.util.Base64$Decoder\" \"aGk\"]"}
