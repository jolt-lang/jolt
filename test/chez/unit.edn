  {:suite "refer-replace-warning" :expr "(binding [*ns* *ns*] (let [w (java.io.StringWriter.)] (binding [*err* w] (load-string \"(ns rplw.b (:refer-clojure :exclude [vals])) (def vals 1) (ns rplw.b2 (:refer-clojure :only [inc])) (def vals 2)\")) (str w)))" :expected "\"\""}
  {:suite "refer-replace-warning" :expr "(binding [*ns* *ns*] (let [w (java.io.StringWriter.)] (binding [*err* w] (load-string \"(ns rplw.c1 (:refer-clojure :exclude [vals])) (defn vals [] :c1) (ns rplw.c (:require [rplw.c1 :refer [vals]]) (:refer-clojure :exclude [vals])) (def vals 5)\")) [(str w) @(resolve 'rplw.c/vals)]))" :expected "[\"WARNING: vals already refers to: #'rplw.c1/vals in namespace: rplw.c, being replaced by: #'rplw.c/vals\\n\" 5]"}
  {:suite "refer-replace-warning" :expr "(binding [*ns* *ns*] (let [w (java.io.StringWriter.)] (binding [*err* w] (load-string \"(ns rplw.d) (intern 'rplw.d 'map 5) (intern 'rplw.d 'map 6)\")) [(str w) @(resolve 'rplw.d/map)]))" :expected "[\"WARNING: map already refers to: #'clojure.core/map in namespace: rplw.d, being replaced by: #'rplw.d/map\\n\" 6]"}
  {:suite "refer-replace-warning" :expr "(binding [*ns* *ns*] (let [w (java.io.StringWriter.)] (binding [*err* w] (load-string \"(ns rplw.f) (declare first) (defmacro rest [x] x) (defmulti second identity) (def first 1)\")) (str w)))" :expected "\"WARNING: first already refers to: #'clojure.core/first in namespace: rplw.f, being replaced by: #'rplw.f/first\\nWARNING: rest already refers to: #'clojure.core/rest in namespace: rplw.f, being replaced by: #'rplw.f/rest\\nWARNING: second already refers to: #'clojure.core/second in namespace: rplw.f, being replaced by: #'rplw.f/second\\n\""}
  {:suite "refer-replace-warning" :expr "(binding [*ns* *ns*] (let [w (java.io.StringWriter.)] (binding [*err* w] (load-string \"(ns rplw.g) (ns-unmap 'rplw.g 'vals) (def vals 1) (in-ns 'rplw.h) (def map 1)\")) (str w)))" :expected "\"\""}
  {:suite "refer-replace-warning" :expr "(binding [*ns* *ns*] (let [w (java.io.StringWriter.)] (binding [*err* w] (load-string \"(ns rplw.i) (when false (def vals 1))\")) [(str w) (some? (resolve 'rplw.i/vals))]))" :expected "[\"WARNING: vals already refers to: #'clojure.core/vals in namespace: rplw.i, being replaced by: #'rplw.i/vals\\n\" true]"}
