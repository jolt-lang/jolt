  {:suite "interrupt / blocking" :expr "(let [c (java.util.concurrent.CompletableFuture.) ready (promise) out (promise) t (Thread. (fn [] (deliver ready true) (let [t0 (System/nanoTime) r (try (deref c) :no-throw (catch InterruptedException e :threw))] (deliver out [r (< (quot (- (System/nanoTime) t0) 1000000) 3000)]))))] (.start t) (deref ready 5000 :timeout) (Thread/sleep 50) (.interrupt t) (deref out 5000 :timeout))" :expected "[:threw true]"}
  {:suite "interrupt / blocking" :expr "(let [c (java.util.concurrent.CompletableFuture.) ready (promise) out (promise) t (Thread. (fn [] (deliver ready true) (deliver out (try [(.join c) (.isInterrupted (Thread/currentThread))] (catch Throwable e :threw)))))] (.start t) (deref ready 5000 :timeout) (Thread/sleep 50) (.interrupt t) (let [early (deref out 300 :still-waiting)] (.complete c :v) [early (deref out 5000 :timeout)]))" :expected "[:still-waiting [:v true]]"}
  {:suite "interrupt / blocking" :expr "(let [c (java.util.concurrent.CompletableFuture.) t (Thread/currentThread) t0 (System/nanoTime)] (future (Thread/sleep 4000) (.complete c :late)) (.interrupt t) (let [r (try (.get c) :no-throw (catch InterruptedException e :threw))] [r (< (quot (- (System/nanoTime) t0) 1000000) 2000) (.isInterrupted t)]))" :expected "[:threw true false]"}
  {:suite "interrupt / blocking" :expr "(let [c (java.util.concurrent.CompletableFuture/completedFuture 1)] [(do (.interrupt (Thread/currentThread)) [(.get c) (Thread/interrupted)]) (do (.interrupt (Thread/currentThread)) [(.join c) (Thread/interrupted)]) (do (.interrupt (Thread/currentThread)) [(deref c) (Thread/interrupted)])])" :expected "[[1 true] [1 true] [1 true]]"}
  ;; THE FIBER ROWS, and they bind *go-backend* :fiber ON PURPOSE — go defaults to
  ;; :thread, so an unbound (go ...) row runs on a plain OS thread and re-tests the
  ;; thread rows above rather than the fiber path. (jolt.host/fiber?) is carried in
  ;; each answer so the row cannot silently stop testing what it claims to.
  ;;
  ;; A fiber is a virtual thread: (Thread/currentThread) inside it is the fiber's
  ;; own Thread object, with its own interrupt flag, so a fiber can interrupt its
  ;; own blocking wait. The late deliver keeps a runtime that ignores it from
  ;; hanging the gate.
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [p (promise)] (future (Thread/sleep 4000) (deliver p :late)) (a/<!! (a/go [(jolt.host/fiber?) (do (.interrupt (Thread/currentThread)) (try (deref p) :no-throw (catch InterruptedException e :threw)))])))))" :expected "[true :threw]"}
  ;; ...and a genuinely PARKED fiber, woken by an external .interrupt of its Thread.
  ;; This is the half a self-interrupt cannot show: the fiber is off the CPU when the
  ;; interrupt lands, so it is the registry that has to find it.
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [p (promise) carrier (promise) out (promise)] (a/go (deliver carrier [(jolt.host/fiber?) (Thread/currentThread)]) (deliver out (try (deref p) :no-throw (catch InterruptedException e :threw)))) (let [[fib? c] (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt c) [fib? (deref out 5000 :timeout)]))))" :expected "[true :threw]"}
  ;; ...and the same for a fiber parked in Object.wait: it is in the monitor's WAIT
  ;; SET, not on a channel, and the interrupt still finds it through the registry —
  ;; then it takes the monitor again before the throw, as on a thread.
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [o (Object.) carrier (promise) out (promise)] (a/go (deliver carrier [(jolt.host/fiber?) (Thread/currentThread)]) (deliver out (locking o (try (.wait o 30000) :no-throw (catch InterruptedException e :threw))))) (let [[fib? c] (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt c) [fib? (deref out 5000 :timeout)]))))" :expected "[true :threw]"}
  ;; Thread/sleep on a fiber parks it with a deadline (fibers-pool-test case 6 pins
  ;; that the carrier runs other fibers meanwhile). An interrupt already set throws
  ;; at once...
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (a/<!! (a/go [(jolt.host/fiber?) (try (.interrupt (Thread/currentThread)) (Thread/sleep 2000) :no-throw (catch InterruptedException e :threw))]))))" :expected "[true :threw]"}
  ;; ...and one arriving DURING the sleep throws the fiber out of it and clears its
  ;; flag, as a JVM virtual thread's sleep does. It used to sleep the carrier and
  ;; see the interrupt only when the nap ended.
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [carrier (promise) out (promise)] (a/go (deliver carrier (Thread/currentThread)) (deliver out [(try (Thread/sleep 1200) :no-throw (catch InterruptedException e :threw)) (Thread/interrupted)])) (let [c (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt c) (deref out 5000 :timeout)))))" :expected "[:threw false]"}
  ;; THE BLOCKING CHANNEL OPS. <!!, >!! and alts!! block by deref'ing a promise on
  ;; the JVM, so .interrupt throws InterruptedException out of them and clears the
  ;; flag. jolt also leaves nothing behind: an interrupted take holds no value and
  ;; is no longer counted as a waiting taker (the offer! answers nil), an
  ;; interrupted put is retracted (the poll! answers nil), and an interrupted
  ;; alts!! has claimed no op. The JVM leaves its handler registered in all three
  ;; (known-divergences.edn), so those tails are jolt's.
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) t (promise) done (promise)] (a/thread (deliver t (Thread/currentThread)) (deliver done (try [:took (a/<!! c)] (catch InterruptedException e [:interrupted (.isInterrupted (Thread/currentThread))])))) (deref t 5000 nil) (Thread/sleep 100) (.interrupt (deref t)) [(deref done 5000 :hung) (a/offer! c 1)]))" :expected "[[:interrupted false] nil]"}
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) t (promise) done (promise)] (a/thread (deliver t (Thread/currentThread)) (deliver done (try [:put (a/>!! c :v)] (catch InterruptedException e [:interrupted (.isInterrupted (Thread/currentThread))])))) (deref t 5000 nil) (Thread/sleep 100) (.interrupt (deref t)) [(deref done 5000 :hung) (a/poll! c)]))" :expected "[[:interrupted false] nil]"}
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan 1) t (promise) done (promise)] (a/>!! c 1) (a/thread (deliver t (Thread/currentThread)) (deliver done (try [:put (a/>!! c 2)] (catch InterruptedException e [:interrupted (.isInterrupted (Thread/currentThread))])))) (deref t 5000 nil) (Thread/sleep 100) (.interrupt (deref t)) [(deref done 5000 :hung) (a/poll! c) (a/poll! c)]))" :expected "[[:interrupted false] 1 nil]"}
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) d (a/chan) t (promise) done (promise)] (a/thread (deliver t (Thread/currentThread)) (deliver done (let [t0 (System/nanoTime)] (try [:alts (a/alts!! [c [d :v] (a/timeout 30000)])] (catch InterruptedException e [:interrupted (.isInterrupted (Thread/currentThread)) (< (quot (- (System/nanoTime) t0) 1000000) 3000)]))))) (deref t 5000 nil) (Thread/sleep 100) (.interrupt (deref t)) [(deref done 5000 :hung) (a/poll! d) (a/offer! c 1)]))" :expected "[[:interrupted false true] nil nil]"}
  ;; A flag already set: an op that would wait throws at once, before registering
  ;; anything; an op that can complete completes and leaves the flag set, as the
  ;; JVM's does (it returns from take!/put! without reaching the promise).
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (deref (future (.interrupt (Thread/currentThread)) (let [c (a/chan) d (a/chan)] [(try (a/<!! c) (catch InterruptedException e :interrupted)) (Thread/interrupted) (do (.interrupt (Thread/currentThread)) (try (a/>!! c 1) (catch InterruptedException e :interrupted))) (Thread/interrupted) (a/poll! c) (do (.interrupt (Thread/currentThread)) (try (a/alts!! [c [d 1]]) (catch InterruptedException e :interrupted))) (Thread/interrupted) (a/poll! d) (a/offer! c 1)])) 5000 :hung))" :expected "[:interrupted false :interrupted false nil :interrupted false nil nil]"}
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (deref (future (let [c (a/chan 2)] (a/>!! c 1) (.interrupt (Thread/currentThread)) [(a/<!! c) (a/>!! c 2) (first (a/alts!! [c])) (Thread/interrupted)])) 5000 :hung))" :expected "[1 true 2 true]"}
  ;; ...including a put to an unbuffered channel a thread is already blocked
  ;; taking from: the taker was counted, so the put completes without waiting and
  ;; the flag stays set. It used to wait, see the flag, withdraw the value and
  ;; throw, leaving the taker blocked. JVM core.async answers [true true 1].
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) t (a/thread (a/<!! c))] (Thread/sleep 100) (deref (future (.interrupt (Thread/currentThread)) [(try (a/>!! c 1) (catch InterruptedException e :interrupted)) (Thread/interrupted) (first (a/alts!! [t (a/timeout 5000)]))]) 5000 :hung)))" :expected "[true true 1]"}
  ;; <! is a PARK, and a parked go block holds no thread to interrupt, so a go body
  ;; on the default :thread backend waits on through an interrupt of the thread it
  ;; runs on and sees the flag still set afterwards.
  {:suite "interrupt / blocking channels" :expr "(do (require (quote [clojure.core.async :as a])) (let [t (promise) c (a/chan) g (a/go (deliver t (Thread/currentThread)) (let [v (a/<! c)] [v (Thread/interrupted)]))] (deref t 5000 nil) (Thread/sleep 100) (.interrupt (deref t)) (Thread/sleep 50) (a/>!! c 5) (deref (future (a/<!! g)) 5000 :hung)))" :expected "[5 true]"}
  ;; The same on a fiber, where the interrupt reaches that fiber alone: its own
  ;; flag, and a direct wake of its park.
  ;; The try keeps the CPS pass off the op, though it leaves <!! alone either way.
  {:suite "interrupt / blocking channels fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [carrier (promise) out (promise) c (a/chan)] (a/go (deliver carrier [(jolt.host/fiber?) (Thread/currentThread)]) (deliver out (try (a/<!! c) :took (catch InterruptedException e :threw)))) (let [[fib? t] (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt t) [fib? (deref out 5000 :hung) (a/offer! c 1)]))))" :expected "[true :threw nil]"}
  {:suite "interrupt / blocking channels fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [carrier (promise) out (promise) c (a/chan)] (a/go (deliver carrier [(jolt.host/fiber?) (Thread/currentThread)]) (deliver out (try (a/>!! c :v) :put (catch InterruptedException e :threw)))) (let [[fib? t] (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt t) [fib? (deref out 5000 :hung) (a/poll! c)]))))" :expected "[true :threw nil]"}
  {:suite "interrupt / blocking channels fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [carrier (promise) out (promise) c (a/chan) d (a/chan)] (a/go (deliver carrier [(jolt.host/fiber?) (Thread/currentThread)]) (deliver out (try (a/alts!! [c [d :v]]) (catch InterruptedException e :threw)))) (let [[fib? t] (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt t) [fib? (deref out 5000 :hung) (a/poll! d) (a/offer! c 1)]))))" :expected "[true :threw nil nil]"}
  ;; ...and a fiber's <! is not interruptible; its flag stays set, which
  ;; Thread/interrupted reads and clears.
  {:suite "interrupt / blocking channels fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [carrier (promise) c (a/chan) g (a/go (deliver carrier (Thread/currentThread)) (let [v (a/<! c)] [(jolt.host/fiber?) v (Thread/interrupted)]))] (let [t (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt t) (Thread/sleep 50) (a/>!! c 5) (deref (future (a/<!! g)) 5000 :hung)))))" :expected "[true 5 true]"}
  ;; With no try around it, a <!! / >!! in a go body is a CHEAP park (the pass
  ;; rewrites it to __sm-take!! / __sm-put!!), and that park carries the interrupt
  ;; arm too: the body dies with InterruptedException, which go-monitor reports,
  ;; and the channel is left as it was — no taker counted, no value queued.
  {:suite "interrupt / blocking channels fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [carrier (promise) c (a/chan) g (a/go (deliver carrier (Thread/currentThread)) (a/<!! c) :took) mon (a/go-monitor g)] (let [t (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt t) (Thread/sleep 100) [(a/offer! c 1) (a/poll! c) (let [e (deref (future (a/<!! mon)) 5000 :hung)] (if (instance? Throwable e) (.getName (class e)) e)) (deref (future (a/<!! g)) 5000 :hung)]))))" :expected "[nil nil \"java.lang.InterruptedException\" nil]"}
  {:suite "interrupt / blocking channels fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [carrier (promise) c (a/chan) g (a/go (deliver carrier (Thread/currentThread)) (a/>!! c :v) :put) mon (a/go-monitor g)] (let [t (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt t) (Thread/sleep 100) [(a/offer! c 1) (a/poll! c) (let [e (deref (future (a/<!! mon)) 5000 :hung)] (if (instance? Throwable e) (.getName (class e)) e)) (deref (future (a/<!! g)) 5000 :hung)]))))" :expected "[nil nil \"java.lang.InterruptedException\" nil]"}
  ;; A FIBER IS A VIRTUAL THREAD. Thread/currentThread inside one is the fiber's own
  ;; Thread object: the same one for the fiber's whole life, across parks, and
  ;; distinct from every other fiber's. isVirtual and isDaemon are true, the id is
  ;; its own, and the name is the empty string a JVM virtual thread gets.
  {:suite "virtual threads / fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [[x y] (a/<!! (a/go [(Thread/currentThread) (let [t (Thread/currentThread)] (a/<! (a/timeout 5)) t)])) z (a/<!! (a/go (Thread/currentThread)))] [(identical? x y) (identical? x z) (.isVirtual z) (.isDaemon z) (not= (.threadId x) (.threadId z)) (.getName z) (.isVirtual (Thread/currentThread))])))" :expected "[true false true true true \"\" false]"}
  ;; Its flag is its own: one fiber interrupting itself and finishing leaves no
  ;; flag behind for the fibers that run on the same carrier afterwards.
  {:suite "virtual threads / fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (do (a/<!! (a/go (.interrupt (Thread/currentThread)) :set)) (frequencies (repeatedly 40 (fn* [] (a/<!! (a/go (.isInterrupted (Thread/currentThread)))))))))))" :expected "{false 40}"}
  ;; Interrupting ONE of many fibers blocked in the same <!! throws exactly that one
  ;; out; the rest keep waiting and then take the values put afterwards.
  {:suite "virtual threads / fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [n 12 c (a/chan) ts (vec (repeatedly n promise)) outs (vec (repeatedly n promise))] (dotimes [i n] (a/go (deliver (ts i) (Thread/currentThread)) (deliver (outs i) (try [:got (a/<!! c)] (catch InterruptedException e :threw))))) (doseq [t ts] (deref t 5000 nil)) (Thread/sleep 100) (.interrupt (deref (ts 3))) (Thread/sleep 100) (let [threw (count (filter (fn* [p] (= :threw (deref p 10 :waiting))) outs))] (dotimes [i (dec n)] (a/>!! c i)) [threw (deref (outs 3) 10 :waiting) (count (filter (fn* [p] (vector? (deref p 5000 :hung))) outs))]))))" :expected "[1 :threw 11]"}
  ;; ...and the same for fibers blocked in a promise deref.
  {:suite "virtual threads / fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [n 8 p (promise) ts (vec (repeatedly n promise)) outs (vec (repeatedly n promise))] (dotimes [i n] (a/go (deliver (ts i) (Thread/currentThread)) (deliver (outs i) (try (deref p) (catch InterruptedException e :threw))))) (doseq [t ts] (deref t 5000 nil)) (Thread/sleep 100) (.interrupt (deref (ts 5))) (Thread/sleep 100) (let [r (deref (outs 5) 10 :waiting)] (deliver p :v) [r (frequencies (map (fn* [o] (deref o 5000 :hung)) outs))]))))" :expected "[:threw {:v 7, :threw 1}]"}
  ;; A virtual thread's object is alive while its fiber runs, and join waits for it.
  {:suite "virtual threads / fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [t (promise) c (a/chan) g (a/go (deliver t (Thread/currentThread)) (a/<! c) :done) th (deref t 5000 nil)] (.join th 50) (let [alive (.isAlive th)] (a/close! c) [alive (do (.join th) (.isAlive th)) (a/<!! g)]))))" :expected "[true false :done]"}
  ;; io-thread runs on a virtual thread, as on the JVM; thread does not.
  {:suite "virtual threads / fibers" :expr "(do (require (quote [clojure.core.async :as a])) [(a/<!! (a/io-thread (.isVirtual (Thread/currentThread)))) (a/<!! (a/thread (.isVirtual (Thread/currentThread))))])" :expected "[true false]"}
  ;; cancel(true) reaches a virtual thread parked in a channel op: the runner it
  ;; records is the fiber's box, and interrupting that box resumes the fiber. JVM
  ;; core.async 1.9.865 answers [true :interrupted true] and [true true :interrupted
  ;; :interrupted 1 true]: it leaves the interrupted op's handler registered
  ;; (known-divergences.edn), so the offer!/poll! tails are jolt's.
  {:suite "interrupt / cancel virtual threads" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) out (promise) ft (java.util.concurrent.FutureTask. (fn [] (deliver out (try (a/<!! c) :took (catch InterruptedException e :interrupted)))))] (Thread/startVirtualThread ft) (Thread/sleep 150) [(.cancel ft true) (deref out 3000 :hung) (a/offer! c 1)]))" :expected "[true :interrupted nil]"}
  {:suite "interrupt / cancel virtual threads" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) d (a/chan) o1 (promise) o2 (promise) f1 (java.util.concurrent.FutureTask. (fn [] (deliver o1 (try (a/>!! c 1) :put (catch InterruptedException e :interrupted))))) f2 (java.util.concurrent.FutureTask. (fn [] (deliver o2 (try (a/alts!! [d]) :alts (catch InterruptedException e :interrupted)))))] (Thread/startVirtualThread f1) (Thread/startVirtualThread f2) (Thread/sleep 150) [(.cancel f1 true) (.cancel f2 true) (deref o1 3000 :hung) (deref o2 3000 :hung) (a/poll! c) (a/offer! d 1)]))" :expected "[true true :interrupted :interrupted nil nil]"}
  ;; ...and a go body's cheap park (<!! with no try around it) the same way: the
  ;; body dies with InterruptedException and the channel is left as it was.
  {:suite "interrupt / cancel virtual threads" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [c (a/chan) ft (promise) g (a/go (let [t (java.util.concurrent.FutureTask. (fn [] (a/<!! c) :took))] (deliver ft t) (.run t) (try (.get t) (catch Exception e (.getName (class e))))))] (Thread/sleep 150) [(.cancel (deref ft 3000 nil) true) (deref (future (a/<!! g)) 5000 :hung) (a/offer! c 1)])))" :expected "[true \"java.util.concurrent.CancellationException\" nil]"}
  ;; An unbuffered put succeeds only when a live taker receives the value. offer!
  ;; used to count a thread blocked in <!! as room for ANY number of puts, so two
  ;; offers in a row both answered true and the second value sat in the channel
  ;; for whoever took next. JVM core.async answers [true nil 1 nil].
  {:suite "core.async / rendezvous" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) t (a/thread (a/<!! c))] (Thread/sleep 50) [(a/offer! c 1) (a/offer! c 2) (a/<!! t) (a/poll! c)]))" :expected "[true nil 1 nil]"}
  {:suite "core.async / rendezvous" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [c (a/chan) t (a/go (a/<! c))] (Thread/sleep 50) [(a/offer! c 1) (a/offer! c 2) (a/<!! t) (a/poll! c)])))" :expected "[true nil 1 nil]"}
  ;; A parked putter and a parked taker are paired by claiming BOTH handlers
  ;; together, and a handler is never paired with itself: an alts!! that takes
  ;; from and puts to the same empty channel waits for a partner (here the
  ;; timeout). It used to claim its own put against its own take, answer true, and
  ;; leave the value in the channel (known-divergences.edn: the JVM also answers
  ;; true there, and drops the value).
  {:suite "core.async / rendezvous" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) to (a/timeout 100) [v p] (a/alts!! [c [c :v] to] :priority true)] [v (= p to) (a/poll! c)]))" :expected "[nil true nil]"}
  ;; A buffer past the fixnum range (Long/MAX_VALUE, how a "practically unbounded"
  ;; channel is often spelled) is a bignum capacity, so the capacity checks must
  ;; not be fixnum-only.
  {:suite "core.async / big buffer" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan Long/MAX_VALUE)] [(a/offer! c 1) (a/>!! c 2) (a/poll! c) (a/<!! c)]))" :expected "[true true 1 2]"}
  {:suite "core.async / big buffer" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan Long/MAX_VALUE)] [(first (a/alts!! [[c 1]])) (first (a/alts!! [c]))]))" :expected "[true 1]"}
  {:suite "core.async / big buffer" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan Long/MAX_VALUE) r (a/thread (a/<!! c))] (Thread/sleep 50) [(a/offer! c 1) (a/<!! r)]))" :expected "[true 1]"}
  {:suite "core.async / big buffer" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [c (a/chan Long/MAX_VALUE)] (a/<!! (a/go (a/>! c 1) (a/<! c))))))" :expected "1"}
  ;; CompletableFuture on a fiber: get parks and is thrown out by an interrupt of
  ;; the carrier, set before the wait or arriving during it; join parks and is
  ;; not, and the flag it leaves set is read (and cleared) by Thread/interrupted so
  ;; it cannot leak onto the carrier the later rows share.
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [c (java.util.concurrent.CompletableFuture.)] (future (Thread/sleep 4000) (.complete c :late)) (a/<!! (a/go [(jolt.host/fiber?) (do (.interrupt (Thread/currentThread)) (try (.get c) :no-throw (catch InterruptedException e :threw)))])))))" :expected "[true :threw]"}
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [c (java.util.concurrent.CompletableFuture.) carrier (promise) out (promise)] (a/go (deliver carrier [(jolt.host/fiber?) (Thread/currentThread)]) (deliver out (try (.get c) :no-throw (catch InterruptedException e :threw)))) (let [[fib? car] (deref carrier 5000 :timeout)] (Thread/sleep 150) (.interrupt car) [fib? (deref out 5000 :timeout)]))))" :expected "[true :threw]"}
  {:suite "interrupt / blocking fibers" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (let [c (java.util.concurrent.CompletableFuture.)] (future (Thread/sleep 200) (.complete c :late)) (a/<!! (a/go [(jolt.host/fiber?) (do (.interrupt (Thread/currentThread)) (try (.join c) (catch Throwable e :threw))) (Thread/interrupted)])))))" :expected "[true :late true]"}
