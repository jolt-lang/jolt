  ;; A hyphen munges to an underscore in a JVM package name, so a record literal or
  ;; a (munge (str *ns*)) lookup names the class my_app.core.Foo where jolt calls it
  ;; my-app.core.Foo. forName demunges to find it. Not certifiable on the JVM: its
  ;; own Class/forName cannot see a class this harness defined at eval time.
  {:suite "errors" :expr "(do (defrecord Foo-bar [a]) [(instance? (Class/forName \"user.Foo_bar\") (->Foo-bar 1)) (= (->Foo-bar 1) (clojure.lang.Reflector/invokeConstructor (Class/forName \"user.Foo_bar\") (object-array [1])))])" :expected "[true true]"}
