  ;; class-extensions (jolt#575): a library adds to / replaces the shim jolt
  ;; already has for a class, instead of replacing the whole class with its own.
  ;; jolt.host/extend-class! keys by class NAME, so every shim family — the jfile
  ;; record, a jhost, a jinst, a regex, a boxed number, a string — is reachable
  ;; through the one seam. Extensions are process-wide, so run-unit.ss clears them
  ;; between rows (class-ext-reset!).
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"java.io.File\" {:methods {\"shout\" (fn [self] (.toUpperCase (.getPath self)))}}) (.shout (java.io.File. \"a/b\")))" :expected "\"A/B\""}
  ;; the default tier only fills gaps — it cannot take a method the shim answers
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"java.io.File\" {:methods {\"getPath\" (fn [self] \"hijacked\")}}) (.getPath (java.io.File. \"a/b\")))" :expected "\"a/b\""}
  ;; …and :override does, for every caller in the process
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"java.io.File\" {:methods {\"getPath\" (fn [self] \"overridden\")} :override true}) (.getPath (java.io.File. \"a/b\")))" :expected "\"overridden\""}
  ;; a registration on a SUPERCLASS answers for a subclass receiver (class graph)
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"java.io.Reader\" {:methods {\"kind\" (fn [_] :reader)}}) (.kind (java.io.StringReader. \"x\")))" :expected ":reader"}
  ;; either spelling of the class name resolves
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"File\" {:methods {\"kind\" (fn [_] :file)}}) (.kind (java.io.File. \"a\")))" :expected ":file"}
  ;; a Class value (the bare token) names the class too
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! java.io.File {:methods {\"kind\" (fn [_] :token)}}) (.kind (java.io.File. \"a\")))" :expected ":token"}
  ;; jhost receiver (java.util.ArrayList)
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"java.util.ArrayList\" {:methods {\"secondItem\" (fn [self] (.get self 1))}}) (let [l (java.util.ArrayList.)] (.add l :a) (.add l :b) (.secondItem l)))" :expected ":b"}
  ;; jinst receiver (java.util.Date) — its arm used to raise its own message
  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"java.util.Date\" {:methods {\"epochish\" (fn [self] (.getTime self))}}) (.epochish (java.util.Date. 5)))" :expected "5"}
