  ;; resolved when the form is READ, before the require in it has run.
  {:suite "require / as-alias" :label "aliases without loading the target" :expected "[true false true]"
   :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-asalias-unit\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/aa\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/src/aa/other.clj\") \"(ns aa.other) (def marker :loaded)\") (jolt.deps/add-deps {:deps {'aa/aa {:local/root d}}}) (require '[aa.other :as-alias o]) [(some? (get (ns-aliases *ns*) 'o)) (some? (resolve 'aa.other/marker)) (some? (find-ns 'aa.other))]))"}
  {:suite "require / as-alias" :label ":as still loads" :expected ":loaded"
   :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-asalias-unit2\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/ab\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/src/ab/other.clj\") \"(ns ab.other) (def marker :loaded)\") (jolt.deps/add-deps {:deps {'ab/ab {:local/root d}}}) (require '[ab.other :as o]) @(resolve 'ab.other/marker)))"}
  ;; A libspec's :rename and :exclude qualify its :refer, and its :as goes
  ;; through the same collision rule as `alias` — load-lib hands refer every one
  ;; of :only/:exclude/:rename and calls alias for :as. :rename used to be
  ;; dropped (the referred name arrived under its source name), :exclude was
  ;; honoured only by a `use` that spelled no :refer key, and a second :as on
  ;; the same alias silently pointed it elsewhere.
  {:suite "require / libspec" :label ":rename binds the local name, not the source" :expected "[#{1 2} false]"
   :expr "(do (ns unit.rn1) (require '[clojure.set :refer [union] :rename {union my-union}]) [(my-union #{1} #{2}) (contains? (ns-refers 'unit.rn1) 'union)])"}
  {:suite "require / libspec" :label ":refer :all :rename excludes the source name" :expected "[#{1 2} false]"
   :expr "(do (ns unit.rn2) (require '[clojure.set :refer :all :rename {union u+}]) [(u+ #{1} #{2}) (contains? (ns-refers 'unit.rn2) 'union)])"}
  {:suite "require / libspec" :label ":refer :all :exclude leaves the name out" :expected "[\"A\" (2 1)]"
   :expr "(do (ns unit.ex1) (require '[clojure.string :refer :all :exclude [reverse]]) [(upper-case \"a\") (reverse [1 2])])"}
  {:suite "require / libspec" :label ":refer [names] :exclude drops the excluded one" :expected "[#{1 2} false]"
   :expr "(do (ns unit.ex2) (require '[clojure.set :refer [union intersection] :exclude [intersection]]) [(union #{1} #{2}) (contains? (ns-refers 'unit.ex2) 'intersection)])"}
  {:suite "require / libspec" :label ":as of an alias already aliasing another namespace throws" :expected "[\"java.lang.IllegalStateException\" :same-target-ok]"
   :expr "(do (ns unit.al1) (require '[clojure.set :as x]) [(try (require '[clojure.walk :as x]) :no-throw (catch IllegalStateException e (.getName (class e)))) (do (require '[clojure.set :as x]) :same-target-ok)])"}
  ;; Class.cast(null) is null for every target class on the JVM; it raised a
  ;; raw record-accessor fault here, from the arm that builds the failure message.
  {:suite "class" :expr "[(.cast Object nil) (.cast String nil) (.cast String \"x\") (try (.cast String 1) :no-throw (catch ClassCastException e :cce))]" :expected "[nil nil \"x\" :cce]"}
  ;; Collection.removeIf's default calls remove() only for an element the
  ;; predicate MATCHES, so on a non-empty immutable collection the predicate
  ;; decides: no match is false, a match is the refusal. It refused every
  ;; non-empty call before, predicate unread.
  {:suite "class" :expr "[(.removeIf [1 2] (constantly false)) (.removeIf [] (constantly true)) (try (.removeIf [1 2] odd?) :no-throw (catch UnsupportedOperationException e :uoe))]" :expected "[false false :uoe]"}
  ;; File.toURI of (File. "") is the working directory, a directory, so it ends
  ;; in a slash like every other existing directory's; the check used to read the
  ;; raw "" instead of the resolved path. Path.toUri names the same directory,
  ;; in its own "file:///" form (jolt-lang/jolt#1467).
  {:suite "class" :expr "(let [u (.toURI (java.io.File. \"\")) p (.toUri (java.nio.file.Paths/get \"\" (into-array String [])))] [(.endsWith (str u) \"/\") (instance? java.net.URI p) (= (str u) (str p)) (= (subs (str u) 5) (subs (str p) 7))])" :expected "[true true false true]"}
  ;; Path.toUri is not File.toURI (jolt-lang/jolt#1467): an empty authority, and
  ;; every byte outside the RFC 2396 path set escaped, non-ASCII as UTF-8.
  {:suite "path-touri" :expr "(mapv #(str (.toUri (java.nio.file.Paths/get % (into-array String [])))) [\"/x/plain.clj\" \"/x/\u00fcn\u00ef c\u00f6d\u00e9.clj\" \"/x/a%b[c]#d?e{f}.clj\" \"/x/a:@&=+$,;!~*'()_.-\"])" :expected "[\"file:///x/plain.clj\" \"file:///x/%C3%BCn%C3%AF%20c%C3%B6d%C3%A9.clj\" \"file:///x/a%25b%5Bc%5D%23d%3Fe%7Bf%7D.clj\" \"file:///x/a:@&=+$,;!~*'()_.-\"]"}
  {:suite "path-touri" :expr "(let [p (java.nio.file.Paths/get \"/x/\u00fc f.clj\" (into-array String [])) u (.toUri p)] [(.getPath u) (.getRawPath u) (.getAuthority u) (= p (java.nio.file.Paths/get u)) (.getPath (java.io.File. u))])" :expected "[\"/x/\u00fc f.clj\" \"/x/%C3%BC%20f.clj\" nil true \"/x/\u00fc f.clj\"]"}
  ;; A java.net.URI opens through its URL, as clojure.java.io's IOFactory does:
  ;; slurp, spit, io/reader, io/writer, io/input-stream and io/output-stream all
  ;; refused one before; a relative URI is refused as the JVM's toURL refuses it.
  {:suite "uri-io" :expr "(let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt uri ïo\") f (str d \"/ü f.txt\") u (.toUri (java.nio.file.Paths/get f (into-array String []))) u2 (.toURI (java.io.File. f))] (.mkdirs (java.io.File. d)) (spit u \"one\n\") (spit u2 \"two\n\" :append true) (with-open [w (clojure.java.io/writer u :append true)] (.write w \"three\n\")) (with-open [o (clojure.java.io/output-stream u2 :append true)] (.write o (.getBytes \"four\n\"))) [(slurp u) (with-open [r (clojure.java.io/reader u2)] (vec (line-seq r))) (with-open [i (clojure.java.io/input-stream u)] (slurp i))])" :expected "[\"one\\ntwo\\nthree\\nfour\\n\" [\"one\" \"two\" \"three\" \"four\"] \"one\\ntwo\\nthree\\nfour\\n\"]"}
  {:suite "uri-io" :expr "(mapv #(try (% (java.net.URI. \"a/b\")) (catch IllegalArgumentException e (ex-message e))) [slurp clojure.java.io/reader clojure.java.io/input-stream (fn [u] (.toURL u))])" :expected "[\"URI is not absolute\" \"URI is not absolute\" \"URI is not absolute\" \"URI is not absolute\"]"}
  ;; default-streams-impl is the IOFactory map a library assocs its own stream fns
  ;; onto (jolt-lang/jolt#1665); the stream fns refuse, reader and writer delegate.
  {:suite "io-default-streams" :label "var has the four method keys" :expr "(sort (keys clojure.java.io/default-streams-impl))" :expected "(:make-input-stream :make-output-stream :make-reader :make-writer)"}
  {:suite "io-default-streams" :label "extended input side reads through input-stream and reader" :expr "(do (deftype Ds1 [s]) (extend Ds1 clojure.java.io/IOFactory (assoc clojure.java.io/default-streams-impl :make-input-stream (fn [x opts] (java.io.ByteArrayInputStream. (.getBytes (.-s x)))))) [(slurp (clojure.java.io/input-stream (->Ds1 \"hi\"))) (slurp (clojure.java.io/reader (->Ds1 \"yo\")))])" :expected "[\"hi\" \"yo\"]"}
  {:suite "io-default-streams" :label "extended input side leaves the output side refusing" :expr "(do (deftype Ds2 [s]) (extend Ds2 clojure.java.io/IOFactory (assoc clojure.java.io/default-streams-impl :make-input-stream (fn [x opts] (java.io.ByteArrayInputStream. (.getBytes \"a\"))))) (mapv #(try (% (->Ds2 1)) (catch IllegalArgumentException e (.replaceAll (ex-message e) \"<.*>\" \"<x>\"))) [clojure.java.io/writer clojure.java.io/output-stream]))" :expected "[\"Cannot open <x> as an OutputStream.\" \"Cannot open <x> as an OutputStream.\"]"}
  {:suite "io-default-streams" :label "the default stream fns refuse, reader and writer delegate to them" :expr "(mapv #(try (% 5 {}) (catch IllegalArgumentException e (ex-message e))) (map clojure.java.io/default-streams-impl [:make-input-stream :make-output-stream :make-reader :make-writer]))" :expected "[\"Cannot open <5> as an InputStream.\" \"Cannot open <5> as an OutputStream.\" \"Cannot open <5> as an InputStream.\" \"Cannot open <5> as an OutputStream.\"]"}
  {:suite "io-default-streams" :label "extended output side writes through output-stream and writer" :expr "(do (deftype Ds3 [^java.io.ByteArrayOutputStream b]) (extend Ds3 clojure.java.io/IOFactory (assoc clojure.java.io/default-streams-impl :make-output-stream (fn [x opts] (.-b x)))) (let [b (java.io.ByteArrayOutputStream.)] (with-open [w (clojure.java.io/writer (->Ds3 b))] (.write w \"out\")) (str b)))" :expected "\"out\""}
  {:suite "io-default-streams" :label "slurp and spit go through the extension" :expr "(do (deftype Ds4 [s]) (defrecord Ds5 [^java.io.ByteArrayOutputStream b]) (extend Ds4 clojure.java.io/IOFactory (assoc clojure.java.io/default-streams-impl :make-input-stream (fn [x opts] (java.io.ByteArrayInputStream. (.getBytes (.-s x)))))) (extend Ds5 clojure.java.io/IOFactory (assoc clojure.java.io/default-streams-impl :make-output-stream (fn [x opts] (:b x)))) (let [b (java.io.ByteArrayOutputStream.)] (spit (->Ds5 b) \"sp\") (spit (->Ds5 b) 42) [(slurp (->Ds4 \"sl\")) (str b) (try (slurp (->Ds5 b)) (catch IllegalArgumentException e (.replaceAll (ex-message e) \"<.*>\" \"<x>\")))]))" :expected "[\"sl\" \"sp42\" \"Cannot open <x> as an InputStream.\"]"}
  ;; URI.toASCIIString percent-encodes every non-ASCII character, NFC first, as
  ;; UTF-8 in every component (jolt-lang/jolt#1468); toString keeps it raw.
  {:suite "uri-ascii" :expr "(mapv #(vector (str %) (.toASCIIString %)) [(java.net.URI. \"file\" nil \"/x/\u00fcn\u00ef c\u00f6d\u00e9.clj\" nil) (java.net.URI. \"http\" nil \"/p\u00e4th\" \"q\u00fcery=\u00fc\" \"fr\u00e4gment\") (java.net.URI. \"http://ex\u00e4mple.com/p\u00e4th?q=\u00fc#fr\u00e4\")])" :expected "[[\"file:/x/\u00fcn\u00ef%20c\u00f6d\u00e9.clj\" \"file:/x/%C3%BCn%C3%AF%20c%C3%B6d%C3%A9.clj\"] [\"http:/p\u00e4th?q\u00fcery=\u00fc#fr\u00e4gment\" \"http:/p%C3%A4th?q%C3%BCery=%C3%BC#fr%C3%A4gment\"] [\"http://ex\u00e4mple.com/p\u00e4th?q=\u00fc#fr\u00e4\" \"http://ex%C3%A4mple.com/p%C3%A4th?q=%C3%BC#fr%C3%A4\"]]"}
  {:suite "uri-ascii" :expr "[(.toASCIIString (java.net.URI. \"http://h/ae\u0301\")) (.toASCIIString (java.net.URI. \"http://h/a%20b?x=1\")) (.toASCIIString (java.net.URI. \"http://h/\ud83d\ude00\"))]" :expected "[\"http://h/a%C3%A9\" \"http://h/a%20b?x=1\" \"http://h/%F0%9F%98%80\"]"}
  {:suite "jolt-version" :label "*jolt-version* is a non-blank string" :expected "true" :expr "(and (string? *jolt-version*) (pos? (count *jolt-version*)))"}
  {:suite "jolt-version" :label "property and host fn match the var" :expected "true" :expr "(= *jolt-version* (System/getProperty \"jolt.version\") (jolt.host/jolt-version))"}
  {:suite "add-deps" :label "inline :local/root dep becomes requirable" :expected ":pong" :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-adddep-unit\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/adddep\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/src/adddep/core.clj\") \"(ns adddep.core) (defn ping [] :pong)\") (jolt.deps/add-deps {:deps {'adddep/adddep {:local/root d}}}) (require 'adddep.core) ((resolve 'adddep.core/ping))))"}
