  {:suite "nio-move" :label "an atomic move answers each case as the JDK does" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jam\" fa) p (fn [s] (.resolve d s)) w (fn [s txt] (spit (str (p s)) txt)) A (into-array java.nio.file.CopyOption [java.nio.file.StandardCopyOption/ATOMIC_MOVE]) mv (fn [a b] (try (java.nio.file.Files/move (p a) (p b) A) :moved (catch Exception e [(.getSimpleName (class e)) (clojure.string/replace (.getMessage e) (str d) \"D\")]))) perms #(java.nio.file.Files/setPosixFilePermissions (p \"ro\") (java.nio.file.attribute.PosixFilePermissions/fromString %))] (w \"a\" \"new\") (w \"b\" \"old\") (java.nio.file.Files/createDirectory (p \"dir\") fa) (java.nio.file.Files/createDirectory (p \"e1\") fa) (java.nio.file.Files/createDirectory (p \"e2\") fa) (java.nio.file.Files/createDirectory (p \"ro\") fa) (w \"dir/c\" \"c\") (w \"f\" \"f\") (perms \"r-xr-xr-x\") (let [r [(mv \"a\" \"b\") (slurp (str (p \"b\"))) (mv \"zz\" \"b\") (mv \"f\" \"dir\") (mv \"e1\" \"e2\") (mv \"e2\" \"dir\") (mv \"f\" \"no/f\") (mv \"f\" \"ro/f\")]] (perms \"rwxr-xr-x\") (doseq [s [\"dir/c\" \"dir\" \"e1\" \"e2\" \"ro\" \"a\" \"b\" \"f\"]] (java.nio.file.Files/deleteIfExists (p s))) (java.nio.file.Files/delete d) r))" :expected "[:moved \"new\" [\"NoSuchFileException\" \"D/zz -> D/b\"] [\"FileSystemException\" \"D/f -> D/dir: Is a directory\"] :moved [\"FileSystemException\" \"D/e2 -> D/dir: Directory not empty\"] [\"NoSuchFileException\" \"D/f -> D/no/f\"] [\"AccessDeniedException\" \"D/f -> D/ro/f\"]]"}
  ;; the accessors keep apart what the message runs together, on what jolt throws
