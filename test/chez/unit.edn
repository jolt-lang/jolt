  ;; multimethod dispatch cache — behavior the cache (a perf optimization) must
  ;; preserve. Each "after" value can only stay correct if the cache invalidates
  ;; on defmethod / derive / underive / prefer-method / remove-method, so these
  ;; rows guard the invalidation machinery (jolt-mw44.30).
  {:suite "mm-cache" :label "isa?-dispatch via derive (2-level) resolves to the registered method" :expected "[:A :A :A]" :expr "(do (defmulti f (fn [x] x)) (defmethod f :p/a [x] :A) (derive :c/b :p/a) (derive :c/c :c/b) [(f :p/a) (f :c/b) (f :c/c)])"}
  {:suite "mm-cache" :label "a closer ancestor added AFTER the first dispatch wins (defmethod + derive invalidate the cached resolution)" :expected "[:ROOT :MID]" :expr "(do (defmulti f (fn [x] x)) (defmethod f :p/root [x] :ROOT) (derive :c/child :p/root) (let [b (f :c/child)] (derive :p/mid :p/root) (derive :c/child :p/mid) (defmethod f :p/mid [x] :MID) [b (f :c/child)]))"}
  {:suite "mm-cache" :label "underive after the first dispatch falls through to :default (hierarchy mutation invalidates)" :expected "[:A :DEF]" :expr "(do (defmulti f (fn [x] x) :default :d) (defmethod f :p/a [x] :A) (defmethod f :d [x] :DEF) (derive :c/c :p/a) (let [b (f :c/c)] (underive :c/c :p/a) [b (f :c/c)]))"}
  {:suite "mm-cache" :label "prefer-method breaks an isa? tie" :expected ":B" :expr "(do (defmulti f (fn [x] x)) (defmethod f :p/a [x] :A) (defmethod f :p/b [x] :B) (derive :c/c :p/a) (derive :c/c :p/b) (prefer-method f :p/b :p/a) (f :c/c))"}
  {:suite "mm-cache" :label "prefer-method re-resolves a value already cached for the other branch (derive + prefer invalidate)" :expected "[:A :B]" :expr "(do (defmulti f (fn [x] x)) (defmethod f :p/a [x] :A) (defmethod f :p/b [x] :B) (derive :c/c :p/a) (let [b (f :c/c)] (derive :c/c :p/b) (prefer-method f :p/b :p/a) [b (f :c/c)]))"}
  {:suite "mm-cache" :label "remove-method after the first dispatch falls through to :default (remove un-caches)" :expected "[:A :DEF]" :expr "(do (defmulti f (fn [x] x) :default :d) (defmethod f :p/a [x] :A) (defmethod f :d [x] :DEF) (derive :c/c :p/a) (let [b (f :c/c)] (remove-method f :p/a) [b (f :c/c)]))"}
  ;; re-defmulti currently CLOBBERS methods (jolt-mw44.30; JVM keeps them —
  ;; jolt-mw44.51 stays an open bead). Pinned AS-IS so a cache change can't
  ;; quietly alter it: after re-defmulti the prior method is gone (default used).
  {:suite "mm-cache" :label "re-defmulti is a no-op: the first definition and its methods stand, so a later :default option never applies" :expected :throws :expr "(do (defmulti f (fn [x] x)) (defmethod f :a [x] :got-a) (defmulti f (fn [x] x) :default :d) (defmethod f :d [x] :DEF) [(f :a) (f :anything)])"}
  {:suite "multimethods / re-defmulti keeps methods" :expr "(do (defmulti mmr identity) (defmethod mmr :a [_] :hit) (defmulti mmr identity) (mmr :a))" :expected ":hit"}
  ;; clojure.math / java.lang.Math: Chez extends several real-domain ops onto the
  ;; complex plane for out-of-domain real inputs, but Java returns NaN there. The
  ;; run-unit harness compares the PRINTED form, so :expected "##NaN" is a string
  ;; compare (sidesteps the (= ##NaN ##NaN) falsity). In-domain results are pinned
  ;; unchanged, including negative-base integer exponents and -Inf passthrough.
  {:suite "math-nan" :label "clojure.math/sqrt negative -> NaN" :expected "##NaN" :expr "(clojure.math/sqrt -1.0)"}
  {:suite "math-nan" :label "clojure.math/pow neg base fractional exp -> NaN" :expected "##NaN" :expr "(clojure.math/pow -2.0 0.5)"}
  {:suite "math-nan" :label "clojure.math/log negative -> NaN" :expected "##NaN" :expr "(clojure.math/log -1.0)"}
  {:suite "math-nan" :label "clojure.math/asin out of domain -> NaN" :expected "##NaN" :expr "(clojure.math/asin 2.0)"}
  {:suite "math-nan" :label "clojure.math/acos out of domain -> NaN" :expected "##NaN" :expr "(clojure.math/acos 2.0)"}
  {:suite "math-nan" :label "clojure.math/log10 negative -> NaN" :expected "##NaN" :expr "(clojure.math/log10 -1.0)"}
  {:suite "math-nan" :label "clojure.math/log1p below -1 -> NaN" :expected "##NaN" :expr "(clojure.math/log1p -2.0)"}
  {:suite "math-nan" :label "Math/sqrt negative -> NaN" :expected "##NaN" :expr "(Math/sqrt -1.0)"}
  {:suite "math-nan" :label "Math/pow neg base fractional exp -> NaN" :expected "##NaN" :expr "(Math/pow -2.0 0.5)"}
  {:suite "math-nan" :label "Math/log negative -> NaN" :expected "##NaN" :expr "(Math/log -1.0)"}
  {:suite "math-nan" :label "Math/asin out of domain -> NaN" :expected "##NaN" :expr "(Math/asin 2.0)"}
  {:suite "math-nan" :label "Math/acos out of domain -> NaN" :expected "##NaN" :expr "(Math/acos 2.0)"}
  {:suite "math-nan" :label "Math/log10 negative -> NaN" :expected "##NaN" :expr "(Math/log10 -1.0)"}
  {:suite "math-nan" :label "Math/log1p below -1 -> NaN" :expected "##NaN" :expr "(Math/log1p -2.0)"}
  {:suite "math-nan" :label "sqrt in-domain unchanged" :expected "2.0" :expr "(clojure.math/sqrt 4.0)"}
