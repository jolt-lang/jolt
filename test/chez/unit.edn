  ;; *compile-path* raises "*compile-path* not set", like Compiler.compile.
  ;; The artifact is only picked up once its directory is also a source root —
  ;; jolt's classpath — which is the JVM's "that directory too must be in the
  ;; classpath" caveat. `out` is a second :local/root project so add-deps puts
  ;; out/src on the roots.
  {:suite "compile / compile-path" :label "nil *compile-path* is an error" :expected :throws
   :expr "(binding [*compile-path* nil] (compile 'clojure.string))"}
  {:suite "compile / compile-path" :label "unknown namespace is an error" :expected :throws
   :expr "(compile 'no.such.namespace.at.all)"}
  {:suite "compile / compile-path" :label "writes an artifact and returns the lib" :expected "[cpath.core true :compiled]"
   :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-compilepath-unit\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/cpath \" d \"/out\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/out/deps.edn\") \"{}\") (spit (str d \"/src/cpath/core.clj\") \"(ns cpath.core) (defn v [] :compiled)\") (jolt.deps/add-deps {:deps {'cpath/cpath {:local/root d}}}) [(binding [*compile-path* (str d \"/out/src\")] (compile 'cpath.core)) (.exists (java.io.File. (str d \"/out/src/cpath/core.so\"))) ((resolve 'cpath.core/v))]))"}
  {:suite "compile / compile-path" :label "a compiled namespace loads with no source present" :expected ":compiled"
   :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-compilepath-unit2\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/cpath2 \" d \"/out\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/out/deps.edn\") \"{}\") (spit (str d \"/src/cpath2/core.clj\") \"(ns cpath2.core) (defn v [] :compiled)\") (jolt.deps/add-deps {:deps {'cpath/cpath {:local/root d}}}) (binding [*compile-path* (str d \"/out/src\")] (compile 'cpath2.core)) (jolt.deps/add-deps {:deps {'cpathout/cpathout {:local/root (str d \"/out\")}}}) (jolt.host/sh (str \"rm -rf \" d \"/src\")) (require 'cpath2.core :reload) ((resolve 'cpath2.core/v))))"}
  {:suite "compile / compile-path" :label "an edited source beats a stale artifact" :expected ":edited"
   :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-compilepath-unit3\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/cpath3 \" d \"/out\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/out/deps.edn\") \"{}\") (spit (str d \"/src/cpath3/core.clj\") \"(ns cpath3.core) (defn v [] :compiled)\") (jolt.deps/add-deps {:deps {'cpath/cpath {:local/root d}}}) (binding [*compile-path* (str d \"/out/src\")] (compile 'cpath3.core)) (jolt.deps/add-deps {:deps {'cpathout/cpathout {:local/root (str d \"/out\")}}}) (spit (str d \"/src/cpath3/core.clj\") \"(ns cpath3.core) (defn v [] :edited)\") (require 'cpath3.core :reload) ((resolve 'cpath3.core/v))))"}
  ;; :as-alias aliases without loading, like clojure.core's load-lib, which picks
  ;; its loader with `need-ns (or as use)` and falls to (create-ns lib). jolt used
  ;; to load the target AND drop the alias on the floor.
  ;; the alias is checked through ns-aliases, not ::o/x — an auto keyword is
  ;; resolved when the form is READ, before the require in it has run.
  {:suite "require / as-alias" :label "aliases without loading the target" :expected "[true false true]"
   :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-asalias-unit\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/aa\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/src/aa/other.clj\") \"(ns aa.other) (def marker :loaded)\") (jolt.deps/add-deps {:deps {'aa/aa {:local/root d}}}) (require '[aa.other :as-alias o]) [(some? (get (ns-aliases *ns*) 'o)) (some? (resolve 'aa.other/marker)) (some? (find-ns 'aa.other))]))"}
  {:suite "require / as-alias" :label ":as still loads" :expected ":loaded"
   :expr "(do (require 'jolt.deps) (let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt-asalias-unit2\")] (jolt.host/sh (str \"rm -rf \" d)) (jolt.host/sh (str \"mkdir -p \" d \"/src/ab\")) (spit (str d \"/deps.edn\") \"{}\") (spit (str d \"/src/ab/other.clj\") \"(ns ab.other) (def marker :loaded)\") (jolt.deps/add-deps {:deps {'ab/ab {:local/root d}}}) (require '[ab.other :as o]) @(resolve 'ab.other/marker)))"}
