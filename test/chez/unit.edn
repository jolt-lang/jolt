  {:suite "jvm-misc" :label "class answers each kind of host table and host object, whichever was asked first" :expr "[(class (sorted-map 1 2)) (class (sorted-set 1)) (class (sorted-map)) (class (sorted-set)) (class (java.io.File. \"/tmp\")) (class (java.io.StringReader. \"x\")) (class (java.io.BufferedReader. (java.io.StringReader. \"x\")))]" :expected "[clojure.lang.PersistentTreeMap clojure.lang.PersistentTreeSet clojure.lang.PersistentTreeMap clojure.lang.PersistentTreeSet java.io.File java.io.StringReader java.io.BufferedReader]"}
  {:suite "jvm-misc" :label "a core.async channel prints as Object's #object form over its toString, as on the JVM" :expr "(do (require 'clojure.core.async) (let [c (clojure.core.async/chan) h (Integer/toHexString (System/identityHashCode c)) n \"clojure.core.async.impl.channels.ManyToManyChannel\"] [(= (pr-str c) (str \"#object[\" n \" 0x\" h \" \\\"\" n \"@\" h \"\\\"]\")) (= (str c) (str n \"@\" h))]))" :expected "[true true]"}
  {:suite "jvm-misc" :label "a fn's class is named as Compiler names it: a defn's ns$f, a fn inside one ns$f$fn__N, a named fn name__N, nested fns, a def'd fn, letfn, #(), a let-bound fn by its local, a deftype method's fn, the evalN of a top-level form; str, pr-str and getSimpleName agree (the counters are jolt's, see known-divergences)" :expr "(load-string \"(ns rfc1.ns) (defn n [s] (clojure.string/replace s #\\\"(__|eval)\\\\d+\\\" \\\"$1N\\\")) (defn cn [f] (n (.getName (class f)))) (defn mk [] (fn [] 1)) (defn mk2 [] (fn inner [] 1)) (defn mk3 [] (fn [] (fn [] 1))) (def f (fn [] 1)) (def g (fn gg [] 1)) (defn lf [] (letfn [(h [] 1)] h)) (defn pm [] #(inc %)) (defn lt [] (let [loc (fn [] 1)] loc)) (defn dash-name! [] 1) (deftype T [] clojure.lang.IFn (invoke [_] (fn [] 1))) (def ff (let [x 1] (fn [] x))) [(cn mk) (cn (mk)) (cn (mk2)) (cn ((mk3))) (cn f) (cn g) (cn (lf)) (cn (pm)) (cn (lt)) (cn dash-name!) (cn ((T.))) (cn ff) (cn (fn [] 1)) (n (str (class (mk)))) (n (re-find #\\\"^#object\\\\[\\\\S+\\\" (pr-str (mk)))) (n (.getSimpleName (class (mk)))) (= (class (mk)) (class (mk))) (= (class (mk)) (class (mk2)))]\")" :expected "[\"rfc1.ns$mk\" \"rfc1.ns$mk$fn__N\" \"rfc1.ns$mk2$inner__N\" \"rfc1.ns$mk3$fn__N$fn__N\" \"rfc1.ns$f\" \"rfc1.ns$gg__N\" \"rfc1.ns$lf$h__N\" \"rfc1.ns$pm$fn__N\" \"rfc1.ns$lt$loc__N\" \"rfc1.ns$dash_name_BANG_\" \"rfc1.ns.T$fn__N\" \"rfc1.ns$fn__N$fn__N\" \"rfc1.ns$evalN$fn__N\" \"class rfc1.ns$mk$fn__N\" \"#object[rfc1.ns$mk$fn__N\" \"ns$mk$fn__N\" true false]"}
  {:suite "jvm-misc" :label "...one class per fn literal: class-keyed dispatch and instance? on (class f) tell two sites apart" :expr "(load-string \"(ns rfc2.ns) (defn mk [] (fn [] 1)) (defn mk2 [] (fn [] 2)) (defmulti by-class class) (defmethod by-class (class (mk)) [_] :mk) (defmethod by-class :default [_] :default) [(by-class (mk)) (by-class (mk2)) (instance? (class (mk)) (mk)) (instance? (class (mk)) (mk2)) (fn? (mk)) (instance? clojure.lang.AFunction (mk)) (instance? clojure.lang.IFn (mk))]\")" :expected "[:mk :default true false true true true]"}
  {:suite "jvm-misc" :label "...ArityException names a fn by its demunged class, a core fn defined early by its own class (clojure.core/first--N)" :expr "(load-string \"(ns rfc3.ns) (defn n [s] (clojure.string/replace s #\\\"(__|--|eval)\\\\d+\\\" \\\"$1N\\\")) (defn mk [] (fn [] 1)) (defn mk2 [] (fn inner [] 1)) (defn t [f] (try (f) (catch clojure.lang.ArityException e (n (.getMessage e))))) [(t #((mk) 1)) (t #((mk2) 1)) (t #(mk 1)) (t #(first)) (t #((let [g (fn [] 1)] g) 1))]\")" :expected "[\"Wrong number of args (1) passed to: rfc3.ns/mk/fn--N\" \"Wrong number of args (1) passed to: rfc3.ns/mk2/inner--N\" \"Wrong number of args (1) passed to: rfc3.ns/mk\" \"Wrong number of args (0) passed to: clojure.core/first--N\" \"Wrong number of args (1) passed to: rfc3.ns/evalN/fn--N/g--N\"]"}
  {:suite "jvm-misc" :label "...clojure.core's closures and transducers report the reference's classes (every-pred's ep1, some-fn's spn, mapcat's comp fn, map's reducing fn)" :expr "(do (defn n [s] (clojure.string/replace s #\"(__|eval)\\d+\" \"$1N\")) (mapv (fn [f] (n (.getName (class f)))) [(map inc) ((map inc) conj) (filter odd?) (remove odd?) (take 1) (drop 1) (take-while odd?) (drop-while odd?) (mapcat identity) (cat conj) (partial + 1) (comp inc dec) (juxt inc) (complement odd?) (constantly 1) (every-pred odd?) (every-pred odd? even?) (some-fn odd?) (some-fn odd? even? pos? neg?) (fnil inc 0) (memoize inc) (replace {}) identity first assoc list not-any? map]))" :expected "[\"clojure.core$map$fn__N\" \"clojure.core$map$fn__N$fn__N\" \"clojure.core$filter$fn__N\" \"clojure.core$filter$fn__N\" \"clojure.core$take$fn__N\" \"clojure.core$drop$fn__N\" \"clojure.core$take_while$fn__N\" \"clojure.core$drop_while$fn__N\" \"clojure.core$comp$fn__N\" \"clojure.core$cat$fn__N\" \"clojure.core$partial$fn__N\" \"clojure.core$comp$fn__N\" \"clojure.core$juxt$fn__N\" \"clojure.core$complement$fn__N\" \"clojure.core$constantly$fn__N\" \"clojure.core$every_pred$ep1__N\" \"clojure.core$every_pred$ep2__N\" \"clojure.core$some_fn$sp1__N\" \"clojure.core$some_fn$spn__N\" \"clojure.core$fnil$fn__N\" \"clojure.core$memoize$fn__N\" \"clojure.core$map$fn__N\" \"clojure.core$identity\" \"clojure.core$first__N\" \"clojure.core$assoc__N\" \"clojure.lang.PersistentList$Primordial\" \"clojure.core$comp$fn__N\" \"clojure.core$map\"]"}
  {:suite "jvm-misc" :label "every-pred and some-fn are the reference's: arities, predicate order and boolean results; replace has its transducer arity" :expr "[((every-pred odd?) 1 3 5 7) ((every-pred odd? pos?) 1 3 -5) ((some-fn #{1}) 2 3 4 1) (let [log (atom [])] ((some-fn (fn [x] (swap! log conj [:a x]) nil) (fn [x] (swap! log conj [:b x]) nil) (fn [x] (swap! log conj [:c x]) nil)) 1 2) @log) (let [log (atom [])] ((some-fn (fn [x] (swap! log conj [:a x]) nil) (fn [x] (swap! log conj [:b x]) nil) (fn [x] (swap! log conj [:c x]) nil) (fn [x] (swap! log conj [:d x]) nil)) 1 2) @log) (into [] (replace {1 :one}) [1 2 1]) (try (every-pred) (catch clojure.lang.ArityException e :arity))]" :expected "[true false 1 [[:a 1] [:a 2] [:b 1] [:b 2] [:c 1] [:c 2]] [[:a 1] [:a 2] [:b 1] [:b 2] [:c 1] [:c 2] [:d 1] [:d 2]] [:one 2 :one] :arity]"}
  {:suite "jvm-misc" :label "an auto-gensym is spelled x__N__auto__ as the reference's" :expr "(clojure.string/replace (str `a#) #\"\\d+\" \"N\")" :expected "\"a__N__auto__\""}
