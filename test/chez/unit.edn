  {:suite "securerandom" :expr "(let [r (SecureRandom.)] (every? (fn [x] (and (>= x 0) (< x 10))) (repeatedly 500 (fn [] (.nextInt r 10)))))" :expected "true"}
  {:suite "securerandom" :expr "(let [r (SecureRandom.) b (byte-array 16)] (.nextBytes r b) [(alength b) (> (count (distinct (seq b))) 4)])" :expected "[16 true]"}
  {:suite "securerandom" :expr "(alength (.generateSeed (SecureRandom.) 32))" :expected "32"}
  {:suite "securerandom" :expr "(let [r (SecureRandom.)] (every? (fn [x] (and (>= x 0.0) (< x 1.0))) (repeatedly 200 (fn [] (.nextDouble r)))))" :expected "true"}
  {:suite "securerandom" :expr "(let [r (SecureRandom.)] (= #{true false} (set (repeatedly 200 (fn [] (.nextBoolean r))))))" :expected "true"}
  {:suite "securerandom" :expr "(let [r (SecureRandom.)] (= 200 (count (distinct (repeatedly 200 (fn [] (.nextLong r)))))))" :expected "true"}
  {:suite "securerandom" :expr "(let [r (SecureRandom.)] (= 200 (count (distinct (repeatedly 200 (fn [] (.nextInt r)))))))" :expected "true"}
  {:suite "securerandom" :expr "(int? (.nextInt (SecureRandom/getInstance \"SHA1PRNG\") 100))" :expected "true"}
  {:suite "securerandom" :expr "(int? (.nextInt (SecureRandom/getInstanceStrong) 100))" :expected "true"}
  {:suite "securerandom" :expr "(try (.nextInt (SecureRandom.) 0) :no-throw (catch IllegalArgumentException e :threw))" :expected ":threw"}
  {:suite "securerandom" :expr "(let [r (SecureRandom.)] (.setSeed r 42) (int? (.nextInt r 100)))" :expected "true"}
  {:suite "securerandom" :expr "(let [r (SecureRandom.)] (every? (fn [x] (and (>= x 0.0) (< x 1.0))) (repeatedly 100 (fn [] (.nextFloat r)))))" :expected "true"}
  {:suite "uuid" :expr "(let [u (str (random-uuid))] [(count u) (nth u 14) (contains? #{\\8 \\9 \\a \\b} (nth u 19))])" :expected "[36 \\4 true]"}
  {:suite "uuid" :expr "(count (distinct (repeatedly 2000 #(str (random-uuid)))))" :expected "2000"}
  {:suite "uuid" :expr "(every? (fn [_] (re-matches #\"[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\" (str (random-uuid)))) (range 200))" :expected "true"}
  {:suite "uuid" :expr "(let [us (repeatedly 400 #(str (random-uuid)))] (every? #(> (count (distinct (map (fn [u] (nth u %)) us))) 8) [0 1 2 7 9 35]))" :expected "true"}
  {:suite "uuid" :expr "(= (str (random-uuid)) (str (random-uuid)))" :expected "false"}
  ;; defonce takes (name doc-string? init), the shape `def` takes. The docstring
  ;; position is a jolt superset (see :permissive in known-divergences.edn — the
  ;; JVM's defonce is [name expr] and raises ArityException there), so it cannot be
  ;; a corpus row. The rest of the parse is def's to the letter.
  {:suite "defonce-shape" :expr "(do (defonce du-a \"the doc\" 42) [du-a (:doc (meta #'du-a))])" :expected "[42 \"the doc\"]"}
  ;; a LONE string is the init, not a docstring — (def x \"s\") means the same
  {:suite "defonce-shape" :expr "(do (defonce du-b \"just a value\") [du-b (:doc (meta #'du-b))])" :expected "[\"just a value\" nil]"}
  ;; ^meta on the name rides along beside the docstring; an explicit docstring
  ;; wins over ^{:doc ...}, exactly as it does for def
  {:suite "defonce-shape" :expr "(do (defonce ^:private ^{:doc \"from meta\"} du-c \"from docstring\" 1) [(:private (meta #'du-c)) (:doc (meta #'du-c))])" :expected "[true \"from docstring\"]"}
  ;; the init is still evaluated at most once
  {:suite "defonce-shape" :expr "(do (def du-d-runs (atom 0)) (defonce du-d \"doc\" (do (swap! du-d-runs inc) 1)) (defonce du-d \"doc\" (do (swap! du-d-runs inc) 2)) [du-d @du-d-runs])" :expected "[1 1]"}
  ;; and a shape that is neither gets a named error rather than a silent mis-parse
  {:suite "defonce-shape" :expr "(try (eval '(defonce du-e)) (catch Throwable e (class e)))" :expected "java.lang.IllegalArgumentException"}
  {:suite "defonce-shape" :expr "(try (eval '(defonce du-f 1 2 3)) (catch Throwable e (class e)))" :expected "java.lang.IllegalArgumentException"}
  ;; The reflection member model: jolt reports what its registries KNOW a class
  ;; declares, not what the JVM ships. Three registries answer: the protocol/type
  ;; registry (a deftype's methods), the host shim tables (an ArrayList's), and
  ;; class-statics (a procedure is a static method, anything else a static field's
  ;; value). A member that lives in none of them — String's instance methods are a
  ;; `cond` in natives-str.ss, not data anything can enumerate — is absent rather
  ;; than guessed at. jolt-only: the JVM answers differently by construction, so
  ;; these cannot be corpus rows.
  {:suite "reflect-member-model" :expr "(let [ns (set (map (fn [m] (.getName m)) (.getMethods String)))] [(contains? ns \"format\") (contains? ns \"substring\")])" :expected "[true false]"}
  {:suite "reflect-member-model" :expr "(java.lang.reflect.Modifier/isStatic (.getModifiers (.getMethod String \"format\" nil)))" :expected "true"}
  {:suite "reflect-member-model" :expr "(mapv (fn [f] (.getName f)) (.getDeclaredFields String))" :expected "[\"CASE_INSENSITIVE_ORDER\"]"}
  ;; a registered static is a Field, and reading it reflectively gives the value
  ;; the static reference gives
  {:suite "reflect-member-model" :expr "(.get (.getField Long \"MAX_VALUE\") nil)" :expected "9223372036854775807"}
  {:suite "reflect-member-model" :expr "(sort (map (fn [f] (.getName f)) (.getDeclaredFields Long)))" :expected "(\"MAX_VALUE\" \"MIN_VALUE\" \"TYPE\")"}
  {:suite "reflect-member-model" :expr "(identical? (.get (.getField clojure.lang.RT \"REQUIRE_LOCK\") clojure.lang.RT) clojure.lang.RT/REQUIRE_LOCK)" :expected "true"}
  {:suite "reflect-member-model" :expr "(try (.getField Long \"NOPE\") (catch NoSuchFieldException _ :nsf))" :expected ":nsf"}
  ;; a shim-backed class reports the methods its tag registers
  {:suite "reflect-member-model" :expr "(contains? (set (map (fn [m] (.getName m)) (.getMethods java.util.ArrayList))) \"add\")" :expected "true"}
  ;; a member object is a java.lang.reflect.* value, not an opaque :object
  {:suite "reflect-member-model" :expr "(mapv class [(.getField Long \"MAX_VALUE\") (.getMethod Math \"floor\" nil) (first (.getConstructors java.util.ArrayList))])" :expected "[java.lang.reflect.Field java.lang.reflect.Method java.lang.reflect.Constructor]"}
  {:suite "reflect-member-model" :expr "(str (.getField Long \"MAX_VALUE\"))" :expected "\"public static final java.lang.Object java.lang.Long.MAX_VALUE\""}
  ;; getMethod / getConstructor select by parameter COUNT (jolt has no signatures)
  ;; and raise NoSuchMethodException only for a name no registry has
  {:suite "reflect-member-model" :expr "(try (.getMethod Math \"nope\" nil) (catch NoSuchMethodException _ :nsm))" :expected ":nsm"}
  {:suite "reflect-member-model" :expr "(do (defrecord RC [a b]) (.getParameterCount (.getConstructor RC (into-array Class [Object Object]))))" :expected "2"}
  {:suite "reflect-member-model" :expr "(.invoke (.getMethod Math \"floor\" nil) nil (into-array Object [2.7]))" :expected "2.0"}
  {:suite "reflect-member-model" :expr "(do (defprotocol PA (pa [this])) (defprotocol PB (pb [this])) (deftype TT [] PA (pa [_] 1) PB (pb [_] 2)) (count (.getMethods TT)))" :expected "2"}
  {:suite "reflect-member-model" :expr "(do (defrecord RR [a b]) (mapv (fn [f] (.getName f)) (.getDeclaredFields RR)))" :expected "[\"a\" \"b\"]"}
  {:suite "reflect-member-model" :expr "(do (defrecord RS [a]) (.getName (.getDeclaredField RS \"a\")))" :expected "\"a\""}
  {:suite "reflect-member-model" :expr "(do (defrecord RT [a]) (= (.getName (.getField RT \"a\")) (.getName (.getDeclaredField RT \"a\"))))" :expected "true"}
  ;; the class graph answers modifiers for a name it models; one it does not
  ;; reports PUBLIC alone rather than claiming non-finality it cannot know
  {:suite "reflect-member-model" :expr "(.getModifiers (Class/forName \"java.lang.Thread\"))" :expected "1"}
  ;; Class.cast is the checked narrowing a reflective caller uses to hand a
  ;; method its (Object) parameter type; without it the lookup fell through to
  ;; resolving the class by name, which raised for java.lang.Object.
  {:suite "reflect-member-model" :expr "(.cast java.lang.Object \"x\")" :expected "\"x\""}
  {:suite "reflect-member-model" :expr "(try (.cast java.lang.String 42) (catch ClassCastException _ :cce))" :expected ":cce"}
  ;; Reflector/getMethods answers the reflective interpretation of a method call:
  ;; the members a class enumerates when it has them, and a name-dispatch member
  ;; when its methods are a cond over the receiver (String, the collections) —
  ;; which is what an interpreted call needs and what a getMethods-only caller
  ;; cannot get from the member model above.
  {:suite "reflect-member-model" :expr "(let [ms (clojure.lang.Reflector/getMethods String 1 \"indexOf\" false)] [(.size ms) (.getName (.get ms 0))])" :expected "[1 \"indexOf\"]"}
  {:suite "reflect-member-model" :expr "(.canAccess (.get (clojure.lang.Reflector/getMethods String 1 \"indexOf\" false) 0) \"x\")" :expected "true"}
  ;; a static resolves through the same lookup, and a zero-parameter one is
  ;; invoked the way sci.impl.reflector invokes it: a nil argument array
  {:suite "reflect-member-model" :expr "(.invoke (.get (clojure.lang.Reflector/getMethods Math 1 \"max\" true) 0) nil (into-array Object [2 3]))" :expected "3"}
  {:suite "reflect-member-model" :expr "(pos? (.invoke (.get (clojure.lang.Reflector/getMethods System 0 \"currentTimeMillis\" true) 0) nil nil))" :expected "true"}
  ;; a name the class does not have still answers a member: dispatch reports it
  ;; at the call, with the method named, instead of an empty list
  {:suite "reflect-member-model" :expr "(try (.invoke (.get (clojure.lang.Reflector/getMethods String 0 \"noSuch\" false) 0) \"x\" nil) (catch Exception e (boolean (re-find #\"noSuch\" (ex-message e)))))" :expected "true"}
  ;; Util/sneakyThrow: the rethrow a reflective invoke ends every call with
  {:suite "reflect-member-model" :expr "(try (clojure.lang.Util/sneakyThrow (ex-info \"boom\" {})) (catch Exception e (ex-message e)))" :expected "\"boom\""}
  ;; clojure.reflect over the same registries: the reference JavaReflector is a
  ;; thin layer on getDeclaredFields/Methods/Constructors + getModifiers + bases,
  ;; so the port is the reference apart from the member-set model above.
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (defrecord Rr1 [a b]) (sort (map (comp str :name) (filter :type (:members (clojure.reflect/reflect Rr1))))))" :expected "(\"a\" \"b\")"}
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (= #{:public :final} (:flags (clojure.reflect/type-reflect 'java.lang.String))))" :expected "true"}
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (= #{:public :interface :abstract} (:flags (clojure.reflect/type-reflect 'java.util.List))))" :expected "true"}
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (contains? (:bases (clojure.reflect/type-reflect 'java.lang.Integer)) 'java.lang.Number))" :expected "true"}
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (defprotocol Prf (prf [this])) (deftype Trf [] Prf (prf [_] 1)) (contains? (set (map (comp str :name) (:members (clojure.reflect/reflect Trf)))) \"prf\"))" :expected "true"}
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (defrecord Rr2 [a]) (= (clojure.reflect/reflect Rr2) (clojure.reflect/reflect (->Rr2 1))))" :expected "true"}
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (map? (clojure.reflect/type-reflect 'java.lang.String :ancestors true)))" :expected "true"}
  {:suite "assert-args" :expr "(:private (meta #'clojure.core/assert-args))" :expected "true"}
  {:suite "assert-args" :expr "(:macro (meta #'clojure.core/assert-args))" :expected "true"}
  {:suite "assert-args" :expr "(seq? (@#'clojure.core/assert-args true \"x\"))" :expected "true"}
  ;; private, so outside clojure.core only @#' reaches it — a qualified use is the
  ;; JVM's "not public" (jolt#1095); the rows below define their macros IN core.
