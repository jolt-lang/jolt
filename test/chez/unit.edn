  ;; jolt.reader — the # dispatch table is open for punctuation. #$ is jolt's own
  ;; reader macro (clojure.core.strint's ~{}/~() grammar over a string literal),
  ;; registered through the same table a program registers into.
  {:suite "reader-macros" :expr "(let [x 3] #$\"a ~{x} b ~(inc x)\")" :expected "\"a 3 b 4\""}
  {:suite "reader-macros" :expr "[(string? #$\"plain\") #$\"plain\"]" :expected "[true \"plain\"]"}
  {:suite "reader-macros" :expr "#$\"~{\\\"~{\\\"}x\"" :expected "\"~{x\""}
  {:suite "reader-macros" :expr "#$\"100~ ok ~x\"" :expected "\"100~ ok ~x\""}
  {:suite "reader-macros" :expr "(= (quote (clojure.core/str \"a \" x)) (read-string \"#$\\\"a ~{x}\\\"\"))" :expected "true"}
  {:suite "reader-macros" :expr "(try (load-string \"#$(+ 1 2)\") (catch Exception e (ex-message e)))" :expected "\"string interpolation reads a string literal, got (+ 1 2)\""}
  ;; an interpolated form's offsets are into the STRING, not the file, so it
  ;; carries no reader position — with one a throw inside ~(…) reported line 1 of
  ;; whatever file the literal sits in. An ordinary read still positions its lists.
  {:suite "reader-macros" :expr "[(meta (nth (read-string \"#$\\\"a ~(inc x)\\\"\") 2)) (some? (:line (meta (read-string \"(inc x)\"))))]" :expected "[nil true]"}
  ;; edn is a closed grammar with no user extension point, so the table is not
  ;; consulted there and #$ stays the unreadable tag it always was.
  {:suite "reader-macros" :expr "(try (clojure.edn/read-string \"#$\\\"a\\\"\") :no-throw (catch Exception e (ex-message e)))" :expected "\"No reader function for tag $\""}
  ;; the two registration tiers: the default reads the next form and hands it to
  ;; the fn, :raw hands the fn the source and an index and takes back [form end].
  {:suite "reader-macros" :expr "(do (require (quote [jolt.reader :as r])) (r/set-dispatch-macro! \\% (fn [f] (list (quote clojure.core/vector) f f))) (load-string \"#%(+ 1 2)\"))" :expected "[3 3]"}
  {:suite "reader-macros" :expr "(do (require (quote [jolt.reader :as r])) (r/set-dispatch-macro! \\| (fn [s i] (let [e (.indexOf s \"|\" i)] [(subs s i e) (inc e)])) {:raw true}) (load-string \"#|a(b|\"))" :expected "\"a(b\""}
  {:suite "reader-macros" :expr "(do (require (quote [jolt.reader :as r])) (r/set-dispatch-macro! \\& (fn [s i] :nope) {:raw true}) (try (load-string \"#& x\") (catch Exception e (ex-message e))))" :expected "\"reader macro #& must return [form end-index]\""}
  ;; an end-index that does not move forward would spin the read loop on the same
  ;; character forever, so it is rejected rather than trusted.
  {:suite "reader-macros" :expr "(do (require (quote [jolt.reader :as r])) (r/set-dispatch-macro! \\& (fn [s i] [1 0]) {:raw true}) (try (load-string \"#& x\") (catch Exception e (ex-message e))))" :expected "\"reader macro #& returned an out-of-range end-index: 0\""}
  ;; a character the reader claims, and a letter (which begins a #tag — a #s
