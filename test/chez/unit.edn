  {:suite "nio-move" :label "FileSystemException accessors on a thrown exception" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jfe\" fa) p (fn [s] (.resolve d s)) A (into-array java.nio.file.CopyOption [java.nio.file.StandardCopyOption/ATOMIC_MOVE]) acc (fn [e] [(.getSimpleName (class e)) (.getMessage e) (.getFile e) (.getOtherFile e) (.getReason e)]) q (fn [v] (mapv #(if (string? %) (clojure.string/replace % (str d) \"D\") %) v))] (spit (str (p \"s\")) \"s\") (java.nio.file.Files/createDirectory (p \"dir\") fa) (let [r [(q (try (java.nio.file.Files/move (p \"zz\") (p \"b\") A) (catch java.nio.file.FileSystemException e (acc e)))) (q (try (java.nio.file.Files/move (p \"s\") (p \"dir\") A) (catch java.nio.file.FileSystemException e (acc e)))) (q (try (java.nio.file.Files/delete (p \"zz\")) (catch java.nio.file.FileSystemException e (acc e))))]] (doseq [s [\"s\" \"dir\"]] (java.nio.file.Files/delete (p s))) (java.nio.file.Files/delete d) r))" :expected "[[\"NoSuchFileException\" \"D/zz -> D/b\" \"D/zz\" \"D/b\" nil] [\"FileSystemException\" \"D/s -> D/dir: Is a directory\" \"D/s\" \"D/dir\" \"Is a directory\"] [\"NoSuchFileException\" \"D/zz\" \"D/zz\" nil nil]]"}
  {:suite "nio-move" :label "FileSystemException family constructors" :expr "(let [acc (fn [e] [(.getMessage e) (.getFile e) (.getOtherFile e) (.getReason e)])] [(acc (java.nio.file.FileSystemException. \"a\")) (acc (java.nio.file.FileSystemException. \"a\" \"b\" \"why\")) (acc (java.nio.file.FileSystemException. \"a\" nil nil)) (acc (java.nio.file.FileSystemException. nil nil \"why\")) (acc (java.nio.file.NoSuchFileException. \"a\" \"b\" \"why\")) (acc (java.nio.file.AtomicMoveNotSupportedException. \"a\" \"b\" \"why\")) (str (java.nio.file.AccessDeniedException. \"a\")) (instance? java.nio.file.FileSystemException (java.nio.file.AtomicMoveNotSupportedException. nil nil \"r\"))])" :expected "[[\"a\" \"a\" nil nil] [\"a -> b: why\" \"a\" \"b\" \"why\"] [\"a\" \"a\" nil nil] [\"why\" nil nil \"why\"] [\"a -> b: why\" \"a\" \"b\" \"why\"] [\"a -> b: why\" \"a\" \"b\" \"why\"] \"java.nio.file.AccessDeniedException: a\" true]"}
