  {:suite "jvm-misc" :label "into-array refuses an element that is not of the array's component class" :expr "(let [ex (fn [f] (try (vec (f)) (catch IllegalArgumentException e [:iae (ex-message e)])))] [(ex #(into-array String [1])) (ex #(into-array [1 \"a\"])) (ex #(into-array [1 2.0])) (ex #(into-array Number [1 2.0 \"x\"])) (ex #(into-array String [\"a\" nil])) (ex #(into-array [nil 1 \"a\"])) (ex #(into-array Object [1 \"a\"])) (ex #(into-array Long [1 2])) (mapv str (into-array java.nio.file.CopyOption [java.nio.file.StandardCopyOption/REPLACE_EXISTING]))])" :expected "[[:iae \"array element type mismatch\"] [:iae \"array element type mismatch\"] [:iae \"array element type mismatch\"] [:iae \"array element type mismatch\"] [\"a\" nil] [nil 1 \"a\"] [1 \"a\"] [1 2] [\"REPLACE_EXISTING\"]]"}
  {:suite "jvm-misc" :label "Arrays/fill on a typed reference array checks the value, and takes a from/to range" :expr "(let [ex (fn [f] (try (vec (f)) (catch Exception e [(.getSimpleName (class e)) (ex-message e)])))] [(ex #(doto (make-array String 2) (java.util.Arrays/fill 1))) (ex #(doto (make-array String 2) (java.util.Arrays/fill \"q\"))) (ex #(doto (make-array String 2) (java.util.Arrays/fill nil))) (ex #(doto (make-array String 3) (java.util.Arrays/fill 0 2 1))) (ex #(doto (make-array String 3) (java.util.Arrays/fill 1 3 \"x\"))) (ex #(doto (make-array String 3) (java.util.Arrays/fill 2 1 \"x\"))) (ex #(doto (make-array String 3) (java.util.Arrays/fill -1 1 \"x\"))) (ex #(doto (make-array String 3) (java.util.Arrays/fill 0 4 \"x\"))) (ex #(doto (int-array 3) (java.util.Arrays/fill 1 3 7))) (ex #(doto (make-array String 3) (java.util.Arrays/fill 1 1 5)))])" :expected "[[\"ArrayStoreException\" \"java.lang.Long\"] [\"q\" \"q\"] [nil nil] [\"ArrayStoreException\" \"java.lang.Long\"] [nil \"x\" \"x\"] [\"IllegalArgumentException\" \"fromIndex(2) > toIndex(1)\"] [\"ArrayIndexOutOfBoundsException\" \"Array index out of range: -1\"] [\"ArrayIndexOutOfBoundsException\" \"Array index out of range: 4\"] [0 7 7] [nil nil nil]]"}
  {:suite "jvm-misc" :label "System/arraycopy into a typed reference array checks each element and keeps what it copied before the bad one" :expr "(let [ex (fn [f] (try (vec (f)) (catch ArrayStoreException e [:ase (ex-message e)])))] [(ex #(doto (make-array String 2) (as-> a (System/arraycopy (object-array [1 2]) 0 a 0 2)))) (ex #(doto (make-array String 2) (as-> a (System/arraycopy (object-array [\"x\" \"y\"]) 0 a 0 2)))) (ex #(doto (make-array Number 2) (as-> a (System/arraycopy (object-array [1 \"y\" 3]) 0 a 0 2)))) (ex #(doto (make-array String 2) (as-> a (System/arraycopy (into-array Number [1 2]) 0 a 0 2)))) (ex #(doto (make-array String 2) (as-> a (System/arraycopy (into-array Number []) 0 a 0 0)))) (ex #(doto (make-array Long 2) (as-> a (System/arraycopy (into-array Number [1 2.0]) 0 a 0 2)))) (ex #(doto (make-array Number 2) (as-> a (System/arraycopy (into-array Long [1 2]) 0 a 0 2)))) (ex #(doto (make-array CharSequence 2) (as-> a (System/arraycopy (into-array String [\"a\" \"b\"]) 0 a 0 2)))) (ex #(doto (make-array String 2 2) (as-> a (System/arraycopy (object-array [(object-array 1)]) 0 a 0 1)))) (let [a (make-array String 3)] (try (System/arraycopy (object-array [\"x\" 2 \"z\"]) 0 a 0 3) (catch ArrayStoreException _ nil)) (vec a))])" :expected "[[:ase \"arraycopy: element type mismatch: can not cast one of the elements of java.lang.Object[] to the type of the destination array, java.lang.String\"] [\"x\" \"y\"] [:ase \"arraycopy: element type mismatch: can not cast one of the elements of java.lang.Object[] to the type of the destination array, java.lang.Number\"] [:ase \"arraycopy: type mismatch: can not copy java.lang.Number[] into java.lang.String[]\"] [nil nil] [:ase \"arraycopy: element type mismatch: can not cast one of the elements of java.lang.Number[] to the type of the destination array, java.lang.Long\"] [1 2] [\"a\" \"b\"] [:ase \"arraycopy: element type mismatch: can not cast one of the elements of java.lang.Object[] to the type of the destination array, [Ljava.lang.String;\"] [\"x\" nil nil]]"}
  {:suite "jvm-misc" :label "a hinted aset into a typed reference array checks the value too" :expr "(let [ex (fn [f] (try (f) :stored (catch ArrayStoreException e [:ase (ex-message e)]))) a (into-array String [\"a\"])] [(ex #(aset ^objects a 0 1)) (ex #(aset ^\"[Ljava.lang.String;\" a 0 2)) (ex #(aset ^objects a 0 \"b\")) (vec a) (ex #(amap (into-array String [\"a\"]) i r 1))])" :expected "[[:ase \"java.lang.Long\"] [:ase \"java.lang.Long\"] :stored [\"b\"] [:ase \"java.lang.Long\"]]"}
  {:suite "jvm-misc" :label "aset-int and its siblings refuse a reference array, after the cast and through the multi-index form" :expr "(let [ex (fn [f] (try (f) (catch IllegalArgumentException e [:iae (ex-message e)]) (catch ClassCastException _ :cce)))] [(ex #(aset-int (make-array String 1) 0 1)) (ex #(aset-char (make-array String 1) 0 \\a)) (ex #(aset-long (object-array 1) 0 1)) (ex #(aset-boolean (make-array String 1) 0 true)) (ex #(aset-double (object-array 1) 0 1.0)) (ex #(aset-int (make-array String 2 2) 0 1 7)) (ex #(aset-int (to-array [0]) 0 \"x\")) (ex #(aset-int (int-array 1) 0 7))])" :expected "[[:iae \"Argument is not an array of primitive type\"] [:iae \"Argument is not an array of primitive type\"] [:iae \"Argument is not an array of primitive type\"] [:iae \"Argument is not an array of primitive type\"] [:iae \"Argument is not an array of primitive type\"] [:iae \"Argument is not an array of primitive type\"] :cce 7]"}
  {:suite "jvm-misc" :label "instance? casts its type argument to Class: a protocol's map (named, held, applied or partial), a keyword, a string or a quoted symbol is the JDK's ClassCastException, nil the NullPointerException" :expr "(load-string \"(ns rir1.ns) (defprotocol P (m [x])) (defn t [f] (try (f) (catch Throwable e [(.getName (class e)) (.getMessage e)]))) [(t #(instance? P 1)) (t #(let [p P] (instance? p 1))) (t #(instance? P nil)) (t #(apply instance? [P 1])) (t #(mapv (partial instance? P) [1])) (t #(instance? {} 1)) (t #(instance? nil 1)) (t #(instance? :k 1)) (t #(instance? \\\"s\\\" 1)) (t #(instance? (quote String) 1)) (instance? String \\\"s\\\") (let [c String] (instance? c \\\"s\\\")) (mapv (partial instance? Long) [1 \\\"x\\\"]) (instance? rir1.ns.P 1)]\")" :expected "[[\"java.lang.ClassCastException\" \"class clojure.lang.PersistentArrayMap cannot be cast to class java.lang.Class (clojure.lang.PersistentArrayMap is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] [\"java.lang.ClassCastException\" \"class clojure.lang.PersistentArrayMap cannot be cast to class java.lang.Class (clojure.lang.PersistentArrayMap is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] [\"java.lang.ClassCastException\" \"class clojure.lang.PersistentArrayMap cannot be cast to class java.lang.Class (clojure.lang.PersistentArrayMap is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] [\"java.lang.ClassCastException\" \"class clojure.lang.PersistentArrayMap cannot be cast to class java.lang.Class (clojure.lang.PersistentArrayMap is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] [\"java.lang.ClassCastException\" \"class clojure.lang.PersistentArrayMap cannot be cast to class java.lang.Class (clojure.lang.PersistentArrayMap is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] [\"java.lang.ClassCastException\" \"class clojure.lang.PersistentArrayMap cannot be cast to class java.lang.Class (clojure.lang.PersistentArrayMap is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] [\"java.lang.NullPointerException\" \"Cannot invoke \\\"java.lang.Class.isInstance(Object)\\\" because \\\"c\\\" is null\"] [\"java.lang.ClassCastException\" \"class clojure.lang.Keyword cannot be cast to class java.lang.Class (clojure.lang.Keyword is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] [\"java.lang.ClassCastException\" \"class java.lang.String cannot be cast to class java.lang.Class (java.lang.String and java.lang.Class are in module java.base of loader 'bootstrap')\"] [\"java.lang.ClassCastException\" \"class clojure.lang.Symbol cannot be cast to class java.lang.Class (clojure.lang.Symbol is in unnamed module of loader 'app'; java.lang.Class is in module java.base of loader 'bootstrap')\"] true true [true false] false]"}
  {:suite "jvm-misc" :label "a reify site compiled before a protocol's redefinition implements the old protocol even when its first instance is built after it" :expr "(load-string \"(ns rir2.ns) (defprotocol P (m [x])) (defn mk [] (reify P (m [_] :old))) (defprotocol P (m [x])) (defn try1 [x] (try (m x) (catch IllegalArgumentException e :miss))) [(try1 (mk)) (satisfies? P (mk)) (try1 (reify P (m [_] :new)))]\")" :expected "[:miss false :new]"}
  {:suite "jvm-misc" :label "a reify's class is named as Compiler names it: the enclosing fn's class with its __N trimmed (a def'd fn, a named fn, fn, the evalN of a top-level form, the fn a try or loop is wrapped in, a type's own class) then $reify__N; the counters are jolt's (see known-divergences)" :expr "(load-string \"(ns rir3.ns) (defprotocol P (m [x])) (defn n [r] (clojure.string/replace (if (string? r) r (.getName (class r))) #\\\"(__|eval)\\\\d+\\\" \\\"$1N\\\")) (def top (reify P (m [_] 1))) (defn mk [] (reify P (m [_] 1))) (defn outer [] (fn [] (reify P (m [_] 1)))) (defn named [] (fn inner-fn [] (reify P (m [_] 1)))) (def f (fn [] (reify P (m [_] 1)))) (defn dash-name! [] (reify P (m [_] 1))) (deftype T [] P (m [_] (reify P (m [_] 2)))) (defn rr [] (reify P (m [_] (reify P (m [_] 3))))) (defn try-expr [] [(try (reify P (m [_] 1)))]) (defn loop-expr [] [(loop [] (reify P (m [_] 1)))]) (def dl (let [x (reify P (m [_] 1))] x)) (defn for-v [] (first (for [i [1]] (reify P (m [_] i))))) (defn for-l [] (first (for [i (list 1)] (reify P (m [_] i))))) (defn lk [] (locking 1 (reify P (m [_] 1)))) [(n top) (n (mk)) (n ((outer))) (n ((named))) (n (f)) (n (dash-name!)) (n (m (T.))) (n (m (rr))) (n (first (try-expr))) (n (first (loop-expr))) (n dl) (n (for-v)) (n (for-l)) (n (lk)) (n (let [x (reify P (m [_] 1))] x)) (n (.getSimpleName (class top))) (= (class (mk)) (class (mk)))]\")" :expected "[\"rir3.ns$reify__N\" \"rir3.ns$mk$reify__N\" \"rir3.ns$outer$fn$reify__N\" \"rir3.ns$named$inner_fn$reify__N\" \"rir3.ns$f$reify__N\" \"rir3.ns$dash_name_BANG_$reify__N\" \"rir3.ns.T$reify__N\" \"rir3.ns$rr$reify$reify__N\" \"rir3.ns$try_expr$fn$reify__N\" \"rir3.ns$loop_expr$fn$reify__N\" \"rir3.ns$fn$reify__N\" \"rir3.ns$for_v$iter__N__N$fn__N$fn$reify__N\" \"rir3.ns$for_l$iter__N__N$fn$reify__N\" \"rir3.ns$lk$reify__N\" \"rir3.ns$evalN$reify__N\" \"ns$reify__N\" true]"}
  {:suite "jvm-misc", :label "an Eduction prints its seq under pr, honoring the print vars, and Object's #object form under print; its print-method is the built-in under the class", :expr "(let [e (eduction (map inc) [1 2 3]) sw (java.io.StringWriter.)] ((get (methods print-method) clojure.core.Eduction) e sw) [(pr-str e) (binding [*print-length* 1] (pr-str e)) (binding [*print-level* 0] (pr-str e)) (pr-str (eduction (map inc) [])) (binding [*print-meta* true] (pr-str (eduction (map identity) [(with-meta [1] {:m 1})]))) (str sw) (some? (re-matches #\"#object\\[clojure\\.core\\.Eduction 0x[0-9a-f]+ clojure\\.core\\.Eduction@[0-9a-f]+\\]\" (with-out-str (print e)))) (some? (re-matches #\"clojure\\.core\\.Eduction@[0-9a-f]+\" (str e)))])", :expected "[\"(2 3 4)\" \"(2 ...)\" \"#\" \"()\" \"(^{:m 1} [1])\" \"(2 3 4)\" true true]"}
  {:suite "jvm-misc", :label "a namespace prints as Object's #object form under pr and print, and str is its name", :expr "(let [n (the-ns 'clojure.core) h (Integer/toHexString (System/identityHashCode n))] [(= (pr-str n) (str \"#object[clojure.lang.Namespace 0x\" h \" \\\"clojure.core\\\"]\")) (= (with-out-str (print [n])) (str \"[#object[clojure.lang.Namespace 0x\" h \" clojure.core]]\")) (= (str [n]) (str \"[\" (pr-str n) \"]\")) (str n)])", :expected "[true true true \"clojure.core\"]"}
  {:suite "jvm-misc", :label "a PersistentQueue prints as Object's #object form over its toString, the class and its List hashCode", :expr "(let [q (conj clojure.lang.PersistentQueue/EMPTY 1 2) h (Integer/toHexString (System/identityHashCode q))] [(str q) (str clojure.lang.PersistentQueue/EMPTY) (= (pr-str q) (str \"#object[clojure.lang.PersistentQueue 0x\" h \" \\\"clojure.lang.PersistentQueue@3e2\\\"]\")) (= (with-out-str (print q)) (str \"#object[clojure.lang.PersistentQueue 0x\" h \" clojure.lang.PersistentQueue@3e2]\")) (= (with-out-str (prn [q])) (str \"[\" (pr-str q) \"]\\n\")) (format \"%s\" q)])", :expected "[\"clojure.lang.PersistentQueue@3e2\" \"clojure.lang.PersistentQueue@1\" true true true \"clojure.lang.PersistentQueue@3e2\"]"}
  {:suite "jvm-misc", :label "pprint writes a PersistentQueue as <-(...)-<", :expr "(do (require 'clojure.pprint) (with-out-str (clojure.pprint/pprint (conj clojure.lang.PersistentQueue/EMPTY 1 2))))", :expected "\"<-(1 2)-<\\n\""}
  {:suite "jvm-misc", :label "every value answers java.lang.Object's methods: a Pattern's hashCode, equals and getClass, and the str of a record holding one", :expr "(do (defrecord ObjRx [a]) (let [p #\"a+b\"] [(= (.hashCode p) (.hashCode p)) (.equals p p) (.equals p #\"a+b\") (.getClass p) (some? (re-matches #\"user\\.ObjRx@[0-9a-f]+\" (str (->ObjRx p)))) (try (.hashCode p 1) (catch IllegalArgumentException e (ex-message e)))]))", :expected "[true true false java.util.regex.Pattern true \"No matching method hashCode found taking 1 args for class java.util.regex.Pattern\"]"}
  {:suite "jvm-misc", :label "a keyword is never equal to a class or another host value, either way round", :expr "[(= :a String) (= String :a) (= :a (java.io.StringWriter.)) (= (Object.) :a) (= :a [:a]) (contains? {String 1 :a 2} :a) (get {String 1 :a 2} String)]", :expected "[false false false false false true 1]"}
  {:suite "jvm-misc" :label "== casts each pair to Number left to right as the JVM does: a non-number is the ClassCastException first, then nil the NPE, and it stops at the first unequal pair" :expr "(mapv (fn [f] (try (f) (catch Throwable t (.getSimpleName (class t))))) [#(== nil 1) #(== 1 nil) #(== 1 :a) #(== :a nil) #(== 1 2 :a) #(== 1 1 nil) #(apply == [1 2 :a]) #(apply == [nil 1]) #(== 1.0 nil) #(== 1 1.0 1)])" :expected "[\"NullPointerException\" \"NullPointerException\" \"ClassCastException\" \"ClassCastException\" false \"NullPointerException\" false \"NullPointerException\" \"NullPointerException\" true]"}
