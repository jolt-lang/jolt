  ;; a span that overflows to Infinity is drawn at half scale (RandomSupport);
  ;; a non-finite end is a bad range; a draw that rounds up to a 0.0 bound steps
  ;; down to -Double/MIN_VALUE (Math/nextDown); an int argument narrows like
  ;; reflective dispatch's intValue, so 3000000000 arrives negative
  {:suite "splittable-random" :expr "(let [r (java.util.SplittableRandom. 42)] [(.nextDouble r (- Double/MAX_VALUE) Double/MAX_VALUE) (.nextDouble r -1.0 Double/MAX_VALUE)])" :expected "[8.685190483839085E307 2.87469815467975E307]"}
  {:suite "splittable-random" :expr "(mapv (fn [[o b]] (try (.nextDouble (java.util.SplittableRandom. 1) o b) (catch IllegalArgumentException e (ex-message e)))) [[0.0 ##Inf] [##-Inf 0.0] [##NaN 1.0] [0.0 ##NaN]])" :expected "[\"bound must be greater than origin\" \"bound must be greater than origin\" \"bound must be greater than origin\" \"bound must be greater than origin\"]"}
