  ;; Atomic compare-and-set!/swap-vals!/reset-vals! — atoms.ss implements them
  ;; atomically (mutex/CAS) and binds the clojure.core vars; the overlay used to
  ;; redefine them as racy check-then-act compositions, losing updates under real
  ;; threads. The contract rows pass under either (single-threaded); the stress row
  ;; fails pre-remint (overlay loses updates => "false") and passes post-remint
  ;; (native atomic => "true"). This stage edits the overlay => needs remint.
  {:suite "atomics" :label "swap-vals! returns [old new]" :expected "[5 6]" :expr "(let [a (atom 5)] (swap-vals! a inc))"}
  {:suite "atomics" :label "reset-vals! returns [old new]" :expected "[5 9]" :expr "(let [a (atom 5)] (reset-vals! a 9))"}
  {:suite "atomics" :label "compare-and-set! true on match and sets" :expected "[true 6]" :expr "(let [a (atom 5)] [(compare-and-set! a 5 6) (deref a)])"}
  {:suite "atomics" :label "compare-and-set! false on mismatch and no set" :expected "[false 5]" :expr "(let [a (atom 5)] [(compare-and-set! a 0 6) (deref a)])"}
  ;; The receiver check. swap!/reset! run jolt-need-atom and report the JVM's cast
  ;; failure; the other three reached a record accessor directly, so a non-atom got
  ;; a condition naming jolt's own record type ("... is not of type #<record type
  ;; jolt-atom-v3>") and nil stopped reporting as a NullPointerException, which a
  ;; catch selecting on it would no longer match.
  ;; The CLASS is asserted and not just the message, because a raw host condition
  ;; classes as :object and :object matches EVERY catch clause — so a row that only
  ;; caught NullPointerException passed on the broken behaviour too.
