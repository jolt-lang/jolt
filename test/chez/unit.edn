  {:suite "gitlibs-cache" :label "require-deps host filesystem works under a caller namespace binding" :expected "true" :expr "(do (require 'jolt.deps) (let [caller (or (find-ns 'required-host-caller) (create-ns 'required-host-caller)) root (str (System/getProperty \"java.io.tmpdir\") \"/required-host-\" (System/currentTimeMillis)) source (str root \"/source\") target (str root \"/target\")] (try (binding [*ns* caller] (let [host (@#'jolt.deps/required-host)] ((:mkdirs! host) root) (spit source \"ok\") ((:atomic-move! host) source target) (and (= \"ok\" (slurp target)) (do ((:delete! host) target) (not (jolt.host/file-exists? target)))))) (finally (jolt.host/delete-tree! root)))))"}
