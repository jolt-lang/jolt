  ;; Daemon status of the core.async threads, which the corpus cannot carry (the
  ;; oracle has no core.async on its classpath). Probed on JVM Clojure 1.12.5 +
  ;; core.async 1.9.865 / JDK 21: thread, go, io-thread and thread-call's threads
  ;; are all daemons, and a Thread made on one inherits it. The fiber row is jolt's
  ;; own: a go block on a fiber is a virtual thread, which is always a daemon.
  {:suite "threads / daemon" :expr "(do (require (quote [clojure.core.async :as a])) (let [me (fn [] (.isDaemon (Thread/currentThread)))] [(a/<!! (a/thread (me))) (a/<!! (a/go (me))) (a/<!! (a/thread (.isDaemon (Thread. (fn []))))) (a/<!! (a/io-thread (me))) (a/<!! (a/thread-call me :compute))]))" :expected "[true true true true true]"}
  {:suite "threads / daemon" :expr "(do (require (quote [clojure.core.async :as a])) (binding [a/*go-backend* :fiber] (a/<!! (a/go [(jolt.host/fiber?) (.isDaemon (Thread/currentThread))]))))" :expected "[true true]"}
  ;; A thread blocked in a core.async channel op is WAITING (<!!, >!!, and alts!!
  ;; over a timeout channel, which parks untimed). Probed on JVM Clojure 1.12.5 +
  ;; core.async 1.9.865 / JDK 21: ["WAITING" "WAITING" "WAITING"].
  {:suite "threads / state" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan) d (a/chan) ts [(Thread. (fn [] (a/<!! c))) (Thread. (fn [] (a/>!! d 1))) (Thread. (fn [] (a/alts!! [(a/chan) (a/timeout 10000)])))]] (doseq [t ts] (.setDaemon t true) (.start t)) (Thread/sleep 200) (let [r (mapv (fn [t] (str (.getState t))) ts)] (a/close! c) (a/<!! d) r)))" :expected "[\"WAITING\" \"WAITING\" \"WAITING\"]"}
  ;; A future and a send-off run on the agent pools, whose threads are never
  ;; daemons, even when a daemon thread (here core.async's) starts them; they used
  ;; to inherit the creator's status. JVM: [false false].
  {:suite "threads / daemon" :expr "(do (require (quote [clojure.core.async :as a])) (let [me (fn [] (.isDaemon (Thread/currentThread)))] (a/<!! (a/thread [(deref (future (me)) 5000 :hung) (let [ag (agent nil) p (promise)] (send-off ag (fn [_] (deliver p (me)))) (deref p 5000 :hung))]))))" :expected "[false false]"}
  ;; A sliding or dropping buffer never makes a put wait, with a transducer as
  ;; without one. With one it used to be treated as a fixed buffer: the first
  ;; value stayed, offer! answered nil after it and >!! blocked. Probed on JVM
  ;; Clojure 1.12.5 + core.async 1.8.741: [[true true true 4] [true true true 2] [:done 3]].
  {:suite "core.async / buffers" :expr "(do (require (quote [clojure.core.async :as a])) [(let [c (a/chan (a/sliding-buffer 1) (map inc))] [(a/offer! c 1) (a/offer! c 2) (a/offer! c 3) (a/poll! c)]) (let [c (a/chan (a/dropping-buffer 1) (map inc))] [(a/offer! c 1) (a/offer! c 2) (a/offer! c 3) (a/poll! c)]) (let [c (a/chan (a/sliding-buffer 1) (map inc))] [(deref (future (a/>!! c 1) (a/>!! c 2) :done) 2000 :blocked) (a/poll! c)])])" :expected "[[true true true 4] [true true true 2] [:done 3]]"}
  ;; An alts put on a FULL fixed buffer with a transducer is not ready: it used
  ;; to count as ready because the channel had a transducer, then the locked
  ;; give answered 'full and alts reported the put as done, losing the value.
  ;; JVM, as above: [nil true 2 true 6].
  {:suite "core.async / alts put xform" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/chan 1 (map inc)) t (a/timeout 100)] (a/>!! c 1) (let [[v p] (a/alts!! [[c 2] t]) f (future (first (a/alts!! [[c 5]])))] [v (= p t) (a/<!! c) (deref f 2000 :hung) (a/<!! c)])))" :expected "[nil true 2 true 6]"}
  ;; promise-chan takes a transducer, and a put after the first never waits,
  ;; with a transducer as without one. The transducer used to be dropped (1, not
  ;; 2), and a promise buffer with one counted as a full fixed buffer.
  ;; JVM, as above: [true true :done true 2 2].
  {:suite "core.async / promise-chan xform" :expr "(do (require (quote [clojure.core.async :as a])) (let [c (a/promise-chan (map inc)) t (a/timeout 200)] [(a/offer! c 1) (a/offer! c 2) (deref (future (a/>!! c 3) :done) 1000 :blocked) (first (a/alts!! [[c 4] t])) (a/poll! c) (a/<!! c)]))" :expected "[true true :done true 2 2]"}
  ;; @ on a promise or future that has settled answers at once, even on a fiber
  ;; holding a lock, as a transducer's completion does inside close! from an
  ;; io-thread: it used to begin a wait, whose may-park check refused it.
  ;; JVM, as above: [:delivered :delivered :done :done].
  {:suite "core.async / settled deref" :expr "(do (require (quote [clojure.core.async :as a])) (let [p (promise) f (future :done) _ (deliver p :delivered) _ (deref f) seen (atom nil) c (a/chan 1 (fn [rf] (fn ([] (rf)) ([acc] (reset! seen [(deref p) (deref p 10 :t) (deref f) (deref f 10 :t)]) (rf acc)) ([acc x] (rf acc x)))))] (a/<!! (a/io-thread (a/close! c))) (deref seen)))" :expected "[:delivered :delivered :done :done]"}
  ;; A finished Thread keeps what it was: the id-keyed tables a running thread's
  ;; name, priority and daemon flag live in let go of it at exit, and the object
  ;; holds them from then on (a rename while it ran included). JVM: [true "w" 3]
  ;; and ["late" 7 false].
  {:suite "threads / finished" :expr "(let [t (Thread. (fn []))] (.setDaemon t true) (.setName t \"w\") (.setPriority t 3) (.start t) (.join t) [(.isDaemon t) (.getName t) (.getPriority t)])" :expected "[true \"w\" 3]"}
  ;; Attributes set AFTER join stick. The thread's exit hook runs after its body
  ;; has woken join, and used to copy the id-keyed tables over the object again,
  ;; so a setDaemon/setName/setPriority between the two was undone — about one
  ;; run in two thousand under contention, and once in CI. Many threads at once
  ;; is what makes the hook land in the window.
  {:suite "threads / finished" :expr "(let [r (fn [] (let [t (Thread. (fn []))] (.start t) (.join t) (.setDaemon t true) (.setName t \"x\") (.setPriority t 2) [(.isDaemon t) (.getName t) (.getPriority t)]))] (frequencies (apply concat (pmap (fn [_] (repeatedly 400 r)) (range 8)))))" :expected "{[true \"x\" 2] 3200}"}
  ;; Threads that finish at once while futures are being created: the parent
  ;; used to read a finished child's freed thread context for its id, often get
  ;; the boot thread's 0, and file the child's object under it, so the boot
