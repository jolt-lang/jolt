  ;; with-out-str binds *out* to a writer over its own port, so a future, agent,
  ;; pmap, executor, core.async thread or fiber the binding conveys to writes into
  ;; the capture. Looped: the first task on a fresh pool worker always worked (jolt-i4d8l).
  {:suite "print-conveyance", :label "a future's print reaches the with-out-str it runs under, every time, not only on a fresh worker", :expr "(frequencies (repeatedly 100 (fn [] (with-out-str @(future (print \"X\"))))))", :expected "{\"X\" 100}"}
  {:suite "print-conveyance", :label "prn, flush, .write and .append on the conveyed capture", :expr "(frequencies (repeatedly 100 (fn [] (with-out-str @(future (prn :a) (flush) (.write *out* \"w\") (.append *out* \\c))))))", :expected "{\":a\\nwc\" 100}"}
  {:suite "print-conveyance", :label "agent send and send-off print into the capture", :expr "(frequencies (repeatedly 50 (fn [] (with-out-str (let [g (agent 0)] (send g (fn [x] (print \"s\") x)) (send-off g (fn [x] (print \"o\") x)) (await g))))))", :expected "{\"so\" 50}"}
  {:suite "print-conveyance", :label "pmap workers print into the capture", :expr "(frequencies (repeatedly 100 (fn [] (count (with-out-str (dorun (pmap (fn [_] (print \"P\")) (range 4))))))))", :expected "{4 100}"}
  {:suite "print-conveyance", :label "an executor task under bound-fn prints into the capture", :expr "(let [ex (java.util.concurrent.Executors/newFixedThreadPool 2)] (try (frequencies (repeatedly 100 (fn [] (with-out-str (.get (.submit ex ^java.util.concurrent.Callable (bound-fn [] (print \"E\") 1))))))) (finally (.shutdown ex))))", :expected "{\"E\" 100}"}
  {:suite "print-conveyance", :label "a core.async thread and a fiber print into the capture", :expr "(do (require (quote [clojure.core.async :as a]) (quote jolt.fibers)) (frequencies (repeatedly 100 (fn [] (with-out-str (a/<!! (a/thread (print \"T\") 1)) (jolt.fibers/join (jolt.fibers/spawn (fn [] (print \"F\") 1))))))))", :expected "{\"TF\" 100}"}
  {:suite "print-conveyance", :label "a capture nested in a future, and the owner's writes around a worker's stay in order", :expr "(frequencies (repeatedly 100 (fn [] [(with-out-str @(future (print (with-out-str @(future (print \"in\"))) \"out\"))) (with-out-str (print \"a\") @(future (print \"b\")) (print \"c\"))])))", :expected "{[\"in out\" \"abc\"] 100}"}
  {:suite "print-conveyance", :label "threads printing into one capture at once lose and corrupt nothing", :expr "(let [s (with-out-str (let [fs (doall (repeatedly 6 (fn [] (future (dotimes [_ 1000] (print \"ab\"))))))] (dotimes [_ 1000] (print \"ab\")) (run! deref fs)))] [(count s) (= s (apply str (repeat 7000 \"ab\")))])", :expected "[14000 true]"}
  {:suite "print-conveyance", :label "a worker forked inside a capture writes its root *out* to the process stream, not to that dead capture", :expr "(do (require (quote jolt.scheme)) (with-out-str (run! deref (doall (repeatedly 12 (fn [] (future (Thread/sleep 30))))))) (frequencies (map deref (doall (repeatedly 24 (fn [] (future (Thread/sleep 10) (jolt.scheme/eval-string \"(eq? (current-output-port) (console-output-port))\"))))))))", :expected "{true 24}"}
  {:suite "char-equality", :label "equal and unequal chars", :expr "[(= \\a \\a) (= \\a \\b) (= \\b \\a) (not= \\a \\b) (not= \\a \\a)]", :expected "[true false false true false]"}
  {:suite "char-equality", :label "a char is never equal to its int code, a one-char string, a double or nil", :expr "[(= \\a 97) (= 97 \\a) (= \\a \"a\") (= \"a\" \\a) (= \\a 97.0) (= \\a nil) (= nil \\a)]", :expected "[false false false false false false false]"}
  {:suite "char-equality", :label "chars across the BMP and the surrogate halves", :expr "[(= (char 0xFFFF) (char 0xFFFE)) (= (char 0xD800) (char 0xDC00)) (= (char 0xD800) (char 0xD800)) (= (char 0x4e2d) (char 0x4e2d)) (= \\a (char 97))]", :expected "[false false true true true]"}
  {:suite "char-equality", :label "variadic = on chars", :expr "[(= \\a \\a \\a) (= \\a \\a \\b) (= \\b \\a \\a)]", :expected "[true false false]"}
  {:suite "char-equality", :label "chars as map keys and set members", :expr "[(get {\\a 1 \\b 2} \\b) (get {\\a 1} \\c) (contains? #{\\a \\b} \\b) (contains? #{\\a \\b} \\c)]", :expected "[2 nil true false]"}
  {:suite "sequence" :label "sequence two colls" :expr "(sequence (map vector) [1 2] [3 4])" :expected "([1 3] [2 4])"}
  {:suite "sequence" :label "sequence three colls, unequal lengths stop at the shortest" :expr "(sequence (map vector) [1 2 3] [4 5] [6 7 8])" :expected "([1 4 6] [2 5 7])"}
  {:suite "sequence" :label "sequence multi-coll with a numeric step fn" :expr "(sequence (map +) [1 2 3] [10 20])" :expected "(11 22)"}
  {:suite "sequence" :label "sequence an empty coll gives ()" :expr "(sequence (map vector) [] [1 2])" :expected "()"}
  {:suite "sequence" :label "sequence nil coll gives ()" :expr "(sequence (map vector) [1] nil)" :expected "()"}
  {:suite "sequence" :label "sequence is lazy over infinite inputs" :expr "(first (sequence (map vector) (range) (range)))" :expected "[0 0]"}
  {:suite "sequence" :label "sequence lazy prefix of infinite inputs" :expr "(take 3 (sequence (map vector) (range) (range)))" :expected "([0 0] [1 1] [2 2])"}
  {:suite "sequence" :label "sequence early termination via take in the xform" :expr "(sequence (comp (map vector) (take 2)) (range) (range) (range))" :expected "([0 0 0] [1 1 1])"}
  {:suite "sequence" :label "sequence stateful xform completion runs" :expr "(sequence (comp (map vector) (partition-all 2)) [1 2 3] [4 5 6])" :expected "([[1 4] [2 5]] [[3 6]])"}
  {:suite "sequence" :label "sequence 1-arity still works" :expr "(sequence [1 2])" :expected "(1 2)"}
  {:suite "sequence" :label "sequence 1-arity nil gives ()" :expr "(sequence nil)" :expected "()"}
  {:suite "sequence" :label "sequence xform and one coll still works" :expr "(sequence (map inc) [1 2 3])" :expected "(2 3 4)"}
  {:suite "sequence" :label "sequence xform and one empty coll gives ()" :expr "(sequence (map inc) [])" :expected "()"}
