  ;; path must step aside for the flag.
  {:suite "interrupt / blocking" :expr "(deref (future (let [q (doto (java.util.concurrent.LinkedBlockingQueue.) (.add 1) (.add 2) (.add 3) (.add 4)) f (fn [op] (.interrupt (Thread/currentThread)) [(try (op) (catch InterruptedException e :interrupted)) (Thread/interrupted)])] [(f #(.take q)) (f #(.poll q 1 java.util.concurrent.TimeUnit/SECONDS)) (f #(.offer q 9 1 java.util.concurrent.TimeUnit/SECONDS)) (f #(.put q 8)) (f #(.poll q)) (.poll q 0 java.util.concurrent.TimeUnit/SECONDS) (.take q) (vec q)])) 5000 :hung)" :expected "[[:interrupted false] [:interrupted false] [:interrupted false] [:interrupted false] [1 true] 2 3 [4]]"}
  {:suite "interrupt / blocking" :expr "(deref (future (let [q (doto (java.util.concurrent.ArrayBlockingQueue. 2) (.add 1)) f (fn [op] (.interrupt (Thread/currentThread)) [(try (op) (catch InterruptedException e :interrupted)) (Thread/interrupted)])] [(f #(.take q)) (f #(.poll q 1 java.util.concurrent.TimeUnit/SECONDS)) (f #(.offer q 9 1 java.util.concurrent.TimeUnit/SECONDS)) (.offer q 9 1 java.util.concurrent.TimeUnit/MILLISECONDS) (.offer q 7 1 java.util.concurrent.TimeUnit/MILLISECONDS) (.poll q 1 java.util.concurrent.TimeUnit/MILLISECONDS) (.poll q 1 java.util.concurrent.TimeUnit/MILLISECONDS) (.poll q 1 java.util.concurrent.TimeUnit/MILLISECONDS)])) 5000 :hung)" :expected "[[:interrupted false] [:interrupted false] [:interrupted false] true false 1 9 nil]"}
  ;; Deadlines are on the monotonic clock (System/nanoTime's), not the wall clock,
  ;; so a clock step cannot fire a wait early or hold it late (#1303). A deadline
