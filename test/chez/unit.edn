  ;; try / catch / finally with the body run in place (rt.ss jolt-guard-body and
  ;; jolt-wind-inline, #1713). Same answers as the JVM.
  {:suite "try-inline", :label "a try's body runs in place with its catch and finally (#1713): the value, and finally after body or catch, in order", :expr "(let [log (atom [])] [(try (swap! log conj :body) 1 (catch Exception e (swap! log conj :catch) 2) (finally (swap! log conj :fin))) (try (swap! log conj :body2) (throw (ex-info \"x\" {})) (catch Exception e (swap! log conj :catch2) 3) (finally (swap! log conj :fin2))) (clojure.core/deref log)])", :expected "[1 3 [:body :fin :body2 :catch2 :fin2]]"}
  {:suite "try-inline", :label "...a catch that does not match rethrows to the next one", :expr "(try (try (throw (ex-info \"inner\" {:n 1})) (catch IllegalStateException e :wrong)) (catch clojure.lang.ExceptionInfo e [(ex-message e) (ex-data e)]))", :expected "[\"inner\" {:n 1}]"}
  {:suite "try-inline", :label "...a throw from a handler reaches the outer catch", :expr "(try (try (throw (ex-info \"inner\" {})) (catch Exception e (throw (ex-info \"from-handler\" {:cause (ex-message e)})))) (catch Exception e [(ex-message e) (ex-data e)]))", :expected "[\"from-handler\" {:cause \"inner\"}]"}
  {:suite "try-inline", :label "...nested finallys run inner to outer around the outer catch", :expr "(let [log (atom [])] [(try (try (throw (ex-info \"a\" {})) (finally (swap! log conj :inner-fin))) (catch Exception e (swap! log conj :outer-catch) :caught) (finally (swap! log conj :outer-fin))) (clojure.core/deref log)])", :expected "[:caught [:inner-fin :outer-catch :outer-fin]]"}
  {:suite "try-inline", :label "...a throw from a finally replaces the value", :expr "(try (try 1 (finally (throw (ex-info \"from-finally\" {})))) (catch Exception e (ex-message e)))", :expected "\"from-finally\""}
  {:suite "try-inline", :label "...a binding is unwound when a throw leaves it", :expr "(do (def ^:dynamic *tf* :root) (let [r (try (binding [*tf* :bound] (throw (ex-info \"b\" {}))) (catch Exception e *tf*))] [r *tf*]))", :expected "[:root :root]"}
  {:suite "try-inline", :label "...the handler stack stays balanced across thousands of caught throws", :expr "(loop [i 0 n 0] (if (< i 10000) (recur (inc i) (+ n (try (if (even? i) (throw (ex-info \"e\" {})) 1) (catch Exception e 2)))) [n (try (throw (ex-info \"after\" {})) (catch Exception e (ex-message e)))]))", :expected "[15000 \"after\"]"}
  {:suite "try-inline", :label "...a throw from 500 tries deep reaches the outer catch", :expr "(do (defn tdeep [n] (try (if (zero? n) (throw (ex-info \"bottom\" {:n n})) (inc (tdeep (dec n)))) (catch IllegalStateException e :never))) (try (tdeep 500) (catch clojure.lang.ExceptionInfo e (ex-data e))))", :expected "{:n 0}"}
  {:suite "try-inline", :label "...a try at every level of a 1000-deep recursion", :expr "(do (defn tsum [n] (try (if (zero? n) 0 (+ n (tsum (dec n)))) (catch Exception e -1))) (tsum 1000))", :expected "500500"}
  {:suite "try-inline", :label "...a fn whose try catches, called repeatedly and under another try", :expr "(let [f (fn [] (try (/ 1 0) (catch ArithmeticException e :div0)))] [(f) (f) (try (f) (finally nil))])", :expected "[:div0 :div0 :div0]"}
  {:suite "try-inline", :label "...with-redefs is undone when a throw leaves it", :expr "(let [r (atom nil)] (try (with-redefs [inc dec] (reset! r (inc 1)) (throw (ex-info \"x\" {}))) (catch Exception e nil)) [(clojure.core/deref r) (inc 1)])", :expected "[2 2]"}
  {:suite "try-inline", :label "...catch clauses are tried in order", :expr "(try (throw (Exception. \"plain\")) (catch RuntimeException e :rt) (catch Exception e [:ex (.getMessage e)]))", :expected "[:ex \"plain\"]"}
