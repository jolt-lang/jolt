  ;; A live value a macro puts in the form it returns is a CONSTANT, not a syntax
  ;; error — Clojure falls through to ConstantExpr and jolt rebuilds it as code
  ;; (jolt-l7tq). A named fn is read back through its var; an anonymous literal
  ;; is rebuilt from the source form and captures the fn-form registry recorded.
  {:suite "embedded-value" :expr "(do (defmacro ev-a [] (deref (var when))) (fn? (ev-a)))" :expected "true"}
  {:suite "embedded-value" :expr "(do (defmacro ev-b [] (list (quote vector) inc 1)) (let [[f n] (ev-b)] [(fn? f) (f n)]))" :expected "[true 2]"}
  {:suite "embedded-value" :expr "(do (defmacro ev-c [] `(vector ~(deref (var memfn)) :tag)) (count (ev-c)))" :expected "2"}
  {:suite "embedded-value" :expr "(do (defn ev-mk [] (fn [x] (+ x 100))) (defmacro ev-d [] (ev-mk)) ((ev-d) 5))" :expected "105"}
  {:suite "embedded-value" :expr "(do (defn ev-clo [n] (fn [x] (+ x n))) (defmacro ev-e [] (ev-clo 7)) ((ev-e) 5))" :expected "12"}
  {:suite "embedded-value" :expr "(do (defmacro ev-f [] (list (quote quote) inc)) (fn? (ev-f)))" :expected "true"}
  ;; ...and a value nothing can rebuild reports what it is, rather than
  ;; \"Unsupported form\" at a line the user never wrote.
  {:suite "embedded-value" :expr "(do (defmacro ev-g [] (java.lang.StringBuilder.)) (try (eval (quote (ev-g))) :no-throw (catch Throwable t (boolean (re-find #\"Cannot compile this value into code\" (or (.getMessage t) \"\"))))))" :expected "true"}
  ;; ...and a capture cp0 folded away is a DIFFERENT refusal, named as such: the
  ;; fn's source IS recorded, so \"no recorded source\" would be a lie about it.
  {:suite "embedded-value" :expr "(do (defmacro ev-h [] (let [n 7] (fn [x] (+ x n)))) (try (eval (quote (ev-h))) :no-throw (catch Throwable t (boolean (re-find #\"folded into the code\" (or (.getMessage t) \"\"))))))" :expected "true"}
  ;; ...and a captured value is a VALUE: a closure over a symbol, a list or a
  ;; vector holding a symbol rebuilds with that datum, not with what the datum
  ;; would mean as code (a closure over 'clojure.core/inc used to read back the fn).
  {:suite "embedded-value" :expr "(do (defn ev-cs [k] (fn [m] (get m k))) (defmacro ev-i [] (ev-cs (quote foo))) ((ev-i) {(quote foo) 1}))" :expected "1"}
  {:suite "embedded-value" :expr "(do (defn ev-cl [k] (fn [] k)) (defmacro ev-j [] (ev-cl (list 1 2))) ((ev-j)))" :expected "(1 2)"}
  {:suite "embedded-value" :expr "(do (defn ev-cq [k] (fn [] k)) (defmacro ev-o [] (ev-cq (quote clojure.core/inc))) [(symbol? ((ev-o))) ((ev-o))])" :expected "[true clojure.core/inc]"}
  {:suite "embedded-value" :expr "(do (defn ev-cv [k] (fn [] k)) (defmacro ev-l [] (ev-cv [1 (quote x)])) ((ev-l)))" :expected "[1 x]"}

  ;; the feature set is {:jolt :clj :default}. :bb is NOT in it: a library's :bb
  ;; branch is written for babashka's host model, not jolt's, and taking it sent
  ;; jolt at namespaces babashka supplies natively and jolt does not. :jolt wins
  ;; over :clj wherever a library gives jolt its own branch; otherwise jolt reads
  ;; the :clj branch its clojure.lang.*/java.* shims target.
  {:suite "reader-features" :expr "#?(:bb :bb-branch :clj :clj-branch)" :expected ":clj-branch"}
  {:suite "reader-features" :expr "#?(:clj :clj-first :bb :bb-second)" :expected ":clj-first"}
  {:suite "reader-features" :expr "#?(:jolt :jolt-branch :clj :clj-branch)" :expected ":jolt-branch"}
  {:suite "reader-features" :expr "[1 #?(:bb :bb-only) 2]" :expected "[1 2]"}
  ;; seqable? is an instance? test over Seqable / ISeq / Iterable on the JVM, so a
  ;; bare deftype or reify declaring one answers true even though it is not coll?.
  ;; It has to agree with whether `seq` actually works on the value — the seq arms
  ;; already accept exactly these, and clojure.core.Eduction is the one in core.
  {:suite "seqable" :expr "(seqable? (eduction (map identity) [1 2 3]))" :expected "true"}
  {:suite "seqable" :expr "(do (deftype SqA [xs] clojure.lang.Seqable (seq [_] (seq xs))) [(seqable? (->SqA [1 2])) (coll? (->SqA [1 2])) (vec (seq (->SqA [1 2])))])" :expected "[true false [1 2]]"}
  {:suite "seqable" :expr "(seqable? (reify Iterable (iterator [_] (.iterator [1 2]))))" :expected "true"}
  {:suite "seqable" :expr "(do (deftype SqB [x]) (seqable? (->SqB 1)))" :expected "false"}
  ;; ...and the collection-BEHAVIOUR interfaces are not Seqable on the JVM: an
  ;; ILookup-only deftype answers false (corpus has the same row).
  {:suite "seqable" :expr "(do (deftype SqC [x] clojure.lang.ILookup (valAt [_ k] nil) (valAt [_ k nf] nf)) [(coll? (->SqC 1)) (seqable? (->SqC 1))])" :expected "[false false]"}
  ;; ...nor is a bare Iterator: RT.canSeq names Iterable, not Iterator, so a
  ;; deftype with only hasNext/next answers false there even though jolt's seq
  ;; can walk it (a superset the predicate does not advertise).
  {:suite "seqable" :expr "(do (deftype SqD [] java.util.Iterator (hasNext [_] false) (next [_] nil)) [(seqable? (->SqD)) (seq (->SqD))])" :expected "[false nil]"}
