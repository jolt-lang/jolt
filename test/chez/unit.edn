  ;; java.net.URI.resolve / normalize / relativize — RFC 2396 §5.2 as the JDK does
  ;; it (a base with an authority and no path merges as "/", the JDK-20 rule), a
  ;; kept segment keeps the slash that followed it, and a URI is Comparable.
  ;; Every expected value is the JVM's (OpenJDK 20).
  {:suite "uri / resolve" :expr "(let [b (java.net.URI. \"https://u@h.com:8080/a/b/c?q=1#f\")] (mapv #(str (.resolve b %)) [\"d\" \"../d\" \"../../../d\" \"/x\" \"//other.com/p\" \"http://z/p\" \"?q2\" \"#g\" \"\" \"d/\" \".\" \"..\" \"mailto:a@b\" \"g;x=1/../y\"]))"
   :expected "[\"https://u@h.com:8080/a/b/d\" \"https://u@h.com:8080/a/d\" \"https://u@h.com:8080/../d\" \"https://u@h.com:8080/x\" \"https://other.com/p\" \"http://z/p\" \"https://u@h.com:8080/a/b/?q2\" \"https://u@h.com:8080/a/b/c?q=1#g\" \"https://u@h.com:8080/a/b/\" \"https://u@h.com:8080/a/b/d/\" \"https://u@h.com:8080/a/b/\" \"https://u@h.com:8080/a/\" \"mailto:a@b\" \"https://u@h.com:8080/a/b/y\"]"}
  {:suite "uri / resolve" :expr "[(mapv #(str (.resolve (java.net.URI. \"https://h.com\") %)) [\"a\" \"?q\" \"\"]) (mapv #(str (.resolve (java.net.URI. \"a/b/c\") %)) [\"d\" \"../../../d\" \"x:y\"]) (str (.resolve (java.net.URI. \"mailto:a@b\") \"x\")) (str (.resolve (java.net.URI. \"https://h.com/a/b/c#f\") \"#f\"))]"
   :expected "[[\"https://h.com/a\" \"https://h.com?q\" \"https://h.com\"] [\"a/b/d\" \"../d\" \"x:y\"] \"x\" \"https://h.com/a/b/c#f\"]"}
  {:suite "uri / resolve" :expr "(mapv #(str (.normalize (java.net.URI. %))) [\"https://h.com/a/./b/../c\" \"https://h.com/a/b/..\" \"https://h.com/a/b/.\" \"/../a\" \"a/../b\" \"x:y/../z\" \"./a:b\" \"https://h.com/a//b/./c\" \"/a/b/../../..\" \"a/..\" \"..\"])"
   :expected "[\"https://h.com/a/c\" \"https://h.com/a/\" \"https://h.com/a/b/\" \"/../a\" \"b\" \"x:y/../z\" \"./a:b\" \"https://h.com/a/b/c\" \"/..\" \"\" \"..\"]"}
  {:suite "uri / resolve" :expr "(let [b (java.net.URI. \"https://h.com/a/b/\")] [(mapv #(str (.relativize b (java.net.URI. %))) [\"https://h.com/a/b/c/d\" \"https://h.com/a/b/\" \"https://h.com/a/x\" \"http://h.com/a/b/c\" \"https://h.com/a/b/c?q#f\" \"https://h.com/a/bc/d\"]) (str (.relativize (java.net.URI. \"HTTPS://h.com/a/\") (java.net.URI. \"https://h.com/a/z\"))) (mapv #(.isOpaque (java.net.URI. %)) [\"mailto:a@b\" \"https://h.com/p\" \"/rel\"]) (mapv #(compare (java.net.URI. \"https://a\") (java.net.URI. %)) [\"https://a\" \"https://b\"]) (mapv str (sort [(java.net.URI. \"https://c\") (java.net.URI. \"https://a\")]))])"
   :expected "[[\"c/d\" \"\" \"https://h.com/a/x\" \"http://h.com/a/b/c\" \"c?q#f\" \"https://h.com/a/bc/d\"] \"z\" [true false false] [0 -1] [\"https://a\" \"https://c\"]]"}
