  {:suite "enum model" :expr "(do (deftype ConcE [n]) (let [fs (doall (for [i (range 16)] (future (jolt.host/register-enum! (str \"user.ConcE\" i) [[\"A\" (->ConcE i)] [\"B\" (->ConcE (- i))]]) (.isEnum (class (->ConcE 0))))))] (run! deref fs) (count (filter (fn [i] (= [\"A\" \"B\"] (mapv (fn [c] (.name c)) (.getEnumConstants (Class/forName (str \"user.ConcE\" i)))))) (range 16)))))" :expected "16"}
  ;; The concurrent collections under contention (jutil-concurrent.ss): adds from
  ;; several threads all land while a reader walks, and a compound write is
  ;; atomic (a skip list map without its root lock lost ~25% of these merges).
  {:suite "concurrent collections" :expr "(let [colls [(java.util.Vector.) (java.util.concurrent.ConcurrentLinkedQueue.) (java.util.concurrent.ConcurrentLinkedDeque.) (java.util.concurrent.CopyOnWriteArrayList.) (java.util.concurrent.CopyOnWriteArraySet.) (java.util.concurrent.ConcurrentSkipListSet.)] rd (future (dotimes [_ 40] (doseq [c colls] (reduce + 0 (seq c))))) fs (doall (for [t (range 8)] (future (doseq [c colls i (range 300)] (.add c (+ (* t 1000) i))))))] (run! deref fs) @rd [(mapv count colls) (= (set (first colls)) (set (last colls)))])" :expected "[[2400 2400 2400 2400 2400 2400] true]"}
  {:suite "concurrent collections" :expr "(let [m (java.util.concurrent.ConcurrentSkipListMap.) h (java.util.Hashtable.) f (reify java.util.function.BiFunction (apply [_ a b] (+ a b))) fs (doall (for [t (range 8)] (future (dotimes [i 500] (.merge m (mod i 7) 1 f) (.merge h (mod i 7) 1 f) (.putIfAbsent m (+ 100 (mod i 5)) t)))))] (run! deref fs) [(reduce + (map val (.headMap m 100))) (reduce + (vals h)) (count m)])" :expected "[4000 4000 12]"}
  {:suite "enum model / java.time" :expr "(let [fs (java.time.temporal.ChronoField/values)] [(mapv str (take 4 fs)) (str java.time.temporal.ChronoField/AMPM_OF_DAY) (.toString java.time.temporal.ChronoField/CLOCK_HOUR_OF_AMPM) (.name java.time.temporal.ChronoField/NANO_OF_SECOND) (str java.time.temporal.ChronoField/YEAR) (clojure.string/replace (pr-str [java.time.temporal.ChronoField/ERA]) #\"0x[0-9a-f]+\" \"0xH\")])" :expected "[[\"NanoOfSecond\" \"NanoOfDay\" \"MicroOfSecond\" \"MicroOfDay\"] \"AmPmOfDay\" \"ClockHourOfAmPm\" \"NANO_OF_SECOND\" \"Year\" \"[#object[java.time.temporal.ChronoField 0xH \\\"Era\\\"]]\"]"}
