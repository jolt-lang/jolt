  {:suite "winsock" :expr "(do (require (quote jolt.socket.native)) (= (set (map :name (filter :ip (jolt.socket.native/interface-addresses)))) (set (map #(.getName %) (enumeration-seq (java.net.NetworkInterface/getNetworkInterfaces))))))" :expected "true"}
  ;; A numeric literal is parsed, never resolved: getaddrinfo goes through a
