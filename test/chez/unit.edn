  {:suite "winsock" :expr "(do (require (quote jolt.socket.native)) (let [r (jolt.socket.native/resolve-addrs \"0.0.0.0\" 80 {:family jolt.socket.native/af-inet}) a (first (:addrs r))] (jolt.socket.native/free-addrs! (:addrs r)) [(:ip a) (:addrlen a) (count (:addrs r))]))" :expected "[\"0.0.0.0\" 16 1]"}
  {:suite "winsock" :expr "(do (require (quote jolt.socket.native)) (let [r (jolt.socket.native/resolve-addrs \"::\" 80) a (first (:addrs r))] (jolt.socket.native/free-addrs! (:addrs r)) [(:ip a) (:addrlen a)]))" :expected "[\"::\" 28]"}
