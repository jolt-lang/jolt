  ;; The socket numbers that differ by platform (jolt.socket.native). Every one
  ;; of the option numbers answered Linux's value on Windows once, which is the
  ;; other half of why no socket worked there — Winsock is BSD-shaped for them,
  ;; and MSG_NOSIGNAL in particular is not merely unnecessary there but an
  ;; unknown flag that fails the send. Its errors, AF_INET6 and WSAPOLLFD are
  ;; its own. A function of the platform, so the Windows row is pinned from
  ;; this runner.
  {:suite "winsock" :expr "(do (require (quote jolt.socket.native)) (select-keys (jolt.socket.native/consts-for :windows) [:sol-socket :so-reuseaddr :msg-nosignal :fionread :af-inet6 :so-reuseport :ipv6-v6only :eagain :econnrefused :pollfd-size :pollin :pollout :ai-addr-offset]))" :expected "{:sol-socket 65535, :so-reuseaddr 4, :msg-nosignal 0, :fionread 1074030207, :af-inet6 23, :so-reuseport nil, :ipv6-v6only 27, :eagain 10035, :econnrefused 10061, :pollfd-size 16, :pollin 768, :pollout 16, :ai-addr-offset 32}"}
  {:suite "winsock" :expr "(do (require (quote jolt.socket.native)) (select-keys (jolt.socket.native/consts-for :macos) [:sol-socket :so-reuseaddr :msg-nosignal :fionread :af-inet6 :so-reuseport :ipv6-v6only :eagain :econnrefused :pollfd-size :pollin :pollout :ai-addr-offset]))" :expected "{:sol-socket 65535, :so-reuseaddr 4, :msg-nosignal 0, :fionread 1074030207, :af-inet6 30, :so-reuseport 512, :ipv6-v6only 27, :eagain 35, :econnrefused 61, :pollfd-size 8, :pollin 1, :pollout 4, :ai-addr-offset 32}"}
  {:suite "winsock" :expr "(do (require (quote jolt.socket.native)) (select-keys (jolt.socket.native/consts-for :linux) [:sol-socket :so-reuseaddr :msg-nosignal :fionread :af-inet6 :so-reuseport :ipv6-v6only :eagain :econnrefused :pollfd-size :pollin :pollout :ai-addr-offset]))" :expected "{:sol-socket 1, :so-reuseaddr 2, :msg-nosignal 16384, :fionread 21531, :af-inet6 10, :so-reuseport 15, :ipv6-v6only 26, :eagain 11, :econnrefused 111, :pollfd-size 8, :pollin 1, :pollout 4, :ai-addr-offset 24}"}
  ;; the poller's wake pair: b is a's own peer, and both ends skip Nagle so a
  ;; one-byte wake is not held behind an unacknowledged one
  {:suite "winsock" :expr "(do (require (quote [jolt.socket.native :as n])) (let [[a b] (n/loopback-pair)] (try [(= (n/local-address a) (n/peer-address b)) (pos? (n/get-int-option a n/ipproto-tcp n/tcp-nodelay)) (pos? (n/get-int-option b n/ipproto-tcp n/tcp-nodelay))] (finally (n/c-close a) (n/c-close b)))))" :expected "[true true true]"}
  ;; SOCK_CLOEXEC is Linux's (bionic included); the BSDs and Winsock have none
  {:suite "winsock" :expr "(do (require (quote jolt.socket.native)) (mapv #(:sock-cloexec (jolt.socket.native/consts-for %)) [:linux :macos :windows]))" :expected "[524288 nil nil]"}
  ;; a nil host with :passive? is getaddrinfo's NULL node: the wildcard to bind
  {:suite "winsock" :expr "(do (require (quote [jolt.socket.native :as n])) (let [{:keys [addrs]} (n/resolve-addrs nil 80 {:passive? true :family n/af-inet})] (try (mapv :ip addrs) (finally (n/free-addrs! addrs)))))" :expected "[\"0.0.0.0\"]"}
  ;; every interface getifaddrs gives an address is a NetworkInterface, v6-only
