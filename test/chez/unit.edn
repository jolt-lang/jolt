  ;; PushbackReader.close() is in.close() — it closes the reader it WRAPS
  ;; (jolt-lang/jolt#1109). It was a no-op, so `with-open` over a PushbackReader —
  ;; the normal spelling, and the one clojure.core/read callers use — closed
  ;; nothing at all and the wrapped reader's port stayed open for the life of the
  ;; process. Only observable where the wrapped reader OWNS a handle: io/reader on
  ;; a path answers a StringReader here, java.io.FileReader is the streaming one.
  {:suite "pushback-close" :expr "(let [f (str (System/getProperty \"java.io.tmpdir\") \"/jolt-pbr-close.txt\") _ (spit f \"ab\") r (java.io.FileReader. f) p (java.io.PushbackReader. r)] (.read p) (.close p) (try (.read r) :not-closed (catch Throwable _ :closed)))" :expected ":closed"}
  {:suite "pushback-close" :expr "(let [closed (atom false) r (reify java.io.Closeable (close [_] (reset! closed true) nil)) p (java.io.PushbackReader. r)] (.close p) @closed)" :expected "true"}
  ;; ...and still after clojure.core/read has run over it (jolt-lang/jolt#1117):
  ;; a form read drains the wrapped reader and swaps a StringReader over the
  ;; unread tail into its place, and close used to close that swap, leaving the
  ;; file open until a GC -- on Windows, an undeletable file. jolt.loader reads
  ;; every source file this way.
  {:suite "pushback-close" :expr "(let [f (str (System/getProperty \"java.io.tmpdir\") \"/jolt-pbr-read-close.txt\") _ (spit f \"(a) (b)\") r (java.io.FileReader. f) p (java.io.PushbackReader. r)] [(read p) (do (.close p) (try (.read r) :not-closed (catch Throwable _ :closed)))])" :expected "[(a) :closed]"}
  {:suite "pushback-close" :expr "(let [f (str (System/getProperty \"java.io.tmpdir\") \"/jolt-lnpbr-read-close.txt\") _ (spit f \"(a)\") r (java.io.FileReader. f)] (with-open [p (clojure.lang.LineNumberingPushbackReader. r)] (read p false nil)) (try (.read r) :not-closed (catch Throwable _ :closed)))" :expected ":closed"}
  ;; the line-numbering subclass shares the table, so it delegates identically
  {:suite "pushback-close" :expr "(let [closed (atom false) r (reify java.io.Closeable (close [_] (reset! closed true) nil)) p (clojure.lang.LineNumberingPushbackReader. r)] (.close p) @closed)" :expected "true"}
  ;; ...but a wrapped value with NO close is still a no-op rather than a throw:
  ;; clojure.core's *in* is a reify over IReader, which a JVM PushbackReader could
  ;; never hold and which has no close to dispatch.
  {:suite "pushback-close" :expr "(with-in-str \"x\" (do (.close (java.io.PushbackReader. *in*)) :ok))" :expected ":ok"}
