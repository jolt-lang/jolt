  {:suite "jvm-misc" :label "aset through the var and the multi-index aset refuse a mismatched value as reflective Array.set does" :expr "(let [ex (fn [f] (try (f) :stored (catch IllegalArgumentException e [:iae (ex-message e)])))] [(ex #(apply aset [(into-array String [\"a\"]) 0 1])) (ex #(aset (make-array String 2 2) 0 1 5)) (ex #(java.lang.reflect.Array/set (make-array String 1) 0 1)) (vec (aget (doto (make-array String 2 2) (aset 0 1 \"z\")) 0)) (vec (doto (into-array String [\"a\"]) (as-> a (apply aset [a 0 \"b\"]))))])" :expected "[[:iae \"array element type mismatch\"] [:iae \"array element type mismatch\"] [:iae \"array element type mismatch\"] [nil \"z\"] [\"b\"]]"}
