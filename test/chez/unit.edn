  ;; Atomic compare-and-set!/swap-vals!/reset-vals! — atoms.ss implements them
  ;; atomically (mutex/CAS) and binds the clojure.core vars; the overlay used to
  ;; redefine them as racy check-then-act compositions, losing updates under real
  ;; threads. The contract rows pass under either (single-threaded); the stress row
  ;; fails pre-remint (overlay loses updates => "false") and passes post-remint
  ;; (native atomic => "true"). This stage edits the overlay => needs remint.
  {:suite "atomics" :label "swap-vals! returns [old new]" :expected "[5 6]" :expr "(let [a (atom 5)] (swap-vals! a inc))"}
  {:suite "atomics" :label "reset-vals! returns [old new]" :expected "[5 9]" :expr "(let [a (atom 5)] (reset-vals! a 9))"}
  {:suite "atomics" :label "compare-and-set! true on match and sets" :expected "[true 6]" :expr "(let [a (atom 5)] [(compare-and-set! a 5 6) (deref a)])"}
  {:suite "atomics" :label "compare-and-set! false on mismatch and no set" :expected "[false 5]" :expr "(let [a (atom 5)] [(compare-and-set! a 0 6) (deref a)])"}
  {:suite "atomics" :label "compare-and-set! rejects an equal distinct expectation" :expected "[false true]" :expr "(let [initial (list :value) equal (list :value) a (atom initial)] [(compare-and-set! a equal :bad) (identical? initial (deref a))])"}
  {:suite "atomics" :label "compare-and-set! accepts the identical expectation" :expected "[true :ok]" :expr "(let [v (list :value) a (atom v)] [(compare-and-set! a v :ok) (deref a)])"}
  {:suite "atomics" :label "compare-and-set! identity check does not realize equal lazy values" :expected "[false 0 true]" :expr "(let [calls (atom 0) actual (lazy-seq (swap! calls inc) (list :x)) expected (lazy-seq (swap! calls inc) (list :x)) a (atom actual)] [(compare-and-set! a expected :changed) (deref calls) (identical? actual (deref a))])"}
  {:suite "atomics" :label "compare-and-set! notifies watches once only after an identity match" :expected "[false true [[:watch true true :ok]]]" :expr "(let [v (list :value) a (atom v) events (atom [])] (add-watch a :watch (fn [k ref old new] (swap! events conj [k (identical? ref a) (identical? old v) new]))) [(compare-and-set! a (list :value) :bad) (compare-and-set! a v :ok) (deref events)])"}
  ;; The receiver check. swap!/reset! run jolt-need-atom and report the JVM's cast
  ;; failure; the other three reached a record accessor directly, so a non-atom got
  ;; a condition naming jolt's own record type ("... is not of type #<record type
  ;; jolt-atom-v3>") and nil stopped reporting as a NullPointerException, which a
  ;; catch selecting on it would no longer match.
  ;; The CLASS is asserted and not just the message, because a raw host condition
  ;; classes as :object and :object matches EVERY catch clause — so a row that only
  ;; caught NullPointerException passed on the broken behaviour too.
  {:suite "atomics" :label "compare-and-set! on a non-atom is the JVM's cast failure" :expected "[\"java.lang.ClassCastException\" \"class clojure.lang.Keyword cannot be cast to class clojure.lang.IAtom\"]" :expr "(try (compare-and-set! :nope 1 2) (catch Throwable e [(.getName (class e)) (.getMessage e)]))"}
  {:suite "atomics" :label "swap-vals! on a non-atom is the JVM's cast failure" :expected "[\"java.lang.ClassCastException\" \"class clojure.lang.Keyword cannot be cast to class clojure.lang.IAtom2\"]" :expr "(try (swap-vals! :nope inc) (catch Throwable e [(.getName (class e)) (.getMessage e)]))"}
  {:suite "atomics" :label "reset-vals! on a non-atom is the JVM's cast failure" :expected "[\"java.lang.ClassCastException\" \"class clojure.lang.Keyword cannot be cast to class clojure.lang.IAtom2\"]" :expr "(try (reset-vals! :nope 1) (catch Throwable e [(.getName (class e)) (.getMessage e)]))"}
  {:suite "atomics" :label "compare-and-set! on nil is a NullPointerException" :expected "\"java.lang.NullPointerException\"" :expr "(try (compare-and-set! nil 1 2) (catch Throwable e (.getName (class e))))"}
  {:suite "atomics" :label "swap-vals! on nil is a NullPointerException" :expected "\"java.lang.NullPointerException\"" :expr "(try (swap-vals! nil inc) (catch Throwable e (.getName (class e))))"}
  {:suite "atomics" :label "reset-vals! on nil is a NullPointerException" :expected "\"java.lang.NullPointerException\"" :expr "(try (reset-vals! nil 1) (catch Throwable e (.getName (class e))))"}
  {:suite "atomics" :label "CAS-retry increments across futures lose no updates (atomic native)" :expected "\"true\"" :expr "(do (let [a (atom 0) done (atom 0) n 4 per 2000 target (* n per)] (dotimes [_ n] (future (dotimes [_ per] (loop [] (let [cur (deref a)] (when-not (compare-and-set! a cur (inc cur)) (recur))))) (swap! done inc))) (loop [w 0] (cond (== (deref done) n) :fin (> w 1000000) :timeout :else (do (Thread/yield) (recur (inc w))))) (str (== (deref a) target))))"}
  {:suite "atomics" :label "AtomicInteger constructors preserve valid primitive values" :expected "[0 7]" :expr "[(.get (AtomicInteger.)) (.get (AtomicInteger. 7))]"}
  {:suite "atomics" :label "AtomicLong constructors preserve valid primitive values" :expected "[0 9]" :expr "[(.get (AtomicLong.)) (.get (AtomicLong. 9))]"}
  {:suite "atomics" :label "AtomicInteger constructor rejects an out-of-range value" :expected :throws :expr "(AtomicInteger. 2147483648)"}
  {:suite "atomics" :label "AtomicInteger addAndGet wraps signed overflow" :expected "-2147483648" :expr "(.addAndGet (AtomicInteger. 2147483647) 1)"}
  {:suite "atomics" :label "AtomicInteger decrementAndGet wraps signed underflow" :expected "2147483647" :expr "(.decrementAndGet (AtomicInteger. -2147483648))"}
  {:suite "atomics" :label "AtomicLong addAndGet wraps signed overflow" :expected "-9223372036854775808" :expr "(.addAndGet (AtomicLong. 9223372036854775807) 1)"}
  {:suite "atomics" :label "AtomicLong decrementAndGet wraps signed underflow" :expected "9223372036854775807" :expr "(.decrementAndGet (AtomicLong. -9223372036854775808))"}
  {:suite "atomics" :label "AtomicLong getAndAdd returns old and stores wrapped result" :expected "[9223372036854775807 -9223372036854775808]" :expr "(let [a (AtomicLong. 9223372036854775807)] [(.getAndAdd a 1) (.get a)])"}
  {:suite "atomics" :label "AtomicLong intValue narrows to signed 32 bits" :expected "[1 -2147483648 2147483647 7]" :expr "[(.intValue (AtomicLong. 4294967297)) (.intValue (AtomicLong. 2147483648)) (.intValue (AtomicLong. -2147483649)) (.intValue (AtomicInteger. 7))]"}
  {:suite "atomics" :label "AtomicInteger getAndSet validates before mutation" :expected "[:threw 7]" :expr "(let [a (AtomicInteger. 7)] [(try (.getAndSet a 2147483648) :no-throw (catch ArithmeticException _ :threw)) (.get a)])"}
  {:suite "atomics" :label "AtomicInteger compareAndSet validates next before mutation" :expected "[:threw 7]" :expr "(let [a (AtomicInteger. 7)] [(try (.compareAndSet a 7 2147483648) :no-throw (catch ArithmeticException _ :threw)) (.get a)])"}
  {:suite "atomics" :label "AtomicInteger compareAndSet validates expected before mutation" :expected "[:threw 7]" :expr "(let [a (AtomicInteger. 7)] [(try (.compareAndSet a 2147483648 8) :no-throw (catch ArithmeticException _ :threw)) (.get a)])"}
  {:suite "atomics" :label "AtomicReference compareAndSet rejects equal distinct expectations" :expected "[false true]" :expr "(let [v (list 1) a (AtomicReference. v)] [(.compareAndSet a (list 1) :bad) (identical? v (.get a))])"}
  {:suite "atomics" :label "AtomicReference compareAndSet accepts the same expectation" :expected "[true :ok]" :expr "(let [v (list 1) a (AtomicReference. v)] [(.compareAndSet a v :ok) (.get a)])"}
  ;; shadow-emitted (compiler-review R2 stage 1). Each row binds a local whose
  ;; name is a bare Scheme head the back end emits, in the scope of a construct
  ;; that emits that head, so the local would shadow the emitted form. Pre-remint
  ;; (old baked backend) these crash; post-remint they return the JVM value.
  {:suite "shadow-emitted" :expr "(let [keyword 5] :a)" :expected ":a"}
  {:suite "shadow-emitted" :expr "(let [integer->char 5] \\a)" :expected "\\a"}
  {:suite "shadow-emitted" :expr "(let [case-lambda 5] ((fn ([x] x) ([x y] y)) 1))" :expected "1"}
  {:suite "shadow-emitted" :expr "(let [dynamic-wind 5] (binding [*print-length* 3] 1))" :expected "1"}
  {:suite "shadow-emitted" :expr "(let [host-new 5] (.size (java.util.ArrayList.)))" :expected "0"}
  {:suite "shadow-emitted" :expr "(do (defrecord Rd [x]) (let [record-method-dispatch 5] (.toString (->Rd 1))))" :expected "\"user.Rd@3c6f1169\""}
  {:suite "shadow-emitted" :expr "(let [host-static-call 5] (String/valueOf 42))" :expected "\"42\""}
  {:suite "shadow-emitted" :expr "(let [host-static-ref 5] (pos? Long/MAX_VALUE))" :expected "true"}
  ;; hashtable-ref is emitted by the devirt ctor-inlining path; reproduces only
  ;; when ctor-shapes is populated (run-passes in compile-eval should set it).
  {:suite "shadow-emitted" :expr "(do (defrecord Hr [x]) (let [hashtable-ref 5] (->Hr 1)))" :expected "#user.Hr{:x 1}"}
  ;; Backend-only heads added to the shadow set for invariant completeness, NOT
  ;; unit-testable via compile-eval (they emit only on the whole-program path):
  ;; var-cell-deref (cell-cached var-cache? deref), def-var! / def-var-with-meta!
  ;; / declare-var! / intern-ns! / define (top-level + forward-decl + ns-splice),
  ;; foreign-procedure (ffi lowering). A local shadowing these only clashes when
  ;; the def/ffi/var-cache form is emitted inside that local's scope.
  ;; munge-injective (compiler-review R2 stage 2). munge-name maps ' -> $P, # -> $H,
  ;; | -> $V, and $ -> $$ (escape-first) so distinct Clojure locals get distinct
  ;; Scheme ids.
  ;; Pre-remint a' and a_PRIME_ both emit a_PRIME_ (old ' -> _PRIME_ substitution),
  ;; so (let [a' 1 a_PRIME_ 2] a') returned 2; post-remint a' emits a$P and returns 1.
  {:suite "munge-injective" :expr "(let [a' 1 a_PRIME_ 2] a')" :expected "1"}
  {:suite "munge-injective" :expr "(let [a' 1 a_PRIME_ 2] a_PRIME_)" :expected "2"}
  {:suite "munge-injective" :expr "(let [| 1 $V 2] |)" :expected "1"}
  {:suite "munge-injective" :expr "(let [| 1 $V 2] $V)" :expected "2"}
  {:suite "munge-injective"
   :expr "(do (defmacro ||| [x y] `(or ~x ~y)) (||| nil 7))"
   :expected "7"}
  ;; The reserved/emitted-name prefix is part of the same injectivity claim. It
  ;; was a bare `_`, which a user can write: `if` and `_if` both emitted `_if`,
  ;; so (let [if 1 _if 2] if) answered 2. The prefix is now the $R escape, which
  ;; no unprefixed munge can start with (an unprefixed $ is always $$/$P/$H/$V/$U).
  {:suite "munge-injective" :expr "(let [if 1 _if 2] if)" :expected "1"}
  {:suite "munge-injective" :expr "(let [if 1 _if 2] _if)" :expected "2"}
  {:suite "munge-injective" :expr "(let [lambda 1 _lambda 2] lambda)" :expected "1"}
  {:suite "munge-injective" :expr "(let [keyword 1] ((fn [_keyword] keyword) 2))" :expected "1"}
  {:suite "munge-injective" :expr "(let [if 1] ((fn [_if] if) 2))" :expected "1"}
  ;; A Clojure symbol both Scheme readers take for a NUMBER: +i/-i, +inf.0 and
  ;; friends, and a dot-leading or sign-dot-leading decimal. The reference reader
  ;; yields symbols for all of these; emitted bare they were "invalid bound
  ;; variable 0+1i" at compile time. Such a name takes the $R prefix too.
  {:suite "munge-injective"
   :expr "(let [+i 1 -i 2 .5 3 -.5 4 +.5e1 5 +inf.0 6 -inf.0 7 +nan.0 8 -NaN.0 9] [+i -i .5 -.5 +.5e1 +inf.0 -inf.0 +nan.0 -NaN.0])"
   :expected "[1 2 3 4 5 6 7 8 9]"}
  {:suite "munge-injective" :expr "((fn +i [] 1))" :expected "1"}
  {:suite "munge-injective" :expr "(letfn [(-i [] 2)] (-i))" :expected "2"}
  ;; near-misses stay bare identifiers on both hosts (a spare prefix would be
  ;; harmless, but these pin that the common -name/+name shapes are untouched)
  {:suite "munge-injective" :expr "(let [-invoke 1 +inc 2 -i0 3 .x 4 .. 5] [-invoke +inc -i0 .x ..])" :expected "[1 2 3 4 5]"}
  ;; A symbol built with (symbol s) can hold any character at all. Every
  ;; character that is not an identifier constituent on BOTH hosts (whitespace,
  ;; controls, the reader delimiters " ( ) [ ] { } ; , ` \ and the non-ASCII
  ;; White_Space chars Chez delimits on) escapes as $U<hex>$, so the emitted
  ;; Scheme still reads as one identifier — and distinct names stay distinct: a
  ;; backslash used to be swallowed by the reader, making a\b the same local as ab.
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a b\") 1] (symbol \"a b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a;b\") 1] (symbol \"a;b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a(b\") 1] (symbol \"a(b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a)b\") 1] (symbol \"a)b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a\\\"b\") 1] (symbol \"a\\\"b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a{b\") 1] (symbol \"a{b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a[b]\") 1] (symbol \"a[b]\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a,b\") 1] (symbol \"a,b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a`b\") 1] (symbol \"a`b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a\\tb\") 1] (symbol \"a\\tb\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a\\u00a0b\") 1] (symbol \"a\\u00a0b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a\\u2028b\") 1] (symbol \"a\\u2028b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a\\\\b\") 1 'ab 2] (symbol \"a\\\\b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a\\\\b\") 1 'ab 2] 'ab))" :expected "2"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a b\") 1 (symbol \"a\\u00a0b\") 2] (symbol \"a b\")))" :expected "1"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"a b\") 1 (symbol \"a\\u00a0b\") 2] (symbol \"a\\u00a0b\")))" :expected "2"}
  {:suite "munge-injective" :expr "(eval (list 'let [(symbol \"\") 1] (symbol \"\")))" :expected "1"}
  ;; the same escapes at a fn's own name and its params, not just a let
  {:suite "munge-injective" :expr "(eval (list (list 'fn (symbol \"f g\") [(symbol \"x y\")] (symbol \"x y\")) 3))" :expected "3"}
  ;; # reaches munge only as the reader's auto-gensym suffix on #() params
  ;; (p__1#) — a user can't write a #-named local (# is a dispatch char) — so the
  ;; # -> $H case is backend-only. Smoke-test that a #() still munges its gensym
  ;; params consistently at binding and reference.
  {:suite "munge-injective" :expr "(#(+ % %2) 1 2)" :expected "3"}
  ;; compiler-review R3 stage 1 — subnormal double printing (rt.ss jolt-flonum->string).
  ;; Chez tags subnormal number->string output with a "|prec" suffix that corrupted
  ;; the exponent; round-trip rows prove the value is preserved, and the plain pr-str
  ;; rows lock that normal-range printing is untouched. A subnormal prints the two
  ;; digits nearest its value, as Double.toString does (4.9E-324, not the padded
  ;; shortest form 5.0E-324); the expected strings are the JVM's.
  {:suite "r3-rt" :expr "(= (read-string (pr-str 4.9E-324)) 4.9E-324)" :expected "true"}
  {:suite "r3-rt" :expr "(= (read-string (pr-str 2.5E-323)) 2.5E-323)" :expected "true"}
  {:suite "r3-rt" :expr "(= (read-string (pr-str 1.0E-322)) 1.0E-322)" :expected "true"}
  {:suite "r3-rt" :expr "(pr-str 4.9E-324)" :expected "\"4.9E-324\""}
  {:suite "r3-rt" :expr "(pr-str 2.5E-323)" :expected "\"2.5E-323\""}
  {:suite "r3-rt" :expr "(pr-str 1.0E-322)" :expected "\"9.9E-323\""}
  {:suite "r3-rt" :expr "(pr-str 1.0E7)" :expected "\"1.0E7\""}
  {:suite "r3-rt" :expr "(pr-str 0.001)" :expected "\"0.001\""}
  {:suite "r3-rt" :expr "(pr-str 1.0E-300)" :expected "\"1.0E-300\""}
  ;; compiler-review R3 stage 2 — bigdec for ratios / sci-notation doubles / typed
  ;; errors (java/bigdec.ss). Ratio -> exact decimal (ArithmeticException if
  ;; non-terminating); flonum + exponent strings parse; Inf/NaN/garbage raise
  ;; NumberFormatException. jbigdec->string now matches BigDecimal.toString
  ;; (scientific for scale<0 or adjusted-exp<-6).
  {:suite "r3-bigdec" :expr "(bigdec 1/4)" :expected "0.25M"}
  {:suite "r3-bigdec" :expr "(+ (bigdec 1/4) 1M)" :expected "1.25M"}
  {:suite "r3-bigdec" :expr "(bigdec 1.0E300)" :expected "1.0E+300M"}
  {:suite "r3-bigdec" :expr "(bigdec \"1.0E300\")" :expected "1.0E+300M"}
  {:suite "r3-bigdec" :expr "(bigdec \"1.5e-7\")" :expected "1.5E-7M"}
  {:suite "r3-bigdec" :expr "(bigdec 1/3)" :expected :throws}
  {:suite "r3-bigdec" :expr "(bigdec ##Inf)" :expected :throws}
  {:suite "r3-bigdec" :expr "(bigdec \"abc\")" :expected :throws}
