  {:suite "math-nan" :label "clojure.math/acos out of domain -> NaN" :expected "##NaN" :expr "(clojure.math/acos 2.0)"}
  {:suite "math-nan" :label "clojure.math/log10 negative -> NaN" :expected "##NaN" :expr "(clojure.math/log10 -1.0)"}
  {:suite "math-nan" :label "clojure.math/log1p below -1 -> NaN" :expected "##NaN" :expr "(clojure.math/log1p -2.0)"}
  {:suite "math-nan" :label "Math/sqrt negative -> NaN" :expected "##NaN" :expr "(Math/sqrt -1.0)"}
  {:suite "math-nan" :label "Math/pow neg base fractional exp -> NaN" :expected "##NaN" :expr "(Math/pow -2.0 0.5)"}
  {:suite "math-nan" :label "Math/log negative -> NaN" :expected "##NaN" :expr "(Math/log -1.0)"}
  {:suite "math-nan" :label "Math/asin out of domain -> NaN" :expected "##NaN" :expr "(Math/asin 2.0)"}
  {:suite "math-nan" :label "Math/acos out of domain -> NaN" :expected "##NaN" :expr "(Math/acos 2.0)"}
  {:suite "math-nan" :label "Math/log10 negative -> NaN" :expected "##NaN" :expr "(Math/log10 -1.0)"}
  {:suite "math-nan" :label "Math/log1p below -1 -> NaN" :expected "##NaN" :expr "(Math/log1p -2.0)"}
