  ;; The reflection member model: jolt reports what its registries KNOW a class
  ;; declares, not what the JVM ships. A host class whose methods are a `cond`
  ;; (String's live in natives-str.ss) has nothing to enumerate, so the honest
  ;; answer is empty rather than a guess. jolt-only — the JVM answers differently
  ;; by construction, so these cannot be corpus rows.
  {:suite "reflect-member-model" :expr "(count (.getMethods String))" :expected "0"}
  {:suite "reflect-member-model" :expr "(count (.getDeclaredFields String))" :expected "0"}
  {:suite "reflect-member-model" :expr "(do (defprotocol PA (pa [this])) (defprotocol PB (pb [this])) (deftype TT [] PA (pa [_] 1) PB (pb [_] 2)) (count (.getMethods TT)))" :expected "2"}
  {:suite "reflect-member-model" :expr "(do (defrecord RR [a b]) (mapv (fn [f] (.getName f)) (.getDeclaredFields RR)))" :expected "[\"a\" \"b\"]"}
  {:suite "reflect-member-model" :expr "(do (defrecord RS [a]) (.getName (.getDeclaredField RS \"a\")))" :expected "\"a\""}
  {:suite "reflect-member-model" :expr "(do (defrecord RT [a]) (= (.getName (.getField RT \"a\")) (.getName (.getDeclaredField RT \"a\"))))" :expected "true"}
  ;; the class graph answers modifiers for a name it models; one it does not
  ;; reports PUBLIC alone rather than claiming non-finality it cannot know
  {:suite "reflect-member-model" :expr "(.getModifiers (Class/forName \"java.lang.Thread\"))" :expected "1"}
  ;; clojure.reflect over the same registries: the reference JavaReflector is a
  ;; thin layer on getDeclaredFields/Methods/Constructors + getModifiers + bases,
  ;; so the port is the reference apart from the member-set model above.
  {:suite "clojure-reflect" :expr "(do (require 'clojure.reflect) (defrecord Rr1 [a b]) (sort (map (comp str :name) (filter :type (:members (clojure.reflect/reflect Rr1))))))" :expected "(\"a\" \"b\")"}
