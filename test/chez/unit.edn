  {:suite "reader-macros" :expr "(do (require (quote [jolt.reader :as r])) (try (r/set-dispatch-macro! \\{ identity) :no-throw (catch Exception e (ex-message e))))" :expected "\"cannot register a reader macro on #{: the reader claims it\""}
