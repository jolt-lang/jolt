  {:suite "class-extensions" :expr "(do (jolt.host/extend-class! \"java.lang.String\" {:methods {\"shoutIt\" (fn [self] (.toUpperCase self))}}) (.shoutIt \"hi\"))" :expected "\"HI\""}
  ;; …because the backend lowers a proven String receiver directly, so an
  ;; override would apply at some call sites and not others
  {:suite "class-extensions" :expr "(jolt.host/extend-class! \"java.lang.String\" {:methods {\"length\" (fn [_] 0)} :override true})" :expected :throws}
