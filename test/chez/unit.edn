  ;; the jolt-only keys the overlay itself reads (protocols.ss make-protocol)
  {:suite "defprotocol-value" :expr "(do (defprotocol Pu5 (mu5 [this])) [(:name Pu5) (-> Pu5 :methods :mu5 :name)])" :expected "[user/Pu5 \"mu5\"]"}
  ;; The :jolt/type discriminator is the same keyword every other :jolt/type in the
  ;; host is — (keyword "jolt" "type"), which is what the reader produces for
  ;; :jolt/type in source — so it is reachable from Clojure and the tag is LIVE.
  ;; It was once (keyword #f "jolt/type"), one keyword whose NAME was the whole
  ;; string: it printed identically, was equal to none of the others, and left
  ;; (:jolt/type P) nil. jolt-dkz. The middle element pins that the legacy spelling
  ;; does not come back; the last one, that the key the value actually carries is
  ;; the one the reader produces.
  {:suite "defprotocol-value" :expr "(do (defprotocol Pu6 (mu6 [this])) [(:jolt/type Pu6) (get Pu6 (keyword nil \"jolt/type\")) (contains? Pu6 :jolt/type)])" :expected "[:jolt/protocol nil true]"}
  ;; ...and the tag now does the job it exists for: host-contract.ss hc-map? is
  ;; "a map form is a pmap with no :jolt/type", so a protocol value a macro put in
  ;; its expansion is no longer re-analyzed as a map literal (which resolved the
  ;; :name entry's symbol and died as "Unable to resolve symbol: user/Pq"). It is a
