  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (str (.toURI (io/file \"/tmp/jolt-no-such-dir/x\"))))" :expected "\"file:/tmp/jolt-no-such-dir/x\""}
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (pr-str (.toURI (io/file \"/tmp/jolt-no-such-dir/x\"))))" :expected "\"#object[java.net.URI \\\"file:/tmp/jolt-no-such-dir/x\\\"]\""}
  {:suite "ioreader" :expr "(do (require (quote [clojure.java.io :as io])) (clojure.string/replace (pr-str (io/file \"/tmp/x\")) #\" 0x[0-9a-f]+\" \"\"))" :expected "\"#object[java.io.File \\\"/tmp/x\\\"]\""}
