  ;; Thread/join must honour its timeout: joining a thread that outlives the
  ;; timeout has to return, not block until the thread happens to finish.
  {:suite "threads" :expr "(let [t (Thread. (fn [] (Thread/sleep 30000)))] (.start t) (.join t 50) (.isAlive t))" :expected "true"}
  {:suite "threads" :expr "(let [t (Thread. (fn [] nil))] (.start t) (.join t 10000) (.isAlive t))" :expected "false"}
  {:suite "threads" :expr "(let [t (Thread. (fn [] nil))] (.start t) (.join t) (.isAlive t))" :expected "false"}
  ;; join waits while the thread is ALIVE, and a thread that was never started
  ;; never is — testing only the completion flag hung forever here, and burned the
  ;; whole timeout in the bounded form.
  {:suite "threads" :expr "(let [t (Thread. (fn [] nil))] (.join t) (.isAlive t))" :expected "false"}
  {:suite "threads" :expr "(let [t (Thread. (fn [] nil)) a (System/nanoTime)] (.join t 5000) (< (- (System/nanoTime) a) 1000000000))" :expected "true"}
  {:suite "threads" :expr "(try (.join (Thread. (fn [] nil)) -1) :no-throw (catch IllegalArgumentException e :iae))" :expected ":iae"}
  ;; TimeUnit: nothing modeled it, so every (timeout, unit) method in the tree was
  ;; uncallable AND silently discarded its timeout. Conversions truncate toward zero.
  {:suite "threads" :expr "(.name java.util.concurrent.TimeUnit/SECONDS)" :expected "\"SECONDS\""}
  {:suite "threads" :expr "(str java.util.concurrent.TimeUnit/MILLISECONDS)" :expected "\"MILLISECONDS\""}
  {:suite "threads" :expr "(.toMillis java.util.concurrent.TimeUnit/SECONDS 5)" :expected "5000"}
  {:suite "threads" :expr "(.toMinutes java.util.concurrent.TimeUnit/SECONDS 90)" :expected "1"}
  ;; a latch nobody counts down: the bounded await must give up, not wait forever
  {:suite "threads" :expr "(.await (java.util.concurrent.CountDownLatch. 1) 50 java.util.concurrent.TimeUnit/MILLISECONDS)" :expected "false"}
  {:suite "threads" :expr "(let [l (java.util.concurrent.CountDownLatch. 1)] (.countDown l) (.await l 10 java.util.concurrent.TimeUnit/SECONDS))" :expected "true"}
  ;; the unit is READ, not assumed to be milliseconds: 2 SECONDS must outlast a 200ms task
  {:suite "threads" :expr "(let [ex (java.util.concurrent.Executors/newSingleThreadExecutor)] (.submit ex (fn [] (Thread/sleep 200))) (.shutdown ex) (.awaitTermination ex 10 java.util.concurrent.TimeUnit/SECONDS))" :expected "true"}
  ;; a bounded Future/get throws TimeoutException instead of waiting out the task
  {:suite "threads" :expr "(let [ex (java.util.concurrent.Executors/newSingleThreadExecutor) f (.submit ex (fn [] (Thread/sleep 30000)))] (try (.get f 50 java.util.concurrent.TimeUnit/MILLISECONDS) :no-throw (catch Throwable e :timeout)))" :expected ":timeout"}
