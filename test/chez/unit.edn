  {:suite "wide-call", :label "...a keyword or a map called with five arguments is an ArityException", :expr "(let [k :a m {:a 1}] [(try (k m 2 3 4 5) (catch clojure.lang.ArityException e :arity)) (try (m :a 2 3 4 5) (catch clojure.lang.ArityException e :arity))])", :expected "[:arity :arity]"}
  {:suite "wide-call", :label "...a multimethod", :expr "(do (defmulti w8 (fn [& xs] (count xs))) (defmethod w8 5 [a b c d e] :five) (defmethod w8 6 [a b c d e f] :six) [(w8 1 2 3 4 5) (w8 1 2 3 4 5 6)])", :expected "[:five :six]"}
