  ;; and the length difference when one string prefixes the other — a sign beside
  ;; a magnitude was two contracts for one pair of methods.
  {:suite "str" :expr "[(.compareTo \"a\" \"c\") (.compareTo \"abcd\" \"ab\") (.compareTo \"ab\" \"abcd\") (.compareTo \"a\" \"a\") (.compareTo \"Z\" \"a\")]" :expected "[-2 2 -2 0 -7]"}
  ;; equalsIgnoreCase IS regionMatches(true, 0, other, 0, length) on the JVM, so
  ;; the two share one fold. Scheme's string-ci=? is the full Unicode folding and
  ;; disagrees on dotless i, which Java calls equal (both upper-case to I).
  {:suite "str" :expr "[(.regionMatches \"I\" true 0 \"ı\" 0 1) (.equalsIgnoreCase \"I\" \"ı\") (.regionMatches \"aÉc\" true 1 \"é\" 0 1)]" :expected "[true true true]"}
  {:suite "str" :expr "[(.regionMatches \"abcd\" 1 \"bc\" 0 2) (.regionMatches \"abcd\" 1 \"xy\" 0 2)]" :expected "[true false]"}
  ;; the leading-boolean ignore-case overload, and an out-of-range region (false, not a throw)
  {:suite "str" :expr "[(.regionMatches \"abcd\" true 1 \"BC\" 0 2) (.regionMatches \"abcd\" false 1 \"BC\" 0 2)]" :expected "[true false]"}
  {:suite "str" :expr "(.regionMatches \"ab\" 1 \"bc\" 0 5)" :expected "false"}
  ;; strip is Character.isWhitespace where trim cuts at <= U+0020: the ideographic
  ;; space goes, the NON-BREAKING space stays (Java excludes it from isWhitespace).
  {:suite "str" :expr "[(.strip \"  a  \") (.stripLeading \"  a  \") (.stripTrailing \"  a  \")]" :expected "[\"a\" \"a  \" \"  a\"]"}
  ;; by length, so the row carries no invisible characters: strip takes the
  ;; ideographic spaces off (1 char left) where trim keeps them (3), and NEITHER
  ;; touches the non-breaking space (3), which Java excludes from isWhitespace.
  {:suite "str" :expr "[(count (.strip \"\\u3000a\\u3000\")) (count (.trim \"\\u3000a\\u3000\"))]" :expected "[1 3]"}
  {:suite "str" :expr "(count (.strip \"\\u00a0a\\u00a0\"))" :expected "3"}
  ;; U+001C..U+001F are whitespace to Java but carry no Unicode White_Space property
  {:suite "str" :expr "(.strip \"\\u001ca\\u001c\")" :expected "\"a\""}
  ;; String/valueOf(char[]) is the chars, not the array's own #object[[C] rendering
  {:suite "str" :expr "(String/valueOf (char-array \"hi\"))" :expected "\"hi\""}
  {:suite "str" :expr "[(String/valueOf 42) (String/valueOf nil)]" :expected "[\"42\" \"null\"]"}
  ;; copyValueOf IS valueOf, at both of its arities (the JDK defines them so), and
  ;; the 3-arg overload is valueOf(char[], offset, count): it used to resolve to the
  ;; 1-arg arm with the offset and count dropped, answering the whole array.
  {:suite "str" :expr "[(String/copyValueOf (char-array \"hi\")) (String/copyValueOf (char-array \"abc\") 1 2) (String/valueOf (char-array \"abc\") 1 2)]" :expected "[\"hi\" \"bc\" \"bc\"]"}
  ;; A STATIC resolves by arity too. These are unit rows rather than corpus rows
  ;; because the JVM compiler rejects the call outright — there is no value for the
  ;; oracle to source, only a compile error — but the report is the compiler's,
  ;; which names the class (Clojure 1.12.0: "No matching method valueOf found
  ;; taking 2 args for class java.lang.String").
  {:suite "str" :expr "(try (String/valueOf (char-array \"abc\") 0) (catch IllegalArgumentException e (.getMessage e)))" :expected "\"No matching method valueOf found taking 2 args for class java.lang.String\""}
  {:suite "str" :expr "(try (String/valueOf 5 1 2) (catch ClassCastException e (.getMessage e)))" :expected "\"class java.lang.Long cannot be cast to class [C\""}
  {:suite "javastatic" :expr "(try (System/getenv \"HOME\" 1) (catch IllegalArgumentException e (.getMessage e)))" :expected "\"No matching method getenv found taking 2 args for class java.lang.System\""}
  {:suite "javastatic" :expr "(map? (System/getenv))" :expected "true"}
  ;; A member that picks its overload out of a rest list states the JVM's
  ;; arities (host-static.ss arity rows), so an extra argument is a miss, not a
  ;; dropped value: each of these used to answer as if the last argument were
  ;; not there (jolt#1020).
  {:suite "javastatic" :expr "(mapv (fn [f] (try (f) (catch IllegalArgumentException e (.getMessage e)))) [#(Integer/parseInt \"1\" 10 3) #(Long/valueOf \"1\" 10 3) #(Long/toString 5 10 3) #(System/getProperty \"x\" \"d\" 1) #(Thread/sleep 1 0 1)])" :expected "[\"No matching method parseInt found taking 3 args for class java.lang.Integer\" \"No matching method valueOf found taking 3 args for class java.lang.Long\" \"No matching method toString found taking 3 args for class java.lang.Long\" \"No matching method getProperty found taking 3 args for class java.lang.System\" \"No matching method sleep found taking 3 args for class java.lang.Thread\"]"}
  {:suite "javastatic" :expr "[(Integer/parseInt \"ff\" 16) (Long/toString 255 16) (System/getProperty \"jolt.no.such.prop\" \"d\")]" :expected "[255 \"ff\" \"d\"]"}
  ;; java.lang.Math's entries coerce their operands through one wrapper, which
  ;; used to hide their arity: an extra argument reached Chez's own arity error,
  ;; naming an anonymous procedure. A proven-double operand takes the flonum
  ;; lowering, which checks the JVM arity too.
  {:suite "javastatic" :expr "(mapv (fn [f] (try (f) (catch IllegalArgumentException e (.getMessage e)))) [#(Math/abs 1 2) #(Math/max 1 2 3) #(Math/floor 4.5 1) #(Math/pow 2.0 3.0 4.0)])" :expected "[\"No matching method abs found taking 2 args for class java.lang.Math\" \"No matching method max found taking 3 args for class java.lang.Math\" \"No matching method floor found taking 2 args for class java.lang.Math\" \"No matching method pow found taking 3 args for class java.lang.Math\"]"}
  ;; a java.lang.Class method is not a static of the class it describes: the dot
  ;; form calls it on the class value, the static form is a miss
  {:suite "javastatic" :expr "[(.getName Math) (try (Math/getName) (catch IllegalArgumentException e :miss))]" :expected "[\"java.lang.Math\" :miss]"}
  ;; BigInteger.toString(radix), the overload jolt's single integer type takes:
  ;; a radix outside 2..36 renders in base 10, as BigInteger does
  {:suite "javastatic" :expr "[(.toString (biginteger 255) 16) (.toString (biginteger 255) 1) (.toString (biginteger 255) 37) (try (.toString 5.0 16) (catch IllegalArgumentException e :miss))]" :expected "[\"ff\" \"255\" \"255\" :miss]"}
  ;; java.lang.Character's case maps and classification, char and int overloads
  {:suite "javastatic" :expr "[(Character/toUpperCase \\a) (Character/toUpperCase 97) (Character/toUpperCase \\ß) (Character/toLowerCase (char 0x130)) (Character/toTitleCase (char 0x1C6)) (Character/toString 128512) (Character/isAlphabetic 97) (Character/isSpaceChar \\space) (Character/isISOControl (char 7)) (Character/compare \\a \\b) (Character/hashCode \\a) (Character/isJavaIdentifierStart \\$) (Character/isJavaIdentifierPart \\1) (Character/isJavaIdentifierStart \\1)]" :expected "[\\A 65 \\ß \\i \\ǅ \"😀\" true true true -1 97 true true false]"}
  {:suite "javastatic" :expr "(try (Character/toString -1) (catch IllegalArgumentException e (.getMessage e)))" :expected "\"Not a valid Unicode code point: 0x-1\""}
  ;; java.util.Objects
  {:suite "javastatic" :expr "[(java.util.Objects/equals 1 1) (java.util.Objects/equals (int-array [1]) (int-array [1])) (java.util.Objects/deepEquals (int-array [1]) (int-array [1])) (java.util.Objects/hash (to-array [\"a\" nil 3])) (java.util.Objects/hashCode nil) (java.util.Objects/toString nil) (java.util.Objects/toString nil \"d\") (java.util.Objects/isNull nil) (java.util.Objects/nonNull nil) (java.util.Objects/requireNonNullElse nil 2) (java.util.Objects/compare 1 2 compare) (java.util.Objects/checkIndex 1 3)]" :expected "[true false true 123011 0 \"null\" \"d\" true false 2 -1 1]"}
  {:suite "javastatic" :expr "(mapv (fn [f] (try (f) (catch Exception e [(.getSimpleName (class e)) (.getMessage e)]))) [#(java.util.Objects/requireNonNull nil) #(java.util.Objects/requireNonNull nil \"boom\") #(java.util.Objects/requireNonNullElse nil nil) #(java.util.Objects/checkIndex 5 3)])" :expected "[[\"NullPointerException\" nil] [\"NullPointerException\" \"boom\"] [\"NullPointerException\" \"defaultObj\"] [\"IndexOutOfBoundsException\" \"Index 5 out of bounds for length 3\"]]"}
  ;; Arrays/asList is a fixed-size view of its array
  {:suite "javastatic" :expr "(let [a (to-array [1 2 3]) l (java.util.Arrays/asList a)] (.set l 0 9) (aset a 2 7) [(vec l) (vec a) (.size l) (.getName (class l)) (count l) (try (.add l 4) (catch UnsupportedOperationException e :unsupported))])" :expected "[[9 2 7] [9 2 7] 3 \"java.util.Arrays$ArrayList\" 3 :unsupported]"}
  ;; the java.lang.Number surface resolves by arity as well; jolt has one integer
  ;; type, so the class it names is Long where the JVM names Integer
  {:suite "javastatic" :expr "(try (.intValue (int 5) 1) (catch IllegalArgumentException e (.getMessage e)))" :expected "\"No matching method intValue found taking 1 args for class java.lang.Long\""}
  ;; String/join over a collection and spread as varargs, the JVM's two overloads
  {:suite "str" :expr "(String/join \",\" [\"a\" \"b\" \"c\"])" :expected "\"a,b,c\""}
  {:suite "str" :expr "[(String/join \"-\" \"a\" \"b\") (String/join \",\" [])]" :expected "[\"a-b\" \"\"]"}
  ;; .split's limit, on both String and Pattern: >0 caps the parts and leaves the
  ;; last one unsplit, 0 (and the 1-arg form) drops trailing empties, <0 keeps them.
  ;; The limit used to be discarded, so splitting a key from a value that may itself
  ;; contain the separator truncated the value at its first one.
  {:suite "str" :expr "(vec (.split \"a:b:c\" \":\" 2))" :expected "[\"a\" \"b:c\"]"}
  {:suite "str" :expr "(vec (.split \"q1,q2,,,\" \",\" -1))" :expected "[\"q1\" \"q2\" \"\" \"\" \"\"]"}
  {:suite "str" :expr "(vec (.split \"q1,q2,,,\" \",\" 0))" :expected "[\"q1\" \"q2\"]"}
  ;; an INTERIOR empty field survives; irregex-split used to collapse it
  {:suite "str" :expr "(vec (.split \"a::b\" \":\"))" :expected "[\"a\" \"\" \"b\"]"}
  {:suite "str" :expr "(vec (.split (java.util.regex.Pattern/compile \":\") \"a:b:c\" 2))" :expected "[\"a\" \"b:c\"]"}
  {:suite "str" :expr "(vec (.split (java.util.regex.Pattern/compile \",\") \"q1,q2,,,\" -1))" :expected "[\"q1\" \"q2\" \"\" \"\" \"\"]"}
  {:suite "str" :expr "(vec (.split (java.util.regex.Pattern/compile \":\") \"a::b\"))" :expected "[\"a\" \"\" \"b\"]"}
  {:suite "str" :expr "(.frobnicate \"abc\")" :expected :throws}
  ;; the priority-6 string arm (records-dispatch.ss) hoists string receivers
  ;; ahead of the dotform/collection arms. These pin the shapes that hoist
  ;; could have changed: .getClass must still outrank it (the string arm has
  ;; no getClass case), a dashed field read must stay a FIELD miss (the
  ;; no-method-throw dash-stripping message, not a method one), and Object
  ;; methods must answer as before.
  {:suite "str" :expr "(.getSimpleName (.getClass \"x\"))" :expected "\"String\""}
  {:suite "str" :expr "(.-f \"s\")" :expected :throws}
  {:suite "str" :expr "(try (.-f \"s\") (catch Exception e (.getMessage e)))" :expected "\"No matching field found: f for class java.lang.String\""}
  {:suite "str" :expr "[(.equals \"a\" \"a\") (.equals \"a\" \"b\") (.equals \"a\" :a)]" :expected "[true false false]"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/upper-case \"abc\"))" :expected "\"ABC\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/lower-case \"ABC\"))" :expected "\"abc\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/capitalize \"hello\"))" :expected "\"Hello\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/trim \"  x  \"))" :expected "\"x\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (= \"x  \" (s/triml \"  x  \")))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (= \"  x\" (s/trimr \"  x  \")))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/blank? \"\"))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/blank? \"  \"))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/blank? \"x\"))" :expected "false"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/blank? nil))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/includes? \"abcd\" \"bc\"))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/includes? \"abcd\" \"zz\"))" :expected "false"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/starts-with? \"abc\" \"ab\"))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/starts-with? \"abc\" \"bc\"))" :expected "false"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/ends-with? \"abc\" \"bc\"))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/join [\"a\" \"b\" \"c\"]))" :expected "\"abc\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/join \",\" [\"a\" \"b\" \"c\"]))" :expected "\"a,b,c\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/join \"-\" [1 2 3]))" :expected "\"1-2-3\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/split \"a,b,c\" \",\"))" :expected "[\"a\" \"b\" \"c\"]"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/split \"a1b2c\" #\"[0-9]\"))" :expected "[\"a\" \"b\" \"c\"]"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/split-lines \"a\\nb\\nc\"))" :expected "[\"a\" \"b\" \"c\"]"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/replace \"a_b_c\" \"_\" \"-\"))" :expected "\"a-b-c\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/replace \"a1b2\" #\"[0-9]\" \"\"))" :expected "\"ab\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/replace-first \"a_b_c\" \"_\" \"-\"))" :expected "\"a-b_c\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/reverse \"abc\"))" :expected "\"cba\""}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/index-of \"abc\" \"b\"))" :expected "1"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (nil? (s/index-of \"abc\" \"z\")))" :expected "true"}
  {:suite "strns" :expr "(do (require (quote [clojure.string :as s])) (s/trim-newline \"abc\\n\\n\"))" :expected "\"abc\""}
