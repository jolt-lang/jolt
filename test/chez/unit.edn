  {:suite "wide-call", :label "...the fn position is evaluated before the arguments", :expr "(do (defn w10 [a b c d e] (str a b c d e)) (defn w10c [] (w10 (do (alter-var-root (var w10) (constantly (fn [a b c d e] :new))) 1) 2 3 4 5)) [(w10c) (w10c)])", :expected "[\"12345\" :new]"}
