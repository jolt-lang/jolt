  ;; the map-as-object read above answers for a key the map HAS. A key it does not
  ;; have, an undeclared record slot, or a value with no field concept at all is an
  ;; error — it used to be a silent nil, which reads as a present-and-nil field.
  {:suite "dotform" :expr "(try (.-nope {:value 41}) (catch IllegalArgumentException e (.getMessage e)))" :expected "\"No matching field found: nope for class clojure.lang.PersistentArrayMap\""}
