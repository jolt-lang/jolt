  ;; binding resolves each name through (var sym) at compile time, as the JVM's
  ;; binding macro does: a name with no var is the compile error, naming it (the
  ;; JVM's message, which there is the cause of a CompilerException), and
  ;; one defined only below the form is the same error, whether the binding is
  ;; at the top level or in a fn body compiled before the def runs. A non-dynamic
  ;; var compiles and is refused when the frame is pushed.
  {:suite "vars / binding resolution" :label "an unresolvable name is a compile error naming it"
   :expr "(try (eval '(binding [*bnd-undef* 1] 2)) (catch Throwable e (ex-message e)))"
   :expected "\"Unable to resolve var: *bnd-undef* in this context\""}
  {:suite "vars / binding resolution" :label "binding a non-dynamic var is the JVM's runtime error"
   :expr "(do (def bnd-nd 1) (try (binding [bnd-nd 2] bnd-nd) (catch IllegalStateException e (ex-message e))))"
   :expected "\"Can't dynamically bind non-dynamic var: user/bnd-nd\""}
  {:suite "vars / binding resolution" :label "a var defined below a top-level binding is unresolved"
   :expr "[(try (eval '(do (println (binding [*bnd-top* 1] *bnd-top*)) (def ^:dynamic *bnd-top* 0))) (catch Throwable e (ex-message e))) (resolve '*bnd-top*)]"
   :expected "[\"Unable to resolve var: *bnd-top* in this context\" nil]"}
  {:suite "vars / binding resolution" :label "a var defined below a fn body's binding is unresolved"
   :expr "[(try (eval '(do (defn bnd-fwd [] (binding [*bnd-fwd* 1] *bnd-fwd*)) (def ^:dynamic *bnd-fwd* 0))) (catch Throwable e (ex-message e))) (resolve '*bnd-fwd*)]"
   :expected "[\"Unable to resolve var: *bnd-fwd* in this context\" nil]"}
