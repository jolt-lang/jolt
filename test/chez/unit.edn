  {:suite "core.async" :expr "(do (require '[clojure.core.async :as a]) (let [far (a/timeout 30000) t0 (System/currentTimeMillis) _ (a/<!! (a/timeout 50)) el (- (System/currentTimeMillis) t0)] [(>= el 40) (< el 5000)]))" :expected "[true true]"}
