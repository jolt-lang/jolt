  {:suite "dyn-cache", :label "...bound-fn* conveys the frames it captured", :expr "(do (def ^:dynamic *dc4* :root) (let [f (binding [*dc4* :conveyed] (bound-fn* (fn [] *dc4*)))] [(f) *dc4* (binding [*dc4* :other] (f))]))", :expected "[:conveyed :root :conveyed]"}
  {:suite "dyn-cache", :label "...a future reads the conveyed binding", :expr "(do (def ^:dynamic *dc5* :root) (binding [*dc5* :parent] (let [v *dc5*] [v (clojure.core/deref (future *dc5*)) *dc5*])))", :expected "[:parent :parent :parent]"}
  {:suite "dyn-cache", :label "...get-thread-bindings and with-bindings", :expr "(do (def ^:dynamic *dc6* 1) (binding [*dc6* 2] (let [m (get-thread-bindings)] [(get m (var *dc6*)) (with-bindings {(var *dc6*) 3} *dc6*) *dc6*])))", :expected "[2 3 2]"}
  {:suite "dyn-cache", :label "...a conveyed frame read on another thread refuses set!", :expr "(do (def ^:dynamic *dc7* :root) (binding [*dc7* :a] (dotimes [_ 5] *dc7*) (let [r (clojure.core/deref (future (try (set! *dc7* :x) :set (catch IllegalStateException e :refused))))] [r *dc7*])))", :expected "[:refused :a]"}
  {:suite "dyn-cache", :label "...thread-bound?", :expr "(do (def ^:dynamic *dc8* 0) [(thread-bound? (var *dc8*)) (binding [*dc8* 1] [(thread-bound? (var *dc8*)) *dc8*]) *dc8*])", :expected "[false [true 1] 0]"}
  {:suite "dyn-cache", :label "...rebinding in a loop, frame by frame", :expr "(do (def ^:dynamic *dc9* 0) (loop [i 0 acc []] (if (< i 4) (recur (inc i) (conj acc (binding [*dc9* i] (+ *dc9* (binding [*dc9* (* 10 i)] *dc9*))))) [acc *dc9*])))", :expected "[[0 11 22 33] 0]"}
