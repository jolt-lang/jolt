  ;; value reported (class x) => :object.
  {:suite "nio-filetime" :expr "(str (class (java.nio.file.attribute.FileTime/fromMillis 5)))" :expected "\"class java.nio.file.attribute.FileTime\""}
  {:suite "nio-filetime" :expr "(instance? java.nio.file.attribute.FileTime (java.nio.file.attribute.FileTime/fromMillis 5))" :expected "true"}
  {:suite "nio-filetime" :expr "(.toMillis (java.nio.file.attribute.FileTime/from (java.time.Instant/ofEpochMilli 1234)))" :expected "1234"}
  {:suite "nio-filetime" :expr "(.toMillis (java.nio.file.attribute.FileTime/from 3 java.util.concurrent.TimeUnit/SECONDS))" :expected "3000"}
  ;; a DIRECTORY's mtime, set from a number and from an Instant, read back to the
  ;; millisecond. On Windows the CRT's _utime64 cannot open a directory at all, so
  ;; the set was silently dropped there and kmet's stale-lock test could not
  ;; back-date its lock directory.
  {:suite "nio-filetime" :expr "(let [d (Files/createTempDirectory \"jft\" (into-array java.nio.file.attribute.FileAttribute []))] (Files/setLastModifiedTime d (java.nio.file.attribute.FileTime/fromMillis 1600000000123)) (let [a (.toMillis (Files/getLastModifiedTime d (into-array java.nio.file.LinkOption [])))] (Files/setLastModifiedTime d (java.nio.file.attribute.FileTime/from (java.time.Instant/ofEpochMilli 1500000000456))) (let [b (.toMillis (Files/getLastModifiedTime d (into-array java.nio.file.LinkOption [])))] (Files/delete d) [a b])))" :expected "[1600000000123 1500000000456]"}
  ;; setAttribute of creationTime / lastAccessTime is not a way to set the mtime:
  ;; the shim wrote every one of the three through to the mtime, so
  ;; (fs/set-creation-time f t) moved the file's last-modified time.
  {:suite "nio-filetime" :expr "(let [f (Files/createTempFile \"jfa\" \".txt\" (into-array java.nio.file.attribute.FileAttribute [])) lo (into-array java.nio.file.LinkOption [])] (Files/setLastModifiedTime f (java.nio.file.attribute.FileTime/fromMillis 1600000000000)) (Files/setAttribute f \"creationTime\" (java.nio.file.attribute.FileTime/fromMillis 5000000000) lo) (Files/setAttribute f \"basic:lastAccessTime\" (java.nio.file.attribute.FileTime/fromMillis 6000000000) lo) (let [m (.toMillis (Files/getLastModifiedTime f lo))] (Files/delete f) m))" :expected "1600000000000"}
  ;; The three basic times are three times (jolt-ow0x): the access time is
  ;; st_atime / ftLastAccessTime and is set without moving the mtime, whichever
  ;; of the three reads asks for it.
  {:suite "nio-filetime" :expr "(let [f (Files/createTempFile \"jfb\" \".txt\" (into-array java.nio.file.attribute.FileAttribute [])) lo (into-array java.nio.file.LinkOption [])] (Files/setLastModifiedTime f (java.nio.file.attribute.FileTime/fromMillis 1600000000000)) (Files/setAttribute f \"lastAccessTime\" (java.nio.file.attribute.FileTime/fromMillis 1100000000000) lo) (let [r [(.toMillis (Files/getAttribute f \"lastAccessTime\" lo)) (.toMillis (.lastAccessTime (Files/readAttributes f java.nio.file.attribute.BasicFileAttributes lo))) (.toMillis (get (Files/readAttributes f \"basic:lastAccessTime,lastModifiedTime\" lo) \"lastAccessTime\")) (.toMillis (Files/getLastModifiedTime f lo))]] (Files/delete f) r))" :expected "[1100000000000 1100000000000 1100000000000 1600000000000]"}
  ;; The creation time is the birth time where the filesystem keeps one. macOS
  ;; and Windows can also SET it; Linux cannot, and the JDK ignores the set
