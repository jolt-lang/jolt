  {:suite "extension points" :expr "(do (jolt.host/register-extension-point! :xt-d {:key :string :root \"\" :fields {:sym :string} :default {:sym \"x\"} :fallback :strict}) (jolt.host/extension-value :xt-d \"fr\"))" :expected :throws}
