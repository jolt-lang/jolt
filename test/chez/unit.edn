  ;; OVERWRITING is the case that broke on Windows while spit staged into a temp
  ;; file and renamed it over the target, a rename onto an existing destination
  ;; being refused there (#1074). spit writes in place now, as the JVM does; the
  ;; rows stay because overwriting is still the case worth pinning.
  {:suite "io" :label "spit overwrites an existing file" :expr "(let [p (str (System/getProperty \"java.io.tmpdir\") \"/jolt-io-overwrite.txt\")] (do (spit p \"first\") (spit p \"second\") (slurp p)))" :expected "\"second\""}
  ;; spit WRITES the file it is given, as FileOutputStream does: through a
  ;; symlink to its target, into the data a hard link shares, keeping the mode.
  ;; The temp-and-rename it used to do replaced the file instead — the link came
  ;; back a regular file, the hard link split, and a 0600 file came back 0644.
  ;; spit overwrites without truncating first, which on disk costs the kernel a
  ;; free and a reallocation, so the file's tail has to go by other means.
  {:suite "io" :label "spit cuts the tail of a longer file" :expr "(let [p (str (System/getProperty \"java.io.tmpdir\") \"/jolt-io-shrink.txt\")] (spit p \"a long first version\") (spit p \"short\") [(slurp p) (.length (java.io.File. p))])" :expected "[\"short\" 5]"}
  {:suite "io" :label "spit grows a shorter file" :expr "(let [p (str (System/getProperty \"java.io.tmpdir\") \"/jolt-io-grow.txt\")] (spit p \"ab\") (spit p \"abcdefgh\") [(slurp p) (.length (java.io.File. p))])" :expected "[\"abcdefgh\" 8]"}
  {:suite "io" :label "spit of the same length replaces every byte" :expr "(let [p (str (System/getProperty \"java.io.tmpdir\") \"/jolt-io-same.txt\")] (spit p \"aaaa\") (spit p \"bbbb\") (slurp p))" :expected "\"bbbb\""}
  {:suite "io" :label "spit of nothing empties a file" :expr "(let [p (str (System/getProperty \"java.io.tmpdir\") \"/jolt-io-empty.txt\")] (spit p \"content\") (spit p \"\") [(slurp p) (.length (java.io.File. p))])" :expected "[\"\" 0]"}
  {:suite "io" :label "spit shrinks through an encoding" :expr "(let [p (str (System/getProperty \"java.io.tmpdir\") \"/jolt-io-enc.txt\")] (spit p \"longer text\" :encoding \"UTF-16LE\") (spit p \"x\" :encoding \"UTF-16LE\") (.length (java.io.File. p)))" :expected "2"}
  {:suite "io" :label "spit writes to a device" :expr "(do (when (= \"/\" java.io.File/separator) (spit \"/dev/null\" \"x\")) :done)" :expected ":done"}
