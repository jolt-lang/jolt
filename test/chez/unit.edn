  ;; the bug itself: deleting the target before the rename left it missing, and
  ;; a reader polling it saw that thousands of times per run
  {:suite "nio-move" :label "a target replaced by atomic moves is never missing" :expr "(let [fa (into-array java.nio.file.attribute.FileAttribute []) d (java.nio.file.Files/createTempDirectory \"jar\" fa) dst (.resolve d \"target\") A (into-array java.nio.file.CopyOption [java.nio.file.StandardCopyOption/ATOMIC_MOVE java.nio.file.StandardCopyOption/REPLACE_EXISTING]) done (atom false) _ (spit (str dst) \"v0\") reader (future (loop [reads 0 missing 0] (if @done [reads missing] (recur (inc reads) (if (java.nio.file.Files/exists dst (into-array java.nio.file.LinkOption [])) missing (inc missing))))))] (dotimes [i 2000] (let [tmp (.resolve d (str \"tmp-\" i))] (spit (str tmp) (str \"v\" i)) (java.nio.file.Files/move tmp dst A))) (reset! done true) (let [[reads missing] @reader] (java.nio.file.Files/delete dst) (java.nio.file.Files/delete d) [(pos? reads) missing]))" :expected "[true 0]"}
  ;; file: URLs round trip (jolt-lang/jolt#1118): File.toURI percent-encodes, and
  ;; the opener did not decode, so a path with a space could not be opened from
  ;; the URL toURI gave for it; "file:///abs" is the JDK's other spelling.
  {:suite "file-url" :expr "(let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt url sp\") f (str d \"/x.txt\")] (.mkdirs (java.io.File. d)) (spit f \"payload\") [(slurp (.toURL (.toURI (java.io.File. f)))) (slurp (clojure.java.io/as-url (java.io.File. f))) (slurp (str \"file://\" (.getAbsolutePath (java.io.File. f)))) (boolean (re-find #\"%20\" (str (.toURI (java.io.File. f)))))])" :expected "[\"payload\" \"payload\" \"payload\" true]"}
  {:suite "file-url" :expr "(let [d (str (System/getProperty \"java.io.tmpdir\") \"/jolt url sp\") f (str d \"/x.txt\")] (.mkdirs (java.io.File. d)) (spit f \"payload\") (= (.getAbsolutePath (clojure.java.io/as-file (.toURL (.toURI (java.io.File. f))))) (.getAbsolutePath (java.io.File. f))))" :expected "true"}
  ;; URI -> File/Path (jolt-lang/jolt#1198): File(URI), Paths.get(URI) and
  ;; Path.of(URI) took the URI's string as the path, so "file:///tmp/a%20b" was
  ;; the relative path "file:/tmp/a%20b". The JDK decodes the path of a file: URI
  ;; and rejects everything else with its own message, in this order; Paths.get
  ;; names a missing scheme and an unknown one differently from File.
  {:suite "file-uri" :expr "(mapv (fn [s] (let [f (java.io.File. (java.net.URI. s))] [(.getPath f) (.getName f) (.isAbsolute f)])) [\"file:///data/tmp/a%20b\" \"file:/data/tmp/a%20b\" \"file:///a/b/\" \"file:///a%25b\" \"file:///\"])" :expected "[[\"/data/tmp/a b\" \"a b\" true] [\"/data/tmp/a b\" \"a b\" true] [\"/a/b\" \"b\" true] [\"/a%b\" \"a%b\" true] [\"/\" \"\" true]]"}
  {:suite "file-uri" :expr "(mapv (fn [s] (try (java.io.File. (java.net.URI. s)) (catch Exception e [(.getName (class e)) (ex-message e)]))) [\"file://localhost/x\" \"http://example.com/x\" \"file:///x?q=1\" \"file:///x#f\" \"file:x\" \"/abs/x\"])" :expected "[[\"java.lang.IllegalArgumentException\" \"URI has an authority component\"] [\"java.lang.IllegalArgumentException\" \"URI scheme is not \\\"file\\\"\"] [\"java.lang.IllegalArgumentException\" \"URI has a query component\"] [\"java.lang.IllegalArgumentException\" \"URI has a fragment component\"] [\"java.lang.IllegalArgumentException\" \"URI is not hierarchical\"] [\"java.lang.IllegalArgumentException\" \"URI is not absolute\"]]"}
  {:suite "file-uri" :expr "[(str (java.nio.file.Paths/get (java.net.URI. \"file:///data/tmp/a%20b\"))) (str (java.nio.file.Path/of (java.net.URI. \"file:/data/tmp/a%20b\"))) (str (java.nio.file.Paths/get (java.net.URI. \"file:///a/b/\")))]" :expected "[\"/data/tmp/a b\" \"/data/tmp/a b\" \"/a/b\"]"}
  {:suite "file-uri" :expr "(mapv (fn [s] (try (java.nio.file.Paths/get (java.net.URI. s)) (catch Exception e [(.getName (class e)) (ex-message e)]))) [\"http://example.com/x\" \"/abs/x\" \"file://localhost/x\" \"file:x\"])" :expected "[[\"java.nio.file.FileSystemNotFoundException\" \"Provider \\\"http\\\" not installed\"] [\"java.lang.IllegalArgumentException\" \"Missing scheme\"] [\"java.lang.IllegalArgumentException\" \"URI has an authority component\"] [\"java.lang.IllegalArgumentException\" \"URI is not hierarchical\"]]"}
