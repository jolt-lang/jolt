  {:suite "protocol-vtable", :label "a protocol call on a deftype's own impl reads the type's dispatch vector at the call site, at both arities (#1713)", :expr "(do (defprotocol VP1 (vp1 [x]) (vp1b [x y])) (deftype VT1 [a] VP1 (vp1 [_] [:direct a]) (vp1b [_ y] [a y])) (defn vc1 [x] [(vp1 x) (vp1b x 2)]) (vc1 (VT1. 1)))", :expected "[[:direct 1] [1 2]]"}
  {:suite "protocol-vtable", :label "...an extend-type after the type and the caller are defined is seen", :expr "(do (defprotocol VP2 (vp2 [x])) (deftype VT2 [a]) (defn vc2 [x] (vp2 x)) (extend-type VT2 VP2 (vp2 [this] [:extended (.-a this)])) (vc2 (VT2. 7)))", :expected "[:extended 7]"}
  {:suite "protocol-vtable", :label "...an impl inherited through Object, and nil and host receivers, go through the protocol fn", :expr "(do (defprotocol VP3 (vp3 [x])) (deftype VT3 [a]) (extend-protocol VP3 Object (vp3 [_] :object) nil (vp3 [_] :nil) String (vp3 [s] [:str s])) (defn vc3 [x] (vp3 x)) [(vc3 (VT3. 1)) (vc3 nil) (vc3 \"s\") (vc3 5)])", :expected "[:object :nil [:str \"s\"] :object]"}
  {:suite "protocol-vtable", :label "...a redefined type's new instances get the new impl and its old instances keep the old class's, as on the JVM evaluating each form in turn", :expr "(do (defprotocol VP4 (vp4 [x])) (deftype VT4 [a] VP4 (vp4 [_] [:v1 a])) (defn vc4 [x] (vp4 x)) (let [old (VT4. 1) r1 (vc4 old)] (deftype VT4 [a] VP4 (vp4 [_] [:v2 a])) [r1 (vc4 (VT4. 2)) (vc4 old)]))", :expected "[[:v1 1] [:v2 2] [:v1 1]]"}
  {:suite "protocol-vtable", :label "...with-redefs of the protocol fn does not reach a call on a type that declares the protocol: the JVM's interface call ignores the var (jolt-9l97g)", :expr "(do (defprotocol VP5 (vp5 [x])) (deftype VT5 [] VP5 (vp5 [_] :real)) (defn vc5 [x] (vp5 x)) [(with-redefs [vp5 (fn [x] :redef)] (vc5 (VT5.))) (vc5 (VT5.))])", :expected "[:real :real]"}
  {:suite "protocol-vtable", :label "...under with-redefs: deftype, defrecord and reify receivers call their own impl; an extended type, nil, a host value and a fn value see the redef, as on the JVM (jolt-9l97g)", :expr "(do (defprotocol VPR (vpr [x] [x y])) (deftype VPRT [] VPR (vpr [_] :real) (vpr [_ y] [:real y])) (defrecord VPRR [] VPR (vpr [_] :rec) (vpr [_ y] [:rec y])) (deftype VPRE []) (extend-type VPRE VPR (vpr ([_] :ext) ([_ y] [:ext y]))) (defn vprc [x] (vpr x)) (defn vprc2 [x y] (vpr x y)) (def vprf (reify VPR (vpr [_] :reify) (vpr [_ y] [:reify y]))) [(with-redefs [vpr (fn ([x] :redef) ([x y] [:redef y]))] [(vprc (VPRT.)) (vprc (->VPRR)) (vprc (VPRE.)) (vprc vprf) (vprc2 (VPRT.) 1) (vprc2 (VPRE.) 2) (vpr (VPRT.)) (vpr (VPRE.)) (mapv vpr [(VPRT.) (VPRE.)]) (vprc nil) (vprc \"s\")]) [(vprc (VPRT.)) (vprc (VPRE.))]])", :expected "[[:real :rec :redef :reify [:real 1] [:redef 2] :real :redef [:redef :redef] :redef :redef] [:real :ext]]"}
  {:suite "protocol-vtable", :label "defprotocol answers the protocol's name, with methods and without, as on the JVM", :expr "[(defprotocol VPN (vpn [x])) (defprotocol VPM0)]", :expected "[VPN VPM0]"}
  {:suite "protocol-vtable", :label "...alter-var-root of the protocol fn, with the receiver built in the argument and in a bare top-level expression (jolt-9l97g)", :expr "(do (defprotocol VPA (vpa [x])) (deftype VPAT [] VPA (vpa [_] :real)) (deftype VPAE []) (extend-type VPAE VPA (vpa [_] :ext)) (alter-var-root (var vpa) (constantly (fn [x] :redef))) (defn vpah [] [(vpa (VPAT.)) (vpa (VPAE.))]) [(vpah) (vpa (VPAT.)) (vpa (VPAE.)) (let [x (VPAT.)] (vpa x))])", :expected "[[:real :redef] :real :redef :real]"}
  {:suite "protocol-vtable", :label "...a protocol with :extend-via-metadata keeps metadata ahead of an extend-type impl", :expr "(do (defprotocol VP6 :extend-via-metadata true (vp6 [x])) (defrecord VR6 []) (extend-type VR6 VP6 (vp6 [_] :extended)) (defn vc6 [x] (vp6 x)) [(vc6 (->VR6)) (vc6 (with-meta (->VR6) {(quote user/vp6) (fn [_] :meta)}))])", :expected "[:extended :meta]"}
  {:suite "protocol-vtable", :label "...a reify receiver, at both arities", :expr "(do (defprotocol VP7 (vp7 [x] [x y])) (defn vc7 [x] [(vp7 x) (vp7 x 5)]) (vc7 (reify VP7 (vp7 [_] :r1) (vp7 [_ y] [:r2 y]))))", :expected "[:r1 [:r2 5]]"}
  {:suite "protocol-vtable", :label "...a method binds only the fields its body names, including inside a nested fn or a quoted form", :expr "(do (defprotocol VP8 (vp8 [x])) (deftype VT8 [a b c] VP8 (vp8 [_] (let [f (fn [] b)] [(f) (quote c) (quote [a])]))) (vp8 (VT8. 1 2 3)))", :expected "[2 c [a]]"}
  {:suite "protocol-vtable", :label "...a field the body reaches only through a macro's expansion is still bound, as on the JVM", :expr "(do (defmacro vp-use-x [] (quote x)) (defmacro vp-use-y [] (quote y)) (defprotocol VPM (vpm1 [this]) (vpm2 [this a])) (deftype VPMT [x y] VPM (vpm1 [this] (vp-use-x)) (vpm2 [this a] (let [f (fn [] (vp-use-y))] [a (f)]))) (defrecord VPMR [x y] VPM (vpm1 [this] (vp-use-x)) (vpm2 [this a] [a (vp-use-y)])) [(vpm1 (VPMT. 1 2)) (vpm2 (VPMT. 1 2) :a) (vpm1 (->VPMR 3 4)) (vpm2 (->VPMR 3 4) :b) (vpm2 (assoc (->VPMR 3 4) :y 5) :c)])", :expected "[1 [:a 2] 3 [:b 4] [:c 5]]"}
  {:suite "protocol-vtable", :label "...a method param shadows a same-named field", :expr "(do (defprotocol VP9 (vp9 [x a])) (deftype VT9 [a b] VP9 (vp9 [_ a] [a b])) (vp9 (VT9. :field :b) :param))", :expected "[:param :b]"}
  {:suite "protocol-vtable", :label "...a defrecord method reads its fields, assoc'd ones included", :expr "(do (defprotocol VP10 (vp10 [x])) (defrecord VR10 [a b c] VP10 (vp10 [_] [b (count [a])])) (defn vc10 [x] (vp10 x)) [(vc10 (->VR10 1 2 3)) (vc10 (assoc (->VR10 1 2 3) :b 9))])", :expected "[[2 1] [9 1]]"}
  {:suite "protocol-vtable", :label "...a protocol redefined and re-extended after the caller compiled: the caller's site still makes the old interface's call, which the type declared, as on the JVM", :expr "(do (defprotocol VP11 (vp11 [x])) (deftype VT11 [] VP11 (vp11 [_] :one)) (defn vc11 [x] (vp11 x)) (let [r1 (vc11 (VT11.))] (defprotocol VP11 (vp11 [x])) (extend-type VT11 VP11 (vp11 [_] :two)) [r1 (vc11 (VT11.))]))", :expected "[:one :one]"}
  {:suite "protocol-vtable", :label "the Chez back end dispatches a protocol method call at the site on the receiver's dispatch vector (#1713)", :expr "(let [ctx (jolt.host/ctx-for-ns \"app.core\") e (fn [f] (jolt.backend-scheme/emit-top-form (jolt.analyzer/analyze ctx f ((clojure.core/deref (var jolt.analyzer/empty-env)))))) _ (eval (quote (defprotocol ShapeP (shape-m [x])))) s (e (quote (defn shape-caller [x] (user/shape-m x))))] [(boolean (re-find #\"jrdesc-vtable-ref\" s)) (boolean (re-find #\"intern-pm-key\" s))])", :expected "[true true]"}
