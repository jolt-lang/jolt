  ;; (.m string-target …) with a PROVEN string target (literal or ^String hint)
  ;; emits the string native directly — no record-method-dispatch, no rest-args
  ;; vector. These pin every table entry plus the fallback shapes (a method or
  ;; arity outside the table routes to the generic dispatch).
  {:suite "strdirect" :expr "(.length \"hello\")" :expected "5"}
  {:suite "strdirect" :expr "(.isEmpty \"\")" :expected "true"}
  {:suite "strdirect" :expr "(.toString \"x\")" :expected "\"x\""}
  {:suite "strdirect" :expr "(.toUpperCase \"ab\")" :expected "\"AB\""}
  {:suite "strdirect" :expr "(.toLowerCase \"AB\")" :expected "\"ab\""}
  {:suite "strdirect" :expr "(.trim \"  x  \")" :expected "\"x\""}
  {:suite "strdirect" :expr "(.hashCode \"hello\")" :expected "99162322"}
  {:suite "strdirect" :expr "(.charAt \"abc\" 1)" :expected "\\b"}
  {:suite "strdirect" :expr "(.indexOf \"a-b-c\" 45)" :expected "1"}
  {:suite "strdirect" :expr "(.indexOf \"a-b-c\" 45 2)" :expected "3"}
  {:suite "strdirect" :expr "(.startsWith \"hello\" \"he\")" :expected "true"}
  {:suite "strdirect" :expr "(.endsWith \"hello\" \"lo\")" :expected "true"}
  {:suite "strdirect" :expr "(.contains \"hello\" \"ell\")" :expected "true"}
  {:suite "strdirect" :expr "(.concat \"a\" \"b\")" :expected "\"ab\""}
  {:suite "strdirect" :expr "(.substring \"abcdef\" 1 3)" :expected "\"bc\""}
  {:suite "strdirect" :expr "(.replace \"a-b-c\" \"-\" \"_\")" :expected "\"a_b_c\""}
  {:suite "strdirect" :expr "(let [^String s \"a-b-c\"] (.charAt s 1))" :expected "\\-"}
  {:suite "strdirect" :expr "((fn [^String s] (.indexOf s 45)) \"a-b-c\")" :expected "1"}
  {:suite "strdirect" :expr "(let [s \"abc\"] (.length ^String s))" :expected "3"}
  ;; outside the table (method / arity) -> generic dispatch, same result
  {:suite "strdirect" :expr "(.codePointAt \"abc\" 1)" :expected "98"}
  {:suite "strdirect" :expr "(.indexOf \"abc\" \"b\" 1)" :expected "1"}
  {:suite "strdirect" :expr "(.substring \"abcdef\" 2)" :expected "\"cdef\""}
  ;; (.m keyword-target …) with a PROVEN keyword target (literal or
  ;; ^clojure.lang.Keyword hint) emits the keyword arm inline — the honeysql
  ;; kw->sym shape. Pins every table entry; (.compareTo) routes generic.
  {:suite "kwdirect" :expr "(.sym :ns/qual)" :expected "ns/qual"}
  {:suite "kwdirect" :expr "(.sym :plain)" :expected "plain"}
  {:suite "kwdirect" :expr "(.getName :ns/qual)" :expected "\"qual\""}
  {:suite "kwdirect" :expr "(.getNamespace :ns/qual)" :expected "\"ns\""}
  {:suite "kwdirect" :expr "(.getNamespace :plain)" :expected ""}
  {:suite "kwdirect" :expr "(.toString :ns/qual)" :expected "\":ns/qual\""}
  {:suite "kwdirect" :expr "(.equals :a :a)" :expected "true"}
  {:suite "kwdirect" :expr "(.equals :a :b)" :expected "false"}
  {:suite "kwdirect" :expr "(.equals :a nil)" :expected "false"}
  {:suite "kwdirect" :expr "((fn [^clojure.lang.Keyword k] (.sym k)) :x/y)" :expected "x/y"}
  {:suite "kwdirect" :expr "(let [k :a/b] (.sym ^clojure.lang.Keyword k))" :expected "a/b"}
  ;; outside the table -> generic dispatch; the keyword arm itself has no
  ;; compareTo, so both paths throw the same IllegalArgumentException
  {:suite "kwdirect" :expr "(.compareTo :a :b)" :expected :throws}
  ;; (.m sb …) with a PROVEN StringBuilder target emits the accessor inline. Three
  ;; proof sources, all pinned below: a local bound to (StringBuilder.) with NO
  ;; hint in the source (init-proves-hint — the shape every string-building let
  ;; has), a ^StringBuilder param tag, and a constructor in target position.
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb \"a\") (.toString sb))" :expected "\"a\""}
  ;; append renders like the JVM's: a number, nil as \"null\", a char bare
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb \"a\") (.append sb 1) (.append sb nil) (.append sb \\c) (.toString sb))" :expected "\"a1nullc\""}
  ;; append RETURNS the builder — the fluent contract (-> sb (.append a) (.append b))
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.toString (.append (.append sb \"a\") \"b\")))" :expected "\"ab\""}
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb \"abc\") (.length sb))" :expected "3"}
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.isEmpty sb))" :expected "true"}
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb \"x\") (.isEmpty sb))" :expected "false"}
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb \"abc\") (.charAt sb 1))" :expected "\\b"}
  ;; the ctor's own content arg still counts, and length/toString flush the chunks
  {:suite "sbdirect" :expr "(let [sb (StringBuilder. \"pre-\")] (.append sb \"x\") [(.toString sb) (.length sb)])" :expected "[\"pre-x\" 5]"}
  {:suite "sbdirect" :expr "((fn [^StringBuilder b] (.append b \"x\") (.toString b)) (StringBuilder. \"p-\"))" :expected "\"p-x\""}
  ;; a constructor in target position is NOT a proof source (it would be spliced
  ;; twice by append's fluent return); the generic path answers it correctly
  {:suite "sbdirect" :expr "(.toString (.append (StringBuilder.) \"lit\"))" :expected "\"lit\""}
  ;; outside the table -> generic dispatch, same answer (setLength is deliberately
  ;; left generic for its range check)
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb \"abcd\") (.setLength sb 2) (.toString sb))" :expected "\"ab\""}
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb \"abcd\") (.substring sb 1 3))" :expected "\"bc\""}
  ;; the emitted heads are shadow-proof (rt-emitted-names): a local named after one
  ;; of them must not be what the inline emission calls
  {:suite "sbdirect" :expr "(let [sb-piece (fn [_] \"SHADOWED\") sb (StringBuilder.)] (.append sb \"ok\") (.toString sb))" :expected "\"ok\""}
  ;; a char[] is its characters on the PROVEN-target path too: the inline body
  ;; calls sb-piece, the same converter the method table's append arm calls, so a
  ;; ^StringBuilder tag cannot get the array's rendering where an untyped target
  ;; gets its characters.
  {:suite "sbdirect" :expr "(let [sb (StringBuilder.)] (.append sb (char-array [\\a \\b \\c])) (.toString sb))" :expected "\"abc\""}
  {:suite "sbdirect" :expr "((fn [^StringBuilder b] (.append b (char-array \"xy\")) (.toString b)) (StringBuilder.))" :expected "\"xy\""}
  {:suite "sbdirect" :expr "(let [sb-append! (fn [_ _] nil) sb (StringBuilder.)] (.append sb \"ok\") (.toString sb))" :expected "\"ok\""}
  ;; StringBuffer is the same store behind a second tag, so it takes the same
  ;; direct-emit path from the same proof sources — and the generic path must
  ;; stay indistinguishable from it, which the constructor-in-target-position row
  ;; and the vector-element row below pin by reaching a builder the analyzer
  ;; cannot prove.
  {:suite "sbdirect" :expr "(let [sb (StringBuffer.)] (.append sb \"a\") (.append sb 1) (.append sb nil) (.append sb \\c) (.toString sb))" :expected "\"a1nullc\""}
  {:suite "sbdirect" :expr "(let [sb (StringBuffer.)] (.toString (.append (.append sb \"a\") \"b\")))" :expected "\"ab\""}
