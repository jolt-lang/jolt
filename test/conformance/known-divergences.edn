   {:suite "reader-model / nested fn literals", :label "nested #() reads", :category :reader-model}
   {:suite "numbers / unsigned string conversions", :label "past 64 bits it is a signed magnitude, not a wrap", :category :integer-box-model}
   {:suite "conformance / numeric pass", :label "literal-init loop var + bignum-literal stays generic (exact)", :category :numeric-model}

   ;; jolt takes :bb reader branches, and babashka code asks (satisfies? Class x)
   ;; where its JVM branch asks instance?; jolt answers instance? there. The JVM
   ;; raises on the class form (satisfies? wants a protocol map), so certify
   ;; buckets the row :jvm-raises.
   ;; The two-argument SimpleDateFormat takes a LOCALE ID STRING on jolt (the
   ;; :date-names extension point's key); the JVM's second argument is a Locale,
   ;; so it has no matching constructor and raises.
   {:suite "time / sdf locale names", :label "explicit ROOT locale id renders ROOT names", :category :host-model}
   {:suite "time / sdf locale names", :label "numeric pattern ignores the locale id", :category :host-model}
   {:suite "time / sdf locale names", :label "unregistered locale id falls back to ROOT", :category :host-model}
   {:suite "protocols / satisfies?", :label "satisfies? on a class or interface answers instance?", :category :host-model}]}
