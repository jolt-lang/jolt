;; Recipes + recorded standings for replaying third-party libraries' own test
;; suites on jolt. See README.md. Driven by run.clj (`make libconformance`).
;;
;; Path prefixes: bare = relative to the library's own root, "@x" = another
;; library under the conformance-libraries checkout, "~x" = a first-party jolt
;; library checked out beside this repo, "/x" = absolute.
;;
;; :expect is the tally last observed. The gate fails when pass drops or
;; fail/error/load-fail rise; it reports BETTER (not a failure) when pass rises,
;; so improving a library is a manifest edit away. :note records why a non-zero
;; fail/error count is expected — a host-model divergence, a missing JVM-only
;; dependency, or a tracked bug.
{:libs
 [;; ---------------------------------------------------------- collections/util
  {:name "medley"
   :paths ["src" "test"]
   :expect {:tests 55 :pass 293 :fail 0 :error 0}}

  {:name "camel-snake-kebab"
   :paths ["src" "test"]
   :expect {:tests 5 :pass 163 :fail 0 :error 0}}

  {:name "cuerdas"
   :paths ["src" "test"]
   :local-deps ["~time"]
   ;; str/abbreviate formats through a Locale, which is jolt-lang/time's (RFC 0008)
   ;; The two errors are java.text.BreakIterator, which abbreviate uses to find a
   ;; word boundary. That is Unicode text segmentation (UAX #29) and jolt has no
   ;; shim; an approximate one would quietly cut in the wrong place, so it stays
   ;; absent and says so.
   :expect {:tests 71 :pass 298 :fail 0 :error 2}}

  {:name "dependency"
   :paths ["src" "test"]
   :expect {:tests 9 :pass 40 :fail 0 :error 0}}

  {:name "ordered"
   :paths ["src" "test"]
   :exclude-nses ["flatland.ordered.performance-test"]
   :expect {:tests 25 :pass 129 :fail 0 :error 0}}

  {:name "text-diff"
   :paths ["src" "test"]
   :expect {:tests 11 :pass 29 :fail 0 :error 0}}

  {:name "math.combinatorics"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :expect {:tests 18 :pass 1193 :fail 0 :error 0}}

  {:name "data.priority-map"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :expect {:tests 4 :pass 142 :fail 0 :error 0}}

  {:name "core.async"
   ;; jolt SHIPS clojure.core.async: the channel primitives are native
   ;; (host/chez/java/async.ss, real OS threads) and the dataflow API is an
   ;; overlay under stdlib/. So the upstream src/main is deliberately NOT on
   ;; :paths — it would shadow jolt's implementation with the JVM one (the IOC
   ;; state-machine macros, java.util.concurrent) and fail to load. Only the
   ;; upstream TESTS run, against jolt's own implementation. That makes this the
   ;; standing regression gate for async.ss, which the fibers epic modifies.
   :paths ["src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; impl.buffers / impl.timers are upstream internals the suites reach for
   ;; directly; the shims map them onto jolt's native equivalents.
   :shims ["!test/conformance/libs/shims/core.async"]
   :nses ["clojure.core.async-test"
          "clojure.core.pipeline-test"
          "clojure.core.async.timers-test"
          "clojure.core.async.lab-test"]
   ;; The other four suites are N/A by construction, not skipped for convenience:
   ;; ioc_macros_test tests the state-machine macro jolt has no equivalent of (a
   ;; go body is a real thread here), concurrent_test needs a ThreadFactory,
   ;; exceptions_test the JVM's uncaught-exception handler, and buffers_test the
   ;; upstream buffer implementations rather than jolt's native ones.
   ;;
   ;; The 8 remaining failures are all in async_test and are SUPERSET
   ;; divergences — jolt is deliberately less restrictive than the JVM
   ;; implementation: four assert that put!/take! with on-caller? true run the
   ;; callback on the calling thread (jolt forks, so it runs there), two assert
   ;; the 1024 pending-operation cap throws (jolt is unbounded), and one that a
   ;; parking op outside a go block fails (jolt's work anywhere). Two of those
   ;; assert thread identity or timing and flap between fail and pass run to run,
   ;; hence the tolerance.
   :tolerance 2
   :expect {:tests 31 :pass 211 :fail 7 :error 0}}

  {:name "core.cache"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@data.priority-map/src/main/clojure"]
   :expect {:tests 23 :pass 1314 :fail 0 :error 0}}

  {:name "core.memoize"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@core.cache/src/main/clojure" "@data.priority-map/src/main/clojure"]
   :expect {:tests 18 :pass 207 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- language / meta
  {:name "tools.macro"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :expect {:tests 4 :pass 14 :fail 0 :error 0}}

  {:name "algo.monads"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@tools.macro/src/main/clojure"]
   :expect {:tests 11 :pass 28 :fail 0 :error 0}}

  {:name "core.match"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; both suites match on the result of JVM reflection (.getReturnType, java.lang.Void)
   :exclude-nses ["clojure.core.match.test.java" "clojure.core.match.test.date"]
   :expect {:tests 118 :pass 153 :fail 0 :error 0}}

  {:name "core.logic"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; nominal.tests loads now that the pretty printer's dispatch fns are
   ;; multimethods it can addMethod to (jolt-v5fh.16), which is where the 64 extra
   ;; passes come from. The nominal residue that surfaced with it (36 fail / 6
   ;; error) was two host ns bugs, both fixed at the root: :use ignored :exclude
   ;; in its refer-all registration, so the test ns's `fresh`/`hash` resolved to
   ;; clojure.core.logic.nominal's instead of clojure.core.logic's / clojure.core's;
   ;; and the refer-clojure macro registered :exclude under the analysis-time ns
   ;; (never the ns an ns form creates), so fd.clj's `-rator` syntax-quotes
   ;; qualified to clojure.core/== instead of clojure.core.logic.fd/==.
   :expect {:tests 423 :pass 658 :fail 0 :error 0}}

  {:name "core.contracts"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :extra-deps {org.clojure/core.unify {:mvn/version "0.5.7"}}
   :expect {:tests 14 :pass 45 :fail 0 :error 0}}

  {:name "tools.reader"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; The 3 fails here were the syntax-quote reader-model divergence — a quoted
   ;; backtick was data on the JVM and jolt's unlowered marker here. Gone since
   ;; the analyzer lowers every marker before anything can see the form
   ;; (jolt-024c).
   :expect {:tests 50 :pass 887 :fail 0 :error 0}}

  {:name "edamame"
   :paths ["src" "resources" "test"]
   :deps ["@tools.reader/src/main/clojure" "@ordered/src"]
   ;; The suite requires cljs.tagged-literals and cljs.test on the :clj branch;
   ;; jolt drops org.clojure/clojurescript from any dependency graph on purpose,
   ;; so those come from a stub. See the shim files for what they stand in for.
   :shims ["!test/conformance/libs/shims/clojurescript"]
   :extra-deps {io.github.borkdude/deflet {:mvn/version "0.1.0"}}
   ;; parse-clojure-core is a benchmark as much as a test: it re-reads
   ;; test-resources/clojure/core.clj 20 times through each of six readers, which
   ;; is where all but ~10s of the run goes (~4.5 min here).
   :timeout 1200
   :expect {:tests 50 :pass 351 :fail 0 :error 0}}

  {:name "tools.namespace"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; the remaining error is a test that builds a symlink through java.lang.reflect
   ;; — Class/forName of an interface, make-array of it, then getMethod/invoke.
   ;; That is the reflection API proper, which jolt does not have.
   :expect {:tests 26 :pass 61 :fail 0 :error 1}}

  {:name "rewrite-clj"
   :paths ["src" "resources" "test"]
   :deps ["@tools.reader/src/main/clojure" "@test.check/src/main/clojure"]
   :expect {:tests 163 :pass 3381 :fail 0 :error 0}}
  ;; Upstream runs test-isolated/ as its own kaocha profile, and the isolation is
  ;; the point: the test asserts a coercion works when rewrite-clj.zip is the ONLY
  ;; namespace required, so requiring any other test namespace pulls in
  ;; rewrite-clj.node and the assertion passes for the wrong reason. A separate
  ;; entry is a separate process, which is exactly that isolation.
  {:name "rewrite-clj-isolated"
   :root "rewrite-clj"
   :paths ["src" "resources" "test-isolated"]
   :test-paths ["test-isolated"]
   :deps ["@tools.reader/src/main/clojure"]
   :expect {:tests 1 :pass 1 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- spec + testing
  {:name "spec.alpha"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; s/exercise generates through test.check
   :deps ["@test.check/src/main/clojure"]
   ;; the 4 fails are instrument's ::caller, which spec reads off the JVM stack
   ;; trace. jolt does tail calls, so the calling frame is gone before anything can
   ;; look — the conform failure still throws with the same explain-data, it just
   ;; carries no ::caller. See known-divergences.edn.
   :expect {:tests 13 :pass 170 :fail 4 :error 0}}

  {:name "test.check"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@spec.alpha/src/main/clojure"]
   :timeout 900
   ;; property-based: the assertion count moves with the generated cases
   :tolerance 40
   :expect {:tests 123 :pass 236 :fail 10 :error 2}}

  {:name "instaparse"
   :paths ["src" "test"]
   ;; All five remaining failures are one divergence, in abnf-test's unicode-test:
   ;; it feeds a parser half of a surrogate pair and expects a parse failure, but a
   ;; jolt string is indexed by code point, so (str (first "<astral>")) is the whole
   ;; character and parses. A surrogate half is not a value jolt can hold
   ;; (:string-model in known-divergences.edn) — nothing to reject.
   :expect {:tests 28 :pass 9515 :fail 5 :error 0}}

  {:name "test.chuck"
   ;; resources/ holds the regex grammar its parser slurps through io/resource
   :paths ["src" "test" "resources"]
   :deps ["@test.check/src/main/clojure" "@spec.alpha/src/main/clojure"]
   ;; the version test.chuck itself declares (its deps.edn / project.clj)
   :extra-deps {instaparse/instaparse {:mvn/version "1.4.10"}}
   :timeout 900
   ;; property-based: the assertion count moves with the generated cases
   :tolerance 30
   ;; regexes-test drives test.chuck's own regex parser against re-pattern. jolt now
   ;; agrees with Java on accepting and rejecting every pattern in its curated list,
   ;; and on what the accepted ones match. What is left is a long tail that is not
   ;; regex-translation work: \N{...} named-character escapes need a Unicode name
   ;; database jolt does not carry, a generated case reaches a lone surrogate (jolt
   ;; chars are scalar values — :string-model), and the clojure-test-output and
   ;; exception-handling namespaces compare printed #error maps whose :trace is
   ;; empty because tail calls leave no frames to report. The load-fail is clj-time,
   ;; which needs joda-time.
   :expect {:tests 39 :pass 110 :fail 17 :error 2 :load-fail 1}}

  ;; ---------------------------------------------------------- data formats
  {:name "data.csv"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :expect {:tests 4 :pass 26 :fail 0 :error 0}}

  {:name "data.codec"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@test.check/src/main/clojure" "@spec.alpha/src/main/clojure"]
   ;; The suite checks jolt's base64 against commons-codec's, which the
   ;; jolt.shim.commons-codec shim registers ahead of the library's sources.
   ;; The 2 remaining failures are clojure.lang.IFn$O..O primitive-interface
   ;; instance? checks — JVM function interfaces jolt has no model for.
   :shims ["!test/conformance/libs/shims/data.codec"]
   :preload ["jolt.shim.commons-codec"]
   :note "IFn$O..O primitive function interfaces are JVM-only"
   :expect {:tests 14 :pass 12 :fail 2 :error 0}}

  {:name "data.json"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; json-gen-test round-trips through stest/check, which generates via test.check
   ;; The 72 ::sci-not-available errors are malli.sci dynaloading sci.core, which
   ;; does not fully load here: sci reaches PRIVATE clojure.core internals by var
   ;; (imap-cons, system-newline) and pulls further deps behind them. Putting
   ;; jolt's vendored sci on the path does not change the count — it is a chain,
   ;; not one gap, and it is what `make sci`'s own floor already tracks. So the
   ;; :=> / function-schema surface stays unexercised here rather than pretending.
   :deps ["@spec.alpha/src/main/clojure" "@test.check/src/main/clojure"]
   :local-deps ["~time"]
   :timeout 900
   ;; The residue is one :escape-unicode true case in each of the two APIs, and
   ;; it is the string model rather than a bug: jolt strings are codepoint-indexed,
   ;; so .charAt hands data.json's escaper an astral character whole where the JVM
   ;; hands it a surrogate half, and the escape comes out \u1f603 rather than the
   ;; \ud83d\ude03 pair. Matching would mean UTF-16 count/nth/char. The
   ;; :escape-unicode false path used to throw out of (char cp) and no longer does.
   ;; :string-model, see known-divergences.edn.
   :expect {:tests 244 :pass 322 :fail 2 :error 0}}

  {:name "data.zip"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["~xml/src"]
   :expect {:tests 9 :pass 12 :fail 0 :error 0}}

  {:name "yamlstar"
