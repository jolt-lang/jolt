  ;; ---------------------------------------------------------- markup / text
  {:name "hiccup"
   :paths ["src" "test"]
   :expect {:tests 64 :pass 386 :fail 0 :error 0}}

  {:name "markdown-clj"
   :paths ["src/clj" "src/cljc" "test"]
   :exclude-nses ["markdown.benchmark"]
   ;; yaml metadata parses through clj-yaml, which jolt-lang/yaml supplies as a
   ;; compatibility layer over jolt.yaml. It goes on as a real dependency rather
   ;; than a source path because it declares :jolt/native libyaml.
   :local-deps ["~yaml"]
   ;; markdown-clj's own deps.edn asks for clj-commons/clj-yaml, and jolt resolves
   ;; Maven now, so the real one — snakeyaml, i.e. Java — is what gets loaded and
   ;; it dies on DumperOptions$FlowStyle. The same jolt-lang/yaml source goes on
   ;; ahead of it as a shim so clj_yaml.core resolves to the compatibility layer.
   :shims ["~yaml/src" "!test/conformance/libs/shims/markdown-clj"]
   ;; the autourl tests unescape markdown's HTML output through
   ;; org.apache.commons.lang.StringEscapeUtils, supplied by the preloaded
   ;; jolt.shim.commons-lang shim. No residue.
   :preload ["jolt.shim.commons-lang"]
   ;; two assertions exist only on the suite's :clj branches; the :bb branches
   ;; jolt now reads skip them. Same test count, nothing fails.
   :expect {:tests 94 :pass 180 :fail 0 :error 0}}

  {:name "Selmer"
   :paths ["src" "test" "resources"]
   ;; jolt-lang/crypto supplies java.security.MessageDigest, which the hash: filter
   ;; calls — the JVM has it built in, jolt gets it from the library. It goes on as
   ;; a real dependency, not a source path, so its :jolt/native libcrypto is loaded.
   :deps ["@data.json/src/main/clojure"]
   :local-deps ["~time" "~crypto"]
   ;; core_test does (:require [cheshire.core :refer :all]). Selmer's own source
   ;; resolves cheshire -> data.json -> jsonista at load and is fine on data.json,
   ;; but the test names cheshire outright, and real cheshire wraps Jackson. The
   ;; shim supplies the cheshire names over data.json.
   ;; selmer.benchmark is excluded from the run but core_test requires it at top
   ;; level and reads its `user` var, so it still has to compile — hence criterium.
   :shims ["!test/conformance/libs/shims/cheshire" "!test/conformance/libs/shims/criterium"]
   :exclude-nses ["selmer.benchmark"]
   ;; StringEscapeUtils is not referenced anywhere in the suite, so no commons-lang
   ;; shim is attached.
   ;;
   ;; The locale work behind this tally lives on three extension points core
   ;; declares and jolt-lang/time fills in: :date-names, :number-symbols and
   ;; :currency-data. Running Selmer needs that library on :deps, which it has.
   :expect {:tests 131 :pass 526 :fail 0 :error 0}}

  {:name "html"
   :paths ["src" "test"]
   :expect {:tests 2 :pass 35 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- data / config
  {:name "honeysql"
   :paths ["src" "test"]
   ;; honey.sql-alphanumeric-test is a defspec over generated identifiers, so it
   ;; needs test.check and test.chuck's generators the way honeysql's own
   ;; deps.edn declares them; without those on the recipe the namespace is a
   ;; load failure rather than a missing dependency anyone would notice.
   :deps ["@core.cache/src/main/clojure"
          "@data.priority-map/src/main/clojure"
          "@test.check/src/main/clojure" "@test.chuck/src" "@test.chuck/resources"]
   :local-deps ["~time"]
   ;; test.chuck's string-from-regex generator parses the pattern with instaparse,
   ;; at the version test.chuck itself declares
   :extra-deps {instaparse/instaparse {:mvn/version "1.4.10"}}
   ;; that suite is a defspec, so its assertion count moves with the drawn cases
   :tolerance 40
   :expect {:tests 177 :pass 2842 :fail 0 :error 0}}

  {:name "config"
   :paths ["src" "test"]
   :expect {:tests 3 :pass 8 :fail 0 :error 0}}

  {:name "aero"
   :paths ["src" "test"]
   :expect {:tests 28 :pass 59 :fail 0 :error 0}}

  ;; the jolt-lang/mount sibling checkout: upstream tolitius/mount with the
  ;; datomic + tools.nrepl TEST dependencies replaced by local stand-ins (the
  ;; library source itself is unchanged). Preloading mount.test puts the suite
  ;; in :cljc mode, which the .cljc tests assume; the var/* tests flip to :clj
  ;; mode around themselves. The tapp config loads from a CWD-relative path,
  ;; hence :dir.
  {:name "mount"
   :paths ["~mount/src" "~mount/test/core" "~mount/test/clj"]
   :test-paths ["~mount/test/core" "~mount/test/clj"]
   :dir "~mount"
   :preload ["mount.test"]
   :expect {:tests 21 :pass 131 :fail 0 :error 0}}

  {:name "malli"
   :paths ["src" "resources" "test"]
   :deps ["@spec.alpha/src/main/clojure"
          "@test.check/src/main/clojure" "@spec-tools/src"
          "@test.chuck/src" "@ordered/src"]
   :local-deps ["~time"]
   ;; malli's own deps, from the upstream deps.edn; jolt resolves the source out
   ;; of the Maven jars.
   :extra-deps {borkdude/dynaload {:mvn/version "0.3.5"}
                borkdude/edamame {:mvn/version "1.5.37"}
                fipp/fipp {:mvn/version "0.6.29"}
                mvxcvi/arrangement {:mvn/version "2.1.0"}}
   ;; jolt.time installs the java.time.* class seams; malli's own requires do
   ;; not reach it, so it is preloaded.
   :preload ["jolt.time"]
   :timeout 900
   ;; Keying protocol dispatch by defining namespace (jolt-ewmt) is what moved
   ;; this: malli.generator-ast evals a textually-renamed copy of
   ;; malli.generator, so a SECOND protocol also named Generator was extended to
   ;; Object and replaced the real -generator. Eight more namespaces load and the
   ;; suite went 28 tests / 121 assertions to the figures below. The remaining
   ;; The 8 remaining load failures are both JVM-internal: fipp reaching Clojure's
   ;; private #'clojure.core/mk-am through core.rrb-vector (7), and jsonista, i.e.
   ;; Jackson (1).
   ;;
   ;; Of what runs: 72 errors are the sci chain above. 104 of the failures are
   ;; parser-info-test alone, which round-trips values drawn by (mg/sample s
   ;; {:seed 0}) — a fixed seed draws DIFFERENT values here than on the JVM, so
   ;; the test runs over different data. :every parsing and registry references
   ;; themselves agree with 1.12.5 exactly on literal inputs, checked directly.
   ;; That is the same family as test.check's :tolerance, not a malli bug.
   ;;
   ;; The four malli.experimental.time suites went green when jolt-lang/time
   ;; grew the 3-arg DateTimeFormatter.parse with a strict pattern walk, the
   ;; X/from statics and OffsetTime — 13 failures and 2 errors' worth. That is
   ;; where the +14/-13/-1 against the previous recording came from.
   ;;
   ;; Two things shape the tally below. The suite :bb-gates roughly half its
   ;; assertions (babashka runs the reduced set, and jolt reads :bb branches
   ;; now) — that is where the old 12059 passes went, with fail and error
   ;; shrinking proportionally. And the one load failure is malli.util-test's
   ;; cheshire, i.e. Jackson. The native-backed clojure.core.rrb-vector
   ;; replaced the jar here, which is what brought the fipp/virhe chain (ten
   ;; namespaces) back from the old mk-am load-fail wall.
   :expect {:tests 219 :pass 6751 :fail 42 :error 34 :load-fail 1}}

  ;; ---------------------------------------------------------- web
  {:name "ring-codec"
   :paths ["src" "test"]
   :expect {:tests 9 :pass 72 :fail 0 :error 0}}

  {:name "ring-core"
   :root "ring"
   ;; the suite reads test/ring/assets/… relative to the module, not the repo root
   :dir "ring-core"
   :paths ["ring-core/src" "ring-core-protocols/src" "ring-websocket-protocols/src"
           "ring-core/test"]
   :test-paths ["ring-core/test"]
   :deps ["@ring-codec/src" "~multipart/src"]
   :local-deps ["~time" "~crypto"]
   :extra-deps {crypto-random/crypto-random {:mvn/version "1.2.1"}
                crypto-equality/crypto-equality {:mvn/version "1.0.1"}}
   ;; The two session/cookie suites are written against clj-time, which is Joda —
   ;; a JVM library with no jolt equivalent. The multipart suites are served by
   ;; jolt.shim.commons-fileupload, which registers the commons-fileupload2 class
   ;; surface ring reaches for over jolt-lang/multipart's RFC 7578 parser — glue,
   ;; not a parser, so ring's own code paths stay its own. Every multipart test
   ;; passes. commons-io (IOUtils/toByteArray in the
   ;; byte-array store, FileUtils/writeStringToFile in the resource-response
   ;; test) is supplied by the preloaded jolt.shim.commons-io shim. The
   ;; resource tests still hit java.net.URLClassLoader and jar: URLs, JDK
   ;; surface with no jolt equivalent. The 8 failures that went away were
   ;; java.io.File comparing by identity under = rather than by pathname;
   ;; 4 more (446 -> 450) when getCanonicalPath learned to resolve symlinks
   ;; in 0.7.20.
   :shims ["!test/conformance/libs/shims/ring-core"]
   ;; commons-fileupload before ring.middleware.multipart-params, which imports
   ;; its classes at load.
   :preload ["jolt.shim.commons-io" "jolt.shim.commons-fileupload"]
   :note "clj-time (Joda) + commons-fileupload are JVM-only; URLClassLoader/jar: URLs are jolt gaps"
   :expect {:tests 152 :pass 451 :fail 0 :error 5 :load-fail 2}}

  {:name "ring-spec"
   :paths ["src" "test"]
   :deps ["@spec.alpha/src/main/clojure" "@ring/ring-core-protocols/src"]
   ;; ring-spec's only test is the lein template placeholder, (is (= 0 1)) under a
   ;; "FIXME, I fail." — it fails on the JVM too. The library itself loads, which is
   ;; what running it here checks.
   :note "the single failure is upstream's unedited template test"
   :expect {:tests 1 :pass 0 :fail 1 :error 0}}

  {:name "reitit-core"
   :root "reitit"
   :paths ["modules/reitit-core/src" "test/cljc"]
   :test-paths ["test/cljc"]
   :deps ["~router/src" "@spec.alpha/src/main/clojure"]
   :extra-deps {meta-merge/meta-merge {:mvn/version "1.0.0"}}
   ;; test/cljc holds the suites for every reitit module; these are the ones that
   ;; need reitit-core alone (the rest pull reitit-ring / -malli / muuntaja /
   ;; jsonista, which are not in the checkout).
   :nses ["reitit.core-test" "reitit.impl-test" "reitit.trie-test"
          "reitit.spec-test"]
   ;; reitit's fast router is built on reitit.Trie, a compiled Java class. jolt-lang/
   ;; router reimplements that trie in Clojure and registers it as the reitit.Trie
   ;; host class, which is how reitit-core runs here unmodified — but only if it is
   ;; loaded before reitit builds a router.
   :preload ["reitit.trie-jolt"]
   :expect {:tests 27 :pass 615 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- tooling
  {:name "compliment"
   :paths ["src" "test"]
   :extra-deps {nubank/matcher-combinators {:mvn/version "3.9.2"}}
   ;; Reflection-backed sources (class members, classes, resources) and classpath
   ;; enumeration do not apply to jolt's host model, and t-core/t-vars pin exact
   ;; candidate lists that jolt's different clojure.core surface changes — see the
   ;; library's own CONFORMANCE.md. These are the host-neutral suites.
   :nses ["compliment.t-context" "compliment.sources.t-special-forms"
          "compliment.sources.t-local-bindings" "compliment.sources.t-keywords"
          "compliment.sources.t-data-readers"]
   ;; completions reflect the live runtime (interned keywords, loaded namespaces),
   ;; so the assertion count moves with suite order
   :tolerance 10
   :expect {:tests 7 :pass 65 :fail 0 :error 0}}

  {:name "lasertag"
   :paths ["src" "test"]
   :local-deps ["~time"]
   ;; lasertag classifies a value by its class, so every failure here is jolt's class
   ;; model rather than a behavioral difference, all recorded in
   ;; known-divergences.edn. The 9 that remain: six narrow numeric classes collapsing
   ;; to Long/Double (:integer-box-model), one seq class still collapsing to LazySeq
   ;; where the JVM says Repeat (:seq-type-model), and two the suite's :bb branches
   ;; asserting babashka's host model (sci.impl.fns classnames, a :lambda-free tag
   ;; set), where jolt answers with the real defining class.
   ;; (subvec answers the real SubVector class since #629, which is the 44 -> 46.)
   ;; 46 -> 49 is the seq classes: #648 gave a seq the class its producer gives it
   ;; and #659 picked the range flavor from the argument types. The row had not been
   ;; re-recorded since before #648, so part of that 3 was slack this gate had been
   ;; carrying — a regression in those rows would have read as "ok".
   :expect {:tests 58 :pass 49 :fail 9 :error 0}}

  {:name "tools.logging"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; test-impl pins the log4j2 backend, which needs the org.apache.logging.log4j jars
   :exclude-nses ["clojure.tools.logging.test-impl"]
   ;; impl/find-factory picks a backend at LOAD time and throws when every one it
   ;; probes is missing, which on jolt is all of them — so without a backend the
   ;; whole suite is a load-fail. The shim registers the classes its FIRST probe
   ;; looks for (org.slf4j), leaving tools.logging itself unmodified and on its own
   ;; slf4j code path. :preload because find-factory runs before any test does.
   :shims ["!test/conformance/libs/shims/slf4j"]
   :preload ["jolt.shim.slf4j"]
   ;; log-capture!/with-logs redirect the process streams through a PrintStream
   ;; over a proxy of ByteArrayOutputStream, so the whole suite passing is the
   ;; proxy-by-delegation path working end to end.
   :expect {:tests 67 :pass 226 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- time
  {:name "tick"
   :paths ["src" "test"]
   :deps ["@spec.alpha/src/main/clojure"]
   :local-deps ["~time"]
   ;; the one failure is the suite's :bb branch asserting babashka's
   ;; English-only locale rendering ("3030-May-03" under Locale/FRENCH); jolt
   ;; renders the correct French "mai" through the time library.
   :expect {:tests 67 :pass 722 :fail 1 :error 0}}

