   :test-paths ["src/test/clojure"]
   :deps ["@data.priority-map/src/main/clojure"]
   :expect {:tests 23 :pass 1314 :fail 0 :error 0}}

  {:name "core.memoize"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@core.cache/src/main/clojure" "@data.priority-map/src/main/clojure"]
   :expect {:tests 18 :pass 207 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- language / meta
  {:name "tools.macro"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :expect {:tests 4 :pass 14 :fail 0 :error 0}}

  {:name "algo.monads"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@tools.macro/src/main/clojure"]
   :expect {:tests 11 :pass 28 :fail 0 :error 0}}

  {:name "core.match"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; both suites match on the result of JVM reflection (.getReturnType, java.lang.Void)
   :exclude-nses ["clojure.core.match.test.java" "clojure.core.match.test.date"]
   :expect {:tests 118 :pass 153 :fail 0 :error 0}}

  {:name "core.logic"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; nominal.tests loads now that the pretty printer's dispatch fns are
   ;; multimethods it can addMethod to (jolt-v5fh.16), which is where the 64 extra
   ;; passes come from. The nominal residue that surfaced with it (36 fail / 6
   ;; error) was two host ns bugs, both fixed at the root: :use ignored :exclude
   ;; in its refer-all registration, so the test ns's `fresh`/`hash` resolved to
   ;; clojure.core.logic.nominal's instead of clojure.core.logic's / clojure.core's;
   ;; and the refer-clojure macro registered :exclude under the analysis-time ns
   ;; (never the ns an ns form creates), so fd.clj's `-rator` syntax-quotes
   ;; qualified to clojure.core/== instead of clojure.core.logic.fd/==.
   :expect {:tests 423 :pass 658 :fail 0 :error 0}}

  {:name "core.contracts"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :extra-deps {org.clojure/core.unify {:mvn/version "0.5.7"}}
   :expect {:tests 14 :pass 45 :fail 0 :error 0}}

  {:name "tools.reader"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; the 3 fails are the syntax-quote reader-model divergence (a quoted
   ;; syntax-quote is data on the JVM, a form on jolt); see known-divergences.edn
   :expect {:tests 50 :pass 884 :fail 3 :error 0}}

  {:name "tools.namespace"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; the remaining error is a test that builds a symlink through java.lang.reflect
   ;; — Class/forName of an interface, make-array of it, then getMethod/invoke.
   ;; That is the reflection API proper, which jolt does not have.
   :expect {:tests 26 :pass 61 :fail 0 :error 1}}

  {:name "rewrite-clj"
   :paths ["src" "resources" "test"]
   :deps ["@tools.reader/src/main/clojure" "@test.check/src/main/clojure"]
   :expect {:tests 162 :pass 3380 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- spec + testing
  {:name "spec.alpha"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; s/exercise generates through test.check
   :deps ["@test.check/src/main/clojure"]
   ;; the 4 fails are instrument's ::caller, which spec reads off the JVM stack
   ;; trace. jolt does tail calls, so the calling frame is gone before anything can
   ;; look — the conform failure still throws with the same explain-data, it just
   ;; carries no ::caller. See known-divergences.edn.
   :expect {:tests 13 :pass 170 :fail 4 :error 0}}

  {:name "test.check"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@spec.alpha/src/main/clojure"]
   :timeout 900
   ;; property-based: the assertion count moves with the generated cases
   :tolerance 40
   :expect {:tests 123 :pass 230 :fail 15 :error 3}}

  {:name "test.chuck"
   ;; resources/ holds the regex grammar its parser slurps through io/resource
   :paths ["src" "test" "resources"]
   :deps ["@test.check/src/main/clojure" "@spec.alpha/src/main/clojure"]
   ;; the version test.chuck itself declares (its deps.edn / project.clj)
   :extra-deps {instaparse/instaparse {:mvn/version "1.4.10"}}
   :timeout 900
   ;; property-based: the assertion count moves with the generated cases
   :tolerance 30
   ;; regexes-test drives test.chuck's own regex parser against re-pattern. jolt now
   ;; agrees with Java on accepting and rejecting every pattern in its curated list,
   ;; and on what the accepted ones match. What is left is a long tail that is not
   ;; regex-translation work: \N{...} named-character escapes need a Unicode name
   ;; database jolt does not carry, a generated case reaches a lone surrogate (jolt
   ;; chars are scalar values — :string-model), and the clojure-test-output and
   ;; exception-handling namespaces compare printed #error maps whose :trace is
   ;; empty because tail calls leave no frames to report. The load-fail is clj-time,
   ;; which needs joda-time.
   :expect {:tests 39 :pass 98 :fail 22 :error 3 :load-fail 1}}

  ;; ---------------------------------------------------------- data formats
  {:name "data.csv"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :expect {:tests 4 :pass 26 :fail 0 :error 0}}

  {:name "data.codec"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["@test.check/src/main/clojure" "@spec.alpha/src/main/clojure"]
   ;; The suite checks jolt's base64 against commons-codec's, which the
   ;; jolt.shim.commons-codec shim registers ahead of the library's sources.
   ;; The 4 errors are System/arraycopy in the suite's copy-bytes helper — a
   ;; java.lang.System host gap, filed separately, not a shim. The 2 failures
   ;; are clojure.lang.IFn$O..O primitive-interface instance? checks, JVM
   ;; function interfaces jolt has no model for.
   :shims ["!test/conformance/libs/shims/data.codec"]
   :preload ["jolt.shim.commons-codec"]
   :note "System/arraycopy is a jolt host gap; IFn$O..O interfaces are JVM-only"
   :expect {:tests 14 :pass 8 :fail 2 :error 4}}

  {:name "data.json"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; json-gen-test round-trips through stest/check, which generates via test.check
   :deps ["~time/src" "@spec.alpha/src/main/clojure" "@test.check/src/main/clojure"]
   :timeout 900
   ;; The residue is one case in each of the two APIs: an astral character. jolt
   ;; strings are codepoint-indexed, so .charAt hands data.json's escaper a value
   ;; above 0xFFFF where the JVM hands it a surrogate — the escape comes out
   ;; \u1f603 rather than the \ud83d\ude03 pair, and the unescaped path throws
   ;; out of (char cp). :string-model, see known-divergences.edn.
   :expect {:tests 244 :pass 320 :fail 2 :error 2}}

  {:name "data.zip"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   :deps ["~xml/src"]
   :expect {:tests 9 :pass 12 :fail 0 :error 0}}

  {:name "yamlstar"
   :root "yamlstar/core"
   :paths ["src" "test"]
   :deps ["~time/src"]
   :expect {:tests 44 :pass 103 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- markup / text
  {:name "hiccup"
   :paths ["src" "test"]
   :expect {:tests 64 :pass 385 :fail 1 :error 0}}

  {:name "markdown-clj"
   :paths ["src/clj" "src/cljc" "test"]
   :exclude-nses ["markdown.benchmark"]
   ;; yaml metadata parses through clj-yaml, which jolt-lang/yaml supplies as a
   ;; compatibility layer over jolt.yaml. It goes on as a real dependency rather
   ;; than a source path because it declares :jolt/native libyaml.
   :local-deps ["~yaml"]
   ;; markdown-clj's own deps.edn asks for clj-commons/clj-yaml, and jolt resolves
   ;; Maven now, so the real one — snakeyaml, i.e. Java — is what gets loaded and
   ;; it dies on DumperOptions$FlowStyle. The same jolt-lang/yaml source goes on
   ;; ahead of it as a shim so clj_yaml.core resolves to the compatibility layer.
   :shims ["~yaml/src"]
   ;; the 2 errors are org.apache.commons.lang.StringEscapeUtils, a JVM jar
   :expect {:tests 94 :pass 180 :fail 0 :error 2}}

  {:name "Selmer"
   :paths ["src" "test" "resources"]
   ;; jolt-crypto supplies java.security.MessageDigest, which the hash: filter
   ;; calls — the JVM has it built in, jolt gets it from the library. It goes on as
   ;; a real dependency, not a source path, so its :jolt/native libcrypto is loaded.
   :deps ["@data.json/src/main/clojure" "~time/src"]
   :local-deps ["~jolt-crypto"]
   ;; core_test does (:require [cheshire.core :refer :all]). Selmer's own source
   ;; resolves cheshire -> data.json -> jsonista at load and is fine on data.json,
   ;; but the test names cheshire outright, and real cheshire wraps Jackson. The
   ;; shim supplies the cheshire names over data.json.
   ;; selmer.benchmark is excluded from the run but core_test requires it at top
   ;; level and reads its `user` var, so it still has to compile — hence criterium.
   :shims ["!test/conformance/libs/shims/cheshire" "!test/conformance/libs/shims/criterium"]
   :exclude-nses ["selmer.benchmark"]
   ;; The one remaining error is commons-lang StringEscapeUtils, a JVM jar with no
   ;; portable equivalent. Nothing else fails.
   ;;
   ;; The locale work behind this tally lives on three extension points core
   ;; declares and jolt-lang/time fills in: :date-names, :number-symbols and
   ;; :currency-data. Running Selmer needs that library on :deps, which it has.
   :expect {:tests 131 :pass 525 :fail 0 :error 1}}

  {:name "html"
   :paths ["src" "test"]
   :expect {:tests 2 :pass 35 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- data / config
  {:name "honeysql"
   :paths ["src" "test"]
   :deps ["~time/src" "@core.cache/src/main/clojure"
          "@data.priority-map/src/main/clojure"]
   :expect {:tests 175 :pass 832 :fail 0 :error 0}}

  {:name "config"
   :paths ["src" "test"]
   :expect {:tests 3 :pass 8 :fail 0 :error 0}}

  {:name "aero"
   :paths ["src" "test"]
   :expect {:tests 28 :pass 59 :fail 0 :error 0}}

  {:name "malli"
   :paths ["src" "resources" "test"]
   :deps ["~time/src" "@spec.alpha/src/main/clojure"
          "@test.check/src/main/clojure" "@spec-tools/src"
          "@test.chuck/src" "@ordered/src"]
   ;; malli's own deps, from the upstream deps.edn; jolt resolves the source out
   ;; of the Maven jars.
   :extra-deps {borkdude/dynaload {:mvn/version "0.3.5"}
                borkdude/edamame {:mvn/version "1.5.37"}
                fipp/fipp {:mvn/version "0.6.29"}
                mvxcvi/arrangement {:mvn/version "2.1.0"}}
   :timeout 900
   :expect {:tests 28 :pass 121 :fail 4 :error 8 :load-fail 20}}

  ;; ---------------------------------------------------------- web
  {:name "ring-codec"
   :paths ["src" "test"]
   :expect {:tests 9 :pass 72 :fail 0 :error 0}}

  {:name "ring-core"
   :root "ring"
   ;; the suite reads test/ring/assets/… relative to the module, not the repo root
   :dir "ring-core"
   :paths ["ring-core/src" "ring-core-protocols/src" "ring-websocket-protocols/src"
           "ring-core/test"]
   :test-paths ["ring-core/test"]
   :deps ["@ring-codec/src" "~time/src"]
   :local-deps ["~jolt-crypto"]
   :extra-deps {crypto-random/crypto-random {:mvn/version "1.2.1"}
                crypto-equality/crypto-equality {:mvn/version "1.0.1"}}
   ;; The two session/cookie suites are written against clj-time, which is Joda —
   ;; a JVM library with no jolt equivalent. The multipart suites need Apache
   ;; commons-fileupload and commons-io; both are JVM-only too.
   :note "clj-time (Joda) + commons-fileupload/commons-io are JVM-only"
   :expect {:tests 151 :pass 405 :fail 15 :error 18 :load-fail 2}}

  {:name "ring-spec"
   :paths ["src" "test"]
   :deps ["@spec.alpha/src/main/clojure" "@ring/ring-core-protocols/src"]
   ;; ring-spec's only test is the lein template placeholder, (is (= 0 1)) under a
   ;; "FIXME, I fail." — it fails on the JVM too. The library itself loads, which is
   ;; what running it here checks.
   :note "the single failure is upstream's unedited template test"
   :expect {:tests 1 :pass 0 :fail 1 :error 0}}

  {:name "reitit-core"
   :root "reitit"
   :paths ["modules/reitit-core/src" "test/cljc"]
   :test-paths ["test/cljc"]
   :deps ["~router/src" "@spec.alpha/src/main/clojure"]
   :extra-deps {meta-merge/meta-merge {:mvn/version "1.0.0"}}
   ;; test/cljc holds the suites for every reitit module; these are the ones that
   ;; need reitit-core alone (the rest pull reitit-ring / -malli / muuntaja /
   ;; jsonista, which are not in the checkout).
   :nses ["reitit.core-test" "reitit.impl-test" "reitit.trie-test"
          "reitit.spec-test"]
   ;; reitit's fast router is built on reitit.Trie, a compiled Java class. jolt-lang/
   ;; router reimplements that trie in Clojure and registers it as the reitit.Trie
   ;; host class, which is how reitit-core runs here unmodified — but only if it is
   ;; loaded before reitit builds a router.
   :preload ["reitit.trie-jolt"]
   :expect {:tests 27 :pass 615 :fail 0 :error 0}}

  ;; ---------------------------------------------------------- tooling
  {:name "compliment"
   :paths ["src" "test"]
   :extra-deps {nubank/matcher-combinators {:mvn/version "3.9.2"}}
   ;; Reflection-backed sources (class members, classes, resources) and classpath
   ;; enumeration do not apply to jolt's host model, and t-core/t-vars pin exact
   ;; candidate lists that jolt's different clojure.core surface changes — see the
   ;; library's own CONFORMANCE.md. These are the host-neutral suites.
   :nses ["compliment.t-context" "compliment.sources.t-special-forms"
          "compliment.sources.t-local-bindings" "compliment.sources.t-keywords"
          "compliment.sources.t-data-readers"]
   ;; completions reflect the live runtime (interned keywords, loaded namespaces),
   ;; so the assertion count moves with suite order
   :tolerance 10
   :expect {:tests 7 :pass 65 :fail 0 :error 0}}

  {:name "lasertag"
   :paths ["src" "test"]
   :deps ["~time/src"]
   ;; lasertag classifies a value by its class, so every failure here is jolt's class
   ;; model rather than a behavioral difference: the narrow numeric classes collapse
   ;; to Long/Double (:integer-box-model), the specialized seq classes to
   ;; PersistentList/LazySeq (:seq-type-model), and subvec has no class of its own —
   ;; which lasertag derives from a sample value, so it reads every vector as a
   ;; subvec. All recorded in known-divergences.edn.
   :expect {:tests 58 :pass 46 :fail 12 :error 0}}

  {:name "tools.logging"
   :paths ["src/main/clojure" "src/test/clojure"]
   :test-paths ["src/test/clojure"]
   ;; test-impl pins the log4j2 backend, which needs the org.apache.logging.log4j jars
   :exclude-nses ["clojure.tools.logging.test-impl"]
   ;; impl/find-factory picks a backend at LOAD time and throws when every one it
   ;; probes is missing, which on jolt is all of them — so without a backend the
   ;; whole suite is a load-fail. The shim registers the classes its FIRST probe
   ;; looks for (org.slf4j), leaving tools.logging itself unmodified and on its own
   ;; slf4j code path. :preload because find-factory runs before any test does.
   :shims ["!test/conformance/libs/shims/slf4j"]
   :preload ["jolt.shim.slf4j"]
   :expect {:tests 67 :pass 219 :fail 0 :error 4}}

  ;; ---------------------------------------------------------- time
  {:name "tick"
   :paths ["src" "test"]
   :deps ["~time/src" "@spec.alpha/src/main/clojure"]
   :expect {:tests 41 :pass 620 :fail 0 :error 0 :load-fail 1}}

  ;; ---------------------------------------------------------- skipped
  {:name "process"
